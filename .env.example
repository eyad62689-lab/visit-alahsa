# ── متغيرات بيئة «زوروا الأحساء» ─────────────────────────────────────────────
#
# انسخ هذا الملف إلى `.env` واملأ القيم الحقيقية. `.env` محجوب في .gitignore.
# هذا الملف نموذج فقط — **لا تضع فيه قيمة حقيقية واحدة**.
#
# القيم الحقيقية للإنتاج تُضبط في لوحة Netlify:
#   Site configuration ← Environment variables
# وقاعدة المستودع (astro-site/CLAUDE.md § قواعد الكود): «لا مفاتيح في الكود».
#
# جُرد بالفحص الفعلي على المصدر (2026-09-03): عشرة متغيرات مستهلكة —
# سبعة تُضبط في Netlify، واثنان محليان فقط، وواحد تحقنه Netlify تلقائياً.
# لا يوجد متغير `PUBLIC_*` — لا شيء من هذه يصل متصفح الزائر.
# (معرّف GA4 مكتوب في `src/layouts/Base.astro` لا هنا: معرّف قياس عام بطبيعته.)
# ─────────────────────────────────────────────────────────────────────────────


# ═══ ١) تُضبط في لوحة Netlify — تخص الإنتاج ═════════════════════════════════

# تقييمات المنشآت وأوقات عملها من Google Places وقت البناء · يستهلكه tools/fetch-places.mjs (prebuild)
# بلا مفتاح: تحذير صاخب في سجل البناء والصفحة تُبنى بلا تقييمات — لا يُفشل البناء أبداً.
GOOGLE_PLACES_API_KEY=AIza-ضع-المفتاح-هنا-قيمة-وهمية

# ملح تجزئة عنوان IP (التزام PDPL: لا عنوان خام في أي سجل) · يستهلكه netlify/functions/copy-log.mjs و netlify/edge-functions/bot-log.mjs
# سلسلة عشوائية طويلة تُولَّد مرة واحدة ولا تُغيَّر — تغييرها يقطع تمييز المصدر الواحد في السجلات القديمة.
IP_HASH_SALT=سلسلة-عشوائية-طويلة-وهمية-غيّرها

# بحث السرقة الخارجية عبر Serper · يستهلكه netlify/functions/theft-scan.mjs (المسح الأسبوعي، 15 عبارة لكل تشغيل)
# بلا مفتاح: تخطٍّ سِلمي مذكور داخل التقرير الأسبوعي.
SERPER_API_KEY=serper-مفتاح-وهمي-0000000000

# إرسال بريد التنبيه عند رصد تطابق خارجي · يستهلكه netlify/functions/theft-scan.mjs
RESEND_API_KEY=re_مفتاح_وهمي_0000000000

# مستقبِل تنبيه السرقة · يستهلكه netlify/functions/theft-scan.mjs
ALERT_EMAIL_TO=owner@example.com

# مُرسِل تنبيه السرقة (نطاق موثَّق في Resend) · يستهلكه netlify/functions/theft-scan.mjs
ALERT_EMAIL_FROM=alerts@example.com

# مفتاح تعطيل إشعار IndexNow دون حذف الإضافة · يستهلكه netlify/plugins/indexnow/index.mjs
# اتركه فارغاً في الإنتاج؛ اضبطه على 1 لتجربة النشر بلا إشعار فعلي.
INDEXNOW_DRY_RUN=


# ═══ ٢) محلية فقط — لا تُضبط في Netlify ═════════════════════════════════════

# معرّف الموقع لسحب تقارير حماية المحتوى من Blobs · يستهلكه scripts/pull-reports.mjs (npm run pull:reports)
# مصدره: لوحة Netlify ← Site configuration ← Site ID
NETLIFY_SITE_ID=00000000-0000-0000-0000-000000000000

# رمز وصول شخصي لسحب التقارير · يستهلكه scripts/pull-reports.mjs
# مصدره: Netlify ← User settings ← Applications ← Personal access tokens
# **رمز حساس** — لا يُودَع في المستودع ولا يُلصق في محادثة.
NETLIFY_AUTH_TOKEN=nfp_رمز_وهمي_0000000000


# ═══ ٣) تحقنه Netlify تلقائياً — لا تضبطه بنفسك ═════════════════════════════

# التزام آخر نشر ناجح · يقرؤه netlify/plugins/indexnow/submit.mjs ليدفع ما تغيّر فقط
# بلا قيمة (أول نشر أو بناء محلي): تُدفع الخريطة كاملة بدل التفاضلي.
# CACHED_COMMIT_REF=   ← اتركه معطَّلاً؛ Netlify تضبطه في بيئة البناء.
