---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import { getCollection } from 'astro:content';
import { catLabel } from '../../lib/categories';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

// أرقام العدّادات بالأرقام العربية‑الهندية في النسخة العربية اتّساقاً مع سائر الموقع.
const num = (n: number) => (ar ? String(n).replace(/[0-9]/g, (d) => '٠١٢٣٤٥٦٧٨٩'[+d]) : String(n));

const items = (await getCollection('attractions')).sort((x, y) => x.data.order - y.data.order);
const detailBase = ar ? '/معالم/' : '/en/attractions/';
const mapHref = ar ? '/خريطة/' : '/en/map/';

// ترتيب عرض المجموعات — الأكثر شهرةً أولاً (قصر إبراهيم، جبل القارة، جواثا، القيصرية…).
// المعالم داخل كل مجموعة مرتّبة أصلاً بحقل order (الأشهر أولاً). كل مجموعة قسمٌ
// بمرساة #cat-<الفئة> تنقل إليها أيقونتها في شريط المجموعات.
const DISPLAY_ORDER = ['historic', 'nature', 'religious', 'market', 'parks', 'farm'];
const groups = DISPLAY_ORDER
  .map((cat) => ({ cat, list: items.filter((i) => i.data.category === cat) }))
  .filter((g) => g.list.length > 0);

// أيقونات المجموعات (خطّية، currentColor) — بديلة لخيارات الفلترة المحذوفة.
const CAT_ICONS: Record<string, string> = {
  historic: '<polygon points="12 2 20 7 4 7"/><line x1="6" y1="10" x2="6" y2="17"/><line x1="10" y1="10" x2="10" y2="17"/><line x1="14" y1="10" x2="14" y2="17"/><line x1="18" y1="10" x2="18" y2="17"/><line x1="4" y1="17" x2="20" y2="17"/><line x1="3" y1="21" x2="21" y2="21"/>',
  nature: '<path d="m8 3 4 8 5-5 5 15H2L8 3z"/>',
  religious: '<path d="M3 21h18"/><path d="M6 21v-6"/><path d="M18 21v-6"/><path d="M5 15a7 7 0 0 1 14 0"/><path d="M12 3.5c1.1 1.1 1.6 2 1.6 2.9a1.6 1.6 0 0 1-3.2 0c0-.9.5-1.8 1.6-2.9z"/><path d="M9 21v-4a3 3 0 0 1 6 0v4"/>',
  market: '<path d="M4 9h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M3 9l1.6-4h14.8L21 9z"/><path d="M3 9h18"/><path d="M9 21v-6h6v6"/>',
  parks: '<path d="M12 22v-5"/><path d="M12 17a5.5 5.5 0 0 0 5.5-5.5c0-1.5-.6-2.6-.6-2.6A5 5 0 0 0 12 4a5 5 0 0 0-4.9 4.9s-.6 1.1-.6 2.6A5.5 5.5 0 0 0 12 17z"/>',
  farm: '<path d="M12 21v-8"/><path d="M12 13c-.5-3-3-5-7-4 3-1.5 5.5-1 7 1 .5-3 3-5 7-4-3-1.5-5.5-1-7 1z"/>',
};
const groupsHint = ar ? 'ابحث بالاسم، أو تصفّح المجموعات أدناه.' : 'Search by name, or browse the groups below.';
const groupsNavAria = ar ? 'مجموعات المعالم' : 'Attraction groups';

const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(alt[lang], siteUrl).href },
    { '@type': 'ListItem', position: 2, name: t('crumb.attractions'), item: new URL(detailBase, siteUrl).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: t('list.title'), numberOfItems: items.length,
    itemListElement: items.map((i, n) => ({ '@type': 'ListItem', position: n + 1, name: ar ? i.data.title : (i.data.title_en ?? i.data.title), url: new URL(detailBase + (ar ? i.data.slug_ar : i.data.slug_en), siteUrl).href })) },
];
---
<Base title={`${t('list.title')} — ${t('site.name')}`} description={t('list.lead')} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-attractions">
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="list-hero on-dark">
      <picture class="photo-bg lh-poster" aria-hidden="true">
        <source srcset="/img/hero-attractions.webp" type="image/webp" />
        <img src="/img/hero-attractions.jpg" alt="" fetchpriority="high" decoding="async" />
      </picture>
      <video class="photo-bg lh-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source data-src="/video/hero-attractions.mp4" type="video/mp4" />
      </video>
      <PalmMotif size={320} class="lh-wm" aria-hidden="true" />
      <div class="container lh-in">
        <span class="eyebrow gold-on-dark">{t('list.eyebrow')}</span>
        <h1 class="lh-title">{t('list.title')}</h1>
        <p class="lh-sum">{t('list.lead')}</p>
        <a href={mapHref} class="btn btn--gold lh-map">{t('list.map')}</a>
      </div>
    </section>

    <section class="container list-body">
      <div class="list-tools">
        <p class="list-hint">{groupsHint}</p>
        <input class="list-search" id="list-search" type="search" placeholder={t('list.search')} aria-label={t('list.searchLabel')} />
      </div>

      <nav class="cat-nav" aria-label={groupsNavAria}>
        {groups.map((g) => (
          <a class="cat-nav-item" href={`#cat-${g.cat}`}>
            <span class="cat-nav-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={CAT_ICONS[g.cat]} /></span>
            <span class="cat-nav-tx">
              <span class="cat-nav-l">{catLabel(g.cat, lang)}</span>
              <span class="cat-nav-n">{num(g.list.length)}</span>
            </span>
          </a>
        ))}
      </nav>

      <div id="list-grid">
        {groups.map((g) => (
          <section class="cat-sec" id={`cat-${g.cat}`} aria-labelledby={`h-${g.cat}`}>
            <header class="cat-sec-head">
              <span class="cat-sec-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={CAT_ICONS[g.cat]} /></span>
              <h2 class="cat-sec-t" id={`h-${g.cat}`}>{catLabel(g.cat, lang)}</h2>
              <span class="cat-sec-count">{num(g.list.length)}</span>
            </header>
            <div class="list-grid">
              {g.list.map((i, idx) => (
                <article class="att-card" data-cat={i.data.category} data-title={`${i.data.title} ${i.data.title_en ?? ''}`} data-reveal style={`transition-delay:${(idx % 4) * 60}ms`}>
                  <a class="lc-link" href={detailBase + (ar ? i.data.slug_ar : i.data.slug_en)}>
                    <Photo src={i.data.heroImage} label={ar ? i.data.title : (i.data.title_en ?? i.data.title)} class="lc-photo" sizes="(max-width: 760px) 100vw, 33vw" />
                    <div class="lc-body">
                      <span class="t-caption lc-k">{catLabel(i.data.category, lang)}</span>
                      <h3 class="lc-t">{ar ? i.data.title : (i.data.title_en ?? i.data.title)}</h3>
                      <p class="lc-d">{ar ? i.data.summary : (i.data.summary_en ?? i.data.summary)}</p>
                    </div>
                  </a>
                  <button class="fav-btn fav-btn--corner" type="button" data-fav={i.data.slug_ar} aria-pressed="false" aria-label={t('fav.add')}><span class="fav-ic"></span></button>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
      <p class="empty" id="empty" hidden>{t('list.empty')}</p>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<script>
  // تشغيل فيديو الهيرو فقط عند السماح بالحركة وعدم تفعيل توفير البيانات؛
  // preload="none" + data-src يمنعان تنزيل الفيديو لمن لا يشمله التشغيل.
  const v = document.querySelector<HTMLVideoElement>('.lh-video');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  if (v && !reduceMotion && !saveData) {
    const s = v.querySelector('source');
    if (s?.dataset.src) {
      v.addEventListener('playing', () => v.classList.add('lh-video--on'), { once: true });
      s.src = s.dataset.src;
      v.autoplay = true;
      v.load();
      v.addEventListener('canplay', () => { v.play().catch(() => {}); }, { once: true });
    }
  }
</script>

<script is:inline>
  function initFilter() {
    const search = document.getElementById('list-search');
    const cards = document.querySelectorAll('#list-grid .att-card');
    const sections = document.querySelectorAll('#list-grid .cat-sec');
    const empty = document.getElementById('empty');
    if (!search || search.dataset.wired) return;
    // بحثٌ حرّ بالاسم عبر كل المجموعات؛ تُخفى المجموعة التي لا نتيجة فيها.
    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const ok = !q || (card.getAttribute('data-title') || '').toLowerCase().includes(q);
        card.style.display = ok ? '' : 'none'; if (ok) shown++;
      });
      sections.forEach((sec) => { sec.hidden = !sec.querySelector('.att-card:not([style*="display: none"])'); });
      if (empty) empty.hidden = shown !== 0;
    }
    search.dataset.wired = '1';
    search.addEventListener('input', apply);
    // روابط ?cat= القديمة (الرئيسية/التذييل) تنقل إلى قسم المجموعة المطابق.
    const want = new URLSearchParams(location.search).get('cat');
    if (want) {
      const sec = document.getElementById('cat-' + want);
      if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  document.addEventListener('astro:page-load', initFilter);
  if (document.readyState !== 'loading') initFilter(); else document.addEventListener('DOMContentLoaded', initFilter);
</script>

<style>
  .list-hero { position: relative; overflow: hidden; background: var(--c-turq-deep); padding-block: var(--s-8) var(--s-7); }
  /* فيديو الهيرو فوق الخلفية الفيروزية؛ يظهر تدريجياً بعد بدء التشغيل، والخلفية تبقى احتياطاً
     لمن يُفعّل «تقليل الحركة» أو «توفير البيانات». */
  .lh-video { object-fit: cover; inline-size: 100%; block-size: 100%; opacity: 0; transition: opacity 1.2s var(--ease); filter: saturate(.94) contrast(1.03); }
  .lh-video--on { opacity: 1; }
  /* طبقة تعتيم لضمان وضوح النصّ فوق الفيديو */
  .list-hero::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(105deg, rgba(0,42,38,.82) 0%, rgba(0,55,49,.55) 50%, rgba(0,79,70,.4) 100%);
  }
  :global(.lh-wm) { position: absolute; inset-block-start: -10%; inset-inline-end: -5%; z-index: 0; color: var(--c-gold); opacity: .1; }
  .lh-in { position: relative; z-index: 2; max-inline-size: 56ch; }
  .lh-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .lh-sum { font-size: var(--t-lg); color: rgba(247,243,234,.9); }
  .lh-map { margin-block-start: var(--s-4); }
  .list-body { padding-block: var(--s-6) var(--s-8); }
  .list-tools { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; margin-block-end: var(--s-5); }
  .list-hint { font-size: var(--t-sm); color: var(--c-ink-soft); }
  .list-search { font-family: var(--font-body); font-size: var(--t-sm); color: var(--c-ink);
    background: #fff; border: 1px solid var(--c-line); border-radius: 999px; padding: 9px 18px; min-inline-size: 220px; }
  .list-search::placeholder { color: var(--c-ink-60); }

  /* شريط المجموعات — أيقونات تنقل إلى أقسامها (بديل خيارات الفلترة) */
  .cat-nav { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s-3); margin-block-end: var(--s-7); }
  .cat-nav-item { display: flex; align-items: center; gap: var(--s-3); background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); padding: var(--s-3) var(--s-4); text-decoration: none; color: var(--c-ink); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .cat-nav-item:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: transparent; }
  .cat-nav-ic { display: inline-grid; place-items: center; inline-size: 42px; block-size: 42px; flex: 0 0 auto; border-radius: 11px; background: color-mix(in srgb, var(--c-turq) 10%, #fff); color: var(--c-turq); }
  .cat-nav-ic svg { inline-size: 22px; block-size: 22px; }
  /* التسمية فوق شارة العدد في عمود واحد — الصفّ الأفقي القديم كان يفيض بالشارة
     خارج حدّ البطاقة عندما يضيق عمود الشبكة عن حدّه الأدنى (الحاسوب والجوال معاً). */
  .cat-nav-tx { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; min-inline-size: 0; }
  .cat-nav-l { font-family: var(--font-body); font-weight: 600; font-size: var(--t-sm); line-height: 1.3; }
  .cat-nav-n { font-size: var(--t-xs); font-weight: 700; color: var(--c-gold-deep); background: var(--c-sand-2); border-radius: 999px; padding: 1px 9px; }

  /* أقسام المجموعات */
  .cat-sec { scroll-margin-block-start: 84px; margin-block-end: var(--s-7); }
  .cat-sec:last-of-type { margin-block-end: 0; }
  .cat-sec[hidden] { display: none; }
  .cat-sec-head { display: flex; align-items: center; gap: var(--s-3); margin-block-end: var(--s-4); }
  .cat-sec-ic { display: inline-grid; place-items: center; inline-size: 40px; block-size: 40px; flex: 0 0 auto; border-radius: 11px; background: color-mix(in srgb, var(--c-turq) 12%, #fff); color: var(--c-turq-deep); }
  .cat-sec-ic svg { inline-size: 22px; block-size: 22px; }
  .cat-sec-t { font-size: var(--t-xl); color: var(--c-turq-deep); }
  .cat-sec-count { font-size: var(--t-xs); font-weight: 700; color: var(--c-gold-deep); background: var(--c-sand-2); border-radius: 999px; padding: 2px 10px; }
  .cat-sec-head::after { content: ''; flex: 1; block-size: 1px; background: var(--c-line); }

  .list-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(264px, 1fr)); gap: var(--s-4); }
  .att-card { position: relative; background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform var(--dur) var(--ease); }
  .lc-link { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .att-card:hover { transform: translateY(-4px); }
  .lc-photo { aspect-ratio: 16 / 10; }
  .lc-body { padding: var(--s-3) var(--s-4) var(--s-5); }
  .lc-k { color: var(--c-gold-deep); }
  .lc-t { font-size: var(--t-lg); color: var(--c-turq-deep); margin-block: var(--s-1) var(--s-2); }
  .lc-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.7; }
  .empty { text-align: center; color: var(--c-ink-soft); padding-block: var(--s-6); }
  @media (max-width: 760px) {
    .list-tools { flex-direction: column; align-items: stretch; }
    .list-search { inline-size: 100%; }
    /* tighten hero text on tablet */
    .lh-sum { font-size: var(--t-base); }
  }
</style>
