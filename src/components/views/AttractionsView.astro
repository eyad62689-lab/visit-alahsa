---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import Photo from '../Photo.astro';
import { getCollection } from 'astro:content';
import { catLabel } from '../../lib/categories';
import { attractionHref } from '../../lib/routes';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

// النطاق: 'sights' صفحة المعالم (تاريخ/طبيعة/دين)، و'leisure' صفحة الأسواق
// والمنتزهات والمزارع المستقلة (فُصلت بطلب إياد 2026-07-13).
interface Props { lang: Lang; alt: AltLinks; scope?: 'sights' | 'leisure'; }
const { lang, alt, scope = 'sights' } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
const leisure = scope === 'leisure';

// أرقام العدّادات بالأرقام العربية‑الهندية في النسخة العربية اتّساقاً مع سائر الموقع.
// الأرقام لاتينية (0-9) في اللغتين — قرار إياد 2026-07-21
const num = (n: number) => String(n);

const detailBase = ar ? '/معالم/' : '/en/attractions/';
const mapHref = ar ? '/خريطة/' : '/en/map/';

// نصوص الصفحة بحسب النطاق (list.* للمعالم، list2.* للأسواق والمنتزهات)
const K = leisure ? 'list2' : 'list';
const tx = (suffix: string) => t(`${K}.${suffix}` as any);

// ترتيب عرض المجموعات — الأكثر شهرةً أولاً. كل مجموعة قسمٌ بمرساة #cat-<الفئة>
// تنقل إليها أيقونتها في شريط المجموعات. المعالم داخل كل مجموعة مرتّبة بحقل order.
const DISPLAY_ORDER = leisure ? ['market', 'parks', 'farm'] : ['historic', 'museum', 'nature', 'religious'];
const items = (await getCollection('attractions'))
  .filter((i) => DISPLAY_ORDER.includes(i.data.category))
  .sort((x, y) => x.data.order - y.data.order);
const groups = DISPLAY_ORDER
  .map((cat) => ({ cat, list: items.filter((i) => i.data.category === cat) }))
  .filter((g) => g.list.length > 0);

// هيرو الصفحة: للمعالم صورة وفيديو hero-attractions؛ لصفحة الأسواق صورة القيصرية بلا فيديو.
const heroImg = leisure ? '/img/qaisariyah' : '/img/hero-attractions';
const heroVideo = leisure ? null : '/video/hero-attractions.mp4';
const selfPath = leisure ? (ar ? '/أسواق-ومنتزهات-ومزارع/' : '/en/souqs-parks-farms/') : detailBase;

// أيقونات المجموعات (خطّية، currentColor) — بديلة لخيارات الفلترة المحذوفة.
const CAT_ICONS: Record<string, string> = {
  historic: '<path d="M3 21h18"/><path d="M5 21V9h2V7h2v2h2V7h2v2h2V7h2v2h2v12"/><path d="M10 21v-5a2 2 0 0 1 4 0v5"/>',
  museum: '<polygon points="12 2 20 7 4 7"/><line x1="6" y1="10" x2="6" y2="17"/><line x1="10" y1="10" x2="10" y2="17"/><line x1="14" y1="10" x2="14" y2="17"/><line x1="18" y1="10" x2="18" y2="17"/><line x1="4" y1="17" x2="20" y2="17"/><line x1="3" y1="21" x2="21" y2="21"/>',
  nature: '<path d="m8 3 4 8 5-5 5 15H2L8 3z"/>',
  religious: '<path d="M3 21h18"/><path d="M6 21v-6"/><path d="M18 21v-6"/><path d="M5 15a7 7 0 0 1 14 0"/><path d="M12 3.5c1.1 1.1 1.6 2 1.6 2.9a1.6 1.6 0 0 1-3.2 0c0-.9.5-1.8 1.6-2.9z"/><path d="M9 21v-4a3 3 0 0 1 6 0v4"/>',
  market: '<path d="M4 9h16v11a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z"/><path d="M3 9l1.6-4h14.8L21 9z"/><path d="M3 9h18"/><path d="M9 21v-6h6v6"/>',
  parks: '<path d="M12 22v-5"/><path d="M12 17a5.5 5.5 0 0 0 5.5-5.5c0-1.5-.6-2.6-.6-2.6A5 5 0 0 0 12 4a5 5 0 0 0-4.9 4.9s-.6 1.1-.6 2.6A5.5 5.5 0 0 0 12 17z"/>',
  farm: '<path d="M12 21v-8"/><path d="M12 13c-.5-3-3-5-7-4 3-1.5 5.5-1 7 1 .5-3 3-5 7-4-3-1.5-5.5-1-7 1z"/>',
};
const groupsHint = ar ? 'ابحث بالاسم، أو تصفّح المجموعات أدناه.' : 'Search by name, or browse the groups below.';

const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: tx('title'), item: new URL(selfPath, siteUrl).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: tx('title'), numberOfItems: items.length,
    itemListElement: items.map((i, n) => ({ '@type': 'ListItem', position: n + 1, name: ar ? i.data.title : (i.data.title_en ?? i.data.title), url: new URL(attractionHref(i.data, lang), siteUrl).href })) },
];
---
<Base title={`${tx('title')} — ${t('site.name')}`} description={tx('lead')} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage={heroImg}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={tx('eyebrow')} title={tx('title')} lead={tx('lead')} leadWidth={56}
      poster={heroImg} video={heroVideo ?? undefined} lang={lang}>
      <a href={mapHref} class="btn btn--gold lh-map">{t('list.map')}</a>
    </PageHero>

    <section class="container list-body">
      <div class="list-tools">
        <p class="list-hint">{groupsHint}</p>
        <input class="list-search" id="list-search" type="search" placeholder={t('list.search')} aria-label={t('list.searchLabel')} />
      </div>

      <div id="list-grid">
        {groups.map((g, gi) => (
          <details class="cat-sec" id={`cat-${g.cat}`} open={gi === 0}>
            <summary class="cat-sec-head">
              <span class="cat-sec-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={CAT_ICONS[g.cat]} /></span>
              <h2 class="cat-sec-t" id={`h-${g.cat}`}>{catLabel(g.cat, lang)}</h2>
              <span class="cat-sec-count">{num(g.list.length)}</span>
              <span class="cat-sec-chev" aria-hidden="true"></span>
            </summary>
            <div class="list-grid">
              {g.list.map((i, idx) => (
                <article class="att-card" data-cat={i.data.category} data-title={`${i.data.title} ${i.data.title_en ?? ''}`} data-reveal style={`transition-delay:${(idx % 4) * 60}ms`}>
                  <a class="lc-link" href={attractionHref(i.data, lang)}>
                    <Photo src={i.data.heroImage} label={ar ? i.data.title : (i.data.title_en ?? i.data.title)} class="lc-photo" sizes="(max-width: 760px) 100vw, 33vw" />
                    <div class="lc-body">
                      <span class="t-caption lc-k">{catLabel(i.data.category, lang)}</span>
                      <h3 class="lc-t">{ar ? i.data.title : (i.data.title_en ?? i.data.title)}</h3>
                      <p class="lc-d">{ar ? i.data.summary : (i.data.summary_en ?? i.data.summary)}</p>
                    </div>
                  </a>
                  <button class="fav-btn fav-btn--corner" type="button" data-fav={i.data.slug_ar} aria-pressed="false" aria-label={t('fav.add')}><span class="fav-ic"></span></button>
                </article>
              ))}
            </div>
          </details>
        ))}
      </div>
      <p class="empty" id="empty" hidden>{t('list.empty')}</p>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<script is:inline>
  function initFilter() {
    const search = document.getElementById('list-search');
    const cards = document.querySelectorAll('#list-grid .att-card');
    const sections = document.querySelectorAll('#list-grid .cat-sec');
    const empty = document.getElementById('empty');
    if (!search || search.dataset.wired) return;
    // بحثٌ حرّ بالاسم عبر كل المجموعات؛ تُخفى المجموعة التي لا نتيجة فيها. الأقسام قوائم
    // منسدلة (<details>): أثناء البحث تُفتح الأقسام المطابقة لتظهر نتائجها، وعند مسح البحث
    // تعود الحالة الأولى (الأول مفتوح والبقية مطويّة).
    function apply() {
      const q = (search.value || '').trim().toLowerCase();
      let shown = 0;
      cards.forEach((card) => {
        const ok = !q || (card.getAttribute('data-title') || '').toLowerCase().includes(q);
        card.hidden = !ok; if (ok) shown++;
      });
      sections.forEach((sec, i) => {
        const hasMatch = !!sec.querySelector('.att-card:not([hidden])');
        sec.hidden = !hasMatch;
        if (q) { if (hasMatch) sec.open = true; }
        else { sec.open = i === 0; }
      });
      if (empty) empty.hidden = shown !== 0;
    }
    search.dataset.wired = '1';
    search.addEventListener('input', apply);
    // روابط ?cat= القديمة (الرئيسية/التذييل) تفتح قسم المجموعة المطابق وتنقل إليه.
    const want = new URLSearchParams(location.search).get('cat');
    if (want) {
      const sec = document.getElementById('cat-' + want);
      if (sec) { sec.open = true; sec.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    }
  }
  document.addEventListener('astro:page-load', initFilter);
  if (document.readyState !== 'loading') initFilter(); else document.addEventListener('DOMContentLoaded', initFilter);
</script>

<style>
  /* التحديد على الفقرة لا على الحاوية — وإلا انزاحت الكتلة عن حافة البداية */
  .lh-map { margin-block-start: var(--s-4); }
  .list-body { padding-block: var(--s-6) var(--s-8); }
  .list-tools { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; margin-block-end: var(--s-5); }
  .list-hint { font-size: var(--t-sm); color: var(--c-ink-soft); }
  /* 16px حدّ أدنى إلزامي: سفاري iOS يزوّم الصفحة تلقائياً عند لمس أي حقل أصغر */
  .list-search { font-family: var(--font-body); font-size: 16px; color: var(--c-ink);
    background: #fff; border: 1px solid var(--c-line); border-radius: 999px; padding: 9px 18px; min-inline-size: 220px; }
  .list-search::placeholder { color: var(--c-ink-60); }

  /* أقسام المجموعات — قوائم منسدلة أصيلة (<details>): تحسين تدريجي، تعمل بلا جافاسكربت */
  .cat-sec { scroll-margin-block-start: 84px; margin-block-end: var(--s-7); }
  /* قسم مطويّ ليس تحته شيء يفصله: بـ64px هامش + 24px تحت الرأس كان بين كل رأسين
     مطويّين 88px فراغ فتُقرأ الأقسام كأنها لم تُحمَّل. المطويّة تلتصق قائمةً. */
  .cat-sec:not([open]) { margin-block-end: var(--s-4); }
  .cat-sec:last-of-type { margin-block-end: 0; }
  .cat-sec[hidden] { display: none; }
  /* summary هو العنوان القابل للنقر — نُزيل مؤشّر المتصفح الافتراضي ونضبطه شبكةً مرنة */
  summary.cat-sec-head { display: flex; align-items: center; gap: var(--s-3); cursor: pointer; list-style: none; }
  /* الفراغ تحت الرأس ينتمي إلى الشبكة المفتوحة لا إلى الرأس نفسه */
  .cat-sec > .list-grid { margin-block-start: var(--s-4); }
  summary.cat-sec-head::-webkit-details-marker { display: none; }
  summary.cat-sec-head:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 4px; border-radius: var(--radius-sm); }
  .cat-sec-ic { display: inline-grid; place-items: center; inline-size: 40px; block-size: 40px; flex: 0 0 auto; border-radius: 11px; background: color-mix(in srgb, var(--c-turq) 12%, #fff); color: var(--c-turq-deep); }
  .cat-sec-ic svg { inline-size: 22px; block-size: 22px; }
  .cat-sec-t { font-size: var(--t-xl); color: var(--c-turq-deep); }
  /* خلفية بيضاء لا رملية-2: الذهبي الداكن عليها 4.46:1 فقط — دون حدّ AA للنصّ
     الصغير — وعلى الأبيض 5.45:1. */
  .cat-sec-count { font-size: var(--t-xs); font-weight: 700; color: var(--c-gold-deep); background: #fff; border: 1px solid var(--c-line); border-radius: 999px; padding: 2px 10px; }
  .cat-sec-head::after { content: ''; flex: 1; block-size: 1px; background: var(--c-line); }
  /* شيفرون الطيّ — order:1 يضعه بعد الخطّ الفاصل (::after)؛ يدور للأعلى عند الفتح */
  /* بلا order:1 — كان الشيفرون يقع بعد الخطّ الفاصل أي على بُعد ~940px من
     العنوان الذي يطويه. الآن يلي العدّاد مباشرةً كما يفعل عرض الهاتف. */
  .cat-sec-chev { flex: 0 0 auto; inline-size: 9px; block-size: 9px; border-inline-end: 2px solid var(--c-turq-deep); border-block-end: 2px solid var(--c-turq-deep); transform: rotate(45deg); transition: transform var(--dur) var(--ease); }
  .cat-sec[open] > summary .cat-sec-chev { transform: rotate(-135deg); }
  @media (prefers-reduced-motion: reduce) { .cat-sec-chev { transition: none; } }

  .list-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 264px), 1fr)); gap: var(--s-4); }
  .att-card { position: relative; background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); transition: transform var(--dur) var(--ease); }
  .lc-link { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .att-card:hover { transform: translateY(-4px); }
  .lc-photo { aspect-ratio: 16 / 10; }
  .lc-body { padding: var(--s-3) var(--s-4) var(--s-5); }
  .lc-k { color: var(--c-gold-deep); }
  .lc-t { font-size: var(--t-lg); color: var(--c-turq-deep); margin-block: var(--s-1) var(--s-2); }
  .lc-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.7; }
  .empty { text-align: center; color: var(--c-ink-soft); padding-block: var(--s-6); }
  @media (max-width: 760px) {
    .list-tools { flex-direction: column; align-items: stretch; }
    .list-search { inline-size: 100%; }
    /* tighten hero text on tablet */
    /* عنوان القسم كان يبقى 30px على الجوال فينكسر 3 أسطر («المساجد والمواقع
       الدينية»)؛ الخطّ الفاصل يزاحمه على العرض فيُخفى هنا ويُضيَّق الفراغ */
    .cat-sec-t { font-size: var(--t-lg); }
    summary.cat-sec-head { gap: var(--s-2); }
    .cat-sec-head::after { display: none; }
  }
</style>
