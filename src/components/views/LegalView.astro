---
// السياسات والشروط القانونية — النص العربي منقول حرفياً من وثيقة اعتمدها إياد
// (docx، آخر تحديث 10 يوليو 2026م)، والإنجليزية ترجمة أمينة لها. القرارات (2026-07-10):
// تُبقى أقسام Google Analytics كما هي لأن إياد يستخدمه فعلاً؛ استُبدلت بها صفحة الخصوصية
// المختصرة القديمة. تكيّف وحيد: مرجع «صفحة اتصل بنا» غير الموجودة → البريد الرسمي.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { LEGAL_SECTIONS_AR, LEGAL_SECTIONS_EN, LEGAL_SECTIONS_RU, LEGAL_SECTIONS_DE, LEGAL_SECTIONS_ZH } from '../../data/legal';
import { localize, titleSep, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const C = localize(lang, {
  ar: {
    title: 'السياسات والشروط القانونية',
    updated: 'آخر تحديث: 10 يوليو 2026م',
    introH: 'مقدمة عامة',
    intro: [
      'مرحبًا بكم في موقع «زوروا الأحساء» (visit-alahsa.com)، البوابة الرقمية المستقلة للتعريف بواحة الأحساء، تراثًا وطبيعةً وثقافةً وفعاليات. تحدد هذه الوثيقة مجموعة السياسات والشروط القانونية التي تنظم استخدامكم للموقع وما يقدمه من محتوى وخدمات، وذلك بما يتوافق مع الأنظمة المعمول بها في المملكة العربية السعودية، ومنها نظام حماية البيانات الشخصية الصادر بالمرسوم الملكي رقم (م/19) وتاريخ 1443/2/9هـ (الموافق 16 سبتمبر 2021م) ولائحته التنفيذية.',
      'باستخدامكم هذا الموقع أو تصفحكم لأي من صفحاته، فإنكم تقرون بأنكم قد اطلعتم على هذه السياسات والشروط وفهمتموها ووافقتم على الالتزام بها. فإن لم توافقوا على أي بند منها، فنرجو منكم التوقف عن استخدام الموقع.',
      'يحتفظ الموقع بحقه في تعديل هذه السياسات أو تحديثها في أي وقت دون إشعار مسبق، ويُعد استمراركم في استخدام الموقع بعد نشر أي تعديل موافقةً ضمنيةً عليه. لذا ننصح بمراجعة هذه الصفحة دوريًا، وسيُشار دائمًا إلى تاريخ آخر تحديث في أعلى الوثيقة.',
    ],
    sections: LEGAL_SECTIONS_AR,
    closingH: 'أحكام ختامية والتواصل',
    closing: [
      'تُشكل هذه الوثيقة بأقسامها الستة كامل السياسات والشروط المنظمة لاستخدام موقع «زوروا الأحساء». وإذا قضت جهة مختصة ببطلان أي بند منها أو عدم قابليته للتنفيذ، فلا يؤثر ذلك على صحة بقية البنود ونفاذها.',
    ],
    contactPre: 'لأي استفسار يتعلق بهذه السياسات، أو لممارسة حقوقكم المتعلقة بالبيانات الشخصية، أو للإبلاغ عن انتهاك للحقوق أو رابط مخالف، يسعدنا تواصلكم عبر البريد الرسمي للموقع: ',
    copyright: 'جميع الحقوق محفوظة © 2026 — زوروا الأحساء | visit-alahsa.com',
  },
  en: {
    title: 'Policies & Legal Terms',
    updated: 'Last updated: 10 July 2026',
    introH: 'General introduction',
    intro: [
      'Welcome to Visit Al-Ahsa (visit-alahsa.com), the independent digital gateway introducing the Al-Ahsa Oasis — its heritage, nature, culture and events. This document sets out the policies and legal terms that govern your use of the site and the content and services it offers, in accordance with the regulations in force in the Kingdom of Saudi Arabia, including the Personal Data Protection Law issued by Royal Decree No. (M/19) dated 9/2/1443 AH (16 September 2021) and its Implementing Regulation.',
      'By using this site or browsing any of its pages, you acknowledge that you have read, understood and agreed to be bound by these policies and terms. If you do not agree to any provision of them, please stop using the site.',
      'The site reserves the right to amend or update these policies at any time without prior notice, and your continued use of the site after any amendment is published constitutes implicit acceptance of it. We therefore advise reviewing this page periodically; the date of the latest update is always shown at the top of the document.',
    ],
    sections: LEGAL_SECTIONS_EN,
    closingH: 'Final provisions & contact',
    closing: [
      'These six sections together constitute the complete policies and terms governing use of Visit Al-Ahsa. If a competent authority rules any provision of them void or unenforceable, this does not affect the validity and effect of the remaining provisions.',
    ],
    contactPre: 'For any enquiry regarding these policies, to exercise your rights relating to personal data, or to report an infringement of rights or a non-compliant link, we welcome hearing from you through the site’s official email: ',
    copyright: '© 2026 Visit Al-Ahsa. All rights reserved. | visit-alahsa.com',
  },
  // خط zh-translation-pipeline (المرحلة هـ، 2026-09-26)
  zh: {
    title: "政策与法律条款",
    updated: "最后更新：2026 年 7 月 10 日",
    introH: "引言",
    intro: [
      "欢迎访问游览哈萨（Visit Al-Ahsa，visit-alahsa.com）——一个介绍哈萨绿洲的独立数字门户，涵盖其遗产、自然、文化与活动。本文件规定了适用于您使用本网站及其提供的内容和服务的政策与法律条款，并符合沙特阿拉伯王国现行法规，包括依据第（M/19）号王室法令（伊斯兰历 1443 年 2 月 9 日）颁布的《个人数据保护法》及其实施条例。",
      "使用本网站或浏览其任何页面，即表示您确认已阅读、理解并同意受本政策与条款的约束。如果您不同意其中任何条款，请停止使用本网站。",
      "本网站保留随时修改或更新本政策与条款的权利，恕不另行通知；任何修改发布后您继续使用本网站，即视为您对该修改的默示同意。因此，我们建议您定期查阅本页面；文件顶部将始终显示最新更新日期。",
    ],
    sections: LEGAL_SECTIONS_ZH,
    closingH: "附则与联系方式",
    closing: [
      "本文件的六个部分共同构成游览哈萨使用的完整政策与条款。如主管机关裁定其中任何条款无效或不可执行的，不影响其余条款的效力与执行。",
    ],
    contactPre: "如对本政策与条款有任何疑问，或需行使您与个人数据相关的权利，或需举报侵权行为或不合规链接，欢迎通过本网站官方邮箱与我们联系：",
    copyright: "© 2026 游览哈萨版权所有 | visit-alahsa.com",
  },
  // خط de-translation-pipeline (المرحلة هـ، 2026-09-26)
  de: {
    title: "Richtlinien und rechtliche Bestimmungen",
    updated: "Zuletzt aktualisiert: 10. Juli 2026",
    introH: "Allgemeine Einführung",
    intro: [
      "Willkommen bei Visit Al-Ahsa (visit-alahsa.com), der unabhängigen digitalen Plattform zur Vorstellung der Oase Al-Ahsa – ihres Erbes, ihrer Natur, Kultur und Veranstaltungen. Dieses Dokument legt die Richtlinien und rechtlichen Bestimmungen fest, die Ihre Nutzung der Website sowie der von ihr angebotenen Inhalte und Dienste regeln. Es steht im Einklang mit den im Königreich Saudi-Arabien geltenden Vorschriften, darunter das Gesetz zum Schutz personenbezogener Daten, erlassen durch Königlichen Erlass Nr. M/19 vom 9.2.1443 nach der Hidschra (n. H.), und seine Durchführungsverordnung.",
      "Mit der Nutzung dieser Website oder dem Besuch einer ihrer Seiten erkennen Sie an, dass Sie diese Richtlinien und Bestimmungen gelesen und verstanden haben und sich mit deren Geltung einverstanden erklären. Sollten Sie einer ihrer Bestimmungen nicht zustimmen, bitten wir Sie, die Nutzung der Website einzustellen.",
      "Die Website behält sich das Recht vor, diese Richtlinien jederzeit ohne vorherige Ankündigung zu ändern oder zu aktualisieren, und Ihre fortgesetzte Nutzung der Website nach Veröffentlichung einer Änderung gilt als deren stillschweigende Annahme. Wir empfehlen daher, diese Seite regelmäßig zu überprüfen; das Datum der letzten Aktualisierung finden Sie stets oben im Dokument.",
    ],
    sections: LEGAL_SECTIONS_DE,
    closingH: "Schlussbestimmungen und Kontakt",
    closing: [
      "Diese sechs Abschnitte bilden zusammen die vollständigen Richtlinien und Bestimmungen für die Nutzung von Visit Al-Ahsa. Sollte eine zuständige Behörde eine ihrer Bestimmungen für nichtig oder nicht durchsetzbar erklären, berührt dies nicht die Gültigkeit und Wirksamkeit der übrigen Bestimmungen.",
    ],
    contactPre: "Für Anfragen zu diesen Richtlinien, zur Ausübung Ihrer Rechte in Bezug auf personenbezogene Daten oder zur Meldung einer Rechtsverletzung oder eines nicht konformen Links wenden Sie sich gerne an die offizielle E-Mail-Adresse der Website: ",
    copyright: "© 2026 Visit Al-Ahsa. Alle Rechte vorbehalten. | visit-alahsa.com",
  },
  // خط ru-translation-pipeline (المرحلة هـ، 2026-09-26)
  ru: {
    title: "Правила и условия использования",
    updated: "Последнее обновление: 10 июля 2026 г.",
    introH: "Общие положения",
    intro: [
      "Добро пожаловать на сайт «Аль-Ахса» (visit-alahsa.com) — независимый цифровой портал, представляющий оазис Аль-Ахса: его наследие, природу, культуру и события. Настоящий документ устанавливает политику и правовые условия, которые регулируют использование вами сайта, а также предлагаемых им контента и услуг, в соответствии с нормативными актами, действующими в Королевстве Саудовская Аравия, включая Закон о защите персональных данных, изданный Королевским указом № (M/19) от 9.2.1443 г. хиджры, и его исполнительный регламент.",
      "Используя этот сайт или просматривая любую из его страниц, вы подтверждаете, что ознакомились с настоящими правилами и условиями, поняли их и согласны соблюдать их. Если вы не согласны с каким-либо их положением, просим вас прекратить использование сайта.",
      "Сайт оставляет за собой право изменять или обновлять настоящие правила в любое время без предварительного уведомления, и дальнейшее использование вами сайта после публикации любого изменения считается молчаливым принятием этого изменения. В связи с этим мы рекомендуем периодически просматривать эту страницу; дата последнего обновления всегда указана в верхней части документа.",
    ],
    sections: LEGAL_SECTIONS_RU,
    closingH: "Заключительные положения и контакты",
    closing: [
      "Эти шесть разделов в совокупности составляют полный свод правил и условий, регулирующих использование сайта «Аль-Ахса». Если компетентный орган признает какое-либо из их положений недействительным или не подлежащим исполнению, это не влияет на действительность и силу остальных положений.",
    ],
    contactPre: "По любым вопросам, касающимся настоящих правил, чтобы воспользоваться своими правами в отношении персональных данных или сообщить о нарушении прав либо о несоответствующей ссылке, мы будем рады получить от вас сообщение по официальному адресу электронной почты сайта: ",
    copyright: "© 2026 Аль-Ахса. Все права защищены. | visit-alahsa.com",
  },
});

const email = 'info@visit-alahsa.com';
// وصف الصفحة بلغاتها — zh/de/ru من خطوطها (المرحلة هـ)
const SEO_DESC: Partial<Record<Lang, string>> = {
  ar: 'السياسات والشروط القانونية لموقع زوروا الأحساء: سياسة الخصوصية، شروط الاستخدام، إخلاء المسؤولية، ملفات تعريف الارتباط، حقوق الملكية الفكرية، والروابط الخارجية.',
  en: 'Policies and legal terms of Visit Al-Ahsa: privacy policy, terms of use, disclaimer, cookies, intellectual property and external links.',
  zh: "游览哈萨（Visit Al-Ahsa）的政策与法律条款：隐私政策、使用条款、免责声明、Cookie 政策、知识产权政策、外部链接政策。",
  de: "Richtlinien und rechtliche Bestimmungen von Visit Al-Ahsa: Datenschutzrichtlinie, Nutzungsbedingungen, Haftungsausschluss, Cookie-Richtlinie, Richtlinie zum geistigen Eigentum und Richtlinie zu externen Links.",
  ru: "Правила и условия использования сайта «Аль-Ахса»: политика конфиденциальности, условия использования, отказ от ответственности, политика использования файлов cookie, политика интеллектуальной собственности и политика внешних ссылок.",
};
const seoDesc = SEO_DESC[lang] ?? SEO_DESC.en!;
---
<Base title={`${C.title} ${titleSep(lang)} ${t('site.name')}`} description={seoDesc} lang={lang} alt={alt}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="container lg-body">
      <header class="lg-head">
        <h1 class="lg-title">{C.title}</h1>
        <p class="lg-updated">{C.updated}</p>
        <nav class="lg-chips" aria-label={C.title}>
          {C.sections.map((s, i) => <a class="lg-chip" href={`#sec-${i}`}>{s.h}</a>)}
        </nav>
      </header>

      <section class="lg-intro">
        <h2 class="lg-h2">{C.introH}</h2>
        {C.intro.map((p) => <p class="lg-p">{p}</p>)}
      </section>

      {C.sections.map((s, i) => (
        <section class="lg-sec" id={`sec-${i}`}>
          <h2 class="lg-h2"><span class="lg-n">{s.n}:</span> {s.h}</h2>
          {s.lead && <p class="lg-p lg-lead">{s.lead}</p>}
          {s.subs.map((sub) => (
            <div class="lg-sub">
              <h3 class="lg-h3">{sub.h}</h3>
              {sub.before && sub.before.map((p) => <p class="lg-p">{p}</p>)}
              {sub.list && (
                <ul class="lg-list">{sub.list.map((li) => <li>{li}</li>)}</ul>
              )}
              {sub.after && sub.after.map((p) => <p class="lg-p">{p}</p>)}
            </div>
          ))}
        </section>
      ))}

      <section class="lg-sec lg-closing">
        <h2 class="lg-h2">{C.closingH}</h2>
        {C.closing.map((p) => <p class="lg-p">{p}</p>)}
        <p class="lg-p">{C.contactPre}<a href={`mailto:${email}`} class="lg-mail">{email}</a></p>
      </section>

      <p class="lg-copy">{C.copyright}</p>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .lg-body { padding-block: var(--s-7) var(--s-8); max-inline-size: 80ch; }
  .lg-head { border-block-end: 1px solid var(--c-line); padding-block-end: var(--s-4); margin-block-end: var(--s-5); }
  .lg-title { font-family: var(--font-heading); font-weight: 700; font-size: var(--t-3xl); color: var(--c-turq-deep); line-height: 1.15; }
  .lg-updated { color: var(--c-gold-deep); font-size: var(--t-sm); font-weight: 600; margin-block-start: var(--s-2); }
  .lg-chips { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-block-start: var(--s-4); }
  .lg-chip { font-size: var(--t-xs); font-weight: 600; color: var(--c-turq-deep); background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: 999px; padding: 5px 14px; text-decoration: none; transition: all var(--dur) var(--ease); }
  .lg-chip:hover { background: var(--c-turq); color: var(--c-sand); border-color: var(--c-turq); }

  .lg-intro { margin-block-end: var(--s-6); }
  .lg-sec { margin-block-start: var(--s-7); scroll-margin-block-start: 90px; }
  .lg-h2 { font-family: var(--font-heading); font-weight: 700; font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.25; margin-block-end: var(--s-3); }
  .lg-n { color: var(--c-gold-deep); margin-inline-end: var(--s-2); }
  .lg-lead { color: var(--c-ink); }
  .lg-sub { margin-block-start: var(--s-5); }
  .lg-h3 { font-size: var(--t-lg); font-weight: 600; color: var(--c-ink); margin-block-end: var(--s-2); }
  .lg-p { color: var(--c-ink-soft); line-height: 1.9; }
  .lg-p + .lg-p { margin-block-start: var(--s-2); }
  .lg-list { margin-block-start: var(--s-2); padding-inline-start: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); }
  .lg-list li { color: var(--c-ink-soft); line-height: 1.85; padding-inline-start: var(--s-2); position: relative; list-style: none; }
  .lg-list li::before { content: ''; position: absolute; inset-inline-start: calc(-1 * var(--s-3)); inset-block-start: .7em; inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--c-gold); }

  .lg-closing { border-block-start: 1px solid var(--c-line); padding-block-start: var(--s-5); }
  .lg-mail { font-family: var(--font-latin); letter-spacing: .02em; color: var(--c-turq-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .lg-copy { margin-block-start: var(--s-6); padding-block-start: var(--s-4); border-block-start: 1px solid var(--c-line); font-size: var(--t-sm); color: var(--c-ink-soft); text-align: center; }
</style>
