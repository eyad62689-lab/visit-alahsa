---
// السياسات والشروط القانونية — النص العربي منقول حرفياً من وثيقة اعتمدها إياد
// (docx، آخر تحديث 10 يوليو 2026م)، والإنجليزية ترجمة أمينة لها. القرارات (2026-07-10):
// تُبقى أقسام Google Analytics كما هي لأن إياد يستخدمه فعلاً؛ استُبدلت بها صفحة الخصوصية
// المختصرة القديمة. تكيّف وحيد: مرجع «صفحة اتصل بنا» غير الموجودة → البريد الرسمي.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import { LEGAL_SECTIONS_AR, LEGAL_SECTIONS_EN } from '../../data/legal';
import { localize, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const C = localize(lang, {
  title: 'السياسات والشروط القانونية',
  updated: 'آخر تحديث: 10 يوليو 2026م',
  chips: ['سياسة الخصوصية', 'شروط الاستخدام', 'إخلاء المسؤولية', 'ملفات تعريف الارتباط', 'حقوق الملكية الفكرية', 'الروابط الخارجية'],
  introH: 'مقدمة عامة',
  intro: [
    'مرحبًا بكم في موقع «زوروا الأحساء» (visit-alahsa.com)، البوابة الرقمية المستقلة للتعريف بواحة الأحساء، تراثًا وطبيعةً وثقافةً وفعاليات. تحدد هذه الوثيقة مجموعة السياسات والشروط القانونية التي تنظم استخدامكم للموقع وما يقدمه من محتوى وخدمات، وذلك بما يتوافق مع الأنظمة المعمول بها في المملكة العربية السعودية، ومنها نظام حماية البيانات الشخصية الصادر بالمرسوم الملكي رقم (م/19) وتاريخ 1443/2/9هـ ولائحته التنفيذية.',
    'باستخدامكم هذا الموقع أو تصفحكم لأي من صفحاته، فإنكم تقرون بأنكم قد اطلعتم على هذه السياسات والشروط وفهمتموها ووافقتم على الالتزام بها. فإن لم توافقوا على أي بند منها، فنرجو منكم التوقف عن استخدام الموقع.',
    'يحتفظ الموقع بحقه في تعديل هذه السياسات أو تحديثها في أي وقت دون إشعار مسبق، ويُعد استمراركم في استخدام الموقع بعد نشر أي تعديل موافقةً ضمنيةً عليه. لذا ننصح بمراجعة هذه الصفحة دوريًا، وسيُشار دائمًا إلى تاريخ آخر تحديث في أعلى الوثيقة.',
  ],
  sections: LEGAL_SECTIONS_AR,
  closingH: 'أحكام ختامية والتواصل',
  closing: [
    'تُشكل هذه الوثيقة بأقسامها الستة كامل السياسات والشروط المنظمة لاستخدام موقع «زوروا الأحساء». وإذا قضت جهة مختصة ببطلان أي بند منها أو عدم قابليته للتنفيذ، فلا يؤثر ذلك على صحة بقية البنود ونفاذها.',
  ],
  contactPre: 'لأي استفسار يتعلق بهذه السياسات، أو لممارسة حقوقكم المتعلقة بالبيانات الشخصية، أو للإبلاغ عن انتهاك للحقوق أو رابط مخالف، يسعدنا تواصلكم عبر البريد الرسمي للموقع: ',
  copyright: 'جميع الحقوق محفوظة © 2026 — زوروا الأحساء | visit-alahsa.com',
}, {
  title: 'Policies & Legal Terms',
  updated: 'Last updated: 10 July 2026',
  chips: ['Privacy Policy', 'Terms of Use', 'Disclaimer', 'Cookies', 'Intellectual Property', 'External Links'],
  introH: 'General introduction',
  intro: [
    'Welcome to Visit Al-Ahsa (visit-alahsa.com), the independent digital gateway introducing the Al-Ahsa Oasis — its heritage, nature, culture and events. This document sets out the policies and legal terms that govern your use of the site and the content and services it offers, in accordance with the regulations in force in the Kingdom of Saudi Arabia, including the Personal Data Protection Law issued by Royal Decree No. (M/19) dated 9/2/1443 AH and its Implementing Regulation.',
    'By using this site or browsing any of its pages, you acknowledge that you have read, understood and agreed to be bound by these policies and terms. If you do not agree to any provision of them, please stop using the site.',
    'The site reserves the right to amend or update these policies at any time without prior notice, and your continued use of the site after any amendment is published constitutes implicit acceptance of it. We therefore advise reviewing this page periodically; the date of the latest update is always shown at the top of the document.',
  ],
  sections: LEGAL_SECTIONS_EN,
  closingH: 'Final provisions & contact',
  closing: [
    'These six sections together constitute the complete policies and terms governing use of Visit Al-Ahsa. If a competent authority rules any provision of them void or unenforceable, this does not affect the validity and effect of the remaining provisions.',
  ],
  contactPre: 'For any enquiry regarding these policies, to exercise your rights relating to personal data, or to report an infringement of rights or a non-compliant link, we welcome hearing from you through the site’s official email: ',
  copyright: '© 2026 Visit Al-Ahsa. All rights reserved. | visit-alahsa.com',
});

const email = 'info@visit-alahsa.com';
const seoDesc = ar
  ? 'السياسات والشروط القانونية لموقع زوروا الأحساء: سياسة الخصوصية، شروط الاستخدام، إخلاء المسؤولية، ملفات تعريف الارتباط، حقوق الملكية الفكرية، والروابط الخارجية.'
  : 'Policies and legal terms of Visit Al-Ahsa: privacy policy, terms of use, disclaimer, cookies, intellectual property and external links.';
---
<Base title={`${C.title} — ${t('site.name')}`} description={seoDesc} lang={lang} alt={alt} noindex={true}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="container lg-body">
      <header class="lg-head">
        <h1 class="lg-title">{C.title}</h1>
        <p class="lg-updated">{C.updated}</p>
        <nav class="lg-chips" aria-label={C.title}>
          {C.chips.map((c, i) => <a class="lg-chip" href={`#sec-${i}`}>{c}</a>)}
        </nav>
      </header>

      <section class="lg-intro">
        <h2 class="lg-h2">{C.introH}</h2>
        {C.intro.map((p) => <p class="lg-p">{p}</p>)}
      </section>

      {C.sections.map((s, i) => (
        <section class="lg-sec" id={`sec-${i}`}>
          <h2 class="lg-h2"><span class="lg-n">{s.n}:</span> {s.h}</h2>
          {s.lead && <p class="lg-p lg-lead">{s.lead}</p>}
          {s.subs.map((sub) => (
            <div class="lg-sub">
              <h3 class="lg-h3">{sub.h}</h3>
              {sub.before && sub.before.map((p) => <p class="lg-p">{p}</p>)}
              {sub.list && (
                <ul class="lg-list">{sub.list.map((li) => <li>{li}</li>)}</ul>
              )}
              {sub.after && sub.after.map((p) => <p class="lg-p">{p}</p>)}
            </div>
          ))}
        </section>
      ))}

      <section class="lg-sec lg-closing">
        <h2 class="lg-h2">{C.closingH}</h2>
        {C.closing.map((p) => <p class="lg-p">{p}</p>)}
        <p class="lg-p">{C.contactPre}<a href={`mailto:${email}`} class="lg-mail">{email}</a></p>
      </section>

      <p class="lg-copy">{C.copyright}</p>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .lg-body { padding-block: var(--s-7) var(--s-8); max-inline-size: 80ch; }
  .lg-head { border-block-end: 1px solid var(--c-line); padding-block-end: var(--s-4); margin-block-end: var(--s-5); }
  .lg-title { font-family: var(--font-heading); font-weight: 700; font-size: var(--t-3xl); color: var(--c-turq-deep); line-height: 1.15; }
  .lg-updated { color: var(--c-gold-deep); font-size: var(--t-sm); font-weight: 600; margin-block-start: var(--s-2); }
  .lg-chips { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-block-start: var(--s-4); }
  .lg-chip { font-size: var(--t-xs); font-weight: 600; color: var(--c-turq-deep); background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: 999px; padding: 5px 14px; text-decoration: none; transition: all var(--dur) var(--ease); }
  .lg-chip:hover { background: var(--c-turq); color: var(--c-sand); border-color: var(--c-turq); }

  .lg-intro { margin-block-end: var(--s-6); }
  .lg-sec { margin-block-start: var(--s-7); scroll-margin-block-start: 90px; }
  .lg-h2 { font-family: var(--font-heading); font-weight: 700; font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.25; margin-block-end: var(--s-3); }
  .lg-n { color: var(--c-gold-deep); margin-inline-end: var(--s-2); }
  .lg-lead { color: var(--c-ink); }
  .lg-sub { margin-block-start: var(--s-5); }
  .lg-h3 { font-size: var(--t-lg); font-weight: 600; color: var(--c-ink); margin-block-end: var(--s-2); }
  .lg-p { color: var(--c-ink-soft); line-height: 1.9; }
  .lg-p + .lg-p { margin-block-start: var(--s-2); }
  .lg-list { margin-block-start: var(--s-2); padding-inline-start: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); }
  .lg-list li { color: var(--c-ink-soft); line-height: 1.85; padding-inline-start: var(--s-2); position: relative; list-style: none; }
  .lg-list li::before { content: ''; position: absolute; inset-inline-start: calc(-1 * var(--s-3)); inset-block-start: .7em; inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--c-gold); }

  .lg-closing { border-block-start: 1px solid var(--c-line); padding-block-start: var(--s-5); }
  .lg-mail { font-family: var(--font-latin); letter-spacing: .02em; color: var(--c-turq-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .lg-copy { margin-block-start: var(--s-6); padding-block-start: var(--s-4); border-block-start: 1px solid var(--c-line); font-size: var(--t-sm); color: var(--c-ink-soft); text-align: center; }
</style>
