---
// صفحة «ثمار الأحساء الموسمية» — اعتمدها إياد (2026-07-09) من معاينة HTML بجذر المشروع.
// المصدران: مسودتا بحث قدّمهما إياد (compass + docx)، والصور من لوحتيه (صور أصناف
// الثمار/الرطب) مقصوصةً في public/img/fruits. قاعدة ملزمة: لا تُختلق معلومة؛ ما لم
// يتأكد يحمل وسم «بانتظار التأكيد» ظاهراً للقارئ. حُذف البرتقال (لا يُزرع في الأحساء)
// وأُكِّدت مواسم البمبر والكنار (2026-07-10) ثم البابايا (يونيو–أغسطس) والأترنج
// (يناير–بداية مارس) من إياد (2026-07-12). الرمان السواري موسوم «شبه منقرض» بلا موسم بطلب إياد.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import Photo from '../Photo.astro';
import { FRUIT_GROUPS_AR, FRUIT_GROUPS_EN, FRUIT_GROUPS_ZH } from '../../data/fruits';
import { localize, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { reviewedLabel } from '../../data/meta';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
const zh = lang === 'zh';

// الكتلة الصينية — خط zh-translation-pipeline (دفعة fruits 2026-09-02، الحاكم 94/100)
const ZH = {
  heroEyebrow: '绿洲的馈赠',
  title: '哈萨时令水果',
  heroSum: '在世界上最大的天然椰枣绿洲，四季在果园间流转，每一季都为到访者献上当令的果香——从盛夏金黄的软熟鲜椰枣、冬日的毛叶枣，到闻名遐迩的哈萨青柠。',
  stats: [
    { n: '250 万', l: '绿洲中的椰枣树' },
    { n: '40 万', l: '与椰枣并植的果树' },
  ],
  statsSrc: '依据吉尼斯世界纪录认证（2020 年 10 月）及沙特环境水务与农业部的统计数据。',
  frEyebrow: '水果之旅',
  frH: '四季皆有果',
  frLead: '请选择您到访的季节，查看当季水果：',
  chipsAria: '按季节筛选水果',
  chips: [
    { f: 'all', l: '全部季节' },
    { f: 'winter', l: '冬季' },
    { f: 'spring', l: '春季' },
    { f: 'summer', l: '夏季' },
    { f: 'autumn', l: '秋季' },
  ],
  pending: '待确认（信息更新中）',
  rare: '濒临绝迹',
  more: '展开简介',
  less: '收起简介',
  emptyMsg: '该季节暂无收录的水果。',
  countPrefix: '当前显示：',
  methodH: '关于信息准确性',
  methodP1: '本页内容取自官方与权威农业来源，每条信息在发布前都经过核实；凡未能找到确凿出处的内容，我们一律明确标注“待确认（信息更新中）”，而不妄下定论。',
  methodP2: `果实成熟期每年随天气略有变化；本页信息于 ${reviewedLabel('fruits', 'zh')} 完成复核。`,
  groups: FRUIT_GROUPS_ZH,
};

const C = localize(lang, {
  heroEyebrow: 'من خيرات الواحة',
  title: 'ثمار الأحساء الموسمية',
  heroSum: 'في أكبر واحة نخيل طبيعية في العالم، تتعاقب المواسم على البساتين فتهدي زائرها في كل فصل ثمرةً ومذاقاً: من رطب الصيف الذهبي إلى كنار الشتاء ولومي الواحة الشهير.',
  stats: [
    { n: '2.5 مليون', l: 'نخلة في الواحة' },
    { n: '400 ألف', l: 'شجرة فاكهة إلى جانب النخيل' },
  ],
  statsSrc: 'وفق تسجيل موسوعة غينيس للأرقام القياسية (أكتوبر 2020م) وإحصاءات وزارة البيئة والمياه والزراعة.',
  frEyebrow: 'جولة الثمار',
  frH: 'ثمرة لكل فصل',
  frLead: 'اختر فصل زيارتك لعرض ثماره:',
  chipsAria: 'تصفية الثمار بحسب الفصل',
  chips: [
    { f: 'all', l: 'كل الفصول' },
    { f: 'winter', l: 'الشتاء' },
    { f: 'spring', l: 'الربيع' },
    { f: 'summer', l: 'الصيف' },
    { f: 'autumn', l: 'الخريف' },
  ],
  pending: 'بانتظار التأكيد',
  rare: 'شبه منقرض',
  more: 'اقرأ النبذة',
  less: 'إخفاء النبذة',
  emptyMsg: 'لا ثمار مسجّلة لهذا الفصل بعد.',
  countPrefix: 'عدد الثمار المعروضة: ',
  methodH: 'حول دقة المعلومات',
  methodP1: 'اعتمدنا في هذه الصفحة على مصادر رسمية وزراعية موثوقة، وحرصنا على التحقّق من كل معلومة قبل نشرها. وما لم نجد له مصدراً مؤكداً وسمناه صراحةً بعلامة «بانتظار التأكيد» بدل الجزم به.',
  methodP2: `تختلف مواعيد النضج قليلاً من موسم لآخر بحسب الأحوال الجوية؛ رُوجعت هذه المعلومات في ${reviewedLabel('fruits', 'ar')}.`,
  groups: FRUIT_GROUPS_AR,
}, {
  heroEyebrow: 'From the oasis bounty',
  title: 'Seasonal Fruits of Al-Ahsa',
  heroSum: "In the world’s largest natural palm oasis, the seasons take turns over the groves, offering visitors a new fruit and flavour with each one — from golden summer rutab to winter kanar and the oasis’s famous lime.",
  stats: [
    { n: '2.5M', l: 'palm trees in the oasis' },
    { n: '400K', l: 'fruit trees alongside the palms' },
  ],
  statsSrc: 'Per the Guinness World Records listing (October 2020) and Ministry of Environment, Water and Agriculture statistics.',
  frEyebrow: 'A tour of the fruits',
  frH: 'A fruit for every season',
  frLead: 'Pick the season of your visit to see its fruits:',
  chipsAria: 'Filter fruits by season',
  chips: [
    { f: 'all', l: 'All seasons' },
    { f: 'winter', l: 'Winter' },
    { f: 'spring', l: 'Spring' },
    { f: 'summer', l: 'Summer' },
    { f: 'autumn', l: 'Autumn' },
  ],
  pending: 'Pending confirmation',
  rare: 'Nearly extinct',
  more: 'Read more',
  less: 'Hide description',
  emptyMsg: 'No fruits recorded for this season yet.',
  countPrefix: 'Fruits shown: ',
  methodH: 'About the accuracy of this page',
  methodP1: 'This page draws on trusted official and agricultural sources, and we take care to verify every fact before publishing it. Anything we could not confirm is explicitly marked “Pending confirmation” rather than stated as fact.',
  methodP2: `Ripening dates shift slightly from season to season with the weather; this information was reviewed in ${reviewedLabel('fruits', 'en')}.`,
  groups: FRUIT_GROUPS_EN,
}, ZH);

const pageTitle = `${C.title} — ${t('site.name')}`;
const description = ar
  ? 'جولة على ثمار واحة الأحساء بمواسمها: التمور والرطب، اللومي الأحسائي، البطيخ الأصفر، التين، الكنار وغيرها — بمعلومات موثقة من مصادر رسمية.'
  : zh
    ? '按季节了解哈萨绿洲的时令水果：椰枣与软熟鲜枣、哈萨青柠、黄西瓜、无花果、毛叶枣等——所有信息均经官方来源核实。'
    : 'A season-by-season tour of Al-Ahsa Oasis fruits: dates and rutab, Hasawi lime, yellow melon, figs, kanar and more — verified from official sources.';

const siteUrl = 'https://visit-alahsa.com';
const selfPath = ar ? '/ثمار/' : zh ? '/zh/fruits/' : '/en/fruits/';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : zh ? '/zh/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: C.title, item: new URL(selfPath, siteUrl).href },
  ] },
];
---
<Base title={pageTitle} description={description} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-fruits">
  <Header lang={lang} alt={alt} />
  <main id="main">

    <PageHero eyebrow={C.heroEyebrow} title={C.title} lead={C.heroSum} leadWidth={62}
      poster="/img/hero-fruits" video="/video/hero-fruits.mp4" scrim="strong" lang={lang}>
      <div class="container fr-stats" slot="after">
        <div class="stats-grid">
          {C.stats.map((s) => (
            <div class="stat"><div class="st-n">{s.n}</div><div class="st-l">{s.l}</div></div>
          ))}
        </div>
        <p class="src-note">{C.statsSrc}</p>
      </div>
    </PageHero>

    <section class="container fr-list">
      <div class="fr-head">
        <span class="eyebrow">{C.frEyebrow}</span>
        <h2>{C.frH}</h2>
        <p class="lead">{C.frLead}</p>
      </div>

      <div class="chips" role="group" aria-label={C.chipsAria} id="fruit-chips">
        {C.chips.map((c, i) => (
          <button class:list={['chip', { 'is-active': i === 0 }]} data-filter={c.f} type="button" aria-pressed={i === 0 ? 'true' : 'false'}>{c.l}</button>
        ))}
      </div>
      <p id="filter-status" class="sr-only" role="status" data-empty={C.emptyMsg} data-prefix={C.countPrefix}></p>

      {C.groups.map((g, gi) => (
        <details class="fgroup" data-group open={gi === 0}>
          <summary class="fgroup-head"><h3>{g.title}</h3><span class="fgroup-chev" aria-hidden="true"></span></summary>
          {g.intro && (
            <p class="fgroup-intro">{g.intro} {g.introTagged && (<>{g.introTagged} <span class="tag-pending">{C.pending}</span>.</>)}</p>
          )}
          <div class="fgrid">
            {g.fruits.map((f, idx) => (
              <article class="card fruit-card" data-season={f.seasons} data-reveal style={`transition-delay:${(idx % 3) * 60}ms`}>
                {/* أزيل فرع الصورتين (img2) — فرع ميت: لا ثمرة في البيانات تحمل
                    الحقل، وكان يكسر astro check (تدقيق 2026-08-28) */}
                <Photo src={f.img} label={f.img ? (f.alt ?? f.name) : f.name} class="fr-photo" sizes="(max-width: 760px) 100vw, 33vw" />
                <div class="fc-body">
                  <span class="t-caption fc-k">{f.k}</span>
                  <h4>{f.name} {f.rare && <span class="tag-rare">{C.rare}</span>} {f.namePending && <span class="tag-pending">{C.pending}</span>}</h4>
                  {f.season && <span class="fc-season">{f.season} {f.seasonPending && <span class="tag-pending">{C.pending}</span>}</span>}
                  {/* زر النبذة: يُظهره السكربت — بلا جافاسكربت يبقى النص ظاهراً */}
                  <button class="disc-toggle" type="button" hidden aria-expanded="false" aria-controls={`fdesc-${gi}-${idx}`} data-more={C.more} data-less={C.less}>
                    <span class="dt-label">{C.more}</span>
                    <span class="dt-chev" aria-hidden="true"></span>
                  </button>
                  <p class="fc-desc" id={`fdesc-${gi}-${idx}`}>{f.pre}{f.sci && <span class="sci" lang="en">{f.sci}</span>}{f.post}</p>
                </div>
              </article>
            ))}
          </div>
        </details>
      ))}

      <p class="fr-empty" id="fruits-empty" hidden>{C.emptyMsg}</p>
    </section>

    <section class="container fr-method">
      <div class="method-box">
        <h2>{C.methodH}</h2>
        <p>{C.methodP1}</p>
        <p>{C.methodP2}</p>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Base>

<script is:inline>
  function initFruitFilter() {
    const wrap = document.getElementById('fruit-chips');
    if (!wrap || wrap.dataset.wired) return;
    wrap.dataset.wired = '1';
    const chips = wrap.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.fruit-card');
    const groups = document.querySelectorAll('[data-group]');
    const empty = document.getElementById('fruits-empty');
    const status = document.getElementById('filter-status');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const f = chip.getAttribute('data-filter');
        chips.forEach((c) => {
          c.classList.toggle('is-active', c === chip);
          c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
        });
        let shown = 0;
        cards.forEach((card) => {
          const ok = f === 'all' || (card.getAttribute('data-season') || '').split(' ').indexOf(f) !== -1;
          card.hidden = !ok; if (ok) shown++;
        });
        // المجموعات قوائم منسدلة (<details>): عند تصفية فصلٍ تُفتح المجموعات المطابقة لتظهر
        // ثمارها، وعند «كل الفصول» تعود الحالة الأولى (الأولى مفتوحة والبقية مطويّة).
        groups.forEach((g, i) => {
          const hasMatch = !!g.querySelector('.fruit-card:not([hidden])');
          g.hidden = !hasMatch;
          if (f === 'all') g.open = i === 0;
          else if (hasMatch) g.open = true;
        });
        if (empty) empty.hidden = shown !== 0;
        if (status) status.textContent = shown === 0
          ? (status.dataset.empty || '')
          : (status.dataset.prefix || '') + shown;
      });
    });
  }
  document.addEventListener('astro:page-load', initFruitFilter);
  if (document.readyState !== 'loading') initFruitFilter(); else document.addEventListener('DOMContentLoaded', initFruitFilter);

  /* نبذة البطاقة مطويّة تُفتح بالضغط — تحسين تدريجي: بلا جافاسكربت يبقى النص ظاهراً */
  function initDescToggles() {
    document.querySelectorAll('.disc-toggle').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';
      const p = document.getElementById(btn.getAttribute('aria-controls'));
      if (!p) return;
      const label = btn.querySelector('.dt-label');
      btn.hidden = false;
      p.hidden = true;
      btn.addEventListener('click', () => {
        const open = p.hidden;
        p.hidden = !open;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.classList.toggle('is-open', open);
        if (label) label.textContent = open ? (btn.dataset.less || '') : (btn.dataset.more || '');
      });
    });
  }
  document.addEventListener('astro:page-load', initDescToggles);
  if (document.readyState !== 'loading') initDescToggles(); else document.addEventListener('DOMContentLoaded', initDescToggles);
</script>

<style>
  /* ═══ الهيرو وشريط الأرقام ═══ */
  /* التحديد على الفقرة لا على الحاوية — وإلا انزاحت الكتلة عن حافة البداية */
  .fr-stats { position: relative; z-index: 2; margin-block-start: var(--s-6); }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr)); gap: var(--s-3); }
  .stat { background: rgba(247,243,234,.07); border: 1px solid rgba(247,243,234,.14); border-radius: var(--radius); padding: var(--s-4); text-align: center; }
  .st-n { font-family: var(--font-heading); font-weight: 700; font-size: var(--t-xl); color: var(--c-gold); line-height: 1.2; }
  .st-l { font-size: var(--t-sm); color: rgba(247,243,234,.85); margin-block-start: var(--s-1); }
  .src-note { color: rgba(247,243,234,.82); font-size: var(--t-xs); margin-block-start: var(--s-3); }

  /* ═══ قسم الثمار ═══ */
  .fr-list { padding-block: var(--s-7) var(--s-8); }
  .fr-head { margin-block-end: var(--s-5); }
  .fr-head h2 { font-size: var(--t-2xl); margin-block: var(--s-2) var(--s-3); }
  /* .chips/.chip موحّدة في global.css (2026-08-30) — يبقى هامش هذه الواجهة وحده */
  .chips { margin-block-end: var(--s-6); }

  /* المجموعات — قوائم منسدلة أصيلة (<details>): تحسين تدريجي، تعمل بلا جافاسكربت */
  .fgroup { margin-block-end: var(--s-7); }
  .fgroup:last-of-type { margin-block-end: 0; }
  summary.fgroup-head { display: flex; align-items: center; gap: var(--s-3); margin-block-end: var(--s-4); cursor: pointer; list-style: none; }
  summary.fgroup-head::-webkit-details-marker { display: none; }
  summary.fgroup-head:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 4px; border-radius: var(--radius-sm); }
  .fgroup-head h3 { font-size: var(--t-xl); color: var(--c-turq-deep); }
  .fgroup-head::after { content: ''; flex: 1; block-size: 1px; background: var(--c-line); }
  /* شيفرون الطيّ — order:1 يضعه بعد الخطّ الفاصل (::after)؛ يدور للأعلى عند الفتح */
  .fgroup-chev { order: 1; flex: 0 0 auto; inline-size: 9px; block-size: 9px; border-inline-end: 2px solid var(--c-turq-deep); border-block-end: 2px solid var(--c-turq-deep); transform: rotate(45deg); transition: transform var(--dur) var(--ease); }
  .fgroup[open] > summary .fgroup-chev { transform: rotate(-135deg); }
  @media (prefers-reduced-motion: reduce) { .fgroup-chev { transition: none; } }
  .fgroup-intro { color: var(--c-ink-soft); max-inline-size: 72ch; margin-block-end: var(--s-4); }
  .fgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }

  /* القشرة من صنف card الموحّد في global.css */
  .fc-body { padding: var(--s-3) var(--s-4) var(--s-5); display: flex; flex-direction: column; gap: var(--s-2); }
  .fc-k { color: var(--c-gold-deep); }
  .fruit-card h4 { font-size: var(--t-lg); color: var(--c-turq-deep); }
  .fc-season { display: inline-flex; align-items: center; gap: var(--s-2); align-self: start; flex-wrap: wrap; font-size: var(--t-xs); font-weight: 600; color: var(--c-turq-deep); background: var(--c-sand-2); border-radius: 999px; padding: 4px 12px; }
  .fruit-card p { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }

  /* زر فتح النبذة المطويّة */
  .disc-toggle { align-self: start; display: inline-flex; align-items: center; gap: var(--s-2); font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); cursor: pointer; color: var(--c-turq-deep); background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: 999px; padding: 6px 14px; transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .disc-toggle:hover { border-color: var(--c-turq); color: var(--c-turq); }
  .disc-toggle[hidden] { display: none; }
  .dt-chev { inline-size: 6px; block-size: 6px; border-inline-end: 2px solid currentColor; border-block-end: 2px solid currentColor; transform: rotate(45deg); transform-origin: 60% 60%; transition: transform var(--dur) var(--ease); }
  .disc-toggle.is-open .dt-chev { transform: rotate(-135deg); }
  /* الاسم العلمي اللاتيني بخط المتن (يتقدم على قاعدة :lang(en) العامة) */
  .fruit-card p :global(.sci:lang(en)) { font-family: var(--font-body); font-style: normal; }

  /* صور الثمار: منتجات مقصوصة على خلفية كريمية — بلا طبقة الظل الفيروزية */
  :global(.fr-photo) { aspect-ratio: 16 / 10; }
  :global(picture.fr-photo) { background: var(--c-sand); }
  :global(picture.fr-photo)::after { content: none; }

  /* إطار مزدوج رطب/تمر — صورتان متجاورتان بوسمين (قاعدة إياد: لكلٍّ صورته) */

  /* الوسوم */
  /* أبيض لا رملي-2 — انظر .cat-sec-count: الذهبي الداكن على الرملي-2 دون AA */
  .tag-pending { display: inline-block; font-size: var(--t-xs); font-weight: 600; color: var(--c-gold-deep); background: #fff; border: 1px solid rgba(138,98,36,.4); border-radius: 999px; padding: 1px 10px; white-space: nowrap; }
  .tag-rare { display: inline-block; font-size: var(--t-xs); font-weight: 600; color: var(--c-turq-deep); background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: 999px; padding: 1px 10px; white-space: nowrap; }

  .fr-empty { text-align: center; color: var(--c-ink-soft); padding-block: var(--s-6); }
  .fruit-card[hidden], .fgroup[hidden] { display: none; }

  /* .sr-only موحّدة في global.css (2026-08-30) */

  /* ═══ الملاحظة المنهجية ═══ */
  .fr-method { padding-block: 0 var(--s-7); }
  .method-box { background: #fff; border-inline-start: 4px solid var(--c-gold); border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); max-inline-size: 78ch; }
  .method-box h2 { font-size: var(--t-lg); margin-block-end: var(--s-2); }
  .method-box p { font-size: var(--t-sm); color: var(--c-ink-soft); }
  .method-box p + p { margin-block-start: var(--s-2); }
</style>
