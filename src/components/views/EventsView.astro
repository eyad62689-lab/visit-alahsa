  <Footer lang={lang} />
</Base>

<script>
  // تشغيل فيديو الهيرو فقط عند السماح بالحركة وعدم تفعيل توفير البيانات؛
  // preload="none" + data-src يمنعان تنزيل الفيديو لمن لا يشمله التشغيل.
  const v = document.querySelector<HTMLVideoElement>('.evh-video');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  if (v && !reduceMotion && !saveData) {
    const s = v.querySelector('source');
    if (s?.dataset.src) {
      v.addEventListener('playing', () => v.classList.add('evh-video--on'), { once: true });
      s.src = s.dataset.src;
      v.autoplay = true;
      v.load();
      v.addEventListener('canplay', () => { v.play().catch(() => {}); }, { once: true });
    }
  }
</script>

<script is:inline>
  // إعادة ترتيب بطاقات الفعاليات حسب الأقرب إلى تاريخ جهاز الزائر، وتمييز الجارية الآن.
  // عرضٌ فقط: لا يضيف ولا يخفي أي معلومة — النوافذ مشتقة من حقل time المعروض في البطاقة.
  // بلا JS يبقى الترتيب التقويمي (يناير ← ديسمبر) كما بُني، وهو ترتيب صادق بذاته.
  function orderEvents() {
    var grid = document.querySelector('[data-ev-grid]');
    if (!grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.ev-card'));
    if (!cards.length) return;

    var now = new Date();
    var gm = now.getMonth() + 1; // الشهر الميلادي 1-12

    // الشهر الهجري من تقويم الجهاز — لليالي كفو (رمضان = الشهر 9).
    // عند غياب دعم التقويم الهجري نُبقيها في آخر الترتيب بلا ادّعاء.
    var hm = 0;
    try {
      var parts = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { month: 'numeric' }).formatToParts(now);
      for (var p = 0; p < parts.length; p++) if (parts[p].type === 'month') hm = parseInt(parts[p].value, 10);
    } catch (err) { hm = 0; }

    var ranked = cards.map(function (el, idx) {
      var running = false, dist = 99;
      if (el.getAttribute('data-ramadan')) {
        if (hm) { running = hm === 9; dist = running ? 0 : (9 - hm + 12) % 12; }
      } else {
        var start = parseInt(el.getAttribute('data-start'), 10);
        var endAttr = el.getAttribute('data-end');
        var end = endAttr ? parseInt(endAttr, 10) : start;
        // النافذة تلتفّ عبر رأس السنة عندما يكون end < start (مثل نوفمبر ← فبراير)
        running = start <= end ? (gm >= start && gm <= end) : (gm >= start || gm <= end);
        dist = running ? 0 : (start - gm + 12) % 12;
      }
      return { el: el, running: running, dist: dist, idx: idx };
    });

    // الجارية أولاً، ثم الأقرب بداية، وعند التساوي يُحفظ الترتيب التقويمي الأصلي
    ranked.sort(function (a, b) {
      if (a.running !== b.running) return a.running ? -1 : 1;
      if (a.dist !== b.dist) return a.dist - b.dist;
      return a.idx - b.idx;
    });

    ranked.forEach(function (r, i) {
      grid.appendChild(r.el); // نقل عقد DOM فعلياً ليبقى ترتيب القراءة والتنقل مطابقاً للمرئي
      r.el.style.transitionDelay = (i % 4) * 60 + 'ms';
      r.el.classList.toggle('is-now', r.running);
      var badge = r.el.querySelector('[data-ev-now]');
      if (badge) badge.hidden = !r.running;
    });

    var note = document.querySelector('[data-ev-order-note]');
    if (note) note.hidden = false;
  }
  document.addEventListener('astro:page-load', orderEvents);
  if (document.readyState !== 'loading') orderEvents();
  else document.addEventListener('DOMContentLoaded', orderEvents);
</script>

