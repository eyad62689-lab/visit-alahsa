---
// صفحة «المهرجانات والفعاليات» — المواسم الثقافية المتكررة في الأحساء.
// المصدر: ملف «الفعاليات الموسمية السنوية في الأحساء» المعتمد من إياد (2026-07-08).
// قاعدة ملزمة: الأصل مواسم تقريبية (أشهر عامة) بلا تواريخ ولا مُدد بالأيام، مع تنبيه
// ظاهر بأن المواعيد تتغيّر سنوياً. الاستثناء الوحيد: نسخة أعلن إياد موعدها الرسمي —
// عندها يُكتب التاريخ في time مع status: 'confirmed'، ويعود تقريبياً بعد انقضائها.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import HeroPoster from '../HeroPoster.astro';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { EVENTS_AR, EVENTS_EN, type Ev } from '../../data/events';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';



const C = ar ? {
  eyebrow: 'مواسم الواحة',
  title: 'المهرجانات والفعاليات',
  lead: 'من سوق القيصرية إلى مزارع النخيل، تنبض الأحساء بمواسمَ تُحيي تراثها على مدار العام — احتفالاتٌ ومهرجاناتٌ تعود كلَّ سنةٍ في موسمها.',
  notice: 'تتكرّر هذه الفعاليات سنوياً في مواسمها التقريبية، وقد تختلف مواعيدها وتفاصيلها من عامٍ لآخر بحسب تنظيم كل نسخة. يُرجى التأكد من إعلانات الجهات المنظّمة والقنوات الرسمية قبل الزيارة.',
  placeK: 'الموقع',
  mapK: 'الخريطة ↗',
  ticketK: 'احجز تذكرتك',
  orgK: 'الجهات المنظّمة',
  spanK: 'المدة التقريبية',
  actsK: 'أبرز الأنشطة',
  statusL: { confirmed: 'مؤكد هذا العام', expected: 'موسم متوقع', tba: 'بانتظار الإعلان' },
  nowBadge: 'نحن الآن هنا',
  orderNote: 'رُتِّبت البطاقات تلقائياً حسب الأقرب إلى تاريخ جهازك — تبدأ بما هو جارٍ الآن.',
  events: EVENTS_AR,
  notesH: 'قبل أن تحضر',
  notes: [
    { h: 'التوقيت', d: 'تتبع الفعاليات التقويمين الهجري والميلادي وتعود سنوياً في مواسمها التقريبية، وقد تختلف المواعيد الرسمية من عامٍ لآخر — تابع إعلانات كل نسخة.' },
    { h: 'التراث والإبداع', d: 'تسلّط المهرجانات الضوء على هوية الأحساء وتراثها عبر الملابس الشعبية والحرف اليدوية والمنتجات المحلية الأصيلة.' },
    { h: 'الأجواء العائلية', d: 'برامج تناسب جميع أفراد العائلة، بتركيزٍ على الترفيه والإبداع والتسوق والتذوق لكل الأعمار.' },
  ],
  srcNote: 'للمزيد من المعلومات والتحديثات، يُرجى متابعة أمانة الأحساء وهيئة تطوير الأحساء والقنوات الرسمية للفعاليات.',
  ctaH: 'اجعل موسمك رحلةً كاملة',
  ctaD: 'اربط زيارة المهرجان بمعالم الواحة القريبة منه، وجهّز مسارك في «رحلتي».',
  ctaBrowse: 'تصفّح المعالم',
  ctaPlan: 'خطّط لرحلتك',
  seoTitle: 'مهرجانات وفعاليات الأحساء — مواسم الواحة على مدار العام',
  seoDesc: 'دليل المهرجانات والفعاليات الموسمية في الأحساء: البشت الحساوي، ليالي القيصرية، ليالي كفو، مهرجان التمور، قرية النخيل، اللومي الحساوي، شتاء العقير، شتاء الوفرة، سباقات الخيل، والأحساء المبدعة — بمواسمها وأنشطتها وجهاتها المنظّمة.',
} : {
  eyebrow: 'Seasons of the oasis',
  title: 'Festivals & Events',
  lead: 'From Qaisariyah Souq to the palm groves, Al-Ahsa pulses with seasons that revive its heritage all year round — celebrations and festivals that return each year in their season.',
  notice: 'These events recur annually in their approximate seasons; official dates and details may vary from year to year with each edition. Please confirm via the organisers’ announcements and official channels before visiting.',
  placeK: 'Location',
  mapK: 'Map ↗',
  ticketK: 'Book your ticket',
  orgK: 'Organisers',
  spanK: 'Approximate length',
  actsK: 'Highlights',
  statusL: { confirmed: 'Confirmed this year', expected: 'Expected season', tba: 'Awaiting announcement' },
  nowBadge: 'You are here now',
  orderNote: 'The cards are ordered automatically by what is nearest to your device’s date — starting with whatever is under way now.',
  events: EVENTS_EN,
  notesH: 'Before you go',
  notes: [
    { h: 'Timing', d: 'The events follow both the Hijri and Gregorian calendars and return annually in their approximate seasons; official dates can shift from year to year — follow each edition’s announcements.' },
    { h: 'Heritage & creativity', d: 'The festivals spotlight Al-Ahsa’s identity and heritage through folk dress, handicrafts and authentic local products.' },
    { h: 'Family atmosphere', d: 'Programmes suit the whole family, focused on entertainment, creativity, shopping and tasting for all ages.' },
  ],
  srcNote: 'For more information and updates, follow Al-Ahsa Municipality, the Al-Ahsa Development Authority and the events’ official channels.',
  ctaH: 'Turn your season into a full trip',
  ctaD: 'Pair the festival with the oasis sights around it, and build your route in “My Trip”.',
  ctaBrowse: 'Browse attractions',
  ctaPlan: 'Plan your trip',
  seoTitle: 'Al-Ahsa festivals & events — seasons of the oasis all year round',
  seoDesc: 'A guide to Al-Ahsa’s seasonal festivals and events: the Hasawi Bisht Festival, Qaisariyah Nights, Kafu Nights, the Processed Dates Festival, Palm Village, the Hasawi Lomi Exhibition, Al-Uqair Winter, Al-Wafrah Winter, the horse racing season and Creative Al-Ahsa — with their seasons, highlights and organisers.',
};

const browseHref = ar ? '/معالم/' : '/en/attractions/';
const detailBase = ar ? '/فعاليات/' : '/en/events/';
const planHref = ar ? '/خطط/' : '/en/plan-your-trip/';
const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: C.title, item: new URL(alt[lang], siteUrl).href },
  ] },
  // ItemList فقط — لا Event schema عمداً: جوجل يشترط startDate محدداً للأهلية،
  // ومواسمنا تقريبية بقرار محتوى ملزم (لا تواريخ دقيقة)، فأي startDate سيكون مختلقاً.
  { '@context': 'https://schema.org', '@type': 'ItemList',
    name: C.title, url: new URL(alt[lang], siteUrl).href,
    itemListElement: [...C.events].sort((a, b) => a.start - b.start).map((e, i) => ({
      '@type': 'ListItem', position: i + 1, name: e.name,
    })),
  },
];
---
<Base title={`${C.seoTitle} — ${t('site.name')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-events">
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="ev-hero on-dark">
      <HeroPoster src="/img/hero-events" class="evh-poster" />
      <video class="photo-bg evh-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source data-src="/video/hero-events.mp4" type="video/mp4" />
      </video>
      <PalmMotif size={320} class="evh-wm" aria-hidden="true" />
      <div class="container evh-in">
        <span class="eyebrow gold-on-dark">{C.eyebrow}</span>
        <h1 class="evh-title">{C.title}</h1>
        <p class="evh-sum">{C.lead}</p>
      </div>
    </section>

    <section class="sec" id="events">
      <div class="container">
        <p class="ev-notice" data-reveal>{C.notice}</p>
        {/* يظهر فقط بعد أن يعيد JS الترتيب فعلاً — بلا JS يبقى الترتيب تقويمياً ولا نَعِد بما لم يحدث */}
        <p class="ev-order-note" data-ev-order-note hidden>{C.orderNote}</p>

        <div class="ev-grid" data-ev-grid>
          {[...C.events].sort((a, b) => a.start - b.start).map((e, i) => (
            <article class="ev-card" data-reveal style={`transition-delay:${(i % 4) * 60}ms`}
              data-start={e.start} data-end={e.end ?? ''} data-ramadan={e.ramadan ? '1' : ''}>
              <div class="ev-media">
                <Photo src={e.img} label={e.name} class="ev-photo" eager={i < 2} sizes="(max-width: 760px) 100vw, (max-width: 1120px) 50vw, 360px" />
                <span class="ev-season">{e.season}</span>
                <span class={`ev-status ev-status--${e.status ?? 'expected'}`}>{C.statusL[e.status ?? 'expected']}</span>
                <span class="ev-now" data-ev-now hidden>{C.nowBadge}</span>
              </div>
              <div class="ev-body">
              <div class="ev-top">
                <span class="ev-time">
                  <svg class="ev-cal" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4.5" width="18" height="17" rx="2" />
                    <path d="M3 9h18M8 2.5v4M16 2.5v4" />
                  </svg>
                  {e.time}
                </span>
                <span class="ev-span">{e.span}</span>
              </div>
              <h2 class="ev-name"><a class="ev-name-link" href={`${detailBase}${e.slug}/`}>{e.name}</a></h2>
              <dl class="ev-meta">
                <div class="evm-row">
                  <dt class="evm-k">{C.placeK}</dt>
                  <dd class="evm-v">{e.place}{e.map && <> — <a class="evm-map" href={e.map} target="_blank" rel="noopener">{C.mapK}</a></>}</dd>
                </div>
                <div class="evm-row">
                  <dt class="evm-k">{C.orgK}</dt>
                  <dd class="evm-v">{e.org}</dd>
                </div>
              </dl>
              <h3 class="ev-acts-h">{C.actsK}</h3>
              <ul class="ev-acts">
                {e.acts.map((a) => <li class="ev-act">{a}</li>)}
              </ul>
              {e.ticket && (
                <a class="ev-ticket" href={e.ticket} target="_blank" rel="noopener noreferrer">
                  <svg class="ev-ticket-ic" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.6V7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2.6a2.4 2.4 0 0 0 0 4.8V17a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2.6a2.4 2.4 0 0 0 0-4.8Z" />
                    <path d="M14.5 6.6v10.8" stroke-dasharray="2 2.6" />
                  </svg>
                  {C.ticketK}
                </a>
              )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="notes">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.notesH}</h2>
        <div class="nt-grid">
          {C.notes.map((n, i) => (
            <article class="nt-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <h3 class="nt-h">{n.h}</h3>
              <p class="nt-d">{n.d}</p>
            </article>
          ))}
        </div>
        <p class="nt-src" data-reveal>{C.srcNote}</p>
      </div>
    </section>

    <section class="ev-cta">
      <div class="container ev-cta-in" data-reveal>
        <h2 class="evc-h">{C.ctaH}</h2>
        <p class="lead evc-d">{C.ctaD}</p>
        <div class="evc-btns">
          <a href={browseHref} class="btn btn--gold">{C.ctaBrowse}</a>
          <a href={planHref} class="btn btn--turq">{C.ctaPlan}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<script>
  // تشغيل فيديو الهيرو فقط عند السماح بالحركة وعدم تفعيل توفير البيانات؛
  // preload="none" + data-src يمنعان تنزيل الفيديو لمن لا يشمله التشغيل.
  const v = document.querySelector<HTMLVideoElement>('.evh-video');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;
  if (v && !reduceMotion && !saveData) {
    const s = v.querySelector('source');
    if (s?.dataset.src) {
      v.addEventListener('playing', () => v.classList.add('evh-video--on'), { once: true });
      s.src = s.dataset.src;
      v.autoplay = true;
      v.load();
      v.addEventListener('canplay', () => { v.play().catch(() => {}); }, { once: true });
    }
  }
</script>

<script is:inline>
  // إعادة ترتيب بطاقات الفعاليات حسب الأقرب إلى تاريخ جهاز الزائر، وتمييز الجارية الآن.
  // عرضٌ فقط: لا يضيف ولا يخفي أي معلومة — النوافذ مشتقة من حقل time المعروض في البطاقة.
  // بلا JS يبقى الترتيب التقويمي (يناير ← ديسمبر) كما بُني، وهو ترتيب صادق بذاته.
  function orderEvents() {
    var grid = document.querySelector('[data-ev-grid]');
    if (!grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.ev-card'));
    if (!cards.length) return;

    var now = new Date();
    var gm = now.getMonth() + 1; // الشهر الميلادي 1-12

    // الشهر الهجري من تقويم الجهاز — لليالي كفو (رمضان = الشهر 9).
    // عند غياب دعم التقويم الهجري نُبقيها في آخر الترتيب بلا ادّعاء.
    var hm = 0;
    try {
      var parts = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { month: 'numeric' }).formatToParts(now);
      for (var p = 0; p < parts.length; p++) if (parts[p].type === 'month') hm = parseInt(parts[p].value, 10);
    } catch (err) { hm = 0; }

    var ranked = cards.map(function (el, idx) {
      var running = false, dist = 99;
      if (el.getAttribute('data-ramadan')) {
        if (hm) { running = hm === 9; dist = running ? 0 : (9 - hm + 12) % 12; }
      } else {
        var start = parseInt(el.getAttribute('data-start'), 10);
        var endAttr = el.getAttribute('data-end');
        var end = endAttr ? parseInt(endAttr, 10) : start;
        // النافذة تلتفّ عبر رأس السنة عندما يكون end < start (مثل نوفمبر ← فبراير)
        running = start <= end ? (gm >= start && gm <= end) : (gm >= start || gm <= end);
        dist = running ? 0 : (start - gm + 12) % 12;
      }
      return { el: el, running: running, dist: dist, idx: idx };
    });

    // الجارية أولاً، ثم الأقرب بداية، وعند التساوي يُحفظ الترتيب التقويمي الأصلي
    ranked.sort(function (a, b) {
      if (a.running !== b.running) return a.running ? -1 : 1;
      if (a.dist !== b.dist) return a.dist - b.dist;
      return a.idx - b.idx;
    });

    ranked.forEach(function (r, i) {
      grid.appendChild(r.el); // نقل عقد DOM فعلياً ليبقى ترتيب القراءة والتنقل مطابقاً للمرئي
      r.el.style.transitionDelay = (i % 4) * 60 + 'ms';
      r.el.classList.toggle('is-now', r.running);
      var badge = r.el.querySelector('[data-ev-now]');
      if (badge) badge.hidden = !r.running;
    });

    var note = document.querySelector('[data-ev-order-note]');
    if (note) note.hidden = false;
  }
  document.addEventListener('astro:page-load', orderEvents);
  if (document.readyState !== 'loading') orderEvents();
  else document.addEventListener('DOMContentLoaded', orderEvents);
</script>

<style>
  .ev-hero { position: relative; overflow: hidden; background: var(--c-turq-deep); padding-block: var(--s-8) var(--s-7); }
  /* فيديو الهيرو فوق الخلفية الفيروزية؛ يظهر تدريجياً بعد بدء التشغيل، والخلفية تبقى احتياطاً
     لمن يُفعّل «تقليل الحركة» أو «توفير البيانات». */
  .evh-video { object-fit: cover; inline-size: 100%; block-size: 100%; opacity: 0; transition: opacity 1.2s var(--ease); filter: saturate(.94) contrast(1.03); }
  .evh-video--on { opacity: 1; }
  /* طبقة تعتيم لضمان وضوح النصّ فوق الفيديو */
  .ev-hero::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: var(--hero-scrim);
  }
  :global(.evh-wm) { position: absolute; inset-block-start: -10%; inset-inline-end: -5%; z-index: 0; color: var(--c-gold); opacity: .1; }
  /* التحديد على الفقرة لا على الحاوية — وإلا انزاحت الكتلة عن حافة البداية */
  .evh-in { position: relative; z-index: 2; }
  .evh-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .evh-sum { font-size: var(--t-lg); color: rgba(247,243,234,.9); max-inline-size: 60ch; }

  .sec { padding-block: var(--s-7); }
  .sec--sand { background: var(--c-sand-2); }
  .sec-h { font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.2; margin-block-end: var(--s-5); }

  .ev-notice { max-inline-size: 78ch; font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.8;
    background: #fff; border: 1px solid var(--c-line); border-inline-start: 3px solid var(--c-gold);
    border-radius: var(--radius); padding: var(--s-3) var(--s-4); margin-block-end: var(--s-5); }

  /* ملاحظة الترتيب التلقائي — يكشفها JS بعد إعادة الترتيب فعلاً */
  .ev-order-note { font-size: var(--t-xs); color: var(--c-ink-60); margin-block-end: var(--s-4); }

  .ev-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }
  .ev-card { position: relative; display: flex; flex-direction: column; background: #fff; border: 1px solid var(--c-line);
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  /* الفعالية الجارية الآن — بنفس لغة «ما موسم الأحساء الآن؟»: إطار ذهبي وظل ذهبي خافت */
  .ev-card.is-now { border-color: var(--c-gold); box-shadow: 0 2px 4px rgba(21,33,30,.06), 0 14px 32px rgba(201,154,74,.18); }
  /* الشارة أسفل الصورة — الزاويتان العلويتان مشغولتان بشارتَي الموسم والحالة */
  .ev-now { position: absolute; inset-block-end: var(--s-3); inset-inline-start: var(--s-3); z-index: 2;
    font-family: var(--font-body); font-weight: 700; font-size: var(--t-xs); color: var(--c-ink);
    background: var(--c-gold); border-radius: 999px; padding: 4px 12px; box-shadow: var(--shadow); }
  .ev-media { position: relative; }
  :global(.ev-photo) { border-radius: 0; }
  .ev-season { position: absolute; inset-block-start: var(--s-3); inset-inline-start: var(--s-3); z-index: 2;
    font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-turq-deep);
    background: color-mix(in srgb, var(--c-sand) 92%, transparent); backdrop-filter: blur(4px);
    border-radius: 999px; padding: 4px 12px; box-shadow: var(--shadow); }
  /* شارة الحالة — مقابل شارة الموسم على الطرف الآخر من الصورة */
  .ev-status { position: absolute; inset-block-start: var(--s-3); inset-inline-end: var(--s-3); z-index: 2;
    font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs);
    border-radius: 999px; padding: 4px 12px; box-shadow: var(--shadow); backdrop-filter: blur(4px); }
  .ev-status--confirmed { color: var(--c-sand); background: color-mix(in srgb, var(--c-turq-deep) 92%, transparent); }
  .ev-status--expected { color: var(--c-ink); background: color-mix(in srgb, var(--c-gold) 90%, transparent); }
  .ev-status--tba { color: var(--c-ink-soft); background: color-mix(in srgb, #fff 90%, transparent); border: 1px solid var(--c-line); }
  .ev-body { display: flex; flex-direction: column; flex: 1; padding: var(--s-4); }
  .ev-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); margin-block-end: var(--s-2); }
  .ev-time { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-body); font-weight: 600;
    font-size: var(--t-sm); color: var(--c-turq-deep); }
  .ev-cal { color: var(--c-gold-deep); flex-shrink: 0; }
