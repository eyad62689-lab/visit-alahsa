---
// صفحة «المهرجانات والفعاليات» — المواسم الثقافية المتكررة في الأحساء.
// المصدر: ملف «الفعاليات الموسمية السنوية في الأحساء» المعتمد من إياد (2026-07-08).
// قاعدة ملزمة: الأصل مواسم تقريبية (أشهر عامة) بلا تواريخ ولا مُدد بالأيام، مع تنبيه
// ظاهر بأن المواعيد تتغيّر سنوياً. الاستثناء الوحيد: نسخة أعلن إياد موعدها الرسمي —
// عندها يُكتب التاريخ في time مع status: 'confirmed'، ويعود تقريبياً بعد انقضائها.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Photo from '../Photo.astro';
import PageHero from '../PageHero.astro';
import EventEdition from '../EventEdition.astro';
import { altHref, localize, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { EVENTS_AR, EVENTS_EN, EVENTS_ZH, evView, type Ev } from '../../data/events';
import { SITE, absUrl, breadcrumb } from '../../lib/schema';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';



const C = localize(lang, {
  eyebrow: 'مواسم الواحة',
  title: 'المهرجانات والفعاليات',
  lead: 'من سوق القيصرية إلى مزارع النخيل، تنبض الأحساء بمواسمَ تُحيي تراثها على مدار العام — احتفالاتٌ ومهرجاناتٌ تعود كلَّ سنةٍ في موسمها.',
  notice: 'تتكرّر هذه الفعاليات سنوياً في مواسمها التقريبية، وقد تختلف مواعيدها وتفاصيلها من عامٍ لآخر بحسب تنظيم كل نسخة. يُرجى التأكد من إعلانات الجهات المنظّمة والقنوات الرسمية قبل الزيارة.',
  placeK: 'الموقع',
  mapK: 'الخريطة ↗',
  ticketK: 'احجز تذكرتك',
  orgK: 'الجهات المنظّمة',
  spanK: 'المدة التقريبية',
  actsK: 'أبرز الأنشطة',
  statusL: { confirmed: 'مؤكد هذا العام', expected: 'موسم متوقع', tba: 'بانتظار الإعلان' },
  // نصوص العدّاد — يملؤها JS من تاريخ جهاز الزائر؛ {n} عدد الأيام
  cd: {
    pre: { one: 'يبدأ غداً', other: 'يبدأ بعد {n} يوماً' },
    today: 'يبدأ اليوم',
    last: 'آخر يوم اليوم',
    left: { one: 'يتبقّى يوم واحد', two: 'يتبقّى يومان', few: 'تتبقّى {n} أيام', many: 'يتبقّى {n} يوماً', other: 'يتبقّى {n} يوم' },
  },
  nowBadge: 'نحن الآن هنا',
  orderNote: 'رُتِّبت البطاقات تلقائياً حسب الأقرب إلى تاريخ جهازك — تبدأ بما هو جارٍ الآن.',
  events: EVENTS_AR,
  notesH: 'قبل أن تحضر',
  notes: [
    { h: 'التوقيت', d: 'تتبع الفعاليات التقويمين الهجري والميلادي وتعود سنوياً في مواسمها التقريبية، وقد تختلف المواعيد الرسمية من عامٍ لآخر — تابع إعلانات كل نسخة.' },
    { h: 'التراث والإبداع', d: 'تسلّط المهرجانات الضوء على هوية الأحساء وتراثها عبر الملابس الشعبية والحرف اليدوية والمنتجات المحلية الأصيلة.' },
    { h: 'الأجواء العائلية', d: 'برامج تناسب جميع أفراد العائلة، بتركيزٍ على الترفيه والإبداع والتسوق والتذوق لكل الأعمار.' },
  ],
  srcNote: 'للمزيد من المعلومات والتحديثات، يُرجى متابعة أمانة الأحساء وهيئة تطوير الأحساء والقنوات الرسمية للفعاليات.',
  ctaH: 'اجعل موسمك رحلةً كاملة',
  ctaD: 'اربط زيارة المهرجان بمعالم الواحة القريبة منه، وجهّز مسارك في «رحلتي».',
  ctaBrowse: 'تصفّح المعالم',
  ctaPlan: 'خطّط لرحلتك',
  seoTitle: 'مهرجانات وفعاليات الأحساء — مواسم الواحة على مدار العام',
  seoDesc: 'دليل المهرجانات والفعاليات الموسمية في الأحساء — البشت، ليالي القيصرية، معرض اللومي، شتاء العقير وغيرها، بمواسمها وأنشطتها وجهاتها المنظّمة.',
}, {
  eyebrow: 'Seasons of the oasis',
  title: 'Festivals & Events',
  lead: 'From Qaisariyah Souq to the palm groves, Al-Ahsa pulses with seasons that revive its heritage all year round — celebrations and festivals that return each year in their season.',
  notice: 'These events recur annually in their approximate seasons; official dates and details may vary from year to year with each edition. Please confirm via the organisers’ announcements and official channels before visiting.',
  placeK: 'Location',
  mapK: 'Map ↗',
  ticketK: 'Book your ticket',
  orgK: 'Organisers',
  spanK: 'Approximate length',
  actsK: 'Highlights',
  statusL: { confirmed: 'Confirmed this year', expected: 'Expected season', tba: 'Awaiting announcement' },
  cd: {
    pre: { one: 'Starts tomorrow', other: 'Starts in {n} days' },
    today: 'Starts today',
    last: 'Last day today',
    left: { one: '1 day left', other: '{n} days left' },
  },
  nowBadge: 'You are here now',
  orderNote: 'The cards are ordered automatically by what is nearest to your device’s date — starting with whatever is under way now.',
  events: EVENTS_EN,
  notesH: 'Before you go',
  notes: [
    { h: 'Timing', d: 'The events follow both the Hijri and Gregorian calendars and return annually in their approximate seasons; official dates can shift from year to year — follow each edition’s announcements.' },
    { h: 'Heritage & creativity', d: 'The festivals spotlight Al-Ahsa’s identity and heritage through folk dress, handicrafts and authentic local products.' },
    { h: 'Family atmosphere', d: 'Programmes suit the whole family, focused on entertainment, creativity, shopping and tasting for all ages.' },
  ],
  srcNote: 'For more information and updates, follow Al-Ahsa Municipality, the Al-Ahsa Development Authority and the events’ official channels.',
  ctaH: 'Turn your season into a full trip',
  ctaD: 'Pair the festival with the oasis sights around it, and build your route in “My Trip”.',
  ctaBrowse: 'Browse attractions',
  ctaPlan: 'Plan your trip',
  seoTitle: 'Al-Ahsa festivals & events — seasons of the oasis all year round',
  seoDesc: 'A guide to Al-Ahsa’s seasonal festivals and events — the Bisht Festival, Qaisariyah Nights, the Lomi Exhibition and more, with seasons and organisers.',
}, {
  // الكتلة الصينية — خط zh-translation-pipeline (دفعة events 2026-09-02، الحاكم 94/100)
  eyebrow: '绿洲的节庆时令',
  title: '节庆与活动',
  lead: '从凯萨利亚市集到连绵的椰枣园，哈萨一年四季都跳动着文化传承的节庆脉搏——一场场庆典与节日，年复一年在各自的时节如约而至。',
  notice: '以上活动每年在大致相同的季节循环举办，具体日期与内容可能因各届安排而有所变动。出行前请以主办方公告及官方渠道信息为准。',
  placeK: '地点',
  mapK: '地图 ↗',
  ticketK: '预订门票',
  orgK: '主办单位',
  spanK: '大致时长',
  actsK: '亮点活动',
  statusL: { confirmed: '今年已确认', expected: '预计档期', tba: '待官方公布' },
  cd: {
    pre: { one: '明天开幕', other: '还有 {n} 天开幕' },
    today: '今天开幕',
    last: '今天是最后一天',
    left: { one: '还剩 {n} 天', two: '还剩 {n} 天', few: '还剩 {n} 天', many: '还剩 {n} 天', other: '还剩 {n} 天' },
  },
  nowBadge: '正当季',
  orderNote: '卡片已按您设备的日期自动排序——正在进行的活动排在最前。',
  events: EVENTS_ZH,
  notesH: '出行前须知',
  notes: [
    { h: '时间安排', d: '各项活动同时参照伊斯兰历与公历，每年在大致相同的季节举办；官方日期可能逐年变动——请关注每届的最新公告。' },
    { h: '传统与创意', d: '这些节庆通过民族服饰、手工艺与地道的本地产品，展现哈萨的文化认同与传统底蕴。' },
    { h: '家庭氛围', d: '活动内容适合全家参与，集娱乐、创意、购物与美食品鉴于一体，老少皆宜。' },
  ],
  srcNote: '欲了解更多信息与最新动态，请关注哈萨市政局、哈萨发展管理局及各活动官方渠道。',
  ctaH: '让节庆之行变成完整旅程',
  ctaD: '将节庆游览与周边绿洲名胜串联起来，在“我的行程”中规划您的路线。',
  ctaBrowse: '浏览景点',
  ctaPlan: '规划行程',
  seoTitle: '哈萨节庆与活动——绿洲四季精彩不断',
  seoDesc: '哈萨季节性节庆活动指南——哈萨比什特长袍节、凯萨利亚市集之夜、哈萨青柠展、乌盖尔之冬等，涵盖举办时节、亮点活动与主办单位。',
});

// العرض الفعّال وقت البناء: النسخة المؤكدة ما دامت قائمة، والموسم التقريبي بعدها
// (evView). ويعيد المتصفّح الحساب بتاريخ الزائر عبر EventEdition تحسّباً لتأخّر
// النشر بعد يوم الختام — raw يبقى للمواعيد ISO التي يقرأها العدّاد.
const cards = [...C.events].sort((a, b) => a.start - b.start).map((raw) => ({ raw, e: evView(raw) }));

// أيّ بطاقتين تُحمَّل صورتاهما فوراً (LCP)؟ المتصفّح يعيد الترتيب فيقدّم الجاري
// الآن، فالمؤكدة أو الجارية في شهر السعودية وقت البناء أولى من أول اثنتين
// تقويمياً — وتُكمَّل الحصّة من الترتيب التقويمي عند نقصها.
const ksaMonth = (calendar?: string): number => {
  try {
    const f = new Intl.DateTimeFormat(calendar ? `en-u-ca-${calendar}` : 'en', { timeZone: 'Asia/Riyadh', month: 'numeric' });
    const m = f.formatToParts(new Date()).find((p) => p.type === 'month');
    return m ? parseInt(m.value, 10) : 0;
  } catch { return 0; }
};
const gmNow = ksaMonth();
const hmNow = ksaMonth('islamic-umalqura');
const runningNow = (e: Ev): boolean => {
  if (e.ramadan) return hmNow === 9;
  const end = e.end ?? e.start;
  return e.start <= end ? (gmNow >= e.start && gmNow <= end) : (gmNow >= e.start || gmNow <= end);
};
const eagerIds = new Set(cards.filter(({ e }) => e.status === 'confirmed' || runningNow(e)).slice(0, 2).map(({ raw }) => raw.id));
for (const { raw } of cards) { if (eagerIds.size >= 2) break; eagerIds.add(raw.id); }

// الصينية: صفحات الفعاليات لها نسخ /zh/ (توسعة 2026-09-02)؛ «خطط» لم تُترجم بعد
const zh = lang === 'zh';
const browseHref = ar ? '/معالم/' : zh ? '/zh/attractions/' : '/en/attractions/';
const detailBase = ar ? '/فعاليات/' : zh ? '/zh/events/' : '/en/events/';
const planHref = ar ? '/خطط/' : '/en/plan-your-trip/';
const siteUrl = SITE;
const jsonLd = [
  breadcrumb([
    { name: t('crumb.home'), path: ar ? '/' : zh ? '/zh/' : '/en/' },
    { name: C.title, path: altHref(alt, lang) },
  ]),
  // ItemList فقط — لا Event schema عمداً: جوجل يشترط startDate محدداً للأهلية،
  // ومواسمنا تقريبية بقرار محتوى ملزم (لا تواريخ دقيقة)، فأي startDate سيكون مختلقاً.
  { '@context': 'https://schema.org', '@type': 'ItemList',
    name: C.title, url: absUrl(altHref(alt, lang), siteUrl),
    itemListElement: cards.map(({ e }, i) => ({
      '@type': 'ListItem', position: i + 1, name: e.name, url: absUrl(`${detailBase}${e.slug}/`, siteUrl),
    })),
  },
];
---
<Base title={`${C.seoTitle} — ${t('site.name')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-events">
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={C.eyebrow} title={C.title} lead={C.lead} leadWidth={60}
      poster="/img/hero-events" video="/video/hero-events.mp4" lang={lang} />

    <section class="sec" id="events">
      <div class="container">
        <p class="ev-notice" data-reveal>{C.notice}</p>
        {/* يظهر فقط بعد أن يعيد JS الترتيب فعلاً — بلا JS يبقى الترتيب تقويمياً ولا نَعِد بما لم يحدث */}
        <p class="ev-order-note" data-ev-order-note hidden>{C.orderNote}</p>

        <div class="ev-grid" data-ev-grid>
          {cards.map(({ raw, e }, i) => (
            <article class="card ev-card" data-reveal style={`transition-delay:${(i % 4) * 60}ms`}
              data-start={e.start} data-end={e.end ?? ''} data-ramadan={e.ramadan ? '1' : ''}
              data-ev-edition={raw.after && raw.endISO ? '' : undefined}
              data-ev-start={raw.after && raw.startISO ? raw.startISO : undefined}
              data-ev-end={raw.after && raw.endISO ? raw.endISO : undefined}
              data-ev-after={raw.after && raw.endISO
                ? JSON.stringify({ time: raw.after.time, span: raw.after.span, status: raw.after.status, label: C.statusL[raw.after.status] })
                : undefined}>
              <div class="ev-media">
                <Photo src={e.img} label={e.name} class="ev-photo" eager={eagerIds.has(raw.id)} sizes="(max-width: 760px) 100vw, (max-width: 1120px) 50vw, 360px" />
                <span class="ev-season">{e.season}</span>
                <span class={`ev-status ev-status--${e.status ?? 'expected'}`} data-ev-status>{C.statusL[e.status ?? 'expected']}</span>
                <span class="ev-now" data-ev-now hidden>{C.nowBadge}</span>
                {/* العدّاد يملؤه JS من تاريخ الجهاز — لا رقم مبنيّ بتاريخ نشرٍ قد يتقادم */}
                {raw.endISO && <span class="ev-cd" data-ev-cd hidden></span>}
              </div>
              <div class="ev-body">
              <div class="ev-top">
                <span class="ev-time">
                  <svg class="ev-cal" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4.5" width="18" height="17" rx="2" />
                    <path d="M3 9h18M8 2.5v4M16 2.5v4" />
                  </svg>
                  <span data-ev-field="time">{e.time}</span>
                </span>
                <span class="ev-span" data-ev-field="span">{e.span}</span>
              </div>
              <h2 class="ev-name"><a class="ev-name-link" href={`${detailBase}${e.slug}/`}>{e.name}</a></h2>
              <dl class="ev-meta">
                <div class="evm-row">
                  <dt class="evm-k">{C.placeK}</dt>
                  <dd class="evm-v">{e.place}{e.map && <> — <a class="evm-map" href={e.map} target="_blank" rel="noopener">{C.mapK}</a></>}</dd>
                </div>
                <div class="evm-row">
                  <dt class="evm-k">{C.orgK}</dt>
                  <dd class="evm-v">{e.org}</dd>
                </div>
              </dl>
              <h3 class="ev-acts-h">{C.actsK}</h3>
              <ul class="ev-acts">
                {e.acts.map((a) => <li class="ev-act">{a}</li>)}
              </ul>
              {e.ticket && (
                <a class="ev-ticket" href={e.ticket} target="_blank" rel="noopener noreferrer" data-ev-dated>
                  <svg class="ev-ticket-ic" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 9.6V7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v2.6a2.4 2.4 0 0 0 0 4.8V17a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-2.6a2.4 2.4 0 0 0 0-4.8Z" />
                    <path d="M14.5 6.6v10.8" stroke-dasharray="2 2.6" />
                  </svg>
                  {C.ticketK}
                </a>
              )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="notes">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.notesH}</h2>
        <div class="nt-grid">
          {C.notes.map((n, i) => (
            <article class="nt-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <h3 class="nt-h">{n.h}</h3>
              <p class="nt-d">{n.d}</p>
            </article>
          ))}
        </div>
        <p class="nt-src" data-reveal>{C.srcNote}</p>
      </div>
    </section>

    <section class="ev-cta">
      <div class="container ev-cta-in" data-reveal>
        <h2 class="evc-h">{C.ctaH}</h2>
        <p class="lead evc-d">{C.ctaD}</p>
        <div class="evc-btns">
          <a href={browseHref} class="btn btn--gold">{C.ctaBrowse}</a>
          <a href={planHref} class="btn btn--turq">{C.ctaPlan}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<EventEdition cd={C.cd} />

<script is:inline>
  // إعادة ترتيب بطاقات الفعاليات حسب الأقرب إلى تاريخ جهاز الزائر، وتمييز الجارية الآن.
  // عرضٌ فقط: لا يضيف ولا يخفي أي معلومة — النوافذ مشتقة من حقل time المعروض في البطاقة.
  // بلا JS يبقى الترتيب التقويمي (يناير ← ديسمبر) كما بُني، وهو ترتيب صادق بذاته.
  function orderEvents() {
    var grid = document.querySelector('[data-ev-grid]');
    if (!grid) return;
    var cards = Array.prototype.slice.call(grid.querySelectorAll('.ev-card'));
    if (!cards.length) return;

    var now = new Date();
    // الشهر بتوقيت السعودية لا بجهاز الزائر — نفس يوم الأحساء الذي يعتمده عدّاد
    // النسخة المؤكدة (EventEdition: UTC+3)، وإلا اختلف الشهر عن العدّاد ليلة رأس
    // الشهر لزائرٍ في منطقة زمنية بعيدة. عند غياب دعم timeZone نعود لشهر الجهاز.
    var gm = now.getMonth() + 1; // الشهر الميلادي 1-12
    try {
      gm = parseInt(new Intl.DateTimeFormat('en', { timeZone: 'Asia/Riyadh', month: 'numeric' }).format(now), 10) || gm;
    } catch (err) { /* شهر الجهاز */ }

    // الشهر الهجري (بتوقيت السعودية أيضاً) — لليالي كفو (رمضان = الشهر 9).
    // عند غياب دعم التقويم الهجري نُبقيها في آخر الترتيب بلا ادّعاء.
    var hm = 0;
    try {
      var parts = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { timeZone: 'Asia/Riyadh', month: 'numeric' }).formatToParts(now);
      for (var p = 0; p < parts.length; p++) if (parts[p].type === 'month') hm = parseInt(parts[p].value, 10);
    } catch (err) { hm = 0; }

    var ranked = cards.map(function (el, idx) {
      var running = false, dist = 99;
      if (el.getAttribute('data-ramadan')) {
        if (hm) { running = hm === 9; dist = running ? 0 : (9 - hm + 12) % 12; }
      } else {
        var start = parseInt(el.getAttribute('data-start'), 10);
        var endAttr = el.getAttribute('data-end');
        var end = endAttr ? parseInt(endAttr, 10) : start;
        // النافذة تلتفّ عبر رأس السنة عندما يكون end < start (مثل نوفمبر ← فبراير)
        running = start <= end ? (gm >= start && gm <= end) : (gm >= start || gm <= end);
        dist = running ? 0 : (start - gm + 12) % 12;
      }
      return { el: el, running: running, dist: dist, idx: idx };
    });

    // الجارية أولاً، ثم الأقرب بداية، وعند التساوي يُحفظ الترتيب التقويمي الأصلي
    ranked.sort(function (a, b) {
      if (a.running !== b.running) return a.running ? -1 : 1;
      if (a.dist !== b.dist) return a.dist - b.dist;
      return a.idx - b.idx;
    });

    ranked.forEach(function (r, i) {
      grid.appendChild(r.el); // نقل عقد DOM فعلياً ليبقى ترتيب القراءة والتنقل مطابقاً للمرئي
      r.el.style.transitionDelay = (i % 4) * 60 + 'ms';
      r.el.classList.toggle('is-now', r.running);
      var badge = r.el.querySelector('[data-ev-now]');
      if (badge) badge.hidden = !r.running;
    });

    var note = document.querySelector('[data-ev-order-note]');
    if (note) note.hidden = false;
  }
  document.addEventListener('astro:page-load', orderEvents);
  if (document.readyState !== 'loading') orderEvents();
  else document.addEventListener('DOMContentLoaded', orderEvents);
</script>

