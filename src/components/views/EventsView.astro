---
// صفحة «المهرجانات والفعاليات» — المواسم الثقافية المتكررة في الأحساء.
// المصدر: ملف «الفعاليات الموسمية السنوية في الأحساء» المعتمد من إياد (2026-07-08).
// قاعدة ملزمة: الأصل مواسم تقريبية (أشهر عامة) بلا تواريخ ولا مُدد بالأيام، مع تنبيه
// ظاهر بأن المواعيد تتغيّر سنوياً. الاستثناء الوحيد: نسخة أعلن إياد موعدها الرسمي —
// عندها يُكتب التاريخ في time مع status: 'confirmed'، ويعود تقريبياً بعد انقضائها.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import HeroPoster from '../HeroPoster.astro';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

type Ev = {
  name: string; place: string; season: string; time: string;
  span: string; org: string; acts: string[]; img: string; start: number;
  map?: string; // رابط خرائط جوجل (اختياري)
  // شارة الحالة: 'confirmed' فقط عندما تُعلن الجهة المنظمة موعد النسخة القادمة رسمياً
  // (ويُحدَّث حقل time بالموعد المعلن)، و'tba' لما توقف أو لم يتأكد تكراره.
  // الافتراضي 'expected': موسم متوقع قياساً على النسخ السابقة — لا نختلق تأكيداً.
  status?: 'confirmed' | 'expected' | 'tba';
  // نافذة الموسم بالأشهر الميلادية (start..end، وتلتفّ عبر رأس السنة إن كان end < start).
  // **مشتقّة حرفياً من حقل time المعروض** ولا تُعرض للقارئ — تُستخدم للترتيب التلقائي
  // وشارة «نحن الآن هنا» فقط. لا تُضِف نافذةً لا يسندها نصّ time الظاهر.
  end?: number;
  // ليالي كفو موسمها هجري متنقل (رمضان) فلا يصلح لها شهر ميلادي ثابت — يُحسب
  // قربها من تقويم جهاز الزائر الهجري. حقل start = 13 يبقى ترتيباً احتياطياً بلا JS.
  ramadan?: true;
};

const C = ar ? {
  eyebrow: 'مواسم الواحة',
  title: 'المهرجانات والفعاليات',
  lead: 'من سوق القيصرية إلى مزارع النخيل، تنبض الأحساء بمواسمَ تُحيي تراثها على مدار العام — احتفالاتٌ ومهرجاناتٌ تعود كلَّ سنةٍ في موسمها.',
  notice: 'تتكرّر هذه الفعاليات سنوياً في مواسمها التقريبية، وقد تختلف مواعيدها وتفاصيلها من عامٍ لآخر بحسب تنظيم كل نسخة. يُرجى التأكد من إعلانات الجهات المنظّمة والقنوات الرسمية قبل الزيارة.',
  placeK: 'الموقع',
  mapK: 'الخريطة ↗',
  orgK: 'الجهات المنظّمة',
  spanK: 'المدة التقريبية',
  actsK: 'أبرز الأنشطة',
  statusL: { confirmed: 'مؤكد هذا العام', expected: 'موسم متوقع', tba: 'بانتظار الإعلان' },
  nowBadge: 'نحن الآن هنا',
  orderNote: 'رُتِّبت البطاقات تلقائياً حسب الأقرب إلى تاريخ جهازك — تبدأ بما هو جارٍ الآن.',
  events: [
    {
      name: 'مهرجان البشت الحساوي', place: 'قصر إبراهيم التاريخي، الهفوف',
      season: 'الشتاء', time: 'ديسمبر تقريباً', span: 'أيامٌ معدودة', img: '/img/event-bisht', start: 12, end: 12,
      org: 'هيئة التراث (وزارة الثقافة)',
      acts: ['معرض البشت', 'ورش تعليم الحياكة', 'سوق البشوت التفاعلي', 'عروض فولكلورية'],
    },
    {
      name: 'ليالي القيصرية', place: 'سوق القيصرية التاريخي، الهفوف',
      season: 'أواخر الشتاء', time: 'فبراير – مارس', span: 'عدة أسابيع', img: '/img/event-qaisariyah-nights', start: 2, end: 3,
      org: 'أمانة الأحساء، هيئة تطوير الأحساء، هيئة التراث',
      acts: ['عروض فنون شعبية', 'جلسات مجتمعية', 'ألعاب تراثية', 'ورش حرفية'],
    },
    {
      name: 'ليالي كفو', place: 'منتزه الملك عبدالله البيئي، الهفوف',
      season: 'شهر رمضان المبارك', time: 'خلال شهر رمضان', span: 'ليالٍ رمضانية ممتدة', img: '/img/event-kafu-nights', start: 13, ramadan: true,
      org: 'جامعة الملك فيصل',
      acts: ['عروض مسرحية', 'منطقة الطفل', 'مطبخ كفو التفاعلي', 'عشاء «الغُبقة»'],
    },
    {
      name: 'مهرجان التمور المصنّعة', place: 'قلعة أمانة الأحساء، الهفوف',
      season: 'الشتاء', time: 'يناير – فبراير', span: 'عدة أسابيع', img: '/img/event-dates-festival', start: 1, end: 2,
      org: 'أمانة الأحساء، هيئة تطوير الأحساء',
      acts: ['جناح التذوق والتسوق', 'أجنحة المنتجات التحويلية', 'ورش ثقافية', 'مسابقات'],
    },
    {
      name: 'قرية النخيل', place: 'واحة الأحساء',
      season: 'الشتاء والربيع', time: 'يناير – مارس', span: 'موسم ممتد', img: '/img/event-palm-village', start: 1, end: 3,
      org: 'المركز الوطني للنخيل والتمور',
      acts: ['متاجر التمور', 'مطاعم ومقاهٍ محلية', 'أجنحة الحرفيين (الخوصيات)', 'تسويق المنتجات الريفية'],
    },
    {
      // موعد نسخة 2026 المعلن: 19 أغسطس – 5 سبتمبر (من إياد، 2026-07-22) — لذلك status: 'confirmed'.
      // عند انقضاء النسخة يعود الحقل إلى الموسم التقريبي «أغسطس – سبتمبر» بحالة 'expected'.
      name: 'معرض اللومي الحساوي', place: 'مركز الأحساء للمعارض',
      season: 'الصيف', time: '19 أغسطس – 5 سبتمبر 2026م', span: 'نحو 18 يوماً', img: '/img/event-lomi', start: 8, end: 9,
      status: 'confirmed',
      org: 'غرفة الأحساء',
      acts: ['معارض منتجات اللومي', 'الطهي الحي', 'ورش عمل زراعية', 'ركن الطفل', 'جلسات عائلية'],
    },
    {
      name: 'شتاء العقير', place: 'منتزه شاطئ العقير',
      season: 'الشتاء', time: 'ديسمبر – فبراير', span: 'عدة أسابيع', img: '/img/event-uqair-winter', start: 12, end: 2,
      org: 'هيئة تطوير الأحساء، أمانة الأحساء',
      acts: ['فعاليات بحرية ورياضية عائلية', 'ورش فنية حرفية', 'ألعاب ترفيهية'],
    },
    {
      // شتاء الوفرة: تجمع شتوي موسمي لعربات الطعام بإشراف أمانة الأحساء
      // (صحيفة اليوم 2024-11-22 وجريدة الوطن 2025-11-08) — أُضيف بطلب إياد 2026-07-13.
      name: 'شتاء الوفرة', place: 'حي الوفرة، جنوب الهفوف',
      // النافذة 11→2: البداية من حقل time («من نوفمبر تقريباً») والامتداد من
      // season «الشتاء» + span «موسم شتوي ممتد» — نهايته غير معلنة في المصدر.
      season: 'الشتاء', time: 'من نوفمبر تقريباً', span: 'موسم شتوي ممتد', img: '', start: 11, end: 2,
      org: 'ملاك ومستثمرون بإشراف أمانة الأحساء',
      acts: ['أكثر من 150 عربة طعام (فود ترك)', 'أكلات شعبية حساوية', 'جلسات شتوية مفتوحة'],
      map: 'https://maps.app.goo.gl/7MASkCUkw7JA4Hds8',
    },
    {
      name: 'موسم سباقات الخيل', place: 'ميدان الفروسية، الطرف',
      season: 'الشتاء', time: 'نوفمبر – فبراير', span: 'موسم ممتد', img: '/img/event-horse-racing', start: 11, end: 2,
      org: 'ميدان الفروسية بالأحساء',
      acts: ['سباقات الخيل', 'فعاليات الفروسية'],
    },
    {
      name: 'مهرجان الأحساء المبدعة', place: 'الفريج التراثي، قلعة الأمانة',
      season: 'الربيع', time: 'مارس – أبريل', span: 'نحو أسبوع', img: '/img/event-creative-ahsa', start: 3, end: 4,
      org: 'أمانة الأحساء',
      acts: ['صناعة الفخار', 'الخوصيات', 'النجارة التقليدية', 'فنون تشكيلية', 'عروض شعبية'],
    },
  ] as Ev[],
  notesH: 'قبل أن تحضر',
  notes: [
    { h: 'التوقيت', d: 'تتبع الفعاليات التقويمين الهجري والميلادي وتعود سنوياً في مواسمها التقريبية، وقد تختلف المواعيد الرسمية من عامٍ لآخر — تابع إعلانات كل نسخة.' },
    { h: 'التراث والإبداع', d: 'تسلّط المهرجانات الضوء على هوية الأحساء وتراثها عبر الملابس الشعبية والحرف اليدوية والمنتجات المحلية الأصيلة.' },
    { h: 'الأجواء العائلية', d: 'برامج تناسب جميع أفراد العائلة، بتركيزٍ على الترفيه والإبداع والتسوق والتذوق لكل الأعمار.' },
  ],
  srcNote: 'للمزيد من المعلومات والتحديثات، يُرجى متابعة أمانة الأحساء وهيئة تطوير الأحساء والقنوات الرسمية للفعاليات.',
  ctaH: 'اجعل موسمك رحلةً كاملة',
  ctaD: 'اربط زيارة المهرجان بمعالم الواحة القريبة منه، وجهّز مسارك في «رحلتي».',
  ctaBrowse: 'تصفّح المعالم',
  ctaPlan: 'خطّط لرحلتك',
  seoTitle: 'مهرجانات وفعاليات الأحساء — مواسم الواحة على مدار العام',
  seoDesc: 'دليل المهرجانات والفعاليات الموسمية في الأحساء: البشت الحساوي، ليالي القيصرية، ليالي كفو، مهرجان التمور، قرية النخيل، اللومي الحساوي، شتاء العقير، شتاء الوفرة، سباقات الخيل، والأحساء المبدعة — بمواسمها وأنشطتها وجهاتها المنظّمة.',
} : {
  eyebrow: 'Seasons of the oasis',
  title: 'Festivals & Events',
  lead: 'From Qaisariyah Souq to the palm groves, Al-Ahsa pulses with seasons that revive its heritage all year round — celebrations and festivals that return each year in their season.',
  notice: 'These events recur annually in their approximate seasons; official dates and details may vary from year to year with each edition. Please confirm via the organisers’ announcements and official channels before visiting.',
  placeK: 'Location',
  mapK: 'Map ↗',
  orgK: 'Organisers',
  spanK: 'Approximate length',
  actsK: 'Highlights',
  statusL: { confirmed: 'Confirmed this year', expected: 'Expected season', tba: 'Awaiting announcement' },
  nowBadge: 'You are here now',
  orderNote: 'The cards are ordered automatically by what is nearest to your device’s date — starting with whatever is under way now.',
  events: [
    {
      name: 'Hasawi Bisht Festival', place: 'Historic Ibrahim Palace, Hofuf',
      season: 'Winter', time: 'Around December', span: 'A few days', img: '/img/event-bisht', start: 12, end: 12,
      org: 'Heritage Commission (Ministry of Culture)',
      acts: ['Bisht exhibition', 'Weaving workshops', 'Interactive bisht souq', 'Folklore performances'],
    },
    {
      name: 'Qaisariyah Nights', place: 'Historic Qaisariyah Souq, Hofuf',
      season: 'Late winter', time: 'February – March', span: 'Several weeks', img: '/img/event-qaisariyah-nights', start: 2, end: 3,
      org: 'Al-Ahsa Municipality, Al-Ahsa Development Authority, Heritage Commission',
      acts: ['Folk arts shows', 'Community gatherings', 'Heritage games', 'Craft workshops'],
    },
    {
      name: 'Kafu Nights', place: 'King Abdullah Environmental Park, Hofuf',
      season: 'The holy month of Ramadan', time: 'During Ramadan', span: 'Extended Ramadan nights', img: '/img/event-kafu-nights', start: 13, ramadan: true,
      org: 'King Faisal University',
      acts: ['Theatre shows', 'Kids’ zone', 'Interactive Kafu kitchen', '“Ghabqa” dinner'],
    },
    {
      name: 'Processed Dates Festival', place: 'Al-Ahsa Municipality Fort, Hofuf',
      season: 'Winter', time: 'January – February', span: 'Several weeks', img: '/img/event-dates-festival', start: 1, end: 2,
      org: 'Al-Ahsa Municipality, Al-Ahsa Development Authority',
      acts: ['Tasting & shopping pavilion', 'Dates-product pavilions', 'Cultural workshops', 'Competitions'],
    },
    {
      name: 'Palm Village', place: 'Al-Ahsa Oasis',
      season: 'Winter & spring', time: 'January – March', span: 'An extended season', img: '/img/event-palm-village', start: 1, end: 3,
      org: 'National Center for Palms and Dates',
      acts: ['Date shops', 'Local restaurants & cafés', 'Artisan pavilions (palm-frond crafts)', 'Rural products market'],
    },
    {
      // 2026 edition announced: 19 August – 5 September (كما في النسخة العربية).
      name: 'Hasawi Lomi Exhibition', place: 'Al-Ahsa Expo Center',
      season: 'Summer', time: '19 August – 5 September 2026', span: 'About 18 days', img: '/img/event-lomi', start: 8, end: 9,
      status: 'confirmed',
      org: 'Al-Ahsa Chamber',
      acts: ['Lomi (dried lime) product shows', 'Live cooking', 'Agricultural workshops', 'Kids’ corner', 'Family sessions'],
    },
    {
      name: 'Al-Uqair Winter', place: 'Al-Uqair Beach Park',
      season: 'Winter', time: 'December – February', span: 'Several weeks', img: '/img/event-uqair-winter', start: 12, end: 2,
      org: 'Al-Ahsa Development Authority, Al-Ahsa Municipality',
      acts: ['Family sea & sports activities', 'Art & craft workshops', 'Fun games'],
    },
    {
      name: 'Al-Wafrah Winter', place: 'Al-Wafrah district, south Hofuf',
      // النافذة 11→2 كما في النسخة العربية (نهايتها غير معلنة في المصدر).
      season: 'Winter', time: 'From around November', span: 'An extended winter season', img: '', start: 11, end: 2,
      org: 'Private operators under Al-Ahsa Municipality supervision',
      acts: ['150+ food trucks', 'Hasawi folk dishes', 'Open-air winter gatherings'],
      map: 'https://maps.app.goo.gl/7MASkCUkw7JA4Hds8',
    },
    {
      name: 'Horse Racing Season', place: 'Al-Ahsa Equestrian Arena, Al-Taraf',
      season: 'Winter', time: 'November – February', span: 'An extended season', img: '/img/event-horse-racing', start: 11, end: 2,
      org: 'Al-Ahsa Equestrian Arena',
      acts: ['Horse races', 'Equestrian events'],
    },
    {
      name: 'Creative Al-Ahsa Festival', place: 'Heritage Freej, the Municipality Fort',
      season: 'Spring', time: 'March – April', span: 'About a week', img: '/img/event-creative-ahsa', start: 3, end: 4,
      org: 'Al-Ahsa Municipality',
      acts: ['Pottery making', 'Palm-frond crafts', 'Traditional carpentry', 'Fine arts', 'Folk performances'],
    },
  ] as Ev[],
  notesH: 'Before you go',
  notes: [
    { h: 'Timing', d: 'The events follow both the Hijri and Gregorian calendars and return annually in their approximate seasons; official dates can shift from year to year — follow each edition’s announcements.' },
    { h: 'Heritage & creativity', d: 'The festivals spotlight Al-Ahsa’s identity and heritage through folk dress, handicrafts and authentic local products.' },
    { h: 'Family atmosphere', d: 'Programmes suit the whole family, focused on entertainment, creativity, shopping and tasting for all ages.' },
  ],
  srcNote: 'For more information and updates, follow Al-Ahsa Municipality, the Al-Ahsa Development Authority and the events’ official channels.',
  ctaH: 'Turn your season into a full trip',
  ctaD: 'Pair the festival with the oasis sights around it, and build your route in “My Trip”.',
  ctaBrowse: 'Browse attractions',
  ctaPlan: 'Plan your trip',
  seoTitle: 'Al-Ahsa festivals & events — seasons of the oasis all year round',
  seoDesc: 'A guide to Al-Ahsa’s seasonal festivals and events: the Hasawi Bisht Festival, Qaisariyah Nights, Kafu Nights, the Processed Dates Festival, Palm Village, the Hasawi Lomi Exhibition, Al-Uqair Winter, Al-Wafrah Winter, the horse racing season and Creative Al-Ahsa — with their seasons, highlights and organisers.',
};

const browseHref = ar ? '/معالم/' : '/en/attractions/';
const planHref = ar ? '/خطط/' : '/en/plan-your-trip/';
const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: C.title, item: new URL(alt[lang], siteUrl).href },
  ] },
  // ItemList فقط — لا Event schema عمداً: جوجل يشترط startDate محدداً للأهلية،
  // ومواسمنا تقريبية بقرار محتوى ملزم (لا تواريخ دقيقة)، فأي startDate سيكون مختلقاً.
  { '@context': 'https://schema.org', '@type': 'ItemList',
    name: C.title, url: new URL(alt[lang], siteUrl).href,
    itemListElement: [...C.events].sort((a, b) => a.start - b.start).map((e, i) => ({
      '@type': 'ListItem', position: i + 1, name: e.name,
    })),
  },
];
---
<Base title={`${C.seoTitle} — ${t('site.name')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-events">
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="ev-hero on-dark">
      <HeroPoster src="/img/hero-events" class="evh-poster" />
      <video class="photo-bg evh-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source data-src="/video/hero-events.mp4" type="video/mp4" />
      </video>
      <PalmMotif size={320} class="evh-wm" aria-hidden="true" />
      <div class="container evh-in">
        <span class="eyebrow gold-on-dark">{C.eyebrow}</span>
        <h1 class="evh-title">{C.title}</h1>
        <p class="evh-sum">{C.lead}</p>
      </div>
    </section>

    <section class="sec" id="events">
      <div class="container">
        <p class="ev-notice" data-reveal>{C.notice}</p>
        {/* يظهر فقط بعد أن يعيد JS الترتيب فعلاً — بلا JS يبقى الترتيب تقويمياً ولا نَعِد بما لم يحدث */}
        <p class="ev-order-note" data-ev-order-note hidden>{C.orderNote}</p>

        <div class="ev-grid" data-ev-grid>
          {[...C.events].sort((a, b) => a.start - b.start).map((e, i) => (
            <article class="ev-card" data-reveal style={`transition-delay:${(i % 4) * 60}ms`}
              data-start={e.start} data-end={e.end ?? ''} data-ramadan={e.ramadan ? '1' : ''}>
              <div class="ev-media">
                <Photo src={e.img} label={e.name} class="ev-photo" eager={i < 2} sizes="(max-width: 760px) 100vw, (max-width: 1120px) 50vw, 360px" />
                <span class="ev-season">{e.season}</span>
                <span class={`ev-status ev-status--${e.status ?? 'expected'}`}>{C.statusL[e.status ?? 'expected']}</span>
                <span class="ev-now" data-ev-now hidden>{C.nowBadge}</span>
              </div>
              <div class="ev-body">
              <div class="ev-top">
                <span class="ev-time">
                  <svg class="ev-cal" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4.5" width="18" height="17" rx="2" />
                    <path d="M3 9h18M8 2.5v4M16 2.5v4" />
                  </svg>
                  {e.time}
                </span>
                <span class="ev-span">{e.span}</span>
              </div>
              <h2 class="ev-name">{e.name}</h2>
              <dl class="ev-meta">
                <div class="evm-row">
                  <dt class="evm-k">{C.placeK}</dt>
                  <dd class="evm-v">{e.place}{e.map && <> — <a class="evm-map" href={e.map} target="_blank" rel="noopener">{C.mapK}</a></>}</dd>
                </div>
                <div class="evm-row">
                  <dt class="evm-k">{C.orgK}</dt>
                  <dd class="evm-v">{e.org}</dd>
                </div>
              </dl>
              <h3 class="ev-acts-h">{C.actsK}</h3>
              <ul class="ev-acts">
                {e.acts.map((a) => <li class="ev-act">{a}</li>)}
              </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="notes">
      <div class="container">
