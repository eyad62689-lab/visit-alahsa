---
// صفحة «المطاعم والمقاهي» — 10 مطاعم + 10 مقاهٍ من قائمتَي إياد (2026-08-22).
// قاعدة ملزمة: لا تُختلق معلومة — الأسماء والصور وروابط الخرائط من ملفَي إياد
// (أفضل مطاعم الأحساء.docx وأفضل مقاهي الأحساء.docx)، والأحياء/العناوين من عناوين
// خرائط قوقل نفسها (تحقق HTTP فعلي 2026-08-22). لا مواعيد ولا أسعار ولا أوصاف حتى تُوثَّق.
// تصحيحان مثبتان من خرائط قوقل: «بيت الموت» في الملف = بيت الكوت، و«ريشيو الموت» = ريشيو الكوت.
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Photo from '../Photo.astro';
import PageHero from '../PageHero.astro';
import { RESTAURANTS_AR, RESTAURANTS_EN, CAFES_AR, CAFES_EN } from '../../data/dining';
import { localize, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

// التقييمات وأوقات العمل من Google Places API — يكتبها tools/fetch-places.mjs
// قبل البناء إن وُجد المفتاح. غيابها متوقَّع (بناء محلي بلا مفتاح) والصفحة
// تتدهور رشيقاً: لا صف تقييم ولا أوقات عمل ولا حالة إغلاق.
type Live = { rating: number | null; count: number | null; hoursAr: string[]; hoursEn: string[]; status: string | null };
// process.cwd() لا import.meta.url: الأخير يشير إلى الملف المُجمَّع وقت البناء
// فيفشل العثور على JSON بصمت. البناء يعمل دائماً من جذر astro-site.
const livePath = join(process.cwd(), 'src', 'data', 'places-live.json');
const liveRaw = existsSync(livePath) ? JSON.parse(readFileSync(livePath, 'utf8')) : null;
const live: Record<string, Live> = liveRaw?.places ?? {};
// شهر التحديث للعرض (أرقام لاتينية دائماً)
const fetchedDate = liveRaw ? new Date(liveRaw.fetchedAt) : null;
const fetchedLabel = fetchedDate
  ? fetchedDate.toLocaleDateString(ar ? 'ar-SA-u-nu-latn-ca-gregory' : 'en-GB', { month: 'long', year: 'numeric' })
  : null;
const liveFor = (img: string): Live | undefined => live[img.replace('/img/dining/', '')];


const C = localize(lang, {
  heroEyebrow: 'من موائد الأحساء',
  title: 'المطاعم والمقاهي',
  // مقدمة مُثراة بكلمات السيو المعتمدة (نتائج جيمني 2026-08-22 — مستندات العمل)
  // دون ادعاءات: التنوّع التراثي/العصري ملحوظ من القائمة نفسها.
  heroSum: 'دليلك إلى موائد الأحساء: مطاعم ومقاهٍ مختارة في الهفوف والمبرز — من الأجواء التراثية والأكل الشعبي إلى المطاعم العصرية والقهوة المختصة — لكلٍّ منها صورته وموقعه على خرائط قوقل، تصل إليه بضغطة واحدة. والقائمة تنمو تباعاً.',
  listEyebrow: 'الدفعة الأولى',
  listH: 'عشرة مطاعم مختارة',
  cafesEyebrow: 'وللقهوة أهلها',
  cafesH: 'عشرة مقاهٍ مختارة',
  openMaps: t('det.openMaps'),
  newWindow: '(يفتح في خرائط قوقل، نافذة جديدة)',
  hoursLabel: 'أوقات العمل',
  ratingLabel: 'التقييم في خرائط قوقل',
  searchPh: 'ابحث باسم المكان أو الحي…',
  searchLabel: 'ابحث في المطاعم والمقاهي',
  kindAria: 'تصفية بحسب النوع',
  kindRestaurants: 'مطاعم',
  kindCafes: 'مقاهٍ',
  districtLabel: 'الموقع',
  districtAll: 'كل المواقع',
  districtNames: {
    alkoot: 'حي الكوت', downtown: 'وسط الهفوف التاريخي', 'rafah-north': 'الرفعة الشمالية',
    khalidiyah: 'الخالدية', mazrou: 'المزروع', uwaimriyah: 'العويمرية',
    olaya: 'العليا', mubarraz: 'المبرز', unspecified: 'مواقع أخرى',
  } as Record<string, string>,
  countPrefix: 'المعروض: ',
  countSuffix: ' من 20',
  emptyMsg: 'لا نتائج مطابقة — جرّب توسيع البحث أو اختيار «كل المواقع».',
  closedPerm: 'مغلق نهائياً — بحسب خرائط قوقل',
  closedTemp: 'مغلق مؤقتاً — بحسب خرائط قوقل',
  srcNote: fetchedLabel ? `التقييمات وأوقات العمل من خرائط قوقل — آخر تحديث ${fetchedLabel}` : null,
  faqH: 'أسئلة شائعة عن مطاعم الأحساء',
  faqs: [
    { q: 'ما الأكلات الشعبية التي تشتهر بها الأحساء؟',
      a: 'تشتهر الأحساء بأطباق مثل الأرز الأحسائي والمندي والهريس وخبز التمر.',
      linkText: 'تعرّف عليها في صفحة المطبخ الأحسائي ←', linkHref: '/أكلات/' },
    { q: 'هل توجد مطاعم ومقاهٍ قريبة من قصر إبراهيم؟',
      a: 'نعم — في هذه القائمة اثنان: دار بسمة بجوار حديقة قصر إبراهيم، ومطعم فندق الكوت التراثي في حي الكوت مقابل القصر مباشرة. وكل بطاقة تحمل رابط موقعها على خرائط قوقل.' },
    { q: 'أين تقع المقاهي داخل الهفوف القديمة؟',
      a: 'في وسط الهفوف التاريخي وحي الرفعة الشمالية تجد: مقهى بيذانه، وبيت الكوت، ودار حويجة على شارع الملك فهد، ومقهى السيد، وريشيو الكوت على طريق الملك عبدالعزيز، و7st للقهوة المختصة.' },
    { q: 'أين آكل في المبرز؟',
      a: 'من هذه القائمة مكانان على طريق عين نجم بالمبرز: بيكنج أب، ومخبز ومقهى دوت. وبقية القائمة في الهفوف.' },
    { q: 'أين تقع مطاعم ومقاهي هذه القائمة؟',
      a: 'تتوزع بين الهفوف — حول حي الكوت التراثي ووسط الهفوف التاريخي وحيَّي الخالدية والرفعة الشمالية — والمبرز على طريق عين نجم، وكل بطاقة تحمل رابط موقعها الدقيق على خرائط قوقل.' },
    liveRaw
      ? { q: 'من أين تأتي التقييمات وأوقات العمل؟',
          a: `التقييمات وأوقات العمل مأخوذة من خرائط قوقل مباشرة (آخر تحديث ${fetchedLabel}) وقد تتغير — للتأكد من أحدث المعلومات افتح رابط خرائط قوقل لكل مكان. الأسعار لا تُعرض.` }
      : { q: 'هل تعرض الصفحة المواعيد والأسعار؟',
          a: 'لا — لا نعرض مواعيد أو أسعاراً أو تقييمات حتى تُوثَّق من مصادرها الرسمية. افتح رابط خرائط قوقل لكل مطعم للاطلاع على أحدث معلوماته.' },
  ],
  methodH: 'حول هذه الصفحة',
  methodP1: 'هذه قائمة أولية تنمو تباعاً. الأسماء والمواقع مأخوذة من خرائط قوقل مباشرة، والنبذات تعريفية موجزة تصف المكان كما يظهر في صورته — لا تقييماً ولا توصية بأصناف بعينها.',
  places: RESTAURANTS_AR,
  cafes: CAFES_AR,
}, {
  heroEyebrow: 'From the tables of Al-Ahsa',
  title: 'Restaurants & Cafés',
  // «Al Ahsa» و«Hofuf» بلا واصلة مقصودتان هنا — تغطية تهجئات البحث الإنجليزية
  heroSum: 'Your guide to dining in Al Ahsa: hand-picked restaurants and cafés across Hofuf and Al-Mubarraz — from heritage settings and traditional food to modern spots and specialty coffee — each with its photo and its place on Google Maps, one tap away. The list keeps growing.',
  listEyebrow: 'The first batch',
  listH: 'Ten hand-picked restaurants',
  cafesEyebrow: 'For the coffee lovers',
  cafesH: 'Ten hand-picked cafés',
  openMaps: t('det.openMaps'),
  newWindow: '(opens Google Maps in a new window)',
  hoursLabel: 'Opening hours',
  ratingLabel: 'Rating on Google Maps',
  searchPh: 'Search by name or area…',
  searchLabel: 'Search the restaurants and cafés',
  kindAria: 'Filter by type',
  kindRestaurants: 'Restaurants',
  kindCafes: 'Cafés',
  districtLabel: 'Area',
  districtAll: 'All areas',
  districtNames: {
    alkoot: 'Al-Koot district', downtown: 'Historic downtown Hofuf', 'rafah-north': 'Al-Raf‘ah North',
    khalidiyah: 'Al-Khalidiyah', mazrou: 'Al-Mazrou‘', uwaimriyah: 'Al-Uwaimriyah',
    olaya: 'Al-Olaya', mubarraz: 'Al-Mubarraz', unspecified: 'Other areas',
  },
  countPrefix: 'Showing ',
  countSuffix: ' of 20',
  emptyMsg: 'No matches — try a broader search or select “All areas”.',
  closedPerm: 'Permanently closed — according to Google Maps',
  closedTemp: 'Temporarily closed — according to Google Maps',
  srcNote: fetchedLabel ? `Ratings and opening hours from Google Maps — last updated ${fetchedLabel}` : null,
  faqH: 'Frequently asked questions about dining in Al Ahsa',
  faqs: [
    { q: 'What traditional dishes is Al Ahsa known for?',
      a: 'Al Ahsa is known for dishes such as Hasawi rice, mandi, harees and date bread.',
      linkText: 'Explore them on the Hasawi Cuisine page →', linkHref: '/en/food/' },
    { q: 'Are there restaurants or cafés near Qasr Ibrahim?',
      a: 'Yes — two on this list: Dar Basma, next to the Qasr Ibrahim park, and the Al-Koot Heritage Hotel Restaurant in the Al-Koot district directly opposite the fort. Each card links to its spot on Google Maps.' },
    { q: 'Where are the cafés inside old Hofuf?',
      a: 'In the historic downtown and Al-Raf‘ah North you will find: Baithana, Bait Al-Koot, Dar Huwaija on King Fahd Road, Al-Sayed Café, Ratio Al-Koot on King Abdulaziz Road, and 7st. Speciality Coffee.' },
    { q: 'Where can I eat in Al-Mubarraz?',
      a: 'Two places on this list sit on Ain Najm Road in Al-Mubarraz: Baking Up and Dot Bakery & Café. The rest of the list is in Hofuf.' },
    { q: 'Where are these restaurants and cafés located?',
      a: 'They are spread between Al Hofuf — around the historic Al-Koot district, the historic downtown, Al-Khalidiyah and Al-Raf‘ah North — and Al-Mubarraz along Ain Najm Road; each card links to the exact spot on Google Maps.' },
    liveRaw
      ? { q: 'Where do the ratings and opening hours come from?',
          a: `Ratings and opening hours come straight from Google Maps (last updated ${fetchedLabel}) and can change — check each place’s Google Maps link for the very latest details. Prices are not listed.` }
      : { q: 'Does this page list opening hours and prices?',
          a: 'No — we only publish opening hours, prices or ratings once they are verified from official sources. Use each restaurant’s Google Maps link for its latest details.' },
  ],
  methodH: 'About this page',
  methodP1: 'This is a first list that will keep growing. Names and locations come straight from Google Maps, and the blurbs are brief introductions describing each place as it appears in its photo — not reviews or dish recommendations.',
  places: RESTAURANTS_EN,
  cafes: CAFES_EN,
});

// قسما الصفحة يُصيَّران بحلقة واحدة — كانت الكتلة نفسها مكرّرة حرفياً مرتين
const SECTIONS = [
  { kind: 'restaurant', eyebrow: C.listEyebrow, h: C.listH, note: C.srcNote, list: C.places },
  { kind: 'cafe', eyebrow: C.cafesEyebrow, h: C.cafesH, note: null, list: C.cafes },
];

// خيارات فلتر الموقع: تُشتقّ من البيانات لا تُكتب يدوياً، فلا يتقادم الخيار ولا
// يظهر خيار بلا نتائج. الترتيب مثبَّت (الأقرب إلى قلب الهفوف أولاً) و«مواقع
// أخرى» آخراً لأنها ليست حيّاً بل غياب حيّ في عنوان قوقل.
const DISTRICT_ORDER = ['alkoot', 'downtown', 'rafah-north', 'khalidiyah', 'mazrou', 'uwaimriyah', 'olaya', 'mubarraz'];
const ALL_PLACES = [...C.places, ...C.cafes];
const districtKey = (d: string | null) => d ?? 'unspecified';
const districtCounts = ALL_PLACES.reduce<Record<string, number>>((acc, p) => {
  const k = districtKey(p.district); acc[k] = (acc[k] ?? 0) + 1; return acc;
}, {});
const districtOptions = [...DISTRICT_ORDER, 'unspecified']
  .filter((k) => districtCounts[k])
  .map((k) => ({ key: k, label: C.districtNames[k], count: districtCounts[k] }));
// نصّ البحث لكل بطاقة: الاسم والموقع بلغة الصفحة — يُبنى وقت البناء لا وقت التشغيل
const searchText = (p: (typeof ALL_PLACES)[number]) => `${p.name} ${p.area}`.toLowerCase();

// عنوان ووصف بكلمات السيو المعتمدة (≤60 و≤160 حرفاً) — بلا سنة حتى لا يتقادم
const pageTitle = ar
  ? 'مطاعم ومقاهي الأحساء — دليلك لتجارب الأكل في الهفوف'
  : 'Al Ahsa Restaurants & Cafés — Where to Eat in Hofuf';
const description = ar
  ? 'اكتشف أفضل مطاعم ومقاهي الأحساء في الهفوف والمبرز — من الأكل الشعبي والأجواء التراثية إلى القهوة المختصة، بالصور ومواقع خرائط قوقل المباشرة.'
  : 'Discover the best restaurants and cafés in Al Ahsa — from traditional Hasawi dining to specialty coffee, with photos and direct Google Maps locations.';

const siteUrl = 'https://visit-alahsa.com';
const selfPath = ar ? '/مطاعم-ومقاهي/' : '/en/restaurants-cafes/';
// ملاحظة ملزمة: لا يُصدَّر التقييم ولا عدد المراجعات في أي JSON-LD — بيانات
// قوقل تُعرض في الواجهة فقط (شروط قوقل + إرشادات المراجعات الذاتية). الحارس
// الآلي في tools/check-consistency.mjs (فحص C10) يُفشل البناء عند أي تسرّب.
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: C.title, item: new URL(selfPath, siteUrl).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: C.title, itemListElement:
    [...C.places.map((p) => ({ p, type: 'Restaurant' })), ...C.cafes.map((p) => ({ p, type: 'CafeOrCoffeeShop' }))]
      .map(({ p, type }, i) => ({ '@type': 'ListItem', position: i + 1, item: {
        '@type': type, name: p.name, hasMap: p.maps,
        image: new URL(`${p.img}.jpg`, siteUrl).href,
        address: { '@type': 'PostalAddress', addressRegion: ar ? 'الأحساء' : 'Al-Ahsa', addressCountry: 'SA' },
      } })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity:
    C.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: {
      '@type': 'Answer', text: f.linkText ? `${f.a} ${f.linkText.replace(/ [←→]$/, '')}` : f.a,
    } })),
  },
];
---
<Base title={pageTitle} description={description} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">

    <PageHero eyebrow={C.heroEyebrow} title={C.title} lead={C.heroSum} leadWidth={62} lang={lang} />

    <section class="container dn-list">
      <div class="dn-tools">
        <input class="dn-search" id="dn-search" type="search" autocomplete="off"
          placeholder={C.searchPh} aria-label={C.searchLabel} />
        <div class="chips" role="group" aria-label={C.kindAria} id="dn-kinds">
          <button class="chip is-active" type="button" data-kind="all" aria-pressed="true">{t('list.all')} <bdi>({ALL_PLACES.length})</bdi></button>
          <button class="chip" type="button" data-kind="restaurant" aria-pressed="false">{C.kindRestaurants} <bdi>({C.places.length})</bdi></button>
          <button class="chip" type="button" data-kind="cafe" aria-pressed="false">{C.kindCafes} <bdi>({C.cafes.length})</bdi></button>
        </div>
        {/* الموقع قائمة أصيلة لا شرائح: تسع قيم تفيض عن شريط الشرائح، و<select>
            يعطي دلالة ولوحة مفاتيح وسلوك جوال مجاناً */}
        <div class="dn-selwrap">
          <label class="dn-sel-l" for="dn-district">{C.districtLabel}</label>
          <select class="dn-select" id="dn-district">
            <option value="all">{C.districtAll} ({ALL_PLACES.length})</option>
            {districtOptions.map((o) => <option value={o.key}>{o.label} ({o.count})</option>)}
          </select>
        </div>
      </div>
      {/* العدّاد المرئي وإعلان قارئ الشاشة منفصلان عمداً: الأول مزخرف بالسياق
          والثاني نصّ صرف — ولو كانا عنصراً واحداً لتكرّر الإعلان */}
      <p class="dn-count" id="dn-count" aria-hidden="true"></p>
      <p class="sr-only" id="dn-status" role="status" data-empty={C.emptyMsg} data-prefix={C.countPrefix} data-suffix={C.countSuffix}></p>
      <p class="dn-empty" id="dn-empty" hidden>{C.emptyMsg}</p>

      {SECTIONS.map((sec, si) => (
        <div class="dn-sec" data-sec>
          <div class:list={['dn-head', { 'dn-head--cafes': si > 0 }]}>
            <span class="eyebrow">{sec.eyebrow}</span>
            <h2>{sec.h}</h2>
            {sec.note && <p class="dn-src">{sec.note}</p>}
          </div>

          <div class="dngrid">
            {sec.list.map((p, idx) => {
              const lv = liveFor(p.img);
              const hours = ar ? lv?.hoursAr : lv?.hoursEn;
              // «مغلق نهائياً» أخطر معلومة خاطئة ممكنة في دليل سياحي — تُعرض
              // فور ورودها من قوقل، لا تُبتلع كما كان الحقل مهملاً حتى 2026-08-30
              const closed = lv?.status === 'CLOSED_PERMANENTLY' ? C.closedPerm
                : lv?.status === 'CLOSED_TEMPORARILY' ? C.closedTemp : null;
              return (
                <article class="card card--lift place-card" data-reveal style={`transition-delay:${(idx % 3) * 60}ms`}
                  data-kind={sec.kind} data-district={districtKey(p.district)} data-q={searchText(p)}>
                  {/* البطاقة كلها هدف نقر واحد — رابط خارجي وحيد يغلّف المحتوى
                      غير التفاعلي. أوقات العمل <details> تبقى خارجه (عنصر تفاعلي
                      داخل رابط = تعشيش محظور). */}
                  <a class="pc-link" href={p.maps} target="_blank" rel="noopener">
                    <Photo src={p.img} label={p.alt} class="dn-photo" sizes="(max-width: 760px) 100vw, 33vw" />
                    <div class="pc-body">
                      <h3>{p.name}</h3>
                      <p class="pc-area">{p.area}</p>
                      {closed && <p class="pc-closed">{closed}</p>}
                      <p class="pc-blurb">{p.blurb}</p>
                      {lv?.rating && (
                        <p class="pc-rating"><span class="pc-star" aria-hidden="true">★</span>
                          <strong>{lv.rating.toFixed(1)}</strong>
                          {lv.count && <span class="pc-count">({lv.count.toLocaleString('en-US')})</span>}
                          <span class="sr-only">{C.ratingLabel}</span>
                        </p>
                      )}
                      <span class="pc-maps">
                        {C.openMaps}
                        <svg class="pc-ext" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                        <span class="sr-only">{C.newWindow}</span>
                      </span>
                    </div>
                  </a>
                  {hours && hours.length > 0 && (
                    <details class="pc-hours">
                      <summary>{C.hoursLabel}</summary>
                      <ul>{hours.map((h) => <li>{h}</li>)}</ul>
                    </details>
                  )}
                </article>
              );
            })}
          </div>
        </div>
      ))}
    </section>

    <section class="container dn-faq">
      <h2 class="faq-h">{C.faqH}</h2>
      <div class="faq-list">
        {C.faqs.map((f) => (
          <article class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a} {f.linkHref && <a href={f.linkHref}>{f.linkText}</a>}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container dn-method">
      <div class="method-box">
        <h2>{C.methodH}</h2>
        <p>{C.methodP1}</p>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Base>

<script is:inline>
  // تصفية الفهرس — تحسين تدريجي: بلا جافاسكربت تظهر المنشآت العشرون كلها،
  // وشريط الأدوات وحده يفقد أثره. النمط من FruitsView (شرائح + role="status").
  function initDiningFilter() {
    const search = document.getElementById('dn-search');
    const kinds = document.getElementById('dn-kinds');
    const sel = document.getElementById('dn-district');
    if (!search || !kinds || !sel || search.dataset.wired) return;
    search.dataset.wired = '1';

    const chips = kinds.querySelectorAll('.chip');
    const cards = document.querySelectorAll('.place-card');
    const secs = document.querySelectorAll('[data-sec]');
    const empty = document.getElementById('dn-empty');
    const status = document.getElementById('dn-status');
    const count = document.getElementById('dn-count');
    let kind = 'all';

    // سكربت الكشف في Base يستعمل IntersectionObserver ثم unobserve، فبطاقةٌ لم
    // تدخل الشاشة قطّ تبقى opacity:0 لو أظهرتها التصفية لاحقاً. عند أول تفاعل
    // نكشفها كلها — الحركة الأولى تكون قد أدّت غرضها.
    let revealed = false;
    function revealAll() {
      if (revealed) return; revealed = true;
      cards.forEach((c) => c.classList.add('in'));
    }

    function apply() {
      revealAll();
      const q = (search.value || '').trim().toLowerCase();
      const d = sel.value;
      let shown = 0;
      cards.forEach((card) => {
        const okKind = kind === 'all' || card.getAttribute('data-kind') === kind;
        const okDist = d === 'all' || card.getAttribute('data-district') === d;
        const okQ = !q || (card.getAttribute('data-q') || '').indexOf(q) !== -1;
        const ok = okKind && okDist && okQ;
        card.hidden = !ok; if (ok) shown++;
      });
      secs.forEach((s) => { s.hidden = !s.querySelector('.place-card:not([hidden])'); });
      if (empty) empty.hidden = shown !== 0;
      const isAll = kind === 'all' && d === 'all' && !q;
      if (count) count.textContent = isAll ? '' : (status.dataset.prefix || '') + shown + (status.dataset.suffix || '');
      if (status) status.textContent = shown === 0
        ? (status.dataset.empty || '')
        : (status.dataset.prefix || '') + shown + (status.dataset.suffix || '');
    }

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        kind = chip.getAttribute('data-kind');
        chips.forEach((c) => {
          c.classList.toggle('is-active', c === chip);
          c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
        });
        apply();
      });
    });
    search.addEventListener('input', apply);
    sel.addEventListener('change', apply);
  }
  document.addEventListener('astro:page-load', initDiningFilter);
  if (document.readyState !== 'loading') initDiningFilter(); else document.addEventListener('DOMContentLoaded', initDiningFilter);
</script>

