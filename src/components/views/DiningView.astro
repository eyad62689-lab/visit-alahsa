// مصدر الحقيقة الوحيد: مجموعة dining (هُجِّرت من data/dining.ts — 2026-08-30).
// عتبة الصفحة المفردة: متنٌ يعبر الحد ولا يكون نسخةً من النبذة. من لم يعبرها
// تبقى بطاقته ترتبط بخرائط قوقل مباشرةً — تدهور رشيق على سابقة title_zh.
const WORD_MIN_AR = 80;
const WORD_MIN_EN = 100;
const words = (t: string) => t.trim().split(/\s+/).filter(Boolean).length;
const diningEntries = (await getCollection('dining')).sort((a, b) => a.data.order - b.data.order);
const toPlace = (e: (typeof diningEntries)[number]) => {
  const d = e.data;
  const bodyAr = (e.body ?? '').trim();
  const passesAr = words(bodyAr) >= WORD_MIN_AR && bodyAr !== d.blurb;
  const passesEn = words(d.body_en) >= WORD_MIN_EN && d.body_en.trim() !== d.blurb_en;
  const hasPage = ar ? passesAr : passesEn;
  return {
    img: d.img, maps: d.maps, district: d.district,
    // الاسم لا يُترجم للصينية (يبقى كما تسمّي المنشأة نفسها)؛ النبذة والموقع والنص البديل
    // من الحقول *_zh (الدفعة 14 — 2026-09-03) بتراجع للإنجليزية عند غيابها.
    name: ar ? d.name : d.name_en,
    area: ar ? d.area : zh ? (d.area_zh ?? d.area_en) : d.area_en,
    alt: ar ? d.alt : zh ? (d.alt_zh ?? d.alt_en) : d.alt_en,
    blurb: ar ? d.blurb : zh ? (d.blurb_zh ?? d.blurb_en) : d.blurb_en,
    // الصينية تتراجع للإنجليزية: صفحات المنشآت المفردة بلا نسخة صينية بعد
    href: hasPage ? diningHref(d, zh ? 'en' : lang) : d.maps,
    internal: hasPage,
  };
};
const RESTAURANTS = diningEntries.filter((e) => e.data.kind === 'restaurant').map(toPlace);
const CAFES = diningEntries.filter((e) => e.data.kind === 'cafe').map(toPlace);
// المخابز التقليدية (دفعة 2026-09-01): نوعٌ ثالث لا مطعمٌ ولا مقهى — مخبز
// الخبز الأحمر الحساوي (خبز التمر) يُقصد للشراء لا للجلوس.
const BAKERIES = diningEntries.filter((e) => e.data.kind === 'bakery').map(toPlace);


