    { ...P.alsayed, name: 'Al-Sayed Café', area: 'Al-Raf‘ah North — Al-Hofuf', alt: 'The heritage interior of Al-Sayed Café with its wooden ceiling',
      blurb: 'A heritage interior with a wooden ceiling that keeps the feel of the old coffeehouses.' },
    { ...P.ratio, name: 'Ratio Al-Koot', area: 'King Abdulaziz Road — historic downtown Al-Hofuf', alt: 'A traditional majlis with cushions and rugs beneath a palm-trunk ceiling at Ratio Al-Koot',
      blurb: 'An Arabian majlis of cushions and rugs beneath a palm-trunk ceiling.' },
    { ...P.soulaf, name: 'Soulaf Coffee', area: 'King Abdullah Road — Al-Hofuf', alt: 'Soulaf Coffee’s modern interior with an olive tree and slatted ceiling',
      blurb: 'A calm, modern interior centred on an olive tree beneath a skylight.' },
    { ...P.bakingUp, name: 'Baking Up', area: 'Ain Najm Road — Al-Mubarraz', alt: 'Baking Up’s storefront with umbrellas and outdoor seating',
      blurb: 'Bakes and crunchy treats — as it calls itself on Google Maps — behind a cheerful storefront.' },
    { ...P.dot, name: 'Dot Bakery & Café', area: 'Ain Najm Road — Al-Mubarraz', alt: 'The order counter and pastry display at Dot Bakery & Café',
      blurb: 'Bakery and café in one: a fresh-pastry display with a blue-accented order counter.' },
    { ...P.raslan, name: 'Karak Raslan', area: 'Al-Khaleej Road', alt: 'Cups of karak on a wooden tray with breakfast dishes at Karak Raslan',
      blurb: 'Karak poured into small cups alongside simple breakfast bites.' },
  ] as Place[],
};

// عنوان ووصف بكلمات السيو المعتمدة (≤60 و≤160 حرفاً) — بلا سنة حتى لا يتقادم
const pageTitle = ar
  ? 'مطاعم ومقاهي الأحساء — دليلك لتجارب الأكل في الهفوف'
  : 'Al Ahsa Restaurants & Cafés — Where to Eat in Hofuf';
const description = ar
  ? 'اكتشف أفضل مطاعم ومقاهي الأحساء في الهفوف والمبرز — من الأكل الشعبي والأجواء التراثية إلى القهوة المختصة، بالصور ومواقع خرائط قوقل المباشرة.'
  : 'Discover the best restaurants and cafés in Al Ahsa — from traditional Hasawi dining to specialty coffee, with photos and direct Google Maps locations.';

const siteUrl = 'https://visit-alahsa.com';
const selfPath = ar ? '/مطاعم-ومقاهي/' : '/en/restaurants-cafes/';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: C.title, item: new URL(selfPath, siteUrl).href },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: C.title, itemListElement:
    [...C.places.map((p) => ({ p, type: 'Restaurant' })), ...C.cafes.map((p) => ({ p, type: 'CafeOrCoffeeShop' }))]
      .map(({ p, type }, i) => ({ '@type': 'ListItem', position: i + 1, item: {
        '@type': type, name: p.name, hasMap: p.maps,
        image: new URL(`${p.img}.jpg`, siteUrl).href,
        address: { '@type': 'PostalAddress', addressRegion: ar ? 'الأحساء' : 'Al-Ahsa', addressCountry: 'SA' },
      } })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity:
    C.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: {
      '@type': 'Answer', text: f.linkText ? `${f.a} ${f.linkText.replace(/ [←→]$/, '')}` : f.a,
    } })),
  },
];
---
<Base title={pageTitle} description={description} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">

    <section class="dn-hero on-dark">
      <PalmMotif size={320} class="dnh-wm" />
      <div class="container dnh-in">
        <span class="eyebrow gold-on-dark">{C.heroEyebrow}</span>
        <h1 class="dnh-title">{C.title}</h1>
        <p class="dnh-sum">{C.heroSum}</p>
      </div>
    </section>

    <section class="container dn-list">
      <div class="dn-head">
        <span class="eyebrow">{C.listEyebrow}</span>
        <h2>{C.listH}</h2>
        {C.srcNote && <p class="dn-src">{C.srcNote}</p>}
      </div>

      <div class="dngrid">
        {C.places.map((p, idx) => { const lv = liveFor(p.img); const hours = ar ? lv?.hoursAr : lv?.hoursEn; return (
          <article class="place-card" data-reveal style={`transition-delay:${(idx % 3) * 60}ms`}>
            <Photo src={p.img} label={p.alt} class="dn-photo" sizes="(max-width: 760px) 100vw, 33vw" />
            <div class="pc-body">
              <h3>{p.name}</h3>
              <p class="pc-area">{p.area}</p>
              <p class="pc-blurb">{p.blurb}</p>
              {lv?.rating && (
                <p class="pc-rating"><span class="pc-star" aria-hidden="true">★</span>
                  <strong>{lv.rating.toFixed(1)}</strong>
                  {lv.count && <span class="pc-count">({lv.count.toLocaleString('en-US')})</span>}
                  <span class="visually-hidden">{C.ratingLabel}</span>
                </p>
              )}
              {hours && hours.length > 0 && (
                <details class="pc-hours">
                  <summary>{C.hoursLabel}</summary>
                  <ul>{hours.map((h) => <li>{h}</li>)}</ul>
                </details>
              )}
              <a class="pc-maps" href={p.maps} target="_blank" rel="noopener">{C.openMaps}</a>
            </div>
          </article>
        ); })}
      </div>

      <div class="dn-head dn-head--cafes">
        <span class="eyebrow">{C.cafesEyebrow}</span>
        <h2>{C.cafesH}</h2>
      </div>

      <div class="dngrid">
        {C.cafes.map((p, idx) => { const lv = liveFor(p.img); const hours = ar ? lv?.hoursAr : lv?.hoursEn; return (
          <article class="place-card" data-reveal style={`transition-delay:${(idx % 3) * 60}ms`}>
            <Photo src={p.img} label={p.alt} class="dn-photo" sizes="(max-width: 760px) 100vw, 33vw" />
            <div class="pc-body">
              <h3>{p.name}</h3>
              <p class="pc-area">{p.area}</p>
              <p class="pc-blurb">{p.blurb}</p>
              {lv?.rating && (
                <p class="pc-rating"><span class="pc-star" aria-hidden="true">★</span>
                  <strong>{lv.rating.toFixed(1)}</strong>
                  {lv.count && <span class="pc-count">({lv.count.toLocaleString('en-US')})</span>}
                  <span class="visually-hidden">{C.ratingLabel}</span>
                </p>
              )}
              {hours && hours.length > 0 && (
                <details class="pc-hours">
                  <summary>{C.hoursLabel}</summary>
                  <ul>{hours.map((h) => <li>{h}</li>)}</ul>
                </details>
              )}
              <a class="pc-maps" href={p.maps} target="_blank" rel="noopener">{C.openMaps}</a>
            </div>
          </article>
        ); })}
      </div>
    </section>

    <section class="container dn-faq">
      <h2 class="faq-h">{C.faqH}</h2>
      <div class="faq-list">
        {C.faqs.map((f) => (
          <article class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a} {f.linkHref && <a href={f.linkHref}>{f.linkText}</a>}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container dn-method">
      <div class="method-box">
        <h2>{C.methodH}</h2>
        <p>{C.methodP1}</p>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Base>

<style>
  /* ═══ الهيرو — لوني بلا صورة (لا أصل هيرو موثّق بعد) ═══ */
  .dn-hero { position: relative; overflow: hidden; background: var(--c-turq-deep); padding-block: var(--s-8) var(--s-7); }
  :global(.dnh-wm) { position: absolute; inset-block-start: -10%; inset-inline-end: -5%; z-index: 0; color: var(--c-gold); opacity: .1; }
  .dnh-in { position: relative; z-index: 2; }
  .dnh-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .dnh-sum { font-size: var(--t-lg); color: rgba(247,243,234,.9); max-inline-size: 62ch; }

  /* ═══ شبكة المطاعم ═══ */
  .dn-list { padding-block: var(--s-6) var(--s-8); }
  .dn-head { margin-block-end: var(--s-6); }
  .dn-head h2 { font-size: var(--t-2xl); margin-block-start: var(--s-2); }
  .dn-head--cafes { margin-block-start: var(--s-7); }
  .dngrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }

  .dn-src { margin-block-start: var(--s-2); font-size: var(--t-xs); color: var(--c-ink-soft); }

  .place-card { background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .pc-body { padding: var(--s-3) var(--s-4) var(--s-5); display: flex; flex-direction: column; gap: var(--s-2); }
  .place-card h3 { font-size: var(--t-lg); color: var(--c-turq-deep); }
  .pc-area { font-size: var(--t-xs); color: var(--c-gold-deep); }
  .pc-blurb { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }

  /* صف التقييم — النجمة ذهبية والأرقام لاتينية دائماً */
  .pc-rating { display: flex; align-items: center; gap: 6px; font-size: var(--t-sm); color: var(--c-ink); }
  .pc-star { color: var(--c-gold-deep); }
  .pc-count { color: var(--c-ink-soft); font-size: var(--t-xs); }

  /* أوقات العمل — مطوية افتراضياً كي لا تُطيل البطاقة */
  .pc-hours { font-size: var(--t-xs); color: var(--c-ink-soft); }
  .pc-hours summary { cursor: pointer; font-weight: 600; color: var(--c-turq-deep); padding-block: 2px; }
  .pc-hours summary:hover { color: var(--c-turq); }
  .pc-hours ul { list-style: none; padding: var(--s-2) 0 0; display: flex; flex-direction: column; gap: 4px; }

  .visually-hidden { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .pc-maps { align-self: start; margin-block-start: auto; display: inline-flex; align-items: center; min-block-size: 44px; font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-turq-deep); background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: 999px; padding: 6px 14px; text-decoration: none; transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .pc-maps:hover { border-color: var(--c-turq); color: var(--c-turq); }

  /* الصور عمودية في معظمها — قصّ موحّد 4:5 يضبط إيقاع الشبكة */
  :global(.dn-photo) { aspect-ratio: 4 / 5; }
  :global(.dn-photo img) { inline-size: 100%; block-size: 100%; object-fit: cover; }
  /* بلا طبقة الظل الفيروزية العامة — تُغبّش صور الواجهات الليلية */
  :global(picture.dn-photo)::after { content: none; }

  /* ═══ الأسئلة الشائعة ═══ */
  .dn-faq { padding-block: 0 var(--s-7); }
  .faq-h { font-size: var(--t-xl); margin-block-end: var(--s-4); }
  .faq-list { display: grid; gap: var(--s-3); max-inline-size: 78ch; }
  .faq-item { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); }
  .faq-item h3 { font-size: var(--t-lg); color: var(--c-turq-deep); margin-block-end: var(--s-2); }
  .faq-item p { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.8; }
  .faq-item a { color: var(--c-turq-deep); font-weight: 600; text-decoration: none; }
  .faq-item a:hover { color: var(--c-turq); }

  /* ═══ الملاحظة ═══ */
  .dn-method { padding-block: 0 var(--s-7); }
  .method-box { background: #fff; border-inline-start: 4px solid var(--c-gold); border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); max-inline-size: 78ch; }
  .method-box h2 { font-size: var(--t-lg); margin-block-end: var(--s-2); }
  .method-box p { font-size: var(--t-sm); color: var(--c-ink-soft); }
</style>
