---
// صفحة «أسواق المزارعين» — الأسواق التي ثبت قيامها (عربي/إنجليزي فقط كأدوات السفر).
// النصوص والأسواق في src/data/farmers-markets.ts؛ التقييم والأوقات من بيانات قوقل الحية
// (lib/places-live.ts) وتسقط رشيقاً حين يغيب الملف — لا يُكتب موعد ثابت.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import OpenNowBadge from '../OpenNowBadge.astro';
import { titleSep, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import { MARKETS_ALT } from '../../lib/routes';
import { breadcrumb } from '../../lib/schema';
import { loadLive, hoursFor, hoursData, fetchedLabel } from '../../lib/places-live';
import { MARKETS, PAGE, mapsUrl, type MarketsLang } from '../../data/farmers-markets';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const L: MarketsLang = lang === 'ar' ? 'ar' : 'en';
const ar = L === 'ar';
const t = useTranslations(lang);
const C = PAGE[L];
const selfPath = MARKETS_ALT[L];
const fetched = fetchedLabel(lang);
const openTxt = ar ? 'مفتوح الآن' : 'Open now';
const shutTxt = ar ? 'مغلق الآن' : 'Closed now';

const cards = MARKETS.map((m) => {
  const lv = loadLive()?.places?.[m.slug];
  return {
    m, lv,
    hours: hoursFor(lv, lang),
    hd: hoursData(lv),
    closed: lv?.status === 'CLOSED_PERMANENTLY' ? C.closedPerm : lv?.status === 'CLOSED_TEMPORARILY' ? C.closedTemp : null,
  };
});

// لا يُصدَّر التقييم ولا عدد المراجعات في JSON-LD (الحارس C10).
const jsonLd = [
  breadcrumb([
    { name: t('crumb.home'), path: ar ? '/' : '/en/' },
    { name: t('nav.markets'), path: selfPath },
  ]),
  { '@context': 'https://schema.org', '@type': 'ItemList', name: t('nav.markets'), itemListElement:
    MARKETS.map((m, i) => ({ '@type': 'ListItem', position: i + 1, item: {
      '@type': 'Place', name: m.name[L], hasMap: mapsUrl(m),
      address: { '@type': 'PostalAddress', addressLocality: m.area[L], addressRegion: ar ? 'الأحساء' : 'Al-Ahsa', addressCountry: 'SA' },
    } })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity:
    C.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={`${C.seoTitle} ${titleSep(lang)} ${t('site.brand')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={C.eyebrow} title={t('nav.markets')} lead={C.lead} leadWidth={60} motif="center" size="compact" lang={lang} />

    <section class="container fm">
      <div class="fm-head">
        <h2>{C.listH}</h2>
        <p class="fm-src">{C.hoursNote}{fetched && <> {C.fetched(fetched)}</>}</p>
      </div>

      <div class="fm-grid">
        {cards.map(({ m, lv, hours, hd, closed }, idx) => (
          <article class="card fm-card" data-reveal style={`transition-delay:${(idx % 3) * 60}ms`} {...(hd ? { 'data-hours': hd } : {})}>
            <div class="fm-body">
              <div class="fm-top">
                <span class="eyebrow">{C.kinds[m.kind]}</span>
                {hd && <span class="fm-open" data-open={openTxt} data-shut={shutTxt} hidden></span>}
              </div>
              <h3>{m.name[L]}</h3>
              <p class="fm-area">{m.area[L]}</p>
              {closed && <p class="fm-closed">{closed}</p>}
              <p class="fm-blurb">{m.blurb[L]}</p>
              {lv?.rating && (
                <p class="fm-rating"><span class="fm-star" aria-hidden="true">★</span>
                  <strong>{lv.rating.toFixed(1)}</strong>
                  {lv.count && <span class="fm-count">({lv.count.toLocaleString('en-US')})</span>}
                  <span class="sr-only">{C.ratingLabel}</span>
                </p>
              )}
              {hours && (
                <details class="fm-hours">
                  <summary>{C.hoursSum}</summary>
                  <ul>{hours.map((h) => <li>{h}</li>)}</ul>
                </details>
              )}
            </div>
            <div class="fm-actions">
              <a class="fm-act" href={mapsUrl(m)} target="_blank" rel="noopener" data-track="outbound_click" data-track-kind="market_map" data-track-item-id={m.slug}>
                {C.openMaps}
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
                </svg>
                <span class="sr-only">{C.newWindow}</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <section class="fm-tips">
        <h2>{C.tipsH}</h2>
        <ol>
          {C.tips.map(([h, p]) => <li><h3>{h}</h3><p>{p}</p></li>)}
        </ol>
      </section>

      <section class="fm-faq">
        <h2>{C.faqH}</h2>
        <dl>
          {C.faqs.map((f) => (
            <>
              <dt>{f.q}</dt>
              <dd>{f.a} <a href={f.linkHref} {...('external' in f && f.external ? { target: '_blank', rel: 'noopener' } : {})}>{f.linkText}</a></dd>
            </>
          ))}
        </dl>
      </section>

      <aside class="fm-note">
        <h2>{C.methodH}</h2>
        <p>{C.methodP}</p>
      </aside>
    </section>
  </main>
  <Footer lang={lang} />
  {cards.some((c) => c.hd) && <OpenNowBadge />}
</Base>

<style>
  .fm { padding-block: var(--s-6) var(--s-8); }
  .fm-head { margin-block-end: var(--s-6); }
  .fm-head h2 { font-size: var(--t-2xl); }
  .fm-src { margin-block-start: var(--s-2); font-size: var(--t-xs); color: var(--c-ink-soft); }
  .fm-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }

  /* القشرة من card الموحّد في global.css؛ البطاقة بلا صورة فيحملها شريط ذهبي أعلاها */
  .fm-card { display: flex; flex-direction: column; border-block-start: 3px solid var(--c-gold); }
  .fm-body { padding: var(--s-4) var(--s-4) var(--s-3); display: flex; flex-direction: column; flex: 1; gap: var(--s-2); }
  .fm-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); }
  .fm-open { font-size: var(--t-xs); font-weight: 600; color: var(--c-turq-deep); }
  .fm-card h3 { font-size: var(--t-lg); color: var(--c-turq-deep); }
  .fm-area { font-size: var(--t-xs); color: var(--c-gold-deep); }
  .fm-blurb { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }
  .fm-closed { font-size: var(--t-xs); font-weight: 700; color: var(--c-gold-deep); background: var(--c-sand-2); border-inline-start: 3px solid var(--c-gold); border-radius: var(--radius-sm); padding: 6px 10px; }
  .fm-rating { display: flex; align-items: center; gap: 6px; font-size: var(--t-sm); }
  .fm-star { color: var(--c-gold-deep); }
  .fm-count { color: var(--c-ink-soft); font-size: var(--t-xs); }
  .fm-hours summary { cursor: pointer; min-block-size: 44px; display: flex; align-items: center; font-size: var(--t-xs); font-weight: 600; color: var(--c-turq-deep); }
  .fm-hours ul { list-style: none; padding: 0; margin: 0; font-size: var(--t-xs); color: var(--c-ink-soft); line-height: 1.8; }
  .fm-actions { margin-block-start: auto; padding: 0 var(--s-4) var(--s-4); }
  .fm-act { display: inline-flex; align-items: center; gap: 6px; min-block-size: 44px; padding: 0 var(--s-3); border: 1px solid var(--c-turq-deep); border-radius: var(--radius-sm); font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-turq-deep); text-decoration: none; }
  .fm-act:hover { background: var(--c-turq-deep); color: #fff; }
  .fm-act:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 2px; }

  .fm-tips { margin-block-start: var(--s-7); }
  .fm-tips h2, .fm-faq h2 { font-size: var(--t-2xl); margin-block-end: var(--s-4); }
  .fm-tips ol { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: var(--s-4); }
  .fm-tips li { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4); }
  .fm-tips h3 { font-size: var(--t-base); color: var(--c-turq-deep); margin-block-end: var(--s-2); }
  .fm-tips p { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }

  .fm-faq { margin-block-start: var(--s-7); }
  .fm-faq dt { font-family: var(--font-body); font-weight: 700; font-size: var(--t-base); color: var(--c-turq-deep); margin-block-start: var(--s-4); }
  .fm-faq dd { margin: var(--s-2) 0 0; font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.85; }
  .fm-faq dd a { color: var(--c-turq-deep); font-weight: 600; }

  .fm-note { margin-block-start: var(--s-7); background: #fff; border-inline-start: 4px solid var(--c-gold); border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); }
  .fm-note h2 { font-size: var(--t-lg); margin-block-end: var(--s-2); }
  .fm-note p { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.85; }
</style>
