---
// صفحة المسار المقترح — /trails/<slug>/ بلغاته الخمس (zh/de/ru تحت بادئة لغتها).
//
// النصوص كلها من src/data/trails.json حرفياً (ملف المالك المدقَّق)، وzh/de/ru من ملفات خطوط
// الترجمة (trails.<lang>.json) حرفياً — لا مسافات ولا مواعيد
// ولا رسوم في متن المسار (editorialRules): البيان التشغيلي في صفحة المعلم، ورابطها تحت
// كل محطة مطابَقة. شارة اليونسكو حيث unesco: true وحده، وملاحظتها مرة واحدة في الصفحة.
// الإسناد (meta.attribution) في ذيل الصفحة إلزامي — والكل يحرسه C27 على dist.
//
// الخريطة: محطات المسار المرتبطة بمعلم فقط، بإحداثيات المعلم المخزّنة (location) —
// لا دبوس ولا إحداثيات مختلَقة لمحطة بلا معلم. Leaflet المستضاف ذاتياً وبلاطات OSM
// القياسية بلا مفتاح (نمط MapView بعد #79).
//
// أدوات المسار: صورة المحطة من heroImage معلمها (لا صورة لمحطة بلا معلم)، ورابط الاتجاهات
// في خرائط قوقل بمحطات الخريطة نفسها وبترتيبها (سيراً لمسار المشي وبالسيارة لغيره)، وزر
// المشاركة — بكل اللغات لأن نصوصها في قواميسها. وضع الجولة وعلامة «زرتُ» والتقدّم والطباعة
// تظهر في لغة يحمل قاموسها مفاتيحها كلها (TOOL_KEYS) بلا تراجع إلى الإنجليزية — لغة جديدة لا
// تراها حتى تمرّ نصوصها بخطها — ومخفية حتى يعمل السكربت. التقدّم في localStorage للمتصفح وحده،
// ووضع الجولة ينسخ محطات القائمة نفسها إلى نافذة حوار فلا نص مكرّر في HTML.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import Photo from '../Photo.astro';
import ShareButton from '../ShareButton.astro';
import { altHref, titleSep, useTranslations, type AltLinks, isRtl } from '../../i18n/utils';
import { ui } from '../../i18n/ui';
import { TRAIL_SOURCES, sourceTitle, stopText, trailAttribution, trailText, trailUnescoNote, type Trail } from '../../data/trails';
import { stopAttraction, trailsIndexHref, type TrailLang } from '../../lib/trails';
import { attractionHref } from '../../lib/routes';
import { absUrl, breadcrumb } from '../../lib/schema';

interface Props { trail: Trail; lang: TrailLang; alt: AltLinks; }
const { trail, lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
// اتجاه الأسهم من اتجاه الصفحة لا من كونها عربية
const rtl = isRtl(lang);
const tx = trailText(trail, lang);
const homeHref = ar ? '/' : `/${lang}/`;
const all = await getCollection('attractions');

// نصّ الحديث في محطة جواثا مضمَّن وسط الجملة بين «…»: يُعزل في <q> بلا أي تغيير في
// المحارف (quotes: none فلا يضيف المتصفح علامات تنصيص) — المقطع الذي يحمل التشكيل وحده.
// الحارس: الأجزاء مجموعةً تساوي النص الأصلي بايتاً ببايت وإلا فشل البناء.
// التشكيل: الفتحتان حتى السكون (U+064B–U+0652) — بأرقام المحارف لا بمحارفها المركّبة غير المرئية
const hasHarakat = (s: string) => [...s].some((c) => c.charCodeAt(0) >= 0x64b && c.charCodeAt(0) <= 0x652);
const splitQuote = (text: string): [string, string, string] | null => {
  const m = text.match(/«[^»]*»/g)?.find(hasHarakat);
  if (!m) return null;
  const i = text.indexOf(m);
  const parts: [string, string, string] = [text.slice(0, i), m, text.slice(i + m.length)];
  if (parts.join('') !== text) throw new Error(`عزل الاقتباس غيّر نص المحطة: ${text.slice(0, 40)}…`);
  return parts;
};

const stops = trail.stops.map((s, i) => {
  const att = stopAttraction(s, all);
  const st = stopText(trail, s, lang);
  return {
    n: i + 1,
    key: s.key,
    name: st.name,
    text: st.text,
    teaser: st.teaser,
    quote: splitQuote(st.text),
    unesco: s.unesco,
    href: att ? attractionHref(att.data, lang) : undefined,
    loc: att?.data.location,
    img: att?.data.heroImage,
    sources: s.sources.map((k) => ({ key: k, url: TRAIL_SOURCES[k].url, title: sourceTitle(k, lang) })),
  };
});
const pins = stops.filter((s) => s.loc && s.href).map((s) => ({ n: s.n, name: s.name, href: s.href!, lat: s.loc!.lat, lng: s.loc!.lng }));
const unescoCount = stops.filter((s) => s.unesco).length;
const idxHref = trailsIndexHref(lang);
const labels = { landmark: t('trails.landmark'), stop: t('trails.stop') };

const TOOL_KEYS = [
  'trails.toolsH', 'trails.tour.start', 'trails.tour.of', 'trails.tour.prev', 'trails.tour.next', 'trails.tour.finish',
  'trails.tour.close', 'trails.visited', 'trails.progress', 'trails.progressReset', 'trails.progressNote', 'trails.print',
] as const;
const tools = TOOL_KEYS.every((k) => Object.hasOwn(ui[lang], k));
// العنوان الافتتاحي والنصيحة وسطر المحطة: في لغة تحمل نصوصها (trails*.json) وعنوان النصيحة في قاموسها
const guide = Boolean(tx.hook && tx.tip) && Object.hasOwn(ui[lang], 'trails.tip');
// خرائط قوقل: الأولى منطلقاً والأخيرة وجهة وما بينهما محطات وسيطة — بترتيب المسار
const ll = (p: { lat: number; lng: number }) => `${p.lat},${p.lng}`;
const dirUrl = (() => {
  if (!pins.length) return undefined;
  const q = new URLSearchParams({ api: '1', destination: ll(pins[pins.length - 1]), travelmode: trail.mode === 'walking' ? 'walking' : 'driving' });
  if (pins.length > 1) q.set('origin', ll(pins[0]));
  if (pins.length > 2) q.set('waypoints', pins.slice(1, -1).map(ll).join('|'));
  return `https://www.google.com/maps/dir/?${q}`;
})();
const tourText = tools ? {
  of: t('trails.tour.of'), next: t('trails.tour.next'), finish: t('trails.tour.finish'), progress: t('trails.progress'),
} : undefined;

const pageUrl = absUrl(altHref(alt, lang));
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'TouristTrip',
    name: tx.title,
    description: tx.intro,
    url: pageUrl,
    inLanguage: lang,
    itinerary: {
      '@type': 'ItemList',
      numberOfItems: stops.length,
      itemListElement: stops.map((s) => ({
        '@type': 'ListItem',
        position: s.n,
        item: {
          '@type': 'TouristAttraction',
          name: s.name,
          ...(s.href ? { url: absUrl(s.href) } : {}),
        },
      })),
    },
  },
  breadcrumb([
    { name: t('crumb.home'), path: homeHref },
    { name: t('trails.title'), path: idxHref },
    { name: tx.title, path: altHref(alt, lang) },
  ]),
];
---
<Base title={`${tx.title} ${titleSep(lang)} ${t('site.brand')}`} description={tx.tagline} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={t('trails.title')} title={tx.title} lead={tx.tagline} leadWidth={56} motif="center" lang={lang}>
      <dl class="trd-meta">
        <div><dt>{t('trails.duration')}</dt><dd>{t(`trails.duration.${trail.suggestedDuration}` as const)}</dd></div>
        <div><dt>{t('trails.mode')}</dt><dd>{t(`trails.mode.${trail.mode}` as const)}</dd></div>
        <div><dt>{t('trails.stopsCount')}</dt><dd><bdi>{stops.length}</bdi></dd></div>
        <div><dt>{t('trails.unescoCount')}</dt><dd><bdi>{unescoCount}</bdi></dd></div>
      </dl>
    </PageHero>

    <section class="container trd-intro">
      <p class="trd-intro-p">{tx.intro}</p>
      {guide && (
        <aside class="trd-tip" aria-labelledby="trd-tip-h" data-trail-tip>
          <h2 id="trd-tip-h" class="trd-tip-h">{t('trails.tip')}</h2>
          <p>{tx.tip}</p>
        </aside>
      )}
    </section>

    <section class="container trd-tools" aria-label={tools ? t('trails.toolsH') : undefined} data-trail-tools={trail.slug}>
      {guide && <p class="trd-hook" data-trail-hook>{tx.hook}</p>}
      <div class="trd-actions">
        {tools && <button type="button" class="btn btn--turq" data-tour-start hidden>{t('trails.tour.start')}</button>}
        {dirUrl && <a class="trd-act" href={dirUrl} target="_blank" rel="noopener" data-directions>{t('plan.route')}</a>}
        {tools && <button type="button" class="trd-act" data-trail-print hidden>{t('trails.print')}</button>}
        <ShareButton lang={lang} contentType="trail" itemId={trail.slug} />
      </div>
      {tools && (
        <div class="trd-progress" data-progress hidden>
          <p class="trd-progress-row"><span data-progress-text aria-live="polite"></span> <button type="button" class="trd-reset" data-progress-reset hidden>{t('trails.progressReset')}</button></p>
          <div class="trd-bar" aria-hidden="true"><span data-progress-bar></span></div>
          <p class="trd-progress-note">{t('trails.progressNote')}</p>
        </div>
      )}
    </section>

    <section class="container trd-stops" aria-labelledby="trd-stops-h">
      <h2 id="trd-stops-h" class="trd-h">{t('trails.stopsH')}</h2>
      <ol class="trd-list">
        {stops.map((s) => (
          <li class="trd-stop" id={s.key} data-stop={s.key}>
            <span class="trd-n" aria-hidden="true">{s.n}</span>
            <div class="trd-body">
              {s.img && <Photo src={s.img} label={s.name} class="trd-photo" sizes="(min-width: 760px) 640px, calc(100vw - 92px)" />}
              <h3 class="trd-name">
                {s.name}
                {s.unesco && <span class="trd-badge" data-unesco-badge>{t('trails.unesco')}</span>}
              </h3>
              {guide && s.teaser && <p class="trd-teaser" data-stop-teaser>{s.teaser}</p>}
              <p class="trd-text">{s.quote
                ? <>{s.quote[0]}<q class="trd-quote">{s.quote[1]}</q>{s.quote[2]}</>
                : s.text}</p>
              {s.href && (
                <p class="trd-land"><a href={s.href} data-landmark-link>{labels.landmark} <span aria-hidden="true">{rtl ? '←' : '→'}</span></a></p>
              )}
              {tools && <button type="button" class="trd-visit" data-visit={s.key} aria-pressed="false" hidden>{t('trails.visited')}</button>}
              <div class="trd-src">
                <h4 class="trd-src-h">{t('trails.sources')}</h4>
                <ul>
                  {s.sources.map((src) => (
                    <li><a href={src.url} target="_blank" rel="noopener" data-source={src.key}>{src.title}</a></li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))}
      </ol>
      <p class="trd-note" data-unesco-note>{trailUnescoNote(lang)}</p>
    </section>

    {pins.length > 0 && (
      <section class="container trd-map-sec" aria-labelledby="trd-map-h">
        <h2 id="trd-map-h" class="trd-h">{t('trails.mapH')}</h2>
        <div id="trail-map" class="trd-map" role="application" aria-label={t('trails.mapH')} data-pins={pins.length}></div>
        <p class="trd-map-note">{t('trails.mapNote')}</p>
      </section>
    )}

    <section class="container trd-foot">
      <p class="trd-attr" data-trail-attribution>{trailAttribution(lang)}</p>
      <a href={idxHref} class="btn btn--turq">{t('trails.all')}</a>
    </section>
  </main>
  <Footer lang={lang} />

  {tools && (
    <dialog class="trd-tour" data-tour aria-labelledby="trd-tour-h">
      <div class="trd-tour-head">
        <p class="trd-tour-k" id="trd-tour-h" data-tour-of></p>
        <button type="button" class="trd-tour-x" data-tour-close aria-label={t('trails.tour.close')}><span aria-hidden="true">×</span></button>
      </div>
      <div class="trd-tour-body" data-tour-body></div>
      <div class="trd-tour-foot">
        <button type="button" class="trd-act" data-tour-prev>{t('trails.tour.prev')}</button>
        <button type="button" class="trd-visit" data-tour-visit aria-pressed="false">{t('trails.visited')}</button>
        <button type="button" class="btn btn--turq" data-tour-next>{t('trails.tour.next')}</button>
      </div>
    </dialog>
    <script is:inline define:vars={{ slug: trail.slug, tourText }}>
      function initTrailTools() {
        const root = document.querySelector('[data-trail-tools]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';
        const items = [...document.querySelectorAll('.trd-stop')];
        const keys = items.map((li) => li.dataset.stop);
        const store = 'va-trail-visited:' + slug;
        const read = () => {
          try {
            const v = JSON.parse(localStorage.getItem(store) || '[]');
            return new Set(Array.isArray(v) ? v.filter((k) => keys.includes(k)) : []);
          } catch { return new Set(); }
        };
        const write = (set) => {
          try { if (set.size) localStorage.setItem(store, JSON.stringify([...set])); else localStorage.removeItem(store); }
          catch { /* تخزين محجوب: يبقى التقدّم لهذه الزيارة وحدها */ }
        };
        const fill = (tpl, n, total) => tpl.replace('{n}', n).replace('{total}', total);
        let visited = read();
        let cur = -1;

        const dlg = document.querySelector('[data-tour]');
        const body = dlg.querySelector('[data-tour-body]');
        const next = dlg.querySelector('[data-tour-next]');
        const prev = dlg.querySelector('[data-tour-prev]');
        const tourVisit = dlg.querySelector('[data-tour-visit]');
        const prog = document.querySelector('[data-progress]');
        const reset = document.querySelector('[data-progress-reset]');

        const paint = () => {
          document.querySelectorAll('[data-visit]').forEach((b) => b.setAttribute('aria-pressed', String(visited.has(b.dataset.visit))));
          items.forEach((li) => li.classList.toggle('is-visited', visited.has(li.dataset.stop)));
          prog.querySelector('[data-progress-text]').textContent = fill(tourText.progress, visited.size, keys.length);
          prog.querySelector('[data-progress-bar]').style.inlineSize = (visited.size / keys.length) * 100 + '%';
          reset.hidden = visited.size === 0;
          if (cur >= 0) tourVisit.setAttribute('aria-pressed', String(visited.has(keys[cur])));
        };
        const toggle = (k) => {
          if (visited.has(k)) visited.delete(k); else visited.add(k);
          write(visited);
          paint();
        };
        document.querySelectorAll('[data-visit]').forEach((b) => {
          b.hidden = false;
          b.addEventListener('click', () => toggle(b.dataset.visit));
        });
        reset.addEventListener('click', () => { visited = new Set(); write(visited); paint(); });
        prog.hidden = false;

        // وضع الجولة: نسخة من صورة المحطة ونصها ورابط معلمها ومصادرها، محطةً محطة
        const show = (i) => {
          cur = i;
          const clone = items[i].querySelector('.trd-body').cloneNode(true);
          clone.querySelectorAll('[data-visit]').forEach((b) => b.remove());
          clone.querySelectorAll('img').forEach((im) => { im.loading = 'eager'; });
          body.replaceChildren(clone);
          body.scrollTop = 0;
          dlg.querySelector('[data-tour-of]').textContent = fill(tourText.of, i + 1, keys.length);
          prev.disabled = i === 0;
          next.textContent = i === keys.length - 1 ? tourText.finish : tourText.next;
          paint();
        };
        const close = () => { if (dlg.open) dlg.close(); };
        dlg.addEventListener('close', () => {
          if (cur >= 0) items[cur].scrollIntoView({ block: 'start' });
          cur = -1;
        });
        const start = document.querySelector('[data-tour-start]');
        start.hidden = false;
        start.addEventListener('click', () => {
          // تبدأ الجولة من أول محطة لم تُزر بعد
          const first = keys.findIndex((k) => !visited.has(k));
          dlg.showModal();
          show(first < 0 ? 0 : first);
        });
        next.addEventListener('click', () => (cur < keys.length - 1 ? show(cur + 1) : close()));
        prev.addEventListener('click', () => { if (cur > 0) show(cur - 1); });
        dlg.querySelector('[data-tour-close]').addEventListener('click', close);
        tourVisit.addEventListener('click', () => { if (cur >= 0) toggle(keys[cur]); });
        dlg.addEventListener('click', (e) => { if (e.target === dlg) close(); });
        // الأسهم باتجاه الصفحة: في RTL السهم الأيسر هو «التالية»
        dlg.addEventListener('keydown', (e) => {
          if ((e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') || e.target.closest('a, button')) return;
          const fwd = (e.key === 'ArrowLeft') === (document.documentElement.dir === 'rtl');
          if (fwd && cur < keys.length - 1) show(cur + 1);
          else if (!fwd && cur > 0) show(cur - 1);
        });

        const pr = document.querySelector('[data-trail-print]');
        pr.hidden = false;
        pr.addEventListener('click', () => window.print());
        paint();
      }
      document.addEventListener('astro:page-load', initTrailTools);
      if (document.readyState !== 'loading') initTrailTools(); else document.addEventListener('DOMContentLoaded', initTrailTools);
    </script>
  )}

  {pins.length > 0 && (
    <>
      <link rel="preconnect" href="https://tile.openstreetmap.org" />
      <link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />
      <script is:inline src="/vendor/leaflet-1.9.4/leaflet.js"></script>
      <script is:inline define:vars={{ pins, labels }}>
        function initTrailMap() {
          const el = document.getElementById('trail-map');
          if (!el || typeof L === 'undefined' || el._leaflet_id) return;
          const map = L.map(el, { scrollWheelZoom: false, attributionControl: false });
          L.control.attribution({ prefix: '<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>' }).addTo(map);
          L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors', maxZoom: 19 }).addTo(map);
          const esc = (v) => String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
          // دبوس بنمط va-pin يحمل رقم المحطة (أرقام لاتينية) — مساحة اللمس 28px
          const pin = (n) => L.divIcon({ className: 'va-pin va-pin--trail', html: '<span>' + n + '</span>', iconSize: [28, 28], iconAnchor: [14, 14] });
          const ms = pins.map((p) => L.marker([p.lat, p.lng], { icon: pin(p.n), title: labels.stop + ' ' + p.n + ': ' + p.name })
            .bindPopup('<div class="va-pop"><span class="va-pop-k">' + esc(labels.stop) + ' ' + p.n + '</span><strong class="va-pop-t">' + esc(p.name) + '</strong><a class="va-pop-a" href="' + esc(p.href) + '">' + esc(labels.landmark) + '</a></div>')
            .addTo(map));
          if (ms.length === 1) map.setView(ms[0].getLatLng(), 14);
          else map.fitBounds(L.latLngBounds(ms.map((m) => m.getLatLng())).pad(0.2), { maxZoom: 15 });
        }
        document.addEventListener('astro:page-load', initTrailMap);
        if (document.readyState !== 'loading') initTrailMap(); else document.addEventListener('DOMContentLoaded', initTrailMap);
      </script>
    </>
  )}
</Base>

<style>
  .trd-meta { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-5); margin: var(--s-4) 0 0; }
  .trd-meta dt { font-size: var(--t-xs); font-weight: 600; color: rgba(247,243,234,.78); }
  .trd-meta dd { margin: 0; font-size: var(--t-base); font-weight: 600; color: var(--c-sand); }
  .trd-intro { padding-block: var(--s-6) var(--s-2); }
  .trd-intro-p { max-inline-size: 68ch; font-size: var(--t-lg); line-height: 1.8; color: var(--c-ink-soft); margin: 0; }
  .trd-tip { max-inline-size: 68ch; margin-block-start: var(--s-4); padding: var(--s-3) var(--s-4); border-inline-start: 3px solid var(--c-gold); background: var(--c-sand-2); border-radius: var(--radius); }
  .trd-tip-h { font-size: var(--t-sm); font-weight: 700; color: var(--c-turq-deep); margin: 0 0 4px; }
  .trd-tip p { margin: 0; line-height: 1.8; color: var(--c-ink); }
  .trd-hook { font-family: var(--font-heading); font-size: var(--t-xl); line-height: 1.5; color: var(--c-turq-deep); margin: 0 0 var(--s-3); }
  .trd-teaser { font-weight: 600; color: var(--c-ink-soft); line-height: 1.8; margin: 0 0 var(--s-2); }
  .trd-stops { padding-block: var(--s-5) var(--s-4); }
  .trd-h { font-size: var(--t-xl); color: var(--c-turq-deep); margin-block-end: var(--s-4); }
  .trd-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--s-5); max-inline-size: 76ch; }
  .trd-stop { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: var(--s-3); }
  .trd-n { display: grid; place-items: center; inline-size: 44px; block-size: 44px; border-radius: 50%; background: var(--c-turq); color: var(--c-sand); font-family: var(--font-latin); font-weight: 600; font-size: var(--t-lg); }
