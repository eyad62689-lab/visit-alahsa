---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import { getCollection } from 'astro:content';
import { catLabel } from '../../lib/categories';
import { srcsetFor } from '../../lib/images';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
const detailBase = ar ? '/معالم/' : '/en/attractions/';

const items = await getCollection('attractions');
// srcset يُحسب هنا وقت البناء من بيان العروض (كما يفعل مكوّن Photo): بطاقات هذه
// الصفحة تُبنى بجافاسكربت فلا يمكنها استدعاء المكوّن، وبدون هذه الحقول كانت
// البطاقات تعرض عنصراً نائباً فارغاً رغم توفّر صورة لكل معلم تقريباً.
const allPoints = items.map((e) => {
  const set = e.data.heroImage ? srcsetFor(e.data.heroImage) : undefined;
  return {
    slug: e.data.slug_ar, // المفتاح العالمي للحفظ
    href: detailBase + (ar ? e.data.slug_ar : e.data.slug_en),
    title: ar ? e.data.title : (e.data.title_en ?? e.data.title),
    cat: catLabel(e.data.category, lang),
    summary: ar ? e.data.summary : (e.data.summary_en ?? e.data.summary),
    lat: e.data.location?.lat ?? null, lng: e.data.location?.lng ?? null,
    mapUrl: e.data.mapUrl ?? null,
    img: e.data.heroImage ?? null,
    setJpg: set?.jpg ?? null, setWebp: set?.webp ?? null,
  };
});
const L = {
  savedSuffix: t('plan.savedSuffix'), route: t('plan.route'), clear: t('plan.clear'),
  remove: t('plan.remove'), location: t('plan.location'),
  copy: t('plan.copy'), copied: t('plan.copied'), waText: t('plan.waText'),
};
const browseHref = ar ? '/معالم/' : '/en/attractions/';
const mapHref = ar ? '/خريطة/' : '/en/map/';
---
<Base title={`${t('plan.title')} — ${t('site.name')}`} description={t('plan.lead')} lang={lang} alt={alt} noindex={true}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="plan-hero on-dark">
      <PalmMotif size={300} class="ph-wm" aria-hidden="true" />
      <div class="container ph-in">
        <span class="eyebrow gold-on-dark">{t('plan.eyebrow')}</span>
        <h1 class="ph-title">{t('plan.title')}</h1>
        <p class="ph-sum">{t('plan.lead')}</p>
      </div>
    </section>

    <section class="container plan-body">
      <div class="shared-note" id="shared-note" hidden>
        <div class="sn-txt">
          <h2 class="sn-h">{t('plan.shared.h')}</h2>
          <p class="sn-d">{t('plan.shared.d')}</p>
        </div>
        <div class="sn-btns">
          <button class="btn btn--gold" id="import-btn" type="button">{t('plan.shared.import')}</button>
          <button class="btn btn--ghost-ink" id="mine-btn" type="button">{t('plan.shared.mine')}</button>
        </div>
      </div>
      <div class="plan-actions" id="plan-actions" hidden>
        {/* عدّاد خاص بالصفحة (لا data-plan-count): في وضع القائمة المشارَكة يعرض عدّها
            لا عدّ الزائر، وsync العالمي لا يصله */}
        <span class="plan-count-txt"><bdi id="plan-count">0</bdi> {L.savedSuffix}</span>
        <div class="plan-act-btns">
          <a href="#" class="btn btn--gold" id="route-btn" target="_blank" rel="noopener">{L.route}</a>
          <a href="#" class="btn btn--turq" id="wa-btn" target="_blank" rel="noopener" data-own-only>{t('plan.share')}</a>
          <button class="btn btn--ghost-ink" id="copy-btn" type="button" data-own-only>{L.copy}</button>
          <button class="btn btn--ghost-ink" id="print-btn" type="button">{t('plan.print')}</button>
          <button class="btn btn--ghost-ink" id="clear-btn" type="button" data-own-only>{L.clear}</button>
        </div>
      </div>
      <p class="print-note">{t('plan.printNote')}</p>
      <div class="plan-grid" id="plan-list"></div>
      <div class="plan-empty" id="plan-empty">
        <PalmMotif size={64} class="pe-palm" aria-hidden="true" />
        <h2 class="pe-h">{t('plan.empty.h')}</h2>
        <p class="pe-d">{t('plan.empty.d')}</p>
        <div class="pe-cta">
          <a href={browseHref} class="btn btn--turq">{t('plan.empty.browse')}</a>
          <a href={mapHref} class="btn btn--ghost-ink">{t('plan.empty.map')}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />

  <script is:inline define:vars={{ allPoints, L }}>
    // قياس استخدام الميزات (GA4) — يتجاهل بصمت إن لم يتوفر gtag
    // وصفة أحجام مطابقة لشبكة البطاقات (auto-fill بحدّ أدنى 280px)
    var PC_SIZES = '(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw';
    function planEvent(name) { try { if (typeof gtag === 'function') gtag('event', name); } catch (e) {} }
    // ?list= يعرض قائمة مُشارَكة للقراءة (بلا حذف) مع زرّ استيرادها إلى «رحلتي»
    function sharedList(map) {
      const q = new URLSearchParams(location.search).get('list');
      if (!q) return null;
      const valid = q.split(',').filter((s) => map[s]);
      return valid.length ? valid : null;
    }
    function renderPlan() {
      const map = {}; allPoints.forEach((p) => (map[p.slug] = p));
      const shared = sharedList(map);
      const favs = shared || (window.VAPlan ? window.VAPlan.get() : []).filter((s) => map[s]);
      const list = document.getElementById('plan-list'); const empty = document.getElementById('plan-empty'); const actions = document.getElementById('plan-actions');
      const sharedNote = document.getElementById('shared-note');
      if (!list) return;
      if (sharedNote) sharedNote.hidden = !shared;
      document.querySelectorAll('[data-own-only]').forEach((b) => { b.style.display = shared ? 'none' : ''; });
      if (!favs.length) { list.innerHTML = ''; empty.hidden = false; actions.hidden = true; return; }
      empty.hidden = true; actions.hidden = false;
      const cnt = document.getElementById('plan-count');
      if (cnt) cnt.textContent = favs.length;
      list.innerHTML = favs.map((slug) => {
        const p = map[slug];
        const maps = p.mapUrl ? '<a class="pc-map" href="' + p.mapUrl + '" target="_blank" rel="noopener">' + L.location + '</a>' : '';
        const remove = shared ? '' : '<button class="pc-remove" type="button" data-fav="' + p.slug + '">' + L.remove + '</button>';
        const esc = (v) => String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
        const photo = p.img
          ? '<picture class="photo photo--img pc-photo">' +
              (p.setWebp ? '<source srcset="' + esc(p.setWebp) + '" type="image/webp" sizes="' + PC_SIZES + '">' : '') +
              '<img src="' + esc(p.img) + '.jpg"' + (p.setJpg ? ' srcset="' + esc(p.setJpg) + '"' : '') +
              ' sizes="' + PC_SIZES + '" alt="' + esc(p.title) + '" loading="lazy" decoding="async">' +
            '</picture>'
          : '<div class="photo pc-photo photo--placeholder"><span class="ph-label">' + p.title + '</span></div>';
        return '<article class="plan-card">' +
          photo +
          '<div class="pc-body"><span class="t-caption pc-k">' + p.cat + '</span>' +
          '<h3 class="pc-t"><a href="' + p.href + '">' + p.title + '</a></h3>' +
          '<p class="pc-d">' + p.summary + '</p>' +
          '<div class="pc-foot">' + maps + remove + '</div>' +
          '</div></article>';
      }).join('');
      const coords = favs.map((s) => map[s]).filter((p) => p.lat && p.lng);
      const routeBtn = document.getElementById('route-btn');
      if (routeBtn) { if (coords.length) { routeBtn.href = 'https://www.google.com/maps/dir/' + coords.map((p) => p.lat + ',' + p.lng).join('/'); routeBtn.style.display = ''; } else routeBtn.style.display = 'none'; }
      // رابط المشاركة يحمل معالم القائمة نفسها في ?list=
      const shareUrl = location.origin + location.pathname + '?list=' + favs.map(encodeURIComponent).join(',');
      const waBtn = document.getElementById('wa-btn');
      if (waBtn) waBtn.href = 'https://wa.me/?text=' + encodeURIComponent(L.waText + '\n' + shareUrl);
      const copyBtn = document.getElementById('copy-btn');
      if (copyBtn) copyBtn.dataset.url = shareUrl;
    }
    document.addEventListener('va-plan-change', renderPlan);
    document.addEventListener('astro:page-load', renderPlan);
    if (document.readyState !== 'loading') renderPlan(); else document.addEventListener('DOMContentLoaded', renderPlan);
    document.addEventListener('click', (e) => {
      const t = e.target.closest ? e.target.closest('button, a') : null;
      if (!t) return;
      if (t.id === 'clear-btn') { if (window.VAPlan) window.VAPlan.save([]); }
      if (t.id === 'print-btn') { planEvent('plan_print'); window.print(); }
      if (t.id === 'wa-btn') planEvent('plan_share_whatsapp');
      if (t.id === 'route-btn') planEvent('plan_open_route');
      if (t.id === 'copy-btn' && t.dataset.url) {
        planEvent('plan_copy_link');
        const done = () => { const old = t.textContent; t.textContent = L.copied; setTimeout(() => { t.textContent = old; }, 2000); };
        if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(t.dataset.url).then(done, () => {});
        else { window.prompt(L.copy, t.dataset.url); }
      }
      if (t.id === 'import-btn') {
        planEvent('plan_import_shared');
        const map = {}; allPoints.forEach((p) => (map[p.slug] = p));
        const shared = sharedList(map) || [];
        if (window.VAPlan) {
          const mine = window.VAPlan.get();
          shared.forEach((s) => { if (mine.indexOf(s) === -1) mine.push(s); });
          window.VAPlan.save(mine);
        }
        history.replaceState({}, '', location.pathname); renderPlan();
      }
      if (t.id === 'mine-btn') { history.replaceState({}, '', location.pathname); renderPlan(); }
    });
  </script>
</Base>

<style>
  /* بطاقات «رحلتي» تُبنى بجافاسكربت (innerHTML) فلا تحمل سمة نطاق المكوّن التي
     تضيفها Astro، وكل قاعدة مُنطَّقة لا تصلها. كانت البطاقات تُعرض بلا أي تنسيق
     — لذا أصناف البطاقة كلّها ملفوفة بـ:global هنا وفي كتلة الطباعة. */
  .plan-hero { position: relative; overflow: hidden; background: var(--c-turq-deep); padding-block: var(--s-8) var(--s-7); }
  /* نزيف من حافة واحدة فقط: الهيرو هنا نصّي وارتفاعه ~310px والسعفة 300–320px،
     فقصّها من الأعلى ومن الجانب معاً كان يُبقي شظيةً بأقواسٍ مبتورة تُقرأ خطأً
     لا زخرفةً. التوسيط الرأسي يُبقي التاج كاملاً ويقصّ الجانب وحده. */
  :global(.ph-wm) { position: absolute; inset-block-start: 50%; transform: translateY(-50%); inset-inline-end: -7%; color: var(--c-gold); opacity: .1; }
  /* التحديد على الفقرة لا على الحاوية — وإلا انزاحت الكتلة عن حافة البداية */
  .ph-in { position: relative; z-index: 2; }
  .ph-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .ph-sum { font-size: var(--t-lg); color: rgba(247,243,234,.9); max-inline-size: 54ch; }
  .plan-body { padding-block: var(--s-6) var(--s-8); }
  .plan-actions { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); flex-wrap: wrap; margin-block-end: var(--s-5); padding-block-end: var(--s-4); border-block-end: 1px solid var(--c-line); }
  .plan-count-txt { font-weight: 600; color: var(--c-turq-deep); }
  .plan-act-btns { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  .btn--ghost-ink { background: transparent; color: var(--c-ink); border: 1.5px solid var(--c-line); }
  .btn--ghost-ink:hover { border-color: var(--c-turq); color: var(--c-turq); }
  .plan-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: var(--s-4); }
  :global(.plan-card) { display: flex; flex-direction: column; background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
  :global(.pc-photo) { aspect-ratio: 16 / 10; }
  :global(.pc-body) { padding: var(--s-3) var(--s-4) var(--s-4); display: flex; flex-direction: column; gap: var(--s-1); }
  :global(.pc-k) { color: var(--c-gold-deep); }
  :global(.pc-t) { font-size: var(--t-lg); margin-block: 2px; }
  :global(.pc-t a) { color: var(--c-turq-deep); text-decoration: none; }
  :global(.pc-t a:hover) { color: var(--c-gold-deep); }
  :global(.pc-d) { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.65; }
  :global(.pc-foot) { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); margin-block-start: var(--s-3); padding-block-start: var(--s-3); border-block-start: 1px solid var(--c-line); }
  :global(.pc-map) { font-weight: 600; font-size: var(--t-sm); color: var(--c-turq); text-decoration: none; }
  :global(.pc-remove) { background: none; border: 0; cursor: pointer; font-family: var(--font-body); font-size: var(--t-sm); color: var(--c-ink-soft); }
  :global(.pc-remove:hover) { color: #a3402a; }
  .plan-empty { text-align: center; max-inline-size: 48ch; margin-inline: auto; padding-block: var(--s-7); }
  :global(.pe-palm) { color: var(--c-turq); opacity: .4; margin-inline: auto; }
  .pe-h { font-size: var(--t-xl); color: var(--c-turq-deep); margin-block: var(--s-3) var(--s-2); }
  .pe-d { color: var(--c-ink-soft); margin-block-end: var(--s-4); }
  .pe-cta { display: flex; gap: var(--s-3); justify-content: center; flex-wrap: wrap; }
  @media (max-width: 760px) {
    .ph-sum { font-size: var(--t-base); }
    .plan-actions { flex-direction: column; align-items: flex-start; }
    .plan-act-btns { inline-size: 100%; }
    .plan-act-btns .btn { flex: 1; justify-content: center; }
    .pe-cta { flex-direction: column; align-items: stretch; }
    .pe-cta .btn { justify-content: center; }
  }

  .shared-note { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); flex-wrap: wrap;
    background: var(--c-sand-2); border: 1px solid var(--c-line); border-inline-start: 3px solid var(--c-gold);
    border-radius: var(--radius); padding: var(--s-4); margin-block-end: var(--s-5); }
  .sn-h { font-size: var(--t-lg); color: var(--c-turq-deep); margin-block-end: var(--s-1); }
  .sn-d { font-size: var(--t-sm); color: var(--c-ink-soft); }
  .sn-btns { display: flex; gap: var(--s-3); flex-wrap: wrap; }

  /* ملاحظة تظهر في الطباعة فقط */
  .print-note { display: none; }

  /* نسخة الطباعة: قائمة نظيفة بلا ترويسة/تذييل/أزرار — الهيرو يبقى عنواناً للورقة */
  @media print {
    :global(.site-header), :global(.site-footer), :global(.skip-link),
    .plan-actions, .shared-note, .plan-empty, :global(.pc-remove) { display: none !important; }
    .print-note { display: block; font-size: 10pt; color: #444; margin-block-end: 12pt; }
    .plan-hero { background: none !important; padding-block: 0 8pt; }
    :global(.ph-wm) { display: none !important; }
    .plan-hero .eyebrow { display: none; }
    .ph-title { color: #000 !important; font-size: 20pt; }
    .ph-sum { display: none; }
    .plan-body { padding-block: 0; }
    .plan-grid { display: block; }
    :global(.plan-card) { box-shadow: none; border: 0; border-block-end: 1pt solid #bbb; border-radius: 0;
      break-inside: avoid; margin-block-end: 8pt; padding-block-end: 8pt; }
    :global(.pc-photo) { display: none !important; }
    :global(.pc-body) { padding: 0; }
    :global(.pc-t a) { color: #000 !important; }
    :global(.pc-foot) { border: 0; padding: 0; margin-block-start: 2pt; }
    :global(.pc-map) { color: #444 !important; }
  }
</style>
