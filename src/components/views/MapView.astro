---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import { getCollection } from 'astro:content';
import { catLabel, CATEGORY_ORDER } from '../../lib/categories';
import { attractionHref } from '../../lib/routes';
import { srcsetFor } from '../../lib/images';
import { altHref, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
// الصينية: العنوان والنبذة يتراجعان للإنجليزية لمعلمٍ بلا ترجمة معتمدة —
// سابقة فهرس المعالم (AttractionsView)، وattractionHref يقصد /zh/ للمترجم وحده.
const zh = lang === 'zh';

// أرقام العرض في النسخة العربية تكون عربية-هندية (قاعدة الموقع العامة)
// الأرقام لاتينية (0-9) في اللغتين — قرار إياد 2026-07-21
const num = (n: number) => String(n);

const items = await getCollection('attractions');
const points = items
  .filter((e) => e.data.location)
  .map((e) => ({
    title: ar ? e.data.title : zh ? (e.data.title_zh ?? e.data.title_en ?? e.data.title) : (e.data.title_en ?? e.data.title),
    cat: e.data.category,
    catLabel: catLabel(e.data.category, lang),
    // معلم بلا ترجمة صينية معتمدة: رابطه يقصد النسخة الإنجليزية (سابقة الفهرس)
    href: attractionHref(e.data, zh && !e.data.title_zh ? 'en' : lang),
    fav: e.data.slug_ar,
    summary: ar ? e.data.summary : zh ? (e.data.summary_zh ?? e.data.summary_en ?? e.data.summary) : (e.data.summary_en ?? e.data.summary),
    img: e.data.heroImage ?? null,
    // مصغّر القائمة (72px) والبطاقة المنبثقة: أصغر نسخة مولَّدة لا الأصل الكامل.
    // 400w أول درجة في سلّم gen-image-widths فوجود أي نسخة يضمن وجودها.
    thumb: e.data.heroImage ? `${e.data.heroImage}${srcsetFor(e.data.heroImage) ? '-400w' : ''}.webp` : null,
    popImg: e.data.heroImage ? `${e.data.heroImage}${(srcsetFor(e.data.heroImage)?.webp ?? '').includes('-800w') ? '-800w' : ''}.webp` : null,
    // نصّ البحث: الاسمان معاً + المنطقة، فيجد الزائر المعلم بأي لغة
    q: `${e.data.title} ${e.data.title_en ?? ''} ${e.data.title_zh ?? ''} ${e.data.area ?? ''} ${e.data.area_en ?? ''}`,
    lat: e.data.location!.lat, lng: e.data.location!.lng,
  }))
  .sort((a, b) => a.title.localeCompare(b.title, ar ? 'ar' : zh ? 'zh' : 'en'));
const usedCats = CATEGORY_ORDER.filter((c) => points.some((p) => p.cat === c));
const catCounts = Object.fromEntries(usedCats.map((c) => [c, points.filter((p) => p.cat === c).length]));
const labels = { view: t('map.pop.view'), favAdd: t('fav.add'), favAdded: t('fav.added') };

// إطار العرض الافتراضي — مئينات 5–95 لا المدى الكامل. معلمان ساحليان يمدّان
// النطاق ~1.2° طولاً (≈120 كم) فيهبط التكبير إلى 9: أغلب المعالم ينهار في
// عنقود واحد وأكثر من نصف اللوحة بحر وصحراء. مشتقّ من البيانات لا مكتوب يدوياً،
// والمعالم البعيدة تبقى في القائمة الجانبية وتظهر بالتصغير.
const pct = (arr: number[], q: number) => {
  const a = [...arr].sort((x, y) => x - y);
  return a[Math.min(a.length - 1, Math.max(0, Math.round(q * (a.length - 1))))];
};
const lats = points.map((p) => p.lat);
const lngs = points.map((p) => p.lng);
const viewBounds = [[pct(lats, 0.05), pct(lngs, 0.05)], [pct(lats, 0.95), pct(lngs, 0.95)]];

const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : zh ? '/zh/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: t('map.title'), item: new URL(altHref(alt, lang), siteUrl).href },
  ] },
];
---
<Base title={`${t('map.title')} — ${t('site.name')}`} description={`${points.length} ${t('map.lead.a')}`} lang={lang} alt={alt} jsonLd={jsonLd}>
  {/* preconnect لكارتو في أسفل الصفحة بلا crossorigin عمداً: البلاطات تُطلب كـ<img> بلا CORS،
      فاتصال crossorigin (الذي يضيفه Base) لا يُعاد استعماله ويُهدر */}
  <Header lang={lang} alt={alt} />
  <main class="map-page" id="main">
    <div class="container map-head">
      <span class="eyebrow">{t('map.eyebrow')}</span>
      <h1 class="map-title">{t('map.title')}</h1>
      <p class="map-sum"><bdi>{num(points.length)}</bdi> {t('map.lead.a')}</p>
      <div class="map-tools">
        <input id="map-search" class="map-search" type="search" placeholder={t('map.search.ph')} aria-label={t('map.search.ph')} autocomplete="off" />
        <div class="chips" id="map-chips" role="group" aria-label={t('map.filter.aria')}>
          <button class="chip is-active" data-filter="all" type="button" aria-pressed="true">{t('list.all')} <bdi>({num(points.length)})</bdi></button>
          {usedCats.map((c) => (
            <button class="chip" data-filter={c} type="button" aria-pressed="false">
              <span class={`dot dot--${c}`} aria-hidden="true"></span>{catLabel(c, lang)} <bdi>({num(catCounts[c])})</bdi>
            </button>
          ))}
        </div>
        {/* الخريطة التضاريسية — صفحة مستقلة (تحسين تدريجي)؛ هذه الصفحة تبقى كما هي.
            خارج مجموعة الفلاتر: رابط تنقّل لا فلتر، وكان شكله يوهم أنه أحدها. */}
        {/* لا نسخة صينية للتضاريسية بعد — رابط zh يقصد الإنجليزية */}
        <a class="map-terrain-link" href={ar ? '/خريطة-تضاريس/' : '/en/terrain-map/'}>{t('map.terrain')} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>
      </div>
    </div>
    <div class="container map-layout">
      <div id="map" role="application" aria-label={t('map.title')}></div>
      <aside class="map-side" aria-label={t('map.list.aria')}>
        <p class="ms-count" role="status">{t('map.count')}: <bdi id="map-count">{num(points.length)}</bdi></p>
        <ul class="ms-list" id="map-list">
          {points.map((p) => (
            <li>
              <button type="button" class="ms-item">
                {p.img ? (
                  <img class="ms-thumb" src={p.thumb} alt="" loading="lazy" decoding="async" width="72" height="54" />
                ) : (
                  <span class="ms-thumb ms-thumb--ph" aria-hidden="true"><PalmMotif size={22} /></span>
                )}
                <span class="ms-tx">
                  <strong class="ms-t">{p.title}</strong>
                  <span class="ms-k"><span class={`dot dot--${p.cat}`} aria-hidden="true"></span>{p.catLabel}</span>
                </span>
              </button>
            </li>
          ))}
        </ul>
        <p class="ms-empty" id="map-empty" hidden>{t('map.empty')}</p>
      </aside>
    </div>
  </main>

  <Footer lang={lang} />

  {/* Leaflet مستضاف ذاتياً (كان يُحمَّل من unpkg.com وقت التشغيل) — يزيل تبعية خارجية
      ونقطة فشل، ويُسرّع أول ظهور للخريطة. المسار مُصدَّر بالإصدار فيُكسر الكاش تلقائياً
      عند أي ترقية. بلاطات الخريطة تبقى من CARTO (مجانية بلا مفتاح) — نُهيّئ اتصالها مبكراً. */}
  <link rel="preconnect" href="https://a.basemaps.cartocdn.com" />
  <link rel="preconnect" href="https://b.basemaps.cartocdn.com" />
  <link rel="preconnect" href="https://c.basemaps.cartocdn.com" />
  <link rel="stylesheet" href="/vendor/leaflet-1.9.4/leaflet.css" />
  <script is:inline src="/vendor/leaflet-1.9.4/leaflet.js"></script>
  {/* تجميع الدبابيس المتقاربة (marker clustering) — مستضاف ذاتياً؛ يمنع تراكب الدبابيس
      عند التكبير الشامل (يعالج target-size) ويوضّح المناطق المزدحمة. */}
  <link rel="stylesheet" href="/vendor/leaflet.markercluster-1.5.3/MarkerCluster.css" />
  <script is:inline src="/vendor/leaflet.markercluster-1.5.3/leaflet.markercluster.js"></script>

  <script is:inline define:vars={{ points, labels, isAr: ar, viewBounds }}>
    function initMap() {
      const el = document.getElementById('map');
      if (!el || typeof L === 'undefined' || el._leaflet_id) return;
      // prefix صريح: بادئة Leaflet الافتراضية تحمل علماً سياسياً لا محلّ له على
      // موقع سياحي — الإسناد نفسه يبقى كاملاً.
      const map = L.map(el, { scrollWheelZoom: false, attributionControl: false }).setView([25.42, 49.62], 11);
      L.control.attribution({ prefix: '<a href="https://leafletjs.com" target="_blank" rel="noopener">Leaflet</a>' }).addTo(map);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { attribution: '&copy; OpenStreetMap &copy; CARTO', maxZoom: 19 }).addTo(map);
      // مساحة اللمس 24×24 (حدّ WCAG الأدنى) والنقطة المرئية تبقى 16px متمركزة
      const pin = (cat) => L.divIcon({ className: 'va-pin va-pin--' + cat, html: '<span></span>', iconSize: [24, 24], iconAnchor: [12, 12] });

      // مجموعة العناقيد: تجمّع الدبابيس المتقاربة في شارة (عددها بأرقام لاتينية) تتوسّع بالتكبير
      const cluster = L.markerClusterGroup({
        showCoverageOnHover: false,
        maxClusterRadius: 48,
        spiderfyOnMaxZoom: true,
        iconCreateFunction: (c) => {
          const n = c.getChildCount();
          const size = n < 10 ? 34 : n < 25 ? 40 : 46;
          return L.divIcon({ html: '<span>' + n + '</span>', className: 'va-cluster', iconSize: [size, size], iconAnchor: [size / 2, size / 2] });
        },
      });
      map.addLayer(cluster);

      const listEl = document.getElementById('map-list');
      const lis = listEl ? Array.from(listEl.children) : [];
      // تطبيع البحث: بلا تشكيل، وتوحيد الهمزات والألف المقصورة (جواثى=جواثا) والتاء المربوطة
      const norm = (s) => (s || '').toLowerCase()
        .replace(/[ً-ْـ]/g, '')
        .replace(/[أإآى]/g, 'ا').replace(/ة/g, 'ه');
      const fmt = (n) => String(n); // الأرقام لاتينية في اللغتين

      const esc = (v) => String(v).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const entries = points.map((p, i) => {
        const m = L.marker([p.lat, p.lng], { icon: pin(p.cat), title: p.title });
        const img = p.popImg ? '<img class="va-pop-img" src="' + esc(p.popImg) + '" alt="" loading="lazy" decoding="async">' : '';
        m.bindPopup('<div class="va-pop">' + img +
          '<span class="va-pop-k">' + esc(p.catLabel) + '</span>' +
          '<strong class="va-pop-t">' + esc(p.title) + '</strong>' +
          '<p class="va-pop-d">' + esc(p.summary) + '</p>' +
          '<a class="va-pop-a" href="' + esc(p.href) + '">' + esc(labels.view) + '</a>' +
          '<button class="fav-btn va-pop-fav" type="button" data-fav="' + esc(p.fav) + '" data-tx-on="' + esc(labels.favAdded) + '" data-tx-off="' + esc(labels.favAdd) + '" aria-pressed="false">' +
          '<span class="fav-ic">+</span><span data-fav-tx>' + esc(labels.favAdd) + '</span></button>' +
          '</div>');
        cluster.addLayer(m);
        const li = lis[i] || null;
        if (li) {
          li.querySelector('.ms-item').addEventListener('click', () => {
            // يكبّر ويفكّ العنقود حتى يظهر الدبوس ثم يفتح بطاقته
            cluster.zoomToShowLayer(m, () => m.openPopup());
            if (window.matchMedia('(max-width: 900px)').matches) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
          });
          m.on('popupopen', () => {
            lis.forEach((x) => x.classList.remove('is-here'));
            li.classList.add('is-here');
            li.scrollIntoView({ block: 'nearest' });
          });
          m.on('popupclose', () => li.classList.remove('is-here'));
        }
        return { p, m, li };
      });

      map.on('popupopen', () => window.VAPlan && window.VAPlan.sync());
      // viewBounds = مئينات 5–95 المحسوبة وقت البناء (انظر التعليق في الترويسة)
      map.fitBounds(viewBounds, { padding: [24, 24], maxZoom: 13 });

      const chips = document.querySelectorAll('#map-chips .chip');
      const search = document.getElementById('map-search');
      const countEl = document.getElementById('map-count');
      const emptyEl = document.getElementById('map-empty');
      const state = { cat: 'all', q: '' };
      function apply() {
        const shown = [];
        entries.forEach(({ p, m, li }) => {
          const ok = (state.cat === 'all' || p.cat === state.cat) && (!state.q || norm(p.q).indexOf(state.q) !== -1);
          if (li) li.hidden = !ok;
          if (ok) { cluster.addLayer(m); shown.push(m); } else { cluster.removeLayer(m); }
        });
        if (countEl) countEl.textContent = fmt(shown.length);
        if (emptyEl) emptyEl.hidden = shown.length > 0;
        if (shown.length) map.fitBounds(L.latLngBounds(shown.map((m) => m.getLatLng())).pad(0.12), { maxZoom: 14 });
      }
      chips.forEach((chip) => chip.addEventListener('click', () => {
        state.cat = chip.getAttribute('data-filter');
        chips.forEach((c) => {
          c.classList.toggle('is-active', c === chip);
          c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
        });
        apply();
      }));
      // تهدئة 200ms: apply() تعيد fitBounds، وبلاها كانت الخريطة تُرسم مع كل حرف
      // (8 أحرف = 8 إعادة رسم — تدقيق 2026-08-28). الشرائح فورية كما كانت.
      if (search) {
        let deb = 0;
        search.addEventListener('input', () => {
          clearTimeout(deb);
          deb = setTimeout(() => { state.q = norm(search.value.trim()); apply(); }, 200);
        });
      }
    }
    document.addEventListener('astro:page-load', initMap);
    if (document.readyState !== 'loading') initMap(); else document.addEventListener('DOMContentLoaded', initMap);
  </script>
</Base>

<style>
  /* ألوان الفئات — أدوار مشتقة من رموز الهوية حصراً */
  .map-page {
    --pin-historic: var(--c-gold-deep);
    --pin-museum: var(--c-ink-soft);
    --pin-religious: var(--c-turq-deep);
    --pin-nature: var(--c-turq);
    --pin-parks: var(--c-turq-tint);
    --pin-farm: var(--c-gold);
    --pin-market: var(--c-ink);
    padding-block: var(--s-6) 0;
  }
  .map-head { margin-block-end: var(--s-4); }
  .map-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-turq-deep); font-size: var(--t-2xl); line-height: 1.2; margin-block: var(--s-2); }
  .map-sum { color: var(--c-ink-soft); margin-block-end: var(--s-4); }
  .map-tools { display: flex; gap: var(--s-3); align-items: center; flex-wrap: wrap; }
  /* 16px حدّ أدنى إلزامي: سفاري iOS يزوّم الصفحة تلقائياً عند لمس أي حقل أصغر */
  .map-search { font-family: var(--font-body); font-size: 16px; color: var(--c-ink); background: #fff; border: 1px solid var(--c-line); border-radius: 999px; padding: 8px 16px; min-inline-size: 230px; }
  /* أزرار تكبير Leaflet الافتراضية 30×30 — دون الحدّ المريح للمس.
     التخصيص هنا (0,3,1) لا بدّ أن يتجاوز قاعدة leaflet‏ `.leaflet-touch .leaflet-bar a` (0,2,1)،
     وبنفس الخاصيتين الماديتين width/height اللتين تستعملهما */
  :global(.leaflet-touch .leaflet-bar a.leaflet-control-zoom-in),
  :global(.leaflet-touch .leaflet-bar a.leaflet-control-zoom-out) { width: 40px; height: 40px; line-height: 40px; font-size: 20px; }
  .map-search::placeholder { color: var(--c-ink-60); }
  /* .chips/.chip موحّدة في global.css (2026-08-30) */
  .map-terrain-link { display: inline-flex; align-items: center; gap: var(--s-2); align-self: flex-start;
    font-family: var(--font-body); font-weight: 600; font-size: var(--t-sm); color: var(--c-turq);
    text-decoration: none; border-block-end: 1.5px solid var(--c-gold); padding-block-end: 2px;
    transition: color var(--dur) var(--ease); }
  .map-terrain-link:hover { color: var(--c-turq-deep); }
  .dot { display: inline-block; inline-size: 10px; block-size: 10px; border-radius: 50%; background: var(--c-turq); flex-shrink: 0; }
  .dot--historic { background: var(--pin-historic); }
  .dot--museum { background: var(--pin-museum); }
  .dot--religious { background: var(--pin-religious); }
  .dot--nature { background: var(--pin-nature); }
  .dot--parks { background: var(--pin-parks); }
  .dot--farm { background: var(--pin-farm); }
  .dot--market { background: var(--pin-market); }
  .chip.is-active .dot { box-shadow: 0 0 0 2px rgba(247,243,234,.85); }

  /* الخريطة + القائمة الجانبية المتزامنة */
  .map-layout { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: var(--s-4); align-items: stretch; padding-block-end: var(--s-6); }
  #map { block-size: clamp(420px, 66vh, 720px); inline-size: 100%; background: var(--c-sand-2); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  .map-side { display: flex; flex-direction: column; block-size: clamp(420px, 66vh, 720px); background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); overflow: hidden; }
  .ms-count { margin: 0; padding: var(--s-3); font-size: var(--t-sm); font-weight: 600; color: var(--c-ink-soft); border-block-end: 1px solid var(--c-line); }
  .ms-list { list-style: none; margin: 0; padding: 0; overflow-y: auto; flex: 1; overscroll-behavior: contain; }
  .ms-item { display: flex; gap: var(--s-3); align-items: center; inline-size: 100%; padding: 10px var(--s-3); background: none; border: 0; border-block-end: 1px solid var(--c-line); cursor: pointer; text-align: start; font-family: var(--font-body); transition: background var(--dur) var(--ease); }
  .ms-item:hover { background: var(--c-sand); }
  .ms-list li.is-here .ms-item { background: var(--c-sand-2); border-inline-start: 3px solid var(--c-turq); padding-inline-start: calc(var(--s-3) - 3px); }
  .ms-thumb { inline-size: 72px; block-size: 54px; object-fit: cover; border-radius: var(--radius-sm); flex-shrink: 0; }
  .ms-thumb--ph { display: grid; place-items: center; background: var(--c-sand-2); color: var(--c-turq); }
  .ms-tx { min-inline-size: 0; }
  .ms-t { display: block; font-size: var(--t-sm); font-weight: 600; color: var(--c-ink); line-height: 1.35; }
  .ms-k { display: flex; align-items: center; gap: 6px; font-size: var(--t-xs); color: var(--c-ink-soft); margin-block-start: 2px; }
  .ms-empty { padding: var(--s-4); margin: 0; color: var(--c-ink-soft); font-size: var(--t-sm); }

  /* الدبابيس الملوّنة حسب الفئة — الحاوية 24px (لمسة WCAG) والنقطة 16px متمركزة */
  :global(.va-pin) { display: grid; place-items: center; }
  :global(.va-pin span) { display: block; inline-size: 16px; block-size: 16px; border-radius: 50%; background: var(--pin, var(--c-turq)); border: 2.5px solid var(--c-sand); box-shadow: 0 1px 4px rgba(0,42,37,.4); transition: transform .2s var(--ease); }
  :global(.va-pin:hover span) { transform: scale(1.35); }
  :global(.va-pin--historic span) { --pin: var(--pin-historic); }
  :global(.va-pin--museum span) { --pin: var(--pin-museum); }
  :global(.va-pin--religious span) { --pin: var(--pin-religious); }
  :global(.va-pin--nature span) { --pin: var(--pin-nature); }
  :global(.va-pin--parks span) { --pin: var(--pin-parks); }
  :global(.va-pin--farm span) { --pin: var(--pin-farm); }
  :global(.va-pin--market span) { --pin: var(--pin-market); }

  /* عناقيد الدبابيس — بألوان الهوية، والعدد بأرقام لاتينية */
  :global(.va-cluster) { display: grid; place-items: center; background: none; }
  :global(.va-cluster span) { display: grid; place-items: center; inline-size: 100%; block-size: 100%; border-radius: 50%; background: var(--c-turq); color: var(--c-sand); font-family: var(--font-body); font-weight: 700; font-size: var(--t-sm); border: 2.5px solid var(--c-sand); box-shadow: 0 2px 8px rgba(0,42,37,.35); transition: transform .2s var(--ease); }
  :global(.va-cluster:hover span) { transform: scale(1.08); background: var(--c-turq-deep); }

