---
// صفحة «خطّط لرحلتك» — المعلومات العملية: الوصول، المواسم، النصائح، الأسئلة الشائعة.
// المحتوى منقول من نصوص الموقع السابق المُراجَعة (بلا حقائق جديدة غير متحقّق منها).
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import { altHref, localize, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

/* أيقونات خطّية بلغة أيقونات فئات المعالم نفسها. كانت إيموجي (✈ 🚗 🚆) تُصيَّرها
   ويندوز ملوّنةً — السيارة حمراء والقطار بنفسجي — فتصير الألوان المشبعة الوحيدة
   في الموقع، وتختلف من نظام تشغيل لآخر. */
const TRAVEL_ICONS: Record<string, string> = {
  air:  '<path d="M12 2.6c.9 0 1.6.9 1.6 2v4l6.9 4v2.1l-6.9-2v3.9l2 1.6v1.6L12 19l-3.6.8v-1.6l2-1.6v-3.9l-6.9 2v-2.1l6.9-4v-4c0-1.1.7-2 1.6-2z"/>',
  road: '<path d="M4 16.2v-2.6l1.6-3.8A2 2 0 0 1 7.5 8.5h9a2 2 0 0 1 1.9 1.3l1.6 3.8v2.6"/><path d="M3.6 13.6h16.8"/><path d="M8.5 8.5 9.4 5.8h5.2l.9 2.7"/><circle cx="8" cy="17.4" r="1.7"/><circle cx="16" cy="17.4" r="1.7"/>',
  rail: '<rect x="6" y="3.5" width="12" height="12" rx="3"/><path d="M6 9.5h12"/><path d="M9.6 12.7h.01"/><path d="M14.4 12.7h.01"/><path d="m8.4 15.5-2 4.5"/><path d="m15.6 15.5 2 4.5"/><path d="M5 20h14"/>',
};

const C = localize(lang, {
  eyebrow: 'خطّط لرحلتك',
  title: 'كلُّ ما تحتاجه قبل أن تنطلق',
  lead: 'معلومات عملية موجزة تجعل رحلتك سلسة من الوصول إلى الوداع.',
  getThereH: 'كيف تصل؟',
  getThere: [
    { icon: 'air', h: 'جوّاً', d: 'مطار الأحساء الدولي يستقبل رحلاتٍ داخلية ودولية؛ وتتغيّر الوجهات والجداول فيُنصح بالتأكد قبل الحجز. وبديلاً عنه، مطار الملك فهد الدولي بالدمام يبعد نحو ساعتين بالسيارة ويتيح وجهاتٍ أوسع.' },
    { icon: 'road', h: 'برّاً', d: 'تبعد عن الرياض نحو 326 كم (قرابة 3 ساعات و20 دقيقة)، وقريبةٌ من الدمام والخبر عبر شبكة طرقٍ سريعة جيدة.' },
    { icon: 'rail', h: 'بالقطار', d: 'للهفوف محطةٌ على خط سكة حديد الرياض–الدمام (شركة سار). من الرياض هي الأسرع والأريح (نحو ساعتين وعشر دقائق)، ومن الدمام نحو ساعة إلى ساعة ونصف، ويتوقف القطار أيضاً في بقيق القريبة على المسار نفسه — خيارٌ ممتاز للقادمين من العاصمة والمنطقة الشرقية.' },
  ],
  practicalH: 'معلومات عملية',
  practical: [
    { k: 'أفضل موسم', v: 'وجهةٌ على مدار العام؛ الأجواء ألطف من أكتوبر إلى مارس، والصيف موسم خيراتٍ وتجاربَ مسائية.' },
    { k: 'الإقامة', v: 'فنادق ومنتجعات حديثة في الواحة، إضافةً إلى نُزلٍ تراثية تمنح تجربة محلية أصيلة.' },
    { k: 'طابع الوجهة', v: 'وجهةٌ عائلية أصيلة بطابعٍ محافظ ومضياف، تجمع بين عبق التراث ومرافق الزائر الحديثة، وتناسب العائلات والأفراد على حدٍّ سواء.' },
    { k: 'العملة', v: 'الريال السعودي (SAR). تُقبل البطاقات في أغلب المنشآت، ويُفضّل حمل نقدٍ للأسواق التقليدية.' },
  ],
  tipsH: 'نصائح للزائر',
  tipsLead: 'تفاصيلٌ صغيرة تصنع فرقاً كبيراً في تجربتك.',
  tips: [
    { h: 'المساومة بأدب', d: 'المساومة في الأسواق مقبولة باحترام، وجزءٌ من متعة التسوّق التقليدي.' },
    { h: 'اختر موسمك', d: 'الصيف للسباحة في العيون بين النخيل والاستمتاع بالثمار الطازجة، والشتاء لزيارة المعالم والغوص في التاريخ.' },
    { h: 'اختر التوقيت', d: 'في الأشهر الحارّة ابدأ باكراً أو بعد العصر لزيارة المواقع المفتوحة؛ أمّا في الشتاء فالجوّ لطيفٌ طوال اليوم.' },
    { h: 'تأكّد من المواعيد', d: 'تحقّق من أوقات فتح المتاحف والقلاع مسبقاً، فبعضها يتغيّر موسمياً.' },
  ],
  faqH: 'أسئلة شائعة',
  faq: [
    { q: 'ماذا يوجد في الأحساء سياحة؟', a: 'الأحساء أكبر واحة نخيل طبيعية في العالم (موسوعة غينيس 2020م) وموقع تراث عالمي مسجّل في اليونسكو منذ 2018م. تجمع بين المعالم الطبيعية كجبل القارة بكهوفه وبحيرة الأصفر والعيون، والتراث العمراني في الهفوف كقصر إبراهيم وسوق القيصرية ومسجد جواثى، إضافةً إلى مزارع النخيل وثمار الواحة وأكلاتها الشعبية — وجهة عائلية تجمع التاريخ والطبيعة والضيافة.' },
    { q: 'ما هي أبرز الأماكن السياحية في الأحساء؟', a: 'من أبرزها: جبل القارة وكهوفه ومركز «أرض الحضارات»، وقصر إبراهيم التاريخي، وسوق القيصرية التراثي، ومسجد جواثى (من أقدم مساجد الإسلام)، وبحيرة الأصفر، وقصر صاهود بالمبرّز. تصفّح صفحة «المعالم» لقائمة كاملة يمكنك إضافتها إلى «رحلتي».' },
    { q: 'ما هي مواعيد وأوقات العمل في جبل القارة؟', a: 'يفتح يومياً من 8:00 صباحاً حتى 10:00 مساءً (وقد تُمدّد المواعيد في العطلات)، ورسوم الدخول 50 ريالاً للبالغين تُحجز تذاكرها عبر مركز «أرض الحضارات». يُفضّل تأكيد المواعيد قبل الزيارة فقد تتغيّر موسمياً. (رُوجعت في يونيو 2026م)' },
    { q: 'متى يفتح سوق القيصرية في الأحساء؟', a: 'يعمل السوق صباحاً من 8 حتى 12 ظهراً، ومساءً من 3:30 حتى 10 مساءً (الجمعة مساءً فقط)، والدخول مجاني. وأفضل أوقاته الفترة المسائية حين تفتح المتاجر ويشتدّ نبض السوق. (رُوجعت في يونيو 2026م)' },
    { q: 'ما هو أفضل وقت لزيارة الأحساء؟', a: 'وجهةٌ على مدار العام؛ الأجواء ألطف من أكتوبر إلى مارس وهي الأنسب لزيارة المعالم والقلاع، أمّا الصيف فموسم الرطب والثمار الطازجة والتجارب المسائية والمنتزهات. ومطلع العام موعد مهرجان التمور.' },
    { q: 'كم تبعد الأحساء عن الرياض؟ وكيف يمكن الذهاب إليها؟', a: 'تبعد عن الرياض نحو 326 كم. أسرع وأريح خيار هو القطار إلى محطة الهفوف (نحو ساعتين وعشر دقائق مع شركة «سار»)، أو القيادة عبر الطريق السريع (نحو 3 ساعات و20 دقيقة)، أو الطيران إلى مطار الأحساء الدولي.' },
    { q: 'كم تبعد الأحساء عن الدمام والبحرين؟', a: 'الأحساء قريبة من الدمام والخبر عبر شبكة طرق سريعة جيدة (الدمام نحو 150 كم / قرابة ساعة ونصف). وتُوصَل مملكة البحرين بالسيارة عبر جسر الملك فهد مروراً بالخبر (نحو ساعتين). ويتوقّف قطار «سار» أيضاً في بقيق القريبة على المسار نفسه.' },
    { q: 'كيف يمكن حجز قطار الرياض–الأحساء؟', a: 'يُحجز القطار عبر الشركة السعودية للخطوط الحديدية «سار» (SAR) من تطبيقها الرسمي أو موقعها sar.com.sa، أو من شبابيك التذاكر في المحطات. يربط الخط الرياض بالهفوف والدمام، ويُنصح بالحجز مبكراً في المواسم وأيام العطل.' },
    { q: 'ما هو الرمز البريدي للأحساء؟', a: 'تقع الأحساء (الهفوف والمبرّز) ضمن نطاق أرقامٍ بريدية تبدأ بالرقم 36، وتختلف الأرقام التفصيلية باختلاف الحي والموقع. للحصول على العنوان الدقيق استخدم دليل العنوان الوطني من مؤسسة البريد السعودي (سُبل) على splonline.com.sa.' },
    { q: 'ما هي أفضل فنادق وشاليهات الأحساء؟', a: 'تضمّ الأحساء فنادق ومنتجعات حديثة موزّعة في الهفوف والمبرّز، إضافةً إلى نُزلٍ ومنازل تراثية وشاليهات ومزارع للإيجار تمنح تجربة محلية أصيلة وسط النخيل. لاختيار الأنسب لميزانيتك وموقعك، قارن الخيارات والتقييمات عبر منصّات الحجز الموثوقة. (لا نرشّح منشآت بعينها حفاظاً على حياد المعلومة.)' },
    { q: 'بماذا تشتهر الأحساء في الطعام والمنتجات المحلية؟', a: 'تشتهر الأحساء بتمور الخلاص الذهبية (أشهر أصنافها)، والأرز الأحسائي الأحمر، والأكلات الشعبية كالهريس والبلاليط والخبز الأحمر. ومن ثمار الواحة: التين الأحسائي واللومي والكنار والرمان السواري. وفي الحِرف يبرز البشت الحساوي المطرّز بخيوط الزري، إلى جانب الفخار والخوص والبخور والعطور من سوق القيصرية.' },
    { q: 'لماذا سميت الأحساء بهذا الاسم؟', a: '«الأحساء» جمعُ «حِسْي»: الماء العذب الذي يجري ويُختزَن تحت طبقةٍ رقيقةٍ من الرمل، تكشفه اليد فلا يلبث أن يفور. وهو وصفٌ دقيق لهذه الأرض: واحةٌ سخيّةٌ بعيونها وأفلاجها ومياهها الجوفية التي جعلتها أكبر واحة نخيل في العالم.' },
    { q: 'ما هي أفضل مطاعم الفطور الشعبي في الأحساء؟', a: 'يُقدَّم الفطور الأحسائي والأكلات الشعبية (الأرز الأحسائي الأحمر، البلاليط، الهريس، الخبز الأحمر) في عددٍ من المطاعم التراثية في الهفوف، وتتيح بعض المزارع تجربة فطور أحسائي وسط الطبيعة. ولاختيار الأنسب حالياً ننصح بمراجعة التقييمات المحلية المحدّثة. (لا نرشّح مطاعم بعينها حفاظاً على حياد المعلومة.)' },
  ],
  ctaH: 'جاهز؟ ابدأ بجمع معالمك',
  ctaD: 'تصفّح المعالم وأضف ما يعجبك إلى «رحلتي»، ثم احصل على مسارٍ جاهز في خرائط جوجل.',
  ctaBrowse: 'تصفّح المعالم',
  ctaTrip: 'رحلتي',
  seoTitle: 'خطّط لرحلتك إلى الأحساء — الوصول وأفضل وقت ونصائح',
  seoDesc: 'كل ما تحتاجه لزيارة الأحساء: الوصول جواً وبراً وبالقطار، أفضل وقت للزيارة، معلومات عملية، ونصائح وأسئلة شائعة. خطّط بثقة.',
}, {
  eyebrow: 'Plan your trip',
  title: 'Everything you need before you go',
  lead: 'Concise, practical information to make your trip smooth from arrival to departure.',
  getThereH: 'How to get there',
  getThere: [
    { icon: 'air', h: 'By air', d: 'Al-Ahsa International Airport handles domestic and international flights; routes and schedules change, so confirm before booking. Alternatively, King Fahd International Airport in Dammam is about a two-hour drive away and offers wider connections.' },
    { icon: 'road', h: 'By road', d: 'About 326 km from Riyadh (around 3 hours 20 minutes), and close to Dammam and Khobar via a good highway network.' },
    { icon: 'rail', h: 'By train', d: 'Hofuf has a station on the Riyadh–Dammam railway (SAR). From Riyadh it is the fastest and most comfortable option (around two hours and ten minutes); from Dammam it is roughly one to one and a half hours, and the train also stops at nearby Abqaiq (Buqayq) on the same line — an excellent choice from the capital and the Eastern Province.' },
  ],
  practicalH: 'Practical information',
  practical: [
    { k: 'Best season', v: 'A year-round destination; the air is gentlest from October to March, while summer is a season of bounty and evening experiences.' },
    { k: 'Accommodation', v: 'Modern hotels and resorts across the oasis, plus heritage inns that offer an authentic local stay.' },
    { k: 'Destination vibe', v: 'An authentic, welcoming destination with a conservative character, blending heritage with modern visitor facilities — well suited to families and solo travellers alike.' },
    { k: 'Currency', v: 'The Saudi Riyal (SAR). Cards are accepted in most venues; carry some cash for traditional souqs.' },
  ],
  tipsH: 'Visitor tips',
  tipsLead: 'Small details that make a big difference to your experience.',
  tips: [
    { h: 'Bargain politely', d: 'Haggling in the souqs is acceptable when done respectfully — part of the traditional shopping fun.' },
    { h: 'Pick your season', d: 'Summer for swimming in the springs among the palms and savouring fresh fruit; winter for the landmarks and history.' },
    { h: 'Time it right', d: 'In the hot months, start early or after mid-afternoon for open-air sites; in winter the weather is pleasant all day.' },
    { h: 'Confirm opening times', d: 'Check museum and fort opening hours ahead — some change seasonally.' },
  ],
  faqH: 'Frequently asked questions',
  faq: [
    { q: 'Is Al-Ahsa worth visiting?', a: 'Absolutely. Al-Ahsa is the world’s largest natural palm oasis (Guinness 2020) and a UNESCO World Heritage Site (2018). It pairs natural wonders — Al-Qarah Mountain’s caves, Al-Asfar Lake and the freshwater springs — with living heritage in Hofuf: Qasr Ibrahim, Qaisariyah Souq and Jawatha Mosque, plus palm groves, oasis fruits and distinctive local cuisine. A welcoming, family-friendly destination blending history, nature and hospitality.' },
    { q: 'What are the best places to visit in Al-Ahsa?', a: 'Highlights include Al-Qarah Mountain with its caves and the “Land of Civilisations” centre, the historic Qasr Ibrahim, the heritage Qaisariyah Souq, Jawatha Mosque (one of the earliest mosques in Islam), Al-Asfar Lake, and Qasr Sahood in Al-Mubarraz. Browse the Attractions page for the full list you can add to “My Trip”.' },
    { q: 'What are the opening hours for Al-Qarah Mountain?', a: 'It opens daily from 8:00 am to 10:00 pm (hours may be extended on holidays), and admission is SAR 50 for adults, booked through the “Land of Civilisations” centre. Hours can change seasonally, so confirm before you go. (Reviewed June 2026)' },
    { q: 'When does Qaisariyah Souq open?', a: 'The souq trades in the morning from 8 am to 12 noon and in the evening from 3:30 pm to 10 pm (Friday evenings only), and entry is free. Evenings are the best time, when the shops open and the market comes alive. (Reviewed June 2026)' },
    { q: 'When is the best time to visit Al-Ahsa?', a: 'A year-round destination; the weather is gentlest from October to March — ideal for the landmarks and forts — while summer brings fresh dates, evening experiences and the parks. Early in the year is the season of the Dates Festival.' },
    { q: 'How do I travel from Riyadh to Al-Ahsa?', a: 'Al-Ahsa is about 326 km from Riyadh. The fastest and most comfortable option is the train to Hofuf station (around two hours and ten minutes with SAR), or driving via the highway (around 3 hours 20 minutes), or flying into Al-Ahsa International Airport.' },
    { q: 'What is the distance from Al-Ahsa to Bahrain and Dammam?', a: 'Al-Ahsa is close to Dammam and Khobar via a good highway network (Dammam is roughly 150 km, about 1.5 hours). Bahrain is reached by road across the King Fahd Causeway via Khobar (about two hours). SAR trains also stop at nearby Abqaiq (Buqayq) on the same line.' },
    { q: 'How do I book a Riyadh–Al-Ahsa train ticket?', a: 'Book through Saudi Arabia Railways (SAR) via its official app or website sar.com.sa, or at station ticket counters. The line connects Riyadh with Hofuf and Dammam; book early during holidays and peak seasons.' },
    { q: 'What is the postal code for Al-Ahsa?', a: 'Al-Ahsa (Hofuf and Al-Mubarraz) falls within postal codes beginning with 36, with the exact code varying by district and location. For a precise address, use the Saudi Post (SPL) National Address directory at splonline.com.sa.' },
    { q: 'What are the best hotels to stay at in Al-Ahsa?', a: 'Al-Ahsa offers modern hotels and resorts across Hofuf and Al-Mubarraz, alongside heritage inns, chalets and farm stays for an authentic local experience among the palms. To find the best fit for your budget and location, compare options and reviews on trusted booking platforms. (We don’t endorse specific venues, to keep the information neutral.)' },
    { q: 'What is Al-Ahsa famous for?', a: 'Al-Ahsa is famous for its golden Khalas dates (its best-known variety), Hasawi red rice and folk dishes such as harees, balaleet and red bread. Its oasis fruits include the Hasawi fig, lomi, kanar and Suwari pomegranate. In crafts, the Hasawi bisht embroidered with zari thread stands out, along with pottery, palm-frond ware, incense and perfumes from Qaisariyah Souq.' },
    { q: 'How did Al-Ahsa get its name?', a: '“Al-Ahsa” is the plural of “hisy”: the sweet water that runs and gathers beneath a thin layer of sand, which springs up as soon as your hand uncovers it. It is a precise description of this land — a generous oasis of springs, channels and groundwater that made it the largest palm oasis in the world.' },
    { q: 'What are the best traditional restaurants in Al-Ahsa?', a: 'Hasawi breakfasts and folk dishes (Hasawi red rice, balaleet, harees, red bread) are served at several heritage restaurants in Hofuf, and some farms offer a Hasawi breakfast in nature. For the best current pick, check up-to-date local reviews. (We don’t endorse specific restaurants, to keep the information neutral.)' },
  ],
  ctaH: 'Ready? Start gathering your sights',
  ctaD: 'Browse the attractions, add what you like to “My Trip”, then get a ready-made route in Google Maps.',
  ctaBrowse: 'Browse attractions',
  ctaTrip: 'My Trip',
  seoTitle: 'Plan your trip to Al-Ahsa — getting there, best time and tips',
  seoDesc: 'Everything you need to visit Al-Ahsa: getting there by air, road and train, the best time to visit, practical information, tips and FAQs. Plan with confidence.',
});

const browseHref = ar ? '/معالم/' : '/en/attractions/';
const tripHref = ar ? '/رحلتي/' : '/en/plan/';
const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: C.faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: t('nav.plan'), item: new URL(altHref(alt, lang), siteUrl).href },
  ] },
];
---
<Base title={`${C.seoTitle} — ${t('site.name')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={C.eyebrow} title={C.title} lead={C.lead} leadWidth={56} motif="center" lang={lang} />

    <section class="sec" id="getting-there">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.getThereH}</h2>
        <div class="gt-grid">
          {C.getThere.map((g, i) => (
            <article class="gt-card" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="gt-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={TRAVEL_ICONS[g.icon]} /></span>
              <h3 class="gt-h">{g.h}</h3>
              <p class="gt-d">{g.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="practical">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.practicalH}</h2>
        <dl class="pr-grid">
          {C.practical.map((p, i) => (
            <div class="pr-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <dt class="pr-k">{p.k}</dt>
              <dd class="pr-v">{p.v}</dd>
