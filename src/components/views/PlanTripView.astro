---
// صفحة «خطّط لرحلتك» — المعلومات العملية: الوصول، المواسم، النصائح، الأسئلة الشائعة.
// المحتوى منقول من نصوص الموقع السابق المُراجَعة (بلا حقائق جديدة غير متحقّق منها).
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const C = ar ? {
  eyebrow: 'خطّط لرحلتك',
  title: 'كلُّ ما تحتاجه قبل أن تنطلق',
  lead: 'معلومات عملية موجزة تجعل رحلتك سلسة من الوصول إلى الوداع.',
  getThereH: 'كيف تصل؟',
  getThere: [
    { icon: '✈', h: 'جوّاً', d: 'مطار الأحساء الدولي يستقبل رحلاتٍ داخلية ودولية؛ وتتغيّر الوجهات والجداول فيُنصح بالتأكد قبل الحجز. وبديلاً عنه، مطار الملك فهد الدولي بالدمام يبعد نحو ساعتين بالسيارة ويتيح وجهاتٍ أوسع.' },
    { icon: '🚗', h: 'برّاً', d: 'تبعد عن الرياض نحو 326 كم (قرابة 3 ساعات و20 دقيقة)، وقريبةٌ من الدمام والخبر عبر شبكة طرقٍ سريعة جيدة.' },
    { icon: '🚆', h: 'بالقطار', d: 'للهفوف محطةٌ على خط سكة حديد الرياض–الدمام (شركة سار). من الرياض هي الأسرع والأريح (نحو ساعتين وعشر دقائق)، ومن الدمام نحو ساعة إلى ساعة ونصف، ويتوقف القطار أيضاً في بقيق القريبة على المسار نفسه — خيارٌ ممتاز للقادمين من العاصمة والمنطقة الشرقية.' },
  ],
  practicalH: 'معلومات عملية',
  practical: [
    { k: 'أفضل موسم', v: 'وجهةٌ على مدار العام؛ الأجواء ألطف من أكتوبر إلى مارس، والصيف موسم خيراتٍ وتجاربَ مسائية.' },
    { k: 'الإقامة', v: 'فنادق ومنتجعات حديثة في الواحة، إضافةً إلى نُزلٍ تراثية تمنح تجربة محلية أصيلة.' },
    { k: 'طابع الوجهة', v: 'وجهةٌ عائلية أصيلة بطابعٍ محافظ ومضياف، تجمع بين عبق التراث ومرافق الزائر الحديثة، وتناسب العائلات والأفراد على حدٍّ سواء.' },
    { k: 'العملة', v: 'الريال السعودي (SAR). تُقبل البطاقات في أغلب المنشآت، ويُفضّل حمل نقدٍ للأسواق التقليدية.' },
  ],
  tipsH: 'نصائح للزائر',
  tipsLead: 'تفاصيلٌ صغيرة تصنع فرقاً كبيراً في تجربتك.',
  tips: [
    { h: 'المساومة بأدب', d: 'المساومة في الأسواق مقبولة باحترام، وجزءٌ من متعة التسوّق التقليدي.' },
    { h: 'اختر موسمك', d: 'الصيف للسباحة في العيون بين النخيل والاستمتاع بالثمار الطازجة، والشتاء لزيارة المعالم والغوص في التاريخ.' },
    { h: 'اختر التوقيت', d: 'في الأشهر الحارّة ابدأ باكراً أو بعد العصر لزيارة المواقع المفتوحة؛ أمّا في الشتاء فالجوّ لطيفٌ طوال اليوم.' },
    { h: 'تأكّد من المواعيد', d: 'تحقّق من أوقات فتح المتاحف والقلاع مسبقاً، فبعضها يتغيّر موسمياً.' },
  ],
  faqH: 'أسئلة شائعة',
  faq: [
    { q: 'كم يوماً تكفي لزيارة الأحساء؟', a: 'يومان إلى ثلاثة أيام كافية لتغطية أبرز المعالم التراثية والطبيعية بتجربةٍ متوازنة. ليومٍ واحد، ركّز على الهفوف التاريخي وجبل القارة.' },
    { q: 'ما أفضل وقتٍ للزيارة؟', a: 'الأحساء وجهةٌ طوال العام؛ الأجواء ألطف من أكتوبر إلى مارس، أمّا الصيف فموسم الرطب والتجارب المسائية والمنتزهات. ومطلع العام موعد مهرجان التمور.' },
    { q: 'كم تبعد الأحساء عن الرياض وكيف أصل إليها؟', a: 'تبعد نحو 326 كم. أسرع وأريح خيار هو القطار إلى محطة الهفوف (نحو ساعتين وعشر دقائق)، أو القيادة عبر الطريق السريع (نحو 3 ساعات و20 دقيقة)، أو الطيران إلى مطار الأحساء الدولي.' },
    { q: 'هل أحتاج إلى سيارة للتنقل داخل الأحساء؟', a: 'يُفضّل ذلك؛ فالمعالم متباعدة وبعضها خارج المدينة (جبل القارة، بحيرة الأصفر، مسجد جواثا)، والسيارة — خاصة أو مستأجرة — تمنحك مرونة أكبر. تطبيقات التوصيل متاحة داخل الهفوف والمبرّز لكنها أقل ملاءمة للمواقع البعيدة.' },
    { q: 'كم رسوم دخول جبل القارة وما أوقات العمل؟', a: 'جبل القارة موقعٌ سياحي مطوَّر يضمّ الكهوف ومركز «أرض الحضارات» ومرافق للزوّار، وتُفرَض رسومٌ على بعض التجارب والمتاحف الداخلية. تتغيّر الأسعار وأوقات العمل موسمياً، لذا ننصح بتأكيدها قبل الزيارة من القنوات الرسمية مثل الموقع الرسمي للسياحة السعودية (visitsaudi.com) أو إدارة الموقع.' },
    { q: 'هل يمكن السباحة في عيون الأحساء؟', a: 'في بعضها نعم؛ أهّلت الجهات المختصة مسابح في عددٍ من العيون مثل أم سبعة والجوهرية والحارة، وهي متاحة للمتنزّهين بمواعيد منظّمة. أمّا عين نجم فهي معلمٌ تاريخي اشتهر قديماً بمياهه الكبريتية الحارة، والاستشفاء بها غير متاح حالياً. تختلف الإتاحة والمواعيد موسمياً، فيُفضّل التأكد محلياً قبل التوجّه.' },
    { q: 'ما الأنشطة التي يمكن ممارستها في بحيرة الأصفر؟', a: 'رحلات السفاري على الكثبان، والتخييم، ومراقبة الطيور المهاجرة (فالبحيرة محمية طبيعية)، والتنزّه وتصوير الغروب. يُفضّل استخدام سيارة دفع رباعي للمناطق الرملية.' },
    { q: 'أين آكل الأرز الحساوي والأكلات الشعبية؟', a: 'يقدّم الرز الحساوي الأحمر والأكلات الشعبية (المندي، البلاليط، الهريس، الخبز الأحمر) عددٌ من المطاعم التراثية في الهفوف، وبعض المزارع تتيح تجربة فطور حساوي وسط الطبيعة. اسأل محلياً عن المطاعم المتخصّصة في الأرز الحساوي الأصلي.' },
    { q: 'هل الأحساء مناسبة للعائلات؟', a: 'نعم، وجهةٌ عائلية بطابعٍ محافظ، تتوافر فيها مرافق العائلات والخيارات الحلال والمساجد بسهولة.' },
    { q: 'ما الذي يجب أن أشتريه من الأحساء؟', a: 'تمور الخلاص الشهيرة، والبشت الأحسائي، ومنتجات الفخار والبخور والعطور من سوق القيصرية.' },
  ],
  ctaH: 'جاهز؟ ابدأ بجمع معالمك',
  ctaD: 'تصفّح المعالم وأضف ما يعجبك إلى «رحلتي»، ثم احصل على مسارٍ جاهز في خرائط جوجل.',
  ctaBrowse: 'تصفّح المعالم',
  ctaTrip: 'رحلتي',
  seoTitle: 'خطّط لرحلتك إلى الأحساء — الوصول وأفضل وقت ونصائح',
  seoDesc: 'كل ما تحتاجه لزيارة الأحساء: الوصول جواً وبراً وبالقطار، أفضل وقت للزيارة، معلومات عملية، ونصائح وأسئلة شائعة. خطّط بثقة.',
} : {
  eyebrow: 'Plan your trip',
  title: 'Everything you need before you go',
  lead: 'Concise, practical information to make your trip smooth from arrival to departure.',
  getThereH: 'How to get there',
  getThere: [
    { icon: '✈', h: 'By air', d: 'Al-Ahsa International Airport handles domestic and international flights; routes and schedules change, so confirm before booking. Alternatively, King Fahd International Airport in Dammam is about a two-hour drive away and offers wider connections.' },
    { icon: '🚗', h: 'By road', d: 'About 326 km from Riyadh (around 3 hours 20 minutes), and close to Dammam and Khobar via a good highway network.' },
    { icon: '🚆', h: 'By train', d: 'Hofuf has a station on the Riyadh–Dammam railway (SAR). From Riyadh it is the fastest and most comfortable option (around two hours and ten minutes); from Dammam it is roughly one to one and a half hours, and the train also stops at nearby Abqaiq (Buqayq) on the same line — an excellent choice from the capital and the Eastern Province.' },
  ],
  practicalH: 'Practical information',
  practical: [
    { k: 'Best season', v: 'A year-round destination; the air is gentlest from October to March, while summer is a season of bounty and evening experiences.' },
    { k: 'Accommodation', v: 'Modern hotels and resorts across the oasis, plus heritage inns that offer an authentic local stay.' },
    { k: 'Destination vibe', v: 'An authentic, welcoming destination with a conservative character, blending heritage with modern visitor facilities — well suited to families and solo travellers alike.' },
    { k: 'Currency', v: 'The Saudi Riyal (SAR). Cards are accepted in most venues; carry some cash for traditional souqs.' },
  ],
  tipsH: 'Visitor tips',
  tipsLead: 'Small details that make a big difference to your experience.',
  tips: [
    { h: 'Bargain politely', d: 'Haggling in the souqs is acceptable and respectful — part of the traditional shopping fun.' },
    { h: 'Pick your season', d: 'Summer for swimming among the palms and savouring fresh fruit; winter for the landmarks and history.' },
    { h: 'Time it right', d: 'In the hot months, start early or after mid-afternoon for open-air sites; in winter the weather is pleasant all day.' },
    { h: 'Confirm opening times', d: 'Check museum and fort opening hours ahead — some change seasonally.' },
  ],
  faqH: 'Frequently asked questions',
  faq: [
    { q: 'How many days are enough for Al-Ahsa?', a: 'Two to three days cover the main heritage and natural sites with a balanced experience. For a single day, focus on historic Hofuf and Al-Qarah mountain.' },
    { q: 'What is the best time to visit?', a: 'Al-Ahsa is a year-round destination; the air is gentlest from October to March, while summer brings fresh dates, evening experiences and the parks. Early in the year is the dates festival.' },
    { q: 'How far is Al-Ahsa from Riyadh and how do I get there?', a: 'About 326 km. The fastest and most comfortable option is the train to Hofuf station (around two hours and ten minutes), or driving via the highway (around 3 hours 20 minutes), or flying into Al-Ahsa International Airport.' },
    { q: 'Do I need a car to get around Al-Ahsa?', a: 'It is recommended; the sights are spread out and some lie outside the city (Al-Qarah mountain, Al-Asfar lake, Jawatha Mosque), so a car — private or rented — gives you more flexibility. Ride-hailing apps work within Hofuf and Al-Mubarraz but are less practical for the farther sites.' },
    { q: 'What are the entry fees and opening hours for Al-Qarah Mountain?', a: 'Al-Qarah is a developed tourist site with caves, the “Land of Civilisations” centre and visitor facilities; some experiences and indoor museums charge a fee. Prices and hours change seasonally, so confirm before your visit via official channels such as visitsaudi.com or the venue itself.' },
    { q: 'Can you swim in Al-Ahsa’s springs?', a: 'In some of them, yes; the authorities have developed swimming pools at several springs such as Umm Sab’ah, Al-Jawhariyah and Al-Harrah, open to visitors at set times. Ain Najm, however, is a historic landmark once known for its hot sulphur waters, and bathing there is not currently available. Availability and timings vary seasonally, so check locally first.' },
    { q: 'What can you do at Al-Asfar Lake?', a: 'Dune safaris, camping, watching migratory birds (the lake is a nature reserve), strolling and sunset photography. A 4x4 is recommended for the sandy areas.' },
    { q: 'Where can I eat Hassawi rice and local dishes?', a: 'Several heritage restaurants in Hofuf serve Hassawi red rice and folk dishes (mandi, balaleet, harees, red date bread), and some farms offer a Hassawi breakfast experience in nature. Ask locally for restaurants specialising in authentic Hassawi rice.' },
    { q: 'Is Al-Ahsa family-friendly?', a: 'Yes — a family destination with a conservative character, with family facilities, halal options and mosques easy to find.' },
    { q: 'What should I buy in Al-Ahsa?', a: 'The famous Khalas dates, the Al-Ahsa bisht, and pottery, incense and perfumes from Qaisariyah Souq.' },
  ],
  ctaH: 'Ready? Start gathering your sights',
  ctaD: 'Browse the attractions, add what you like to “My Trip”, then get a ready-made route in Google Maps.',
  ctaBrowse: 'Browse attractions',
  ctaTrip: 'My Trip',
  seoTitle: 'Plan your trip to Al-Ahsa — getting there, best time and tips',
  seoDesc: 'Everything you need to visit Al-Ahsa: getting there by air, road and train, the best time to visit, practical information, tips and FAQs. Plan with confidence.',
};

const browseHref = ar ? '/معالم/' : '/en/attractions/';
const tripHref = ar ? '/رحلتي/' : '/en/plan/';
const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: C.faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: t('nav.plan'), item: new URL(alt[lang], siteUrl).href },
  ] },
];
---
<Base title={`${C.seoTitle} — ${t('site.name')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="pt-hero on-dark">
      <PalmMotif size={320} class="pth-wm" aria-hidden="true" />
      <div class="container pth-in">
        <span class="eyebrow gold-on-dark">{C.eyebrow}</span>
        <h1 class="pth-title">{C.title}</h1>
        <p class="pth-sum">{C.lead}</p>
      </div>
    </section>

    <section class="sec" id="getting-there">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.getThereH}</h2>
        <div class="gt-grid">
          {C.getThere.map((g, i) => (
            <article class="gt-card" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="gt-icon" aria-hidden="true">{g.icon}</span>
              <h3 class="gt-h">{g.h}</h3>
              <p class="gt-d">{g.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="practical">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.practicalH}</h2>
        <dl class="pr-grid">
          {C.practical.map((p, i) => (
            <div class="pr-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <dt class="pr-k">{p.k}</dt>
              <dd class="pr-v">{p.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec" id="tips">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.tipsH}</h2>
        <p class="lead" data-reveal>{C.tipsLead}</p>
        <ol class="tip-grid">
          {C.tips.map((p, i) => (
            <li class="tip-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <h3 class="tip-h">{p.h}</h3>
              <p class="tip-d">{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec sec--sand" id="faq">
      <div class="container faq-in">
        <h2 class="sec-h" data-reveal>{C.faqH}</h2>
        <div class="faq-list" data-reveal>
          {C.faq.map((f) => (
            <details class="faq">
              <summary class="faq-q">{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pt-cta">
      <div class="container pt-cta-in" data-reveal>
        <h2 class="ptc-h">{C.ctaH}</h2>
        <p class="lead ptc-d">{C.ctaD}</p>
        <div class="ptc-btns">
          <a href={browseHref} class="btn btn--gold">{C.ctaBrowse}</a>
          <a href={tripHref} class="btn btn--turq">{C.ctaTrip}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .pt-hero { position: relative; overflow: hidden; background: var(--c-turq-deep); padding-block: var(--s-8) var(--s-7); }
  :global(.pth-wm) { position: absolute; inset-block-start: -10%; inset-inline-end: -5%; color: var(--c-gold); opacity: .1; }
  .pth-in { position: relative; z-index: 2; max-inline-size: 56ch; }
  .pth-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .pth-sum { font-size: var(--t-lg); color: rgba(247,243,234,.9); }
  .sec { padding-block: var(--s-7); }
  .sec--sand { background: var(--c-sand-2); }
  .sec-h { font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.2; margin-block-end: var(--s-5); }
  .gt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); gap: var(--s-3); }
  .gt-card { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); padding: var(--s-5) var(--s-4); }
  .gt-icon { display: inline-grid; place-items: center; inline-size: 52px; block-size: 52px; border-radius: 13px; background: color-mix(in srgb, var(--c-turq) 10%, #fff); font-size: 1.4rem; margin-block-end: var(--s-3); }
  .gt-h { font-size: var(--t-lg); color: var(--c-ink); margin-block-end: var(--s-2); }
  .gt-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }
  .pr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); gap: var(--s-4); margin: 0; }
  .pr-item { padding-inline-start: var(--s-3); border-inline-start: 2px solid rgba(201,154,74,.55); }
  .pr-k { font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-gold-deep); margin-block-end: var(--s-1); }
  .pr-v { margin: 0; font-size: var(--t-sm); color: var(--c-ink); line-height: 1.75; }
  .tip-grid { list-style: none; counter-reset: tip; padding: 0; margin-block-start: var(--s-5); display: grid; grid-template-columns: repeat(auto-fit, minmax(248px, 1fr)); gap: var(--s-4); }
  .tip-item { counter-increment: tip; position: relative; padding-inline-start: 52px; }
  .tip-item::before { content: counter(tip, arabic-indic); position: absolute; inset-inline-start: 0; inset-block-start: 0;
    inline-size: 38px; block-size: 38px; display: grid; place-items: center; border-radius: 50%;
    background: var(--c-turq); color: var(--c-sand); font-family: var(--font-heading); font-weight: 700; }
  :global([dir='ltr']) .tip-item::before { content: counter(tip); }
  .tip-h { font-size: var(--t-lg); color: var(--c-ink); margin-block-end: var(--s-1); }
  .tip-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }
  .faq-in { max-inline-size: 72ch; }
  .faq { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); margin-block-end: var(--s-2); overflow: hidden; }
  .faq-q { cursor: pointer; font-family: var(--font-body); font-weight: 600; font-size: var(--t-base); color: var(--c-turq-deep); padding: var(--s-3) var(--s-4); list-style-position: inside; }
  .faq-q:hover { color: var(--c-gold-deep); }
  .faq[open] .faq-q { border-block-end: 1px solid var(--c-line); }
  .faq-a { padding: var(--s-3) var(--s-4) var(--s-4); font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.8; max-inline-size: 65ch; }
  .pt-cta { background: var(--c-sand); padding-block: var(--s-8); text-align: center; }
  .pt-cta-in { max-inline-size: 56ch; margin-inline: auto; display: flex; flex-direction: column; align-items: center; gap: var(--s-3); }
