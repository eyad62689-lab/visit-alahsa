  practical: [
    { k: '最佳季节', v: '哈萨四季皆宜；10 月至次年 3 月天气最为宜人，夏季则是瓜果飘香、夜间活动丰富的时节。' },
    { k: '住宿', v: '绿洲内既有现代化的酒店与度假村，也有传统民居客栈，让您体验地道的当地风情。' },
    { k: '目的地风情', v: '这里民风淳朴、热情好客，整体氛围较为保守传统。历史韵味与现代旅游设施在此融为一体，既适合家庭出游，也适合独自旅行。' },
    { k: '货币', v: '沙特里亚尔（SAR）。大多数场所可刷卡消费，逛传统市集时建议随身携带一些现金。' },
  ],
  tipsH: '游客贴士',
  tipsLead: '小细节，让您的旅行体验大不同。',
  tips: [
    { h: '礼貌议价', d: '在传统市集购物时，有礼有节地讨价还价并不失礼，反而是传统购物乐趣的一部分。' },
    { h: '选对季节', d: '夏季可在棕榈林间的泉水中畅游、品尝新鲜瓜果；冬季则适合走访名胜古迹、探寻历史。' },
    { h: '选对时段', d: '炎热月份游览露天景点，宜趁清晨出发，或等到临近傍晚、暑气稍退时再出行；冬季则全天气候宜人。' },
    { h: '确认开放时间', d: '博物馆与城堡的开放时间请提前查询，部分场所会随季节调整。' },
  ],
  faqH: '常见问题',
  faq: [
    { q: '哈萨有哪些旅游看点？', a: '哈萨是世界最大的绿洲（2020 年吉尼斯世界纪录），并自 2018 年起列入联合国教科文组织世界遗产名录。这里既有卡拉山及其洞穴、阿斯法湖（黄湖）与众多泉眼等自然景观，也有胡富夫的建筑遗产——易卜拉欣宫、凯撒利亚集市与贾瓦塔清真寺，还有棕榈园、绿洲瓜果与地道的民间美食——是一处集历史、自然与好客之道于一体、适合全家出游的目的地。' },
    { q: '哈萨最值得游览的景点有哪些？', a: '主要景点包括：卡拉山及其洞穴与“文明之地”（Land of Civilizations）中心、历史悠久的易卜拉欣宫、传统的凯撒利亚集市、伊斯兰教最早的清真寺之一贾瓦塔清真寺、阿斯法湖，以及穆巴拉兹的萨胡德宫（Qasr Sahood）。您可以在“景点”页面浏览完整列表，并将心仪的景点加入“我的行程”。' },
    { q: '卡拉山几点开放？门票多少钱？', a: `卡拉山每天上午 8:00 至晚上 10:00 开放（节假日可能延长），成人门票 50 里亚尔，通过“文明之地”中心预约购票。开放时间或随季节调整，建议您行前确认。（复核于 ${rev}）` },
    { q: '凯撒利亚集市何时开放？', a: `市集营业时间为上午 8:00 至中午 12:00、下午 3:30 至晚上 10:00（周五仅晚间营业），免费入场。最推荐傍晚前往——店铺陆续开门，市集也随之热闹起来。（复核于 ${rev}）` },
    { q: '游览哈萨的最佳时间是什么时候？', a: '哈萨四季皆宜；10 月至次年 3 月天气最为宜人，最适合游览名胜与城堡；夏季则是软熟鲜椰枣（Rutab）与新鲜瓜果上市的时节，夜间活动丰富，还可以逛逛公园。每年年初则迎来椰枣节。' },
    { q: '哈萨距利雅得多远？如何前往？', a: '哈萨距利雅得约 326 公里。最快捷、最舒适的方式是乘火车前往胡富夫站（沙特铁路公司运营，约 2 小时 10 分钟）；也可经高速公路自驾（约 3 小时 20 分钟），或乘飞机抵达哈萨国际机场。' },
    { q: '哈萨距达曼和巴林多远？', a: '从哈萨出发，经完善的高速公路网可便捷前往达曼与胡拜尔（距达曼约 150 公里，车程约 1.5 小时）。前往巴林王国，可自驾经胡拜尔跨越法赫德国王大桥（约 2 小时）。此外，若选择乘坐火车，沙特铁路公司的列车也停靠同一线路上邻近的布盖格站。' },
    { q: '如何预订利雅得—哈萨的火车票？', a: '您可通过沙特铁路公司的官方 App 或官网 sar.com.sa 购票，也可在车站售票窗口购买。该线路连接利雅得、胡富夫与达曼；节假日与出行高峰期建议提前订票。' },
    { q: '哈萨的邮政编码是多少？', a: '哈萨（胡富夫与穆巴拉兹）的邮政编码以 36 开头，具体编码因街区和位置而异。如需精确地址，请使用沙特邮政（SPL）的国家地址查询服务：splonline.com.sa。' },
    { q: '哈萨有哪些优质的酒店和度假别墅？', a: '哈萨的现代化酒店与度假村多分布在胡富夫与穆巴拉兹，另有传统客栈、老宅民居、度假别墅与可供租住的农庄，让您在棕榈林间享受地道的当地体验。请通过可信的预订平台比较各项选择与住客评价，找到最符合您预算与位置需求的住宿。（为保持信息中立，我们不推荐具体的住宿场所。）' },
    { q: '哈萨以哪些美食和特产闻名？', a: '哈萨以金黄的哈拉斯椰枣（Khalas，其最负盛名的品种）与哈萨红米闻名，民间美食则有哈里斯（Harees）、巴拉利特（Balaleet）、椰枣面包（当地又称“红面包”）等。绿洲瓜果有哈萨无花果、哈萨青柠、毛叶枣（Kanar），以及名为“苏瓦里”（Suwari）的石榴。手工艺方面，以扎里线刺绣的哈萨比什特长袍最为出名，凯撒利亚集市上还能买到陶器、棕榈叶编织品、熏香与香水。' },
    { q: '“哈萨”这个名字从何而来？', a: '“哈萨”（Al-Ahsa）是“希斯”（hisy）一词的复数，指在薄薄沙层之下流淌、蓄积的甘泉——用手拨开沙土，泉水便会涌出。这正是这片土地的真实写照：一片泉眼遍布、灌渠纵横、地下水丰沛的富饶绿洲，也因此成为世界上最大的绿洲。' },
    { q: '哈萨有哪些地道的传统早餐餐厅？', a: '胡富夫的多家传统餐厅供应哈萨式早餐与民间美食——哈萨焖饭、巴拉利特、哈里斯、椰枣面包（即“红面包”），部分农庄还可让您在田园风光中享用哈萨式早餐。选择时，建议您参考最新的当地评价。（为保持信息中立，我们不推荐具体的餐厅。）' },
  ],
  ctaH: '准备好了吗？开始收集您的心仪景点',
  ctaD: '浏览各处景点，将喜欢的加入“我的行程”，即可在谷歌地图中获取现成的游览路线。',
  ctaBrowse: '浏览景点',
  ctaTrip: '我的行程',
  seoTitle: '规划您的哈萨之旅——交通、最佳时间与实用贴士',
  seoDesc: '游览哈萨所需的一切信息：乘飞机、自驾与乘火车的交通方式，最佳到访时间，以及实用信息、游客贴士与常见问题——助您安心规划行程。',
});

const zh = lang === 'zh';
const browseHref = ar ? '/معالم/' : zh ? '/zh/attractions/' : '/en/attractions/';
// «رحلتي» بلا نسخة صينية بعد — تقصد الإنجليزية
const tripHref = ar ? '/رحلتي/' : zh ? '/zh/plan/' : '/en/plan/';
const siteUrl = 'https://visit-alahsa.com';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: C.faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : zh ? '/zh/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: t('nav.plan'), item: new URL(altHref(alt, lang), siteUrl).href },
  ] },
];
---
<Base title={`${C.seoTitle} ${titleSep(lang)} ${t('site.name')}`} description={C.seoDesc} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={C.eyebrow} title={C.title} lead={C.lead} leadWidth={56} motif="center" lang={lang} />

    <section class="sec" id="getting-there">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.getThereH}</h2>
        <div class="gt-grid">
          {C.getThere.map((g, i) => (
            <article class="gt-card" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="gt-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={TRAVEL_ICONS[g.icon]} /></span>
              <h3 class="gt-h">{g.h}</h3>
              <p class="gt-d">{g.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="practical">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.practicalH}</h2>
        <dl class="pr-grid">
          {C.practical.map((p, i) => (
            <div class="pr-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <dt class="pr-k">{p.k}</dt>
              <dd class="pr-v">{p.v}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="sec" id="tips">
      <div class="container">
        <h2 class="sec-h" data-reveal>{C.tipsH}</h2>
        <p class="lead" data-reveal>{C.tipsLead}</p>
        <ol class="tip-grid">
          {C.tips.map((p, i) => (
            <li class="tip-item" data-reveal style={`transition-delay:${i * 70}ms`}>
              <h3 class="tip-h">{p.h}</h3>
              <p class="tip-d">{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec sec--sand" id="faq">
      <div class="container faq-in">
        <h2 class="sec-h" data-reveal>{C.faqH}</h2>
        <div class="faq-list" data-reveal>
          {C.faq.map((f) => (
            <details class="faq">
              <summary class="faq-q">{f.q}</summary>
              <p class="faq-a">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pt-cta">
      <div class="container pt-cta-in" data-reveal>
        <h2 class="ptc-h">{C.ctaH}</h2>
        <p class="lead ptc-d">{C.ctaD}</p>
        <div class="ptc-btns">
          <a href={browseHref} class="btn btn--gold">{C.ctaBrowse}</a>
          <a href={tripHref} class="btn btn--turq">{C.ctaTrip}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .sec { padding-block: var(--s-7); }
  .sec--sand { background: var(--c-sand-2); }
  .sec-h { font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.2; margin-block-end: var(--s-5); }
  .gt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 248px), 1fr)); gap: var(--s-3); }
  .gt-card { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); padding: var(--s-5) var(--s-4); }
  .gt-icon { display: inline-grid; place-items: center; inline-size: 52px; block-size: 52px; border-radius: 13px; background: color-mix(in srgb, var(--c-turq) 12%, #fff); color: var(--c-turq-deep); margin-block-end: var(--s-3); }
  .gt-icon svg { inline-size: 26px; block-size: 26px; }
  .gt-h { font-size: var(--t-lg); color: var(--c-ink); margin-block-end: var(--s-2); }
  .gt-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }
  .pr-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 248px), 1fr)); gap: var(--s-4); margin: 0; }
  .pr-item { padding-inline-start: var(--s-3); border-inline-start: 2px solid rgba(201,154,74,.55); }
  .pr-k { font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-gold-deep); margin-block-end: var(--s-1); }
  .pr-v { margin: 0; font-size: var(--t-sm); color: var(--c-ink); line-height: 1.75; }
  .tip-grid { list-style: none; counter-reset: tip; padding: 0; margin-block-start: var(--s-5); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 248px), 1fr)); gap: var(--s-4); }
  .tip-item { counter-increment: tip; position: relative; padding-inline-start: 52px; }
  /* الترقيم لاتيني في اللغتين (قرار إياد 2026-07-21) */
  .tip-item::before { content: counter(tip); position: absolute; inset-inline-start: 0; inset-block-start: 0;
    inline-size: 38px; block-size: 38px; display: grid; place-items: center; border-radius: 50%;
    background: var(--c-turq); color: var(--c-sand); font-family: var(--font-heading); font-weight: 700; }
  .tip-h { font-size: var(--t-lg); color: var(--c-ink); margin-block-end: var(--s-1); }
  .tip-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }
  /* القيد على القائمة لا على الحاوية: بوضعه على .faq-in (وهي نفسها .container
     ذات margin-inline:auto) كانت الكتلة كلّها تتوسّط الصفحة بينما كل قسم آخر
     مرتكزٌ على حافة البداية. */
  .faq-list { max-inline-size: 72ch; }
  .faq { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); margin-block-end: var(--s-2); overflow: hidden; }
  /* شيفرون بلغة .cat-sec-chev بدل مؤشّر <details> الافتراضي — كان الرمز الوحيد
     في الموقع الذي يرسمه المتصفح، ويختلف شكله بين المتصفحات. */
  .faq-q { cursor: pointer; font-family: var(--font-body); font-weight: 600; font-size: var(--t-base); color: var(--c-turq-deep); padding: var(--s-3) var(--s-4); list-style: none; display: flex; align-items: center; gap: var(--s-3); }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after { content: ''; margin-inline-start: auto; flex: 0 0 auto; inline-size: 9px; block-size: 9px;
    border-inline-end: 2px solid var(--c-turq-deep); border-block-end: 2px solid var(--c-turq-deep);
    transform: rotate(45deg); transition: transform var(--dur) var(--ease); }
  .faq[open] .faq-q::after { transform: rotate(-135deg); }
  @media (prefers-reduced-motion: reduce) { .faq-q::after { transition: none; } }
  .faq-q:hover { color: var(--c-gold-deep); }
  .faq[open] .faq-q { border-block-end: 1px solid var(--c-line); }
  .faq-a { padding: var(--s-3) var(--s-4) var(--s-4); font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.8; max-inline-size: 65ch; }
  .pt-cta { background: var(--c-sand); padding-block: var(--s-8); text-align: center; }
  .pt-cta-in { max-inline-size: 56ch; margin-inline: auto; display: flex; flex-direction: column; align-items: center; gap: var(--s-3); }
  .ptc-h { font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.2; }
  .ptc-d { text-align: center; }
  .ptc-btns { display: flex; gap: var(--s-3); flex-wrap: wrap; justify-content: center; margin-block-start: var(--s-2); }
  @media (max-width: 760px) {
    .ptc-btns { flex-direction: column; align-items: stretch; inline-size: 100%; }
    .ptc-btns .btn { justify-content: center; }
  }
</style>
