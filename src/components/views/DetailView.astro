---
import { render, getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import HeroPoster from '../HeroPoster.astro';
import { catLabel } from '../../lib/categories';
import { attractionHref } from '../../lib/routes';
import { unescoOasisNode } from '../../lib/schema';
import { formatDate } from '../../lib/dates';
import { titleSep, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { entry: CollectionEntry<'attractions'>; lang: Lang; alt: AltLinks; }
const { entry, lang, alt } = Astro.props;
const a = entry.data;
const t = useTranslations(lang);
const ar = lang === 'ar';
const zh = lang === 'zh';
const de = lang === 'de';

// اختيار الحقل بلغة الصفحة — الصينية والألمانية تتراجعان للإنجليزية فالعربية عند الغياب
const pick = <T,>(arV: T, enV: T | undefined, zhV: T | undefined, deV?: T): T =>
  ar ? arV : zh ? (zhV ?? enV ?? arV) : de ? (deV ?? enV ?? arV) : (enV ?? arV);

const title = pick(a.title, a.title_en, a.title_zh, a.title_de);
const summary = pick(a.summary, a.summary_en, a.summary_zh, a.summary_de);
const bodyText = zh ? (a.body_zh ?? a.body_en ?? '')
  : de ? (a.body_de ?? a.body_en ?? '')
  : (a.body_en ?? a.summary_en ?? '');
const { Content } = ar ? await render(entry) : { Content: null };

// فئات الأسواق/المنتزهات/المزارع تتبع صفحتها المستقلة في الفتات وزر العودة (2026-07-13)
// الصينية: الفهرسان صينيان (الأسواق والمنتزهات أُضيفت في الدفعة 12 — 2026-09-03)
// الألمانية: لا فهارس /de/ بعد (مرحلة «النواة» لم تبدأ) — الفتات وزر العودة
// يقصدان النظير الإنجليزي مؤقتاً، كما كانت الصينية قبل دفعتها.
const isLeisure = ['market', 'parks', 'farm'].includes(a.category);
const attractionsHref = isLeisure
  ? (ar ? '/أسواق-ومنتزهات-ومزارع/' : zh ? '/zh/souqs-parks-farms/' : '/en/souqs-parks-farms/')
  : (ar ? '/معالم/' : zh ? '/zh/attractions/' : de ? '/de/attractions/' : '/en/attractions/');
const crumbLabel = isLeisure ? t('crumb.leisure') : t('crumb.attractions');
const backLabel = isLeisure ? t('det.allLeisure') : t('det.allSights');
const siteUrl = 'https://visit-alahsa.com';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const homeHref = ar ? '/' : zh ? '/zh/' : de ? '/de/' : '/en/';
const regionName = ar ? 'الأحساء' : zh ? '哈萨' : 'Al-Ahsa';
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'TouristAttraction',
    name: title, description: summary, url: pageUrl, image: siteUrl + (a.heroImage ? `${a.heroImage}.jpg` : '/og-default.png'),
    ...(a.location ? { geo: { '@type': 'GeoCoordinates', latitude: a.location.lat, longitude: a.location.lng } } : {}),
    address: { '@type': 'PostalAddress', addressLocality: pick(a.area, a.area_en, a.area_zh, a.area_de) ?? regionName, addressRegion: regionName, addressCountry: 'SA' },
    touristType: catLabel(a.category, lang),
    // alt[lang] هنا هو رابط صفحة المعلم نفسه — فكانت السكيما تقول إن المعلم جزءٌ
    // من نفسه في 116 صفحة (تدقيق 2026-08-28). الوجهة هي الرئيسية بلغة الصفحة.
    // ومعلم يحمل معرّف مكوّن يونسكو يصير جزءاً من الواحة كموقع تراث عالمي أيضاً
    // (بند 3.1 — 2026-09-04): عقدة ثانية في isPartOf لا استبدال للأولى.
    isPartOf: a.unesco
      ? [{ '@type': 'TouristDestination', name: regionName, url: new URL(homeHref, siteUrl).href }, unescoOasisNode(lang)]
      : { '@type': 'TouristDestination', name: regionName, url: new URL(homeHref, siteUrl).href },
    // sameAs: هوية المعلم في Wikidata وويكيبيديا — تُرمَّز عند الإصدار لأن المصدر
    // يحفظ روابط ويكيبيديا العربية مفكوكةً كي تبقى مقروءة في الملف.
    ...(a.sameAs.length ? { sameAs: a.sameAs.map((u) => encodeURI(u)) } : {}),
    ...(a.unesco ? { identifier: { '@type': 'PropertyValue', propertyID: 'UNESCO World Heritage Site component', value: a.unesco } } : {}),
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(homeHref, siteUrl).href },
    { '@type': 'ListItem', position: 2, name: crumbLabel, item: new URL(attractionsHref, siteUrl).href },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ] },
];
const ogImage = a.heroImage ? `${a.heroImage}.jpg` : '/og-default.png';

// بطاقة معلومات الزيارة بلغة الصفحة: البند لا يظهر إلا إن وُجدت ترجمته للغة
// الصفحة (label_en/value_en أو label_zh/value_zh) — لا نعرض لغةً داخل صفحة أخرى.
const areaVal = ar ? a.area : zh ? (a.area_zh ?? null) : de ? (a.area_de ?? null) : (a.area_en ?? null);
const bestTimeVal = ar ? a.bestTime : zh ? (a.bestTime_zh ?? null) : de ? (a.bestTime_de ?? null) : (a.bestTime_en ?? null);
const shownPractical = a.practical
  .filter((p) => p.verified && (ar || (zh ? p.label_zh && p.value_zh : de ? p.label_de && p.value_de : p.label_en && p.value_en)));
const practicalItems = shownPractical.map((p) => ({
  label: ar ? p.label : zh ? p.label_zh! : de ? p.label_de! : p.label_en!,
  value: ar ? p.value : zh ? p.value_zh! : de ? p.value_de! : p.value_en!,
}));
const hasTimeFee = a.practical.some((p) => p.verified && /المواعيد|الرسوم/.test(p.label));

// ── الإسناد (2026-08-31) ──────────────────────────────────────────────────
// كانت البطاقة تحمل ملاحظة واحدة «روجعت في يونيو 2026م» تسري على كل البنود
// بتاريخٍ واحد مكتوبٍ يدوياً — تتقادم بصمت ولا تقول من أين جاءت المعلومة.
// صارت تُشتقّ من حقلَي source/verifiedAt الإلزاميين لكل بند موثّق (المخطط
// يرفض البناء بدونهما)، وتُجمَّع البنود المتشاركة في المصدر والتاريخ نفسه
// فلا يتكرّر السطر تحت كل صف.
const sourceGroups = [...shownPractical
  .reduce((m, p) => {
    // اسم المصدر بلغة الصفحة — الصينية تتراجع للإنجليزية على سلسلة الموقع
    const name = ar ? p.source! : zh ? (p.source_zh ?? p.source_en!) : de ? (p.source_de ?? p.source_en!) : p.source_en!;
    const key = `${name}|${p.verifiedAt}|${p.sourceUrl ?? ''}`;
    if (!m.has(key)) m.set(key, { source: name, verifiedAt: p.verifiedAt!, sourceUrl: p.sourceUrl, labels: [] as string[] });
    m.get(key)!.labels.push(ar ? p.label : zh ? p.label_zh! : de ? p.label_de! : p.label_en!);
    return m;
  }, new Map<string, { source: string; verifiedAt: string; sourceUrl?: string; labels: string[] }>())
  .values()];

// سلاسل مضمّنة خارج القاموس — كل لغة جديدة تحتاج فرعاً هنا يدوياً، **والفشل
// صامت**: مفاتيح القاموس تبدو مكتملة بينما الصفحة تعرض الإنجليزية (رصدته
// المرحلتان 1 و3 من دفعة الواجهة الألمانية 2026-09-03).
const srcLabel = ar ? 'المصدر' : zh ? '来源' : de ? 'Quelle' : 'Source';
const verifiedLabel = ar ? 'تاريخ التحقق' : zh ? '核实日期' : de ? 'Zuletzt geprüft' : 'Verified';
// الصيني من خط zh-translation-pipeline (misc.reviewNote — دورة 2026-08-29)
// والألماني من خط de-translation-pipeline (دفعة الواجهة — الحاكم 90/100)
const reviewNote = ar
  ? 'المواعيد والرسوم قابلة للتغيير في المواسم والأعياد.'
  : zh
    ? '开放时间与门票价格可能随季节和节假日变动。'
    : de
      ? 'Öffnungszeiten und Eintritt können sich je nach Saison und an Feiertagen ändern.'
      : 'Hours and fees can change in seasons and holidays.';

// «أكمل يومك» — أقرب 3 معالم تُحسب وقت البناء من الإحداثيات الموثّقة في ملفات المعالم.
// المسافة بخطٍّ مستقيم (haversine) وتُعرض تقريبية بالكيلومتر — لا تُقدَّر مسافات قيادة.
const kmBetween = (la1: number, lo1: number, la2: number, lo2: number) => {
  const r = Math.PI / 180, R = 6371;
  const dLa = (la2 - la1) * r, dLo = (lo2 - lo1) * r;
  const h = Math.sin(dLa / 2) ** 2 + Math.cos(la1 * r) * Math.cos(la2 * r) * Math.sin(dLo / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
};
const nearby = a.location
  ? (await getCollection('attractions'))
      .filter((e) => e.data.slug_ar !== a.slug_ar && e.data.location)
      .map((e) => ({
        // البطاقة القريبة بلغة الصفحة، وعنوانها يتراجع للإنجليزية إن غابت
        // ترجمته الصينية — لكن رابطها يقصد صفحة اللغة الحالية إن وُجدت،
        // وإلا فالإنجليزية (لا رابط لصفحة /zh/ غير مولّدة).
        href: attractionHref(e.data, (zh && !e.data.title_zh) || (de && !e.data.title_de) ? 'en' : lang),
        title: ar ? e.data.title
          : zh ? (e.data.title_zh ?? e.data.title_en ?? e.data.title)
          : de ? (e.data.title_de ?? e.data.title_en ?? e.data.title)
          : (e.data.title_en ?? e.data.title),
        cat: catLabel(e.data.category, lang),
        // العنوان المتراجع للإنجليزية يُوسم lang="en" فيقرؤه قارئ الشاشة بلغته،
        // ويستثنيه الحارس C18 (تهجئة Souk الألمانية) من نصّ الصفحة الألماني.
        titleLang: (zh && !e.data.title_zh) || (de && !e.data.title_de) ? 'en' : undefined,
        img: e.data.heroImage,
        km: kmBetween(a.location!.lat, a.location!.lng, e.data.location!.lat, e.data.location!.lng),
      }))
      .sort((x, y) => x.km - y.km)
      .slice(0, 3)
      .map((n) => ({
        ...n,
        // الصيني من خط الإنتاج (misc.underKm/aboutKm — دورة 2026-08-29)
        // والألماني من دفعة الواجهة الألمانية (detail.underKm/aboutKm — 2026-09-03)
        dist: n.km < 1
          ? (ar ? 'أقل من كيلومتر' : zh ? '不足 1 公里' : de ? 'unter 1 km' : 'under 1 km')
          : (ar ? `نحو ${Math.round(n.km)} كم` : zh ? `约 ${Math.round(n.km)} 公里` : de ? `ca. ${Math.round(n.km)} km` : `~${Math.round(n.km)} km`),
      }))
  : [];
---
<Base title={`${title} ${titleSep(lang)} ${t('site.name')}`} description={summary} lang={lang} alt={alt} type="article" image={ogImage} jsonLd={jsonLd} preloadImage={a.heroImage}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class={`att-hero photo ${a.heroImage ? '' : 'photo--placeholder'}`}>
      {a.heroImage && (
        <HeroPoster src={a.heroImage} />
      )}
      <PalmMotif size={360} class="ah-wm" />
      <div class="container ah-in">
        <nav class="crumbs" aria-label={t('a11y.crumbs')}>
          <a href={homeHref}>{t('crumb.home')}</a><span>/</span>
          <a href={attractionsHref}>{crumbLabel}</a><span>/</span>
          <span aria-current="page">{title}</span>
        </nav>
        <span class="eyebrow gold-on-dark ah-k">{catLabel(a.category, lang)}</span>
        <h1 class="ah-title">{title}</h1>
        <p class="ah-sum">{summary}</p>
        <button class="fav-btn ah-fav" type="button" data-fav={a.slug_ar} data-tx-on={t('fav.added')} data-tx-off={t('fav.add')} aria-pressed="false">
          <span class="fav-ic">+</span><span data-fav-tx>{t('fav.add')}</span>
        </button>
      </div>
    </section>

    <div class="container att-layout">
      <article class="prose" data-reveal>
        {ar && Content ? <Content /> : <p>{bodyText}</p>}
      </article>

      <aside class="att-aside" data-reveal>
        <div class="info-card">
          <h2 class="info-h">{t('det.visitInfo')}</h2>
          <dl class="info-list">
            {areaVal && (<><dt>{t('det.area')}</dt><dd>{areaVal}</dd></>)}
            {bestTimeVal && (<><dt>{t('det.bestTime')}</dt><dd>{bestTimeVal}</dd></>)}
            {practicalItems.map((p) => (
              <><dt>{p.label}</dt><dd>{p.value}</dd></>
            ))}
          </dl>
          {practicalItems.length > 0 && hasTimeFee && (
            <p class="info-note">{reviewNote}</p>
          )}
          {sourceGroups.length > 0 && (
            <p class="info-src">
              {sourceGroups.map((g) => (
                <span class="src-line">
                  <span class="src-k">{srcLabel}:</span>{' '}
                  {g.sourceUrl
                    ? <a href={g.sourceUrl} target="_blank" rel="noopener">{g.source}</a>
                    : g.source}
                  {' · '}
                  <span class="src-k">{verifiedLabel}:</span>{' '}
                  <time datetime={g.verifiedAt}>{formatDate(new Date(g.verifiedAt), lang)}</time>
                </span>
              ))}
            </p>
          )}
          {/* رابط الخريطة: أيقونة صغيرة داخل البطاقة نفسها بدل اللوحة الخضراء الكبيرة
              التي كانت تحتلّ العمود (تغيير بطلب إياد 2026-07-22) */}
          {a.mapUrl && (
            <a class="map-link" href={a.mapUrl} target="_blank" rel="noopener">
              <svg class="map-ic" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z" />
                <circle cx="12" cy="10" r="2.6" />
              </svg>
              {t('det.openMaps')}
            </a>
          )}
          <a class="report-link" href={`${ar ? '/أبلغ/' : '/en/report/'}?page=${encodeURIComponent(decodeURI(Astro.url.pathname))}`}>{t('det.report')}</a>
        </div>
      </aside>
    </div>

    {/* الشرط على القسم كله لا على محتواه: القسم الفارغ كان يترك فراغاً 32–48px */}
    {a.gallery.length > 0 && (
      <section class="container gallery-sec" data-reveal>
        <h2 class="gal-h">{t('det.fromPlace')}</h2>
        <div class="gal-grid">
          {a.gallery.map((g, i) => (
            <Photo src={g} label={`${title} — ${t('det.photo')} ${i + 1}`} class="gal-item" sizes="(max-width: 760px) 50vw, 33vw" />
          ))}
        </div>
      </section>
    )}

    {nearby.length > 0 && (
      <section class="nearby-sec">
        <div class="container" data-reveal>
          <h2 class="nb-h">{t('det.nearby.h')}</h2>
          <p class="nb-lead">{t('det.nearby.d')}</p>
          <div class="nb-grid">
            {nearby.map((n) => (
              <a class="card card--lift nb-card" href={n.href}>
                <Photo src={n.img} label={n.title} class="nb-photo" sizes="(max-width: 760px) 100vw, 33vw" />
                <div class="nb-body">
                  <span class="t-caption nb-k">{n.cat}</span>
                  <h3 class="nb-t" lang={n.titleLang}>{n.title}</h3>
                  <span class="nb-dist">{n.dist}</span>
                </div>
              </a>
            ))}
          </div>
          <p class="nb-note">{t('det.nearby.note')}</p>
        </div>
      </section>
    )}

    <section class="container back-sec">
      <a href={attractionsHref} class="btn btn--turq back-btn">{backLabel}</a>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .att-hero { position: relative; overflow: hidden; color: var(--c-sand); min-block-size: 46vh; display: flex; align-items: flex-end; }
  /* تعتيم اتجاهي تحت كتلة النصّ — تدرّج .photo العامّ شفافٌ في أعلى 40% من
     الحاوية، وهناك تقع الفتات والتسمية، فكانتا تختفيان فوق الصور الساطعة. */
  .att-hero::before {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: var(--hero-scrim-soft);
  }
  /* :global لأن PalmMotif مكوّن منفصل والـ scoped CSS لا تصله — بدونها تبقى
     السعفة عنصراً في التدفق يدفع نصّ الهيرو عن حافة البداية (سبب انعكاس الاتجاه) */
  :global(.ah-wm) { position: absolute; inset-block-start: -6%; inset-inline-end: -4%; color: var(--c-gold); opacity: .12; z-index: 0; }
  /* لا max-inline-size على الحاوية نفسها: مع margin-inline:auto كانت الكتلة
     تنكمش وتنزاح عن حافة البداية (العربي يظهر يسار الشاشة والإنجليزي يمينها).
     التحديد على الفقرات الداخلية فقط. */
  .ah-in { position: relative; z-index: 2; padding-block: var(--s-6); }
  .crumbs { display: flex; gap: var(--s-2); align-items: center; font-size: var(--t-xs); margin-block-end: var(--s-3); flex-wrap: wrap; }
  .crumbs a { display: inline-block; padding-block: var(--s-1); color: rgba(247,243,234,.92); text-decoration: none; }
  .crumbs a:hover { color: var(--c-gold-bright); }
  .crumbs span { color: rgba(247,243,234,.62); }
  /* تسمية الفئة صارت eyebrow مثل بقيّة أبطال الموقع: نصٌّ رملي وزخرفة ذهبية.
     كانت نصّاً ذهبياً صغيراً فوق صورة — دون 4.5:1 المطلوبة للنصّ الصغير. */
  .ah-k { margin-block-end: var(--s-1); }
  .ah-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .ah-sum { font-size: var(--t-lg); color: rgba(247,243,234,.92); max-inline-size: 52ch; }
  /* min-inline-size لا تقصيرُ نصّ: الزرّ يبدّل تسميته بين «أضف» و«في رحلتي ✓»
     (‏data-tx-on/off)، والفارق بالألمانية تسعة محارف مقابل اثنين بالإنجليزية —
     فيقفز عرض الزرّ تحت إصبع الزائر لحظة الضغط. */
  .ah-fav { margin-block-start: var(--s-4); min-inline-size: 15ch; background: transparent; color: var(--c-sand); border-color: rgba(247,243,234,.5); }
  .ah-fav:hover { border-color: var(--c-sand); }
  .ah-fav.is-saved { background: var(--c-gold); color: var(--c-ink); border-color: var(--c-gold); }
  .att-layout { display: grid; grid-template-columns: 1fr 320px; gap: var(--s-6); padding-block: var(--s-7); align-items: start; }
  .prose { font-size: var(--t-base); line-height: 1.85; color: var(--c-ink); max-inline-size: 68ch; }
  .prose :global(p) { margin-block-end: var(--s-4); }
  .prose :global(strong) { color: var(--c-turq-deep); font-weight: 600; }
  .att-aside { position: sticky; inset-block-start: 88px; display: flex; flex-direction: column; gap: var(--s-3); }
  .info-card { background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: var(--radius); padding: var(--s-4); }
  .info-h { font-size: var(--t-lg); color: var(--c-turq-deep); margin-block-end: var(--s-3); }
  .info-list { display: grid; grid-template-columns: auto 1fr; gap: var(--s-2) var(--s-3); margin: 0; }
  .info-list dt { font-size: var(--t-xs); color: var(--c-ink-soft); font-weight: 600; white-space: nowrap; }
  .info-list dd { font-size: var(--t-sm); color: var(--c-ink); margin: 0; }
  .info-note { font-size: var(--t-xs); color: var(--c-ink-soft); line-height: 1.7; margin-block-start: var(--s-3); }
  /* سطر الإسناد: يُفصل بخطٍّ ويصغر حجمه، لكن لونه --c-ink-soft لا --c-ink-60.
     قيس فعلياً على خلفية البطاقة #EFE8D6 (2026-08-31): ink-60 يعطي 4.36:1
     ودون AA، وink-soft يعطي 8:1. الإسناد بيان مصداقية يُقرأ لا زخرفة تُلمح. */
