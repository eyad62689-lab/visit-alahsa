---
// صفحة شكر ما بعد إرسال بلاغ الخطأ (وجهة action في نموذج Netlify).
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import { localize, titleSep, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const C = localize(lang, {
  ar: {
    title: 'وصل بلاغك — شكراً لك',
    d: 'سيراجع فريق الموقع الملاحظة ويصحح ما يثبت منها. مساهمتك تُبقي دليل الأحساء دقيقاً للجميع.',
    back: 'عودة إلى الرئيسية',
  },
  en: {
    title: 'Your report has arrived — thank you',
    d: 'The site team will review the note and correct whatever is confirmed. Your contribution keeps the Al-Ahsa guide accurate for everyone.',
    back: 'Back to home',
  },
  // خط zh-translation-pipeline (المرحلة هـ، 2026-09-26)
  zh: {
    title: "您的反馈已收到——谢谢您",
    d: "网站团队将核实您的反馈，并更正查证属实的问题。您的贡献让哈萨指南对每一位读者始终保持准确。",
    back: "返回首页",
  },
  // خط de-translation-pipeline (المرحلة هـ، 2026-09-26)
  de: {
    title: "Ihre Meldung ist eingegangen – vielen Dank",
    d: "Das Team der Website prüft den Hinweis und korrigiert die Angabe, sobald sie sich bestätigt. Mit Ihrem Beitrag bleibt der Al-Ahsa-Reiseführer für alle korrekt.",
    back: "Zurück zur Startseite",
  },
  // خط ru-translation-pipeline (المرحلة هـ، 2026-09-26)
  ru: {
    title: "Ваше сообщение получено — спасибо",
    d: "Команда сайта проверит замечание и исправит всё, что подтвердится. Ваш вклад помогает поддерживать точность путеводителя по Аль-Ахсе для всех.",
    back: "Вернуться на главную",
  },
});
const homeHref = ar ? '/' : `/${lang}/`;
---
<Base title={`${C.title} ${titleSep(lang)} ${t('site.name')}`} description={C.d} lang={lang} alt={alt} noindex={true}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="container tk-body">
      <PalmMotif size={64} class="tk-palm" />
      <h1 class="tk-h">{C.title}</h1>
      <p class="tk-d">{C.d}</p>
      <a href={homeHref} class="btn btn--turq">{C.back}</a>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .tk-body { text-align: center; max-inline-size: 52ch; margin-inline: auto; padding-block: var(--s-8); }
  :global(.tk-palm) { color: var(--c-turq); opacity: .45; margin-inline: auto; }
  .tk-h { font-size: var(--t-2xl); color: var(--c-turq-deep); margin-block: var(--s-3) var(--s-2); line-height: 1.2; }
  .tk-d { color: var(--c-ink-soft); margin-block-end: var(--s-5); line-height: 1.8; }
</style>
