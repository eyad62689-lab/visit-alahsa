---
// صفحة «المطبخ الأحسائي» (كانت «الأكلات الشعبية» — أعيدت تسميتها بطلب إياد 2026-07-13؛
// المسار /أكلات/ باقٍ حفاظاً على الروابط) — صور الأطباق الثمانية مقصوصة من لوحة قدّمها إياد
// (2026-07-10) في public/img/food. قاعدة ملزمة: لا تُختلق معلومة؛ الأوصاف تعريفية عامة
// بمكوّنات الأطباق المعروفة، بلا مواعيد ولا رسوم ولا ادّعاءات تاريخية غير موثقة.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

type Dish = { img: string; alt: string; k: string; name: string; pre: string; };
type Group = { title: string; dishes: Dish[] };

const C = ar ? {
  heroEyebrow: 'من موائد الواحة',
  title: 'المطبخ الأحسائي',
  heroSum: 'يقوم المطبخ الأحسائي على خيرات الواحة: الأرز الأحسائي المحلي، ودبس التمر، واللومي، والقمح المجروش — فتولد أطباقٌ دافئة توارثتها الموائد جيلاً بعد جيل.',
  listEyebrow: 'جولة المذاق',
  listH: 'ثمانية أطباق من قلب الواحة',
  methodH: 'حول هذه الصفحة',
  methodP1: 'الأوصاف هنا للتعريف بالأطباق الشعبية ومكوّناتها المعروفة، لا وصفاتٍ دقيقة؛ إذ تتفاوت المقادير والمسمّيات من بيتٍ لآخر ومن منطقةٍ لأخرى.',
  groups: [
    {
      /* أزيلت عناوين المجموعات («أطباق رئيسية» و«حلويات ومعجنات بالتمر») بطلب
         إياد (2026-07-13) — التصنيف يظهر على بطاقة كل طبق (طبق رئيسي/حلى/خبز) */
      title: '',
      dishes: [
        { img: '/img/food/hasawi-rice', alt: 'الأرز الأحسائي باللحم والليمون في طبق تقديم', k: 'طبق رئيسي', name: 'الأرز الأحسائي',
          pre: 'طبق الأحساء الأشهر: أرزٌ أحسائي محلي يُطهى مع اللحم أو الدجاج وصلصة الطماطم والبهارات (لومي وقرفة وهيل) حتى يكتسب لونه البني المحمّر ونكهته الغنية. يُقدَّم في المناسبات وموائد الضيافة.' },
        { img: '/img/food/mandi', alt: 'المندي بالأرز والدجاج والخضار', k: 'طبق رئيسي', name: 'المندي',
          pre: 'في الأحساء، المندي لا يُطهى … بل يُستودَع في باطن الأرض كما تُستودَع الأسرار. لحمٌ يتشرّب أنفاس التنور الطيني ساعاتٍ طوال، وأرزٌ يحمل عبق النخيل والدخان، ليقدَّم إليك طبقًا يروي حكاية واحةٍ عرفت الكرم قبل أن تعرفه الكلمات.' },
        { img: '/img/food/harees-v2', alt: 'صحن الهريس وفي وسطه السمن، مع التمر والدلة في أجواء الواحة', k: 'طبق رئيسي', name: 'الهريس',
          pre: 'حين يمتزج القمح باللحم حتى يصيرا روحًا واحدة، يولد الهريس. طبق الكرم الأول في ولائم الأحساء وأفراحها، ورفيق موائد رمضان منذ الأزل.' },
        { img: '/img/food/mufallaq', alt: 'المفلق بالجريش والتمر والبيض المسلوق', k: 'طبق رئيسي', name: 'المفلق',
          pre: 'من الأطباق التراثية الأحسائية: قمحٌ مجروش (جريش) يُطهى بالبهارات ويُنكَّه باللومي، ثم يُزيَّن بالتمر والبيض المسلوق. طبقٌ دسمٌ يجمع نكهات الواحة.' },
        { img: '/img/food/balaleet', alt: 'البلاليط بالدبس مع عجّة البيض واللوز', k: 'حلى', name: 'البلاليط بالدبس',
          pre: 'شعيريةٌ ذهبية معطّرة بالزعفران والهيل، تتحلّى على الطريقة الأحسائية بدبس التمر؛ فمن أرضٍ هي عاصمة النخيل، يأتي الحلا من التمر ذاته.' },
        { img: '/img/food/date-asida', alt: 'عصيدة التمر وحفرة الدبس في وسطها', k: 'حلى', name: 'عصيدة التمر',
          pre: 'تمرُ الأحساء ذاته يذوب مع دقيق البرّ على نارٍ هادئة، وتُقلَّب العصيدة بصبرٍ حتى تتماسك وتلمع بالزعفران، ثم تُتوَّج بالسمن ورشّة فلفلٍ أسود تُشعل دفأها. حلا الشتاء الأحسائي الذي تلتفّ حوله العائلة في الليالي الباردة.' },
        { img: '/img/food/sago', alt: 'الساقو مزيّناً بالجوز والفستق', k: 'حلى', name: 'الساقو',
          pre: 'حبيباتٌ صغيرة تذوب على النار حتى تصير جوهرًا شفافًا يتلألأ بالزعفران والهيل. حلوى الأحساء التي تتصدّر موائد رمضان، رقيقةُ القوام، عريقةُ الحضور، لا يعرف سرَّ إتقانها إلا أهل الواحة.' },
        { img: '/img/food/date-bread', alt: 'خبز التمر مرشوشاً بحبة البركة', k: 'خبز', name: 'خبز التمر',
          pre: 'خبزٌ محليٌّ يُعجن أو يُحشى بمعجون التمر ويُرشُّ بحبّة البركة (الحبّة السوداء)، فيجمع بين طيّبِ الخبز وحلاوةِ التمر. يُقدَّم مع القهوة العربية.' },
      ],
    },
  ] as Group[],
} : {
  heroEyebrow: 'From the oasis table',
  title: 'Hasawi Cuisine',
  heroSum: "Al-Ahsa's kitchen rests on the bounty of the oasis: local Hasawi rice, date syrup, lime and cracked wheat — giving rise to warm dishes handed down the tables generation after generation.",
  listEyebrow: 'A taste tour',
  listH: 'Eight dishes from the heart of the oasis',
  methodH: 'About this page',
  methodP1: 'The descriptions here introduce the traditional dishes and their well-known ingredients rather than exact recipes; measures and names vary from one household and region to the next.',
  groups: [
    {
      title: '',
      dishes: [
        { img: '/img/food/hasawi-rice', alt: 'Hasawi rice with meat and lime in a serving dish', k: 'Main dish', name: 'Hasawi Rice',
          pre: "Al-Ahsa's most famous dish: local long-grain Hasawi rice cooked with meat or chicken, tomato and spices (dried lime, cinnamon, cardamom) until it takes on its reddish-brown colour and rich flavour. A staple of celebrations and hospitality." },
        { img: '/img/food/mandi', alt: 'Mandi with rice, chicken and vegetables', k: 'Main dish', name: 'Mandi',
          pre: 'Spiced rice with slow-cooked chicken or meat prepared in the mandi style until tender and infused with flavour, garnished with vegetables — a beloved dish on Hasawi tables.' },
        { img: '/img/food/harees-v2', alt: 'A dish of harees with ghee at its centre, with dates and a coffee pot in an oasis setting', k: 'Main dish', name: 'Harees',
          pre: 'Cracked wheat simmered with meat for long hours until the two blend into a smooth, creamy texture, served hot with ghee. A blessed dish, especially common in Ramadan and at feasts.' },
        { img: '/img/food/mufallaq', alt: 'Mufallaq of cracked wheat with dates and boiled eggs', k: 'Main dish', name: 'Mufallaq',
          pre: 'A traditional Hasawi dish of cracked wheat (jareesh) cooked with spices and dried lime, then garnished with dates and boiled eggs — a hearty plate gathering the flavours of the oasis.' },
        { img: '/img/food/balaleet', alt: 'Balaleet with date syrup, egg omelette and almonds', k: 'Sweet', name: 'Balaleet with Date Syrup',
          pre: 'Fine vermicelli fried and sweetened, scented with cardamom and saffron, served with an egg omelette and almonds — here with Hasawi date syrup. A heritage breakfast marrying sweet and savoury.' },
        { img: '/img/food/date-asida', alt: 'Date asida with a well of syrup in its centre', k: 'Sweet', name: 'Date Asida',
          pre: 'A thick cooked flour paste with a well of date syrup (dibs) and ghee poured into its centre. A warm winter sweet eaten by hand.' },
        { img: '/img/food/sago', alt: 'Sago garnished with walnuts and pistachios', k: 'Sweet', name: 'Sago',
          pre: 'A famous Hasawi sweet of sago starch cooked with date syrup, cardamom and saffron into a glossy, jelly-like texture, garnished with walnuts and pistachios.' },
        { img: '/img/food/date-bread', alt: 'Date bread sprinkled with black seed', k: 'Bread', name: 'Date Bread',
          pre: 'A local bread kneaded or filled with date paste and sprinkled with black seed (nigella), uniting good bread with the sweetness of dates. Served with Arabic coffee.' },
      ],
    },
  ] as Group[],
};

const pageTitle = `${C.title} — ${t('site.name')}`;
const description = ar
  ? 'جولة في المطبخ الأحسائي: الأرز الأحسائي، المندي، الهريس، المفلق، البلاليط بالدبس، عصيدة التمر، الساقو، وخبز التمر.'
  : 'A tour of Hasawi cuisine: Hasawi rice, mandi, harees, mufallaq, balaleet with date syrup, date asida, sago and date bread.';

const siteUrl = 'https://visit-alahsa.com';
const selfPath = ar ? '/أكلات/' : '/en/food/';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: C.title, item: new URL(selfPath, siteUrl).href },
  ] },
];
---
<Base title={pageTitle} description={description} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-food">
  <Header lang={lang} alt={alt} />
  <main id="main">

    <section class="fd-hero on-dark">
      <picture class="photo-bg fdh-poster" aria-hidden="true">
        <source srcset="/img/hero-food.webp" type="image/webp" />
        <img src="/img/hero-food.jpg" alt="" fetchpriority="high" decoding="async" />
      </picture>
      <video class="photo-bg fdh-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
        <source data-src="/video/hero-food.mp4" type="video/mp4" />
      </video>
      <PalmMotif size={320} class="fdh-wm" aria-hidden="true" />
      <div class="container fdh-in">
        <span class="eyebrow gold-on-dark">{C.heroEyebrow}</span>
        <h1 class="fdh-title">{C.title}</h1>
        <p class="fdh-sum">{C.heroSum}</p>
      </div>
    </section>

    <section class="container fd-list">
      <div class="fd-head">
        <span class="eyebrow">{C.listEyebrow}</span>
        <h2>{C.listH}</h2>
      </div>

      {C.groups.map((g) => (
        <div class="fgroup">
          {g.title && <div class="fgroup-head"><h3>{g.title}</h3></div>}
          <div class="fgrid">
            {g.dishes.map((d, idx) => (
              <article class="dish-card" data-reveal style={`transition-delay:${(idx % 4) * 60}ms`}>
                <Photo src={d.img} label={d.alt} class="fd-photo" sizes="(max-width: 760px) 100vw, 25vw" />
                <div class="dc-body">
                  <span class="t-caption dc-k">{d.k}</span>
                  <h4>{d.name}</h4>
                  <p>{d.pre}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="container fd-method">
      <div class="method-box">
        <h2>{C.methodH}</h2>
        <p>{C.methodP1}</p>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</Base>

<script is:inline>
  /* تفعيل فيديو الهيرو كسولاً — يحترم تفضيل تقليل الحركة وتوفير البيانات */
  function initFoodHeroVideo() {
    const v = document.querySelector('.fdh-video');
    if (!v || v.dataset.wired) return;
    v.dataset.wired = '1';
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = navigator.connection && navigator.connection.saveData === true;
    if (reduceMotion || saveData) return;
    const s = v.querySelector('source');
    if (s && s.dataset.src) {
      v.addEventListener('playing', () => v.classList.add('fdh-video--on'), { once: true });
      s.src = s.dataset.src;
      v.autoplay = true;
      v.load();
      v.addEventListener('canplay', () => { v.play().catch(() => {}); }, { once: true });
    }
  }
  document.addEventListener('astro:page-load', initFoodHeroVideo);
  if (document.readyState !== 'loading') initFoodHeroVideo(); else document.addEventListener('DOMContentLoaded', initFoodHeroVideo);
</script>

<style>
  /* ═══ الهيرو ═══ */
  .fd-hero { position: relative; overflow: hidden; background: var(--c-turq-deep); padding-block: var(--s-8) var(--s-7); }
  .fdh-video { object-fit: cover; inline-size: 100%; block-size: 100%; opacity: 0; transition: opacity 1.2s var(--ease); filter: saturate(.94) contrast(1.03); }
  .fdh-video--on { opacity: 1; }
  /* طبقة تعتيم لضمان وضوح النصّ فوق الفيديو */
  .fd-hero::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(105deg, rgba(0,42,38,.82) 0%, rgba(0,55,49,.55) 50%, rgba(0,79,70,.4) 100%);
  }
  :global(.fdh-wm) { position: absolute; inset-block-start: -10%; inset-inline-end: -5%; z-index: 0; color: var(--c-gold); opacity: .1; }
  /* التحديد على الفقرة لا على الحاوية — وإلا انزاحت الكتلة عن حافة البداية */
  .fdh-in { position: relative; z-index: 2; }
  .fdh-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-3xl); line-height: 1.1; margin-block: var(--s-2) var(--s-3); }
  .fdh-sum { font-size: var(--t-lg); color: rgba(247,243,234,.9); max-inline-size: 62ch; }

  /* ═══ قسم الأطباق ═══ */
  .fd-list { padding-block: var(--s-6) var(--s-8); }
  .fd-head { margin-block-end: var(--s-6); }
  .fd-head h2 { font-size: var(--t-2xl); margin-block-start: var(--s-2); }

  .fgroup { margin-block-end: var(--s-7); }
  .fgroup:last-of-type { margin-block-end: 0; }
  .fgroup-head { display: flex; align-items: center; gap: var(--s-3); margin-block-end: var(--s-4); }
  .fgroup-head h3 { font-size: var(--t-xl); color: var(--c-turq-deep); }
  .fgroup-head::after { content: ''; flex: 1; block-size: 1px; background: var(--c-line); }
  .fgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: var(--s-4); }

  .dish-card { background: #fff; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); display: flex; flex-direction: column; }
  .dc-body { padding: var(--s-3) var(--s-4) var(--s-5); display: flex; flex-direction: column; gap: var(--s-2); }
  .dc-k { color: var(--c-gold-deep); }
  .dish-card h4 { font-size: var(--t-lg); color: var(--c-turq-deep); }
  .dish-card p { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }

  /* صور الأطباق: أطباق مقصوصة على خلفية كريمية، مربّعة — بلا طبقة الظل الفيروزية */
  :global(.fd-photo) { aspect-ratio: 1 / 1; }
  :global(picture.fd-photo) { background: var(--c-sand); }
  :global(picture.fd-photo)::after { content: none; }

  /* ═══ الملاحظة ═══ */
  .fd-method { padding-block: 0 var(--s-7); }
  .method-box { background: #fff; border-inline-start: 4px solid var(--c-gold); border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); max-inline-size: 78ch; }
  .method-box h2 { font-size: var(--t-lg); margin-block-end: var(--s-2); }
  .method-box p { font-size: var(--t-sm); color: var(--c-ink-soft); }
</style>
