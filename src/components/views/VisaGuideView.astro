---
// صفحة «دليل التأشيرات» — بلغات الموقع الست (إعادة كتابة 2026-10-16 بقرار إياد؛ zh/de/ru/ur عبر خطوط
// الترجمة 2026-10-17، واللغات المبنية في VISA_LANGS بـsrc/lib/visa-guide.mjs).
//
// المصدر الوحيد للنصّ: src/data/visa-guide.ts (سجلّ لكل لغة). هذه الواجهة تُنسّق فقط:
//   1. الهيرو: H1 والنبذة وسطر الرسوم العام وسطر التحقق من المصدر الرسمي وتاريخ آخر تحديث.
//   2. بطاقات: تمهيد الأحساء (روابط داخلية)، جدول «اختر مسارك» (4 أعمدة)، قسم لكل مسار من
//      الثمانية ينتهي بزر المنصة الرسمية، الوصول إلى الأحساء، خطواتك بعد التأشيرة، الأسئلة
//      الشائعة (details/summary كصفحة «خطّط»)، جدول الروابط الرسمية.
//   3. كل رابط خارجي يُفتح في نافذة جديدة بـrel="noopener"؛ الروابط الرسمية من
//      VISA_OFFICIAL_LINKS وحدها. الجداول بقشرة الموقع (tbl-wrap + va-table) بلا data-table
//      عمداً: C24 يحرس جداول مصادر الحقيقة الثلاثة (practical/events/fruits) وحدها.
//   4. JSON-LD بالآلية القائمة (jsonLd في Base): Article + FAQPage (الأسئلة المرئية نفسها)
//      + BreadcrumbList (الرئيسية ← خطّط لرحلتك ← الدليل).
// يحرس ذلك كله C28 (tools/check-visa-guide.mjs) على dist: صفر «لم يُتحقَّق»، صفر عملات
// ورسوم، الروابط الرسمية حرفياً ولا سواها، الأسئلة 5–7 ومطابقة لـFAQPage، 5 روابط داخلية
// على الأقل، سطر التحديث، hreflang بين اللغتين، والعنوان والوصف ضمن حدودهما.
//
// ملاحظة المعاينة «يجب فتح كل رابط يدوياً قبل النشر» لا تظهر في الإنتاج: تُصيَّر فقط حين
// يبني Netlify بسياق غير الإنتاج (CONTEXT = deploy-preview أو branch-deploy)، موسومةً lang="ar"
// لأنها نصّ عربي على صفحات بكل اللغات (حارس الأوردو C45 يستثني ما وُسم بلغة أخرى).
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import { titleSep, useTranslations, type AltLinks } from '../../i18n/utils';
import { ORG_ID, breadcrumb, absUrl } from '../../lib/schema';
import { VISA_GUIDE_ALT, VISA_UPDATED_ISO, VISA_PREVIEW_NOTE } from '../../lib/visa-guide.mjs';
import type { Lang } from '../../i18n/ui';
import { visaGuide, type Rich } from '../../data/visa-guide';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const C = visaGuide(lang);
const alt: AltLinks = VISA_GUIDE_ALT;
const selfPath = alt[lang];
if (!selfPath) throw new Error(`visa-guide: لا مسار للصفحة بلغة ${lang} في VISA_GUIDE_ALT`);
const homePath = lang === 'ar' ? '/' : `/${lang}/`;
// «خطّط لرحلتك» مبنية بلغات الدليل الست (الأوردية منذ ur-plan-1)
const planPath = lang === 'ar' ? '/خطط/' : `/${lang}/plan-your-trip/`;
const isPreview = Boolean(process.env.CONTEXT) && process.env.CONTEXT !== 'production';
const isExt = (href: string) => /^https?:\/\//.test(href);

const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Article',
    headline: C.h1, description: C.seo.description, inLanguage: lang, dateModified: VISA_UPDATED_ISO,
    mainEntityOfPage: absUrl(selfPath), publisher: { '@id': ORG_ID },
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: C.faq.items.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  breadcrumb([
    { name: t('crumb.home'), path: homePath },
    { name: t('nav.plan'), path: planPath },
    { name: C.h1, path: selfPath },
  ]),
];
---
<Base title={`${C.seo.title} ${titleSep(lang)} ${t('site.brand')}`} description={C.seo.description} lang={lang} alt={alt} type="article" jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={t('nav.plan')} title={C.h1} lead={C.lead} leadWidth={64} motif="center" lang={lang}>
      <p class="vg-note" data-vg-fees>{C.feesLine}</p>
      <p class="vg-note" data-vg-verify>{C.verifyLine}</p>
      <p class="vg-note vg-updated" data-vg-updated>{C.updatedLine}</p>
    </PageHero>

    <div class="container vg-wrap">
      {isPreview && (
        <p class="vg-preview-note" role="note" lang="ar" dir="rtl" data-vg-preview-note data-pagefind-ignore>{VISA_PREVIEW_NOTE}</p>
      )}
      <article class="vg-body" data-vg-body>
        <section class="card vg-sec" aria-labelledby="vg-intro">
          <h2 id="vg-intro">{C.intro.h}</h2>
          <p>{C.intro.parts.map((p) => typeof p === 'string' ? p : <a href={p.href}>{p.t}</a>)}</p>
        </section>

        <section class="card vg-sec" aria-labelledby="vg-table">
          <h2 id="vg-table">{C.table.h}</h2>
          <div class="tbl-wrap vg-tbl" role="region" tabindex="0" aria-labelledby="vg-table">
            <table class="va-table">
              <caption>{C.table.caption}</caption>
              <thead><tr>{C.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {C.table.rows.map(([route, who, validity, platform]) => (
                  <tr><th scope="row">{route}</th><td>{who}</td><td>{validity}</td><td>{platform}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        {C.routes.map((r) => (
          <section class="card vg-sec" aria-labelledby={`vg-${r.id}`} data-vg-route={r.id}>
            <h2 id={`vg-${r.id}`}>{r.h}</h2>
            <p>{r.who.label && <strong>{r.who.label}</strong>} {r.who.text}</p>
            {r.validity && <p><strong>{r.validity.label}</strong> {r.validity.text}</p>}
            <p class="vg-cta"><a href={r.cta.href} target="_blank" rel="noopener">{r.cta.label}</a></p>
          </section>
        ))}

        <section class="card vg-sec" aria-labelledby="vg-arrive">
          <h2 id="vg-arrive">{C.arrive.h}</h2>
          {[C.arrive.air, C.arrive.land, C.arrive.more].map((rich: Rich) => (
            <p>{rich.map((p) => typeof p === 'string' ? p : isExt(p.href) ? <a href={p.href} target="_blank" rel="noopener">{p.t}</a> : <a href={p.href}>{p.t}</a>)}</p>
          ))}
        </section>

        <section class="card vg-sec" aria-labelledby="vg-next">
          <h2 id="vg-next">{C.next.h}</h2>
          <ul>
            {C.next.items.map((it) => (
              <li><strong>{it.label}</strong> {it.parts.map((p) => typeof p === 'string' ? p : <a href={p.href}>{p.t}</a>)}</li>
            ))}
          </ul>
        </section>

        <section class="card vg-sec" aria-labelledby="vg-faq" data-vg-faq>
          <h2 id="vg-faq">{C.faq.h}</h2>
          <div class="faq-list">
            {C.faq.items.map((f) => (
              <details class="faq">
                <summary class="faq-q">{f.q}</summary>
                <p class="faq-a">{f.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="card vg-sec" aria-labelledby="vg-links">
          <h2 id="vg-links">{C.links.h}</h2>
          <div class="tbl-wrap vg-tbl" role="region" tabindex="0" aria-labelledby="vg-links">
            <table class="va-table">
              <thead><tr>{C.links.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
              <tbody>
                {C.links.rows.map((row) => (
                  <tr><th scope="row">{row.route}</th><td><a href={row.href} target="_blank" rel="noopener">{row.href}</a></td><td>{row.org}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </article>
    </div>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .vg-note { margin-block-start: var(--s-2); font-size: var(--t-sm); color: rgba(247,243,234,.88); max-inline-size: 64ch; }
  .vg-updated { margin-block-start: var(--s-3); }
  .vg-wrap { padding-block: var(--s-6) var(--s-7); }
  .vg-preview-note {
    margin-block-end: var(--s-4); padding: var(--s-3); border-radius: var(--radius-sm);
    background: #FDECEA; color: #7A1F12; border: 2px dashed #B3261E; font-weight: 600;
  }
  .vg-body { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-4); min-inline-size: 0; }
  .vg-sec { padding: var(--s-5) var(--s-5) var(--s-4); min-inline-size: 0; font-size: var(--t-base); line-height: 1.85; color: var(--c-ink); }
  .vg-sec h2 { font-family: var(--font-heading); font-weight: 700; color: var(--c-turq-deep); font-size: var(--t-xl); line-height: 1.3; margin-block: 0 var(--s-3); }
  .vg-sec p { margin-block-end: var(--s-3); max-inline-size: 72ch; }
  .vg-sec strong { color: var(--c-turq-deep); font-weight: 700; }
  .vg-sec ul { margin-block-end: var(--s-3); padding-inline-start: 1.4em; max-inline-size: 72ch; }
  .vg-sec li { margin-block-end: var(--s-1); }
  .vg-sec li::marker { color: var(--c-gold-deep); }
  .vg-sec a { color: var(--c-turq-deep); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .vg-sec a:hover { color: var(--c-gold-deep); }
  /* رمز «نافذة جديدة» زخرفي — لا نصّ في الشجرة ولا يُقرأ */
  .vg-sec a[target="_blank"]::after { content: "\2197" / ""; font-size: .8em; margin-inline-start: .15em; text-decoration: none; display: inline-block; }

  /* الجداول: قشرة الموقع (global.css) + تمرير أفقي داخل الغلاف لا في الصفحة */
  .vg-sec .vg-tbl { margin-block: 0 var(--s-3); max-inline-size: 100%; }
  .vg-sec .vg-tbl:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 2px; }
  .vg-sec .vg-tbl table { min-inline-size: 760px; }
  .vg-sec .vg-tbl td { overflow-wrap: anywhere; }

  /* زرّ المنصة الرسمية بلغة أزرار الموقع (btn--turq) */
  .vg-sec .vg-cta { margin-block: var(--s-4) 0; }
  .vg-sec .vg-cta a {
    display: inline-block; padding: 12px 26px; border-radius: var(--radius-pill);
    background: var(--c-turq); color: var(--c-sand); text-decoration: none; font-weight: 600;
    transition: transform .2s, box-shadow .2s;
  }
  .vg-sec .vg-cta a::after { content: none; }
  .vg-sec .vg-cta a:hover { color: var(--c-sand); transform: translateY(-2px); box-shadow: 0 10px 24px rgba(0,110,97,.3); }
  @media (prefers-reduced-motion: reduce) { .vg-sec .vg-cta a:hover { transform: none; } }

  /* الأسئلة الشائعة — القشرة نفسها في صفحة «خطّط لرحلتك» */
  .faq-list { max-inline-size: 72ch; }
  .faq { background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); margin-block-end: var(--s-2); overflow: hidden; }
  .faq-q { cursor: pointer; font-family: var(--font-body); font-weight: 600; font-size: var(--t-base); color: var(--c-turq-deep); padding: var(--s-3) var(--s-4); list-style: none; display: flex; align-items: center; gap: var(--s-3); }
  .faq-q::-webkit-details-marker { display: none; }
  .faq-q::after { content: ''; margin-inline-start: auto; flex: 0 0 auto; inline-size: 9px; block-size: 9px; border-inline-end: 2px solid var(--c-turq-deep); border-block-end: 2px solid var(--c-turq-deep); transform: rotate(45deg); transition: transform var(--dur) var(--ease); }
  .faq[open] .faq-q::after { transform: rotate(-135deg); }
  @media (prefers-reduced-motion: reduce) { .faq-q::after { transition: none; } }
  .faq-q:hover { color: var(--c-gold-deep); }
  .faq[open] .faq-q { border-block-end: 1px solid var(--c-line); }
  .faq-a { padding: var(--s-3) var(--s-4) var(--s-4); font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.8; max-inline-size: 65ch; margin-block-end: 0; }

  @media (max-width: 760px) {
    .vg-sec { padding: var(--s-4) var(--s-3) var(--s-3); }
  }
</style>
