---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import HeroPoster from '../HeroPoster.astro';
import HeroVideo from '../HeroVideo.astro';
import SeasonNow from '../SeasonNow.astro';
import { getCollection } from 'astro:content';
import { attractionHref } from '../../lib/routes';
import { SITE, ORG, WEBSITE, OASIS_SAMEAS, UNESCO_WHS_ID, absUrl } from '../../lib/schema';
import { altHref, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
const zh = lang === 'zh';
const de = lang === 'de';

// اختيار حقل المحتوى بلغة الصفحة (الصينية تتراجع للإنجليزية عند الغياب)،
// ورابط المعلم يقصد صفحة اللغة الحالية إن وُجدت وإلا فالإنجليزية.
const pickTitle = (d: { title: string; title_en?: string; title_zh?: string; title_de?: string }) =>
  ar ? d.title : zh ? (d.title_zh ?? d.title_en ?? d.title) : de ? (d.title_de ?? d.title_en ?? d.title) : (d.title_en ?? d.title);
const pickSummary = (d: { summary: string; summary_en?: string; summary_zh?: string; summary_de?: string }) =>
  ar ? d.summary : zh ? (d.summary_zh ?? d.summary_en ?? d.summary) : de ? (d.summary_de ?? d.summary_en ?? d.summary) : (d.summary_en ?? d.summary);
const hrefLang = (d: { title_zh?: string; title_de?: string }) =>
  zh && !d.title_zh ? 'en' : de && !d.title_de ? 'en' : lang;

const allEntries = await getCollection('attractions');
const featuredEntries = allEntries
  .filter((e) => e.data.featured).sort((a, b) => a.data.order - b.data.order);
// خريطة slug_en → بيانات المعلم لمحطات مسار اليومين (لحسم تراجع رابط zh لكل محطة)
const bySlugEn = new Map(allEntries.map((e) => [e.data.slug_en, e.data]));

// key = مفتاح النصّ في القاموس؛ cat = فئة حقيقية في المجموعة تُفتح مفلترة،
// والفئات التي لا معالم لها بعد تقود إلى القائمة الكاملة.
// فئتا farm وmarket تقودان إلى صفحة الأسواق والمنتزهات المستقلة (2026-07-13).
// img = صورة الفئة من المكتبة الجاهزة — بطاقات الفئات صارت photo-first (إعادة تصميم 2026-07).
const leisureBase = ar ? '/أسواق-ومنتزهات-ومزارع/' : zh ? '/zh/souqs-parks-farms/' : '/en/souqs-parks-farms/';
const catCards = [
  { key: 'historic', cat: 'historic', href: null, img: '/img/qasr-ibrahim' },
  { key: 'nature', cat: 'nature', href: null, img: '/img/jabal-al-qarah' },
  { key: 'crafts', cat: null, href: null, img: '/img/craftsmen-souq' },
  { key: 'taste', cat: null, href: `${leisureBase}?cat=farm`, img: '/img/hasawi-lemon-farm' },
  { key: 'market', cat: null, href: `${leisureBase}?cat=market`, img: '/img/qaisariyah' },
  { key: 'events', cat: null, href: ar ? '/فعاليات/' : zh ? '/zh/events/' : '/en/events/', img: '/img/event-dates-festival' },
];
const facts = [
  // أرقام مضمّنة خارج القاموس: كل لغة تحتاج فرعاً يدوياً هنا، والفشل صامت
  // (فاصلة عشرية ألمانية — دفعة الواجهة الألمانية 2026-09-03).
  { n: ar ? '2.5 مليون' : zh ? '250 万' : de ? '2,5 Mio.' : '2.5M', l: t('fact.palms.l') },
  { n: '2018', l: t('fact.unesco.l') },
  // العدد يُشتقّ من المجموعة لا يُكتب يدوياً: كان مثبَّتاً «+60» بينما المنشور 58،
  // فتضاربت الرئيسية مع الخريطة وllms.txt (تدقيق 2026-08-30). أرقام لاتينية بحكم قاعدة الموقع.
  { n: String(allEntries.length), l: t('fact.sites.l') },
  { n: ar ? 'آلاف' : zh ? '数千' : de ? 'Tausende' : 'Thousands', l: t('fact.springs.l') },
];
// الصينية: كل هذه الصفحات لها نسخة /zh/ (رحلتي أُضيفت في الدفعة 13 — 2026-09-03)
const allHref = ar ? '/معالم/' : zh ? '/zh/attractions/' : de ? '/de/attractions/' : '/en/attractions/';
const planTripHref = ar ? '/خطط/' : zh ? '/zh/plan-your-trip/' : '/en/plan-your-trip/';
const myTripHref = ar ? '/رحلتي/' : zh ? '/zh/plan/' : '/en/plan/';

// مسار «يومان في الواحة» — النصوص كلّها من القاموس، والوصلات من slug ملفات المعالم
// الفعلية (لا مسارات مكتوبة يدوياً). time = شارة إيقاع النهار، لا موعد محدَّد.
const routeDays = [
  {
    k: 'd1',
    stops: [
      { k: 's1', time: 'morning', ar: 'قصر-إبراهيم', en: 'qasr-ibrahim' },
      { k: 's2', time: 'noon', ar: 'سوق-القيصرية', en: 'qaisariyah' },
      { k: 's3', time: 'sunset', ar: 'جبل-القارة', en: 'jabal-al-qarah' },
    ],
  },
  {
    k: 'd2',
    stops: [
      { k: 's4', time: 'morning', ar: 'مسجد-جواثا', en: 'jawatha-mosque' },
      { k: 's5', time: 'noon', ar: 'مزرعة-الليمون-الحساوي', en: 'lemon-farm' },
      { k: 's6', time: 'sunset', ar: 'العقير', en: 'al-uqair' },
    ],
  },
];

const siteUrl = SITE;
// الجهة والموقع من lib/schema.ts بمعرّفَي @id ثابتين — العقدتان نفساهما اللتان
// تشير إليهما WebPage في Base على كل صفحة، فلا يتفرّق الاسم بين الصفحات.
const jsonLd = [
  { '@context': 'https://schema.org', ...ORG },
  { '@context': 'https://schema.org', ...WEBSITE, inLanguage: lang },
  {
    '@context': 'https://schema.org', '@type': 'TouristDestination',
    name: ar ? 'الأحساء' : zh ? '哈萨' : 'Al-Ahsa', url: absUrl(altHref(alt, lang), siteUrl), image: siteUrl + '/og-default.png',
    description: t('home.hero.lead'),
    geo: { '@type': 'GeoCoordinates', latitude: 25.4, longitude: 49.62 },
    containedInPlace: { '@type': 'Country', name: ar ? 'المملكة العربية السعودية' : zh ? '沙特阿拉伯' : de ? 'Saudi-Arabien' : 'Saudi Arabia' },
    // هوية الوجهة خارج الموقع (بند 3.1 — 2026-09-04): Wikidata Q311341 وقائمة
    // اليونسكو 1563 وويكيبيديا الأربع — الكيان واحد بكل لغة فالقائمة لا تتبدّل.
    sameAs: OASIS_SAMEAS,
    identifier: UNESCO_WHS_ID,
  },
];
// عنوان ووصف بكلمة «دليل السياحة» المستهدفة (سيو 2026-08-22) — كل ما يُذكر
// موجود فعلاً في الموقع (معالم وخرائط ومسارات وفعاليات ومطاعم).
// النص الصيني من خط zh-translation-pipeline (misc.seo.* — دفعة الرئيسية 2026-08-29)
const title = ar
  ? 'الأحساء — دليلك السياحي لأكبر واحة في العالم'
  : zh
    ? '哈萨旅游指南——全球最大的绿洲'
    : de
      ? 'Al-Ahsa-Reiseführer – die größte Oase der Welt'
      : 'Al-Ahsa Travel Guide — the World’s Largest Oasis';
const description = ar
  ? 'دليل سياحة الأحساء: جبل القارة وقصر إبراهيم وسوق القيصرية والعقير، مع خرائط ومسارات وفعاليات ومطاعم — واحة مسجلة في تراث اليونسكو العالمي.'
  : zh
    ? '沙特阿拉伯哈萨旅游指南：卡拉山、易卜拉欣宫、凯撒利亚集市、乌盖尔（Al-Uqair）。在这片列入联合国教科文组织世界遗产名录的绿洲，查看地图与行程，了解活动与美食。'
    : de
      ? 'Ihr Al-Ahsa-Reiseführer: Jabal al-Qarah, Qasr Ibrahim, Qaisariyah-Souk und Al-Uqair – Karten, Routen, Veranstaltungen und Restaurants im UNESCO-Welterbe.'
      : 'Your guide to Al-Ahsa: Jabal Al-Qarah, Qasr Ibrahim, Qaisariyah Souq and Al-Uqair — maps, itineraries, events and dining in the UNESCO-listed oasis.';
---
<Base title={title} description={description} lang={lang} alt={alt} jsonLd={jsonLd} preloadImage="/img/hero-home">
  <Header lang={lang} alt={alt} />
  <main id="main">
    <section class="hero photo">
      <HeroPoster src="/img/hero-home" class="hero-bg" />
      <HeroVideo src="/video/hero-home-v2.mp4" srcMobile="/video/hero-home-v2-portrait.mp4" lang={lang} />
      <span class="hero-glow" aria-hidden="true"></span>
      <PalmMotif size={520} class="hero-wm" />
      <div class="container hero-in">
        <span class="eyebrow gold-on-dark">{t('home.hero.eyebrow')}</span>
        <h1 class="hero-title">{t('home.hero.title')}</h1>
        <p class="hero-lead">{t('home.hero.lead')}</p>
        <div class="hero-cta">
          <a href="#name" class="btn btn--gold">{t('home.hero.cta1')}</a>
          <a href="#attractions" class="btn btn--ghost">{t('home.hero.cta2')}</a>
        </div>
      </div>
      <a href="#name" class="scroll-cue" aria-label={t('a11y.scrollDown')}><span></span></a>
    </section>

    <section class="name-sec" id="name">
      <div class="container name-in" data-reveal>
        <span class="eyebrow">{t('home.name.eyebrow')}</span>
        <h2 class="name-h">{t('home.name.title')}</h2>
        <p class="name-body">{t('home.name.body')}</p>
      </div>
    </section>

    <section class="sec" id="experiences">
      <div class="container">
        <header class="sec-head" data-reveal>
          <span class="eyebrow">{t('home.cats.eyebrow')}</span>
          <h2 class="sec-title">{t('home.cats.title')}</h2>
          <p class="lead">{t('home.cats.lead')}</p>
        </header>
        <div class="cat-grid">
          {catCards.map((c, i) => (
            <a class="cat-card" href={c.href ?? (c.cat ? `${allHref}?cat=${c.cat}` : allHref)} data-reveal style={`transition-delay:${i * 60}ms`}>
              <Photo src={c.img} label="" class="cat-photo" sizes="(max-width: 760px) 100vw, 33vw" />
              <div class="cat-body">
                <h3 class="cat-t">{t(`cat.${c.key}.t` as any)}</h3>
                <p class="cat-d">{t(`cat.${c.key}.d` as any)}</p>
              </div>
              {/* اتجاه السهم كرابط المسار أدناه: في العربية يشير إلى جهة التقدّم (يسار) */}
              <span class="cat-go" aria-hidden="true">{ar ? '←' : '→'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sec sec--sand" id="attractions">
      <div class="container">
        <header class="sec-head" data-reveal>
          <span class="eyebrow">{t('home.feat.eyebrow')}</span>
          <h2 class="sec-title">{t('home.feat.title')}</h2>
          <p class="lead">{t('home.feat.lead')}</p>
        </header>
        <div class="att-grid">
          {featuredEntries.map((e, i) => (
            <a class={`card card--lift att-card ${i === 0 ? 'att-card--lead' : ''}`} href={attractionHref(e.data, hrefLang(e.data))} data-reveal style={`transition-delay:${i * 80}ms`}>
              <Photo src={e.data.heroImage} label={pickTitle(e.data)} class="att-photo" eager={i === 0} sizes={i === 0 ? "(max-width: 1000px) 100vw, 1120px" : "(max-width: 760px) 100vw, (max-width: 1000px) 50vw, 33vw"} />
              <div class="att-body">
                {/* التسمية العلوية عربية/صينية فقط — لا عنصر فارغ في الإنجليزية */}
                {(() => { const k = ar ? e.data.kicker : zh ? (e.data.kicker_zh ?? '') : de ? (e.data.kicker_de ?? '') : ''; return k ? <span class="t-caption att-k">{k}</span> : null; })()}
                <h3 class="att-t">{pickTitle(e.data)}</h3>
                <p class="att-d">{pickSummary(e.data)}</p>
              </div>
            </a>
          ))}
        </div>
        <div class="att-more"><a href={allHref} class="btn btn--turq">{t('home.feat.all')}</a></div>
      </div>
    </section>

    <section class="sec route-sec" id="route">
      <div class="container">
        <header class="sec-head" data-reveal>
          <span class="eyebrow">{t('home.route.eyebrow')}</span>
          <h2 class="sec-title">{t('home.route.title')}</h2>
          <p class="lead">{t('home.route.lead')}</p>
          <a href={myTripHref} class="route-link">{t('home.route.link')} <span aria-hidden="true">{ar ? '←' : '→'}</span></a>
        </header>
        <div class="route-grid">
          {routeDays.map((d, i) => (
            <article class="route-card" data-reveal style={`transition-delay:${i * 80}ms`}>
              <span class="route-k">{t(`home.route.${d.k}.k` as any)}</span>
              <h3 class="route-t">{t(`home.route.${d.k}.t` as any)}</h3>
              <ol class="route-stops">
                {d.stops.map((s) => (
                  <li class="route-stop">
                    <span class="route-time">{t(`home.route.time.${s.time}` as any)}</span>
                    <div class="route-stop-b">
                      <a class="route-n" href={attractionHref(bySlugEn.get(s.en) ?? { slug_ar: s.ar, slug_en: s.en }, hrefLang(bySlugEn.get(s.en) ?? {}))}>{t(`home.route.${s.k}.n` as any)}</a>
                      <p class="route-d">{t(`home.route.${s.k}.d` as any)}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <SeasonNow lang={lang} />

    <section class="why on-dark">
      <PalmMotif size={360} class="why-wm" />
      <div class="container why-in">
        <header class="sec-head why-head" data-reveal>
          <span class="eyebrow gold-on-dark">{t('home.why.eyebrow')}</span>
          <h2 class="sec-title">{t('home.why.title')}</h2>
        </header>
        <div class="facts">
          {facts.map((f, i) => (
            <div class="fact" data-reveal style={`transition-delay:${i * 70}ms`}>
              <span class="fact-n"><bdi>{f.n}</bdi></span>
              <span class="fact-l">{f.l}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="plan" id="plan">
      <div class="container plan-in" data-reveal>
        <span class="eyebrow">{t('home.plan.eyebrow')}</span>
        <h2 class="plan-h">{t('home.plan.title')}</h2>
        <p class="lead plan-lead">{t('home.plan.lead')}</p>
        <div class="plan-ctas">
          <a href={planTripHref} class="btn btn--gold">{t('home.plan.cta')}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .hero { min-block-size: 92vh; display: flex; align-items: center; color: var(--c-sand); position: relative; overflow: hidden; }
  /* طبقة تعتيم أقوى فوق صورة الهيرو لضمان وضوح النصّ (تَغلِب ::after العامّة) */
  .hero::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: var(--hero-scrim);
  }
  .hero-bg { z-index: 0; }
  /* Ken Burns — تكبير بطيء جداً على الصورة الثابتة يمنح الهيرو حياةً بلا إلهاء */
  @keyframes kb { 0% { transform: scale(1.04); } 100% { transform: scale(1.14); } }
  .hero-bg > img { transform: scale(1.04); animation: kb 26s var(--ease) infinite alternate; will-change: transform; }
  /* توهّج ذهبي ناعم في الزاوية السفلية البعيدة عن كتلة النصّ (يمين في الإنجليزية، يسار في العربية) */
  .hero-glow {
    position: absolute; z-index: 2; pointer-events: none;
    inline-size: 520px; block-size: 520px;
    inset-block-end: -150px; inset-inline-end: -120px;
    background: radial-gradient(circle, rgba(201,154,74,.22), transparent 68%);
  }
  @media (prefers-reduced-motion: reduce) { .hero-bg > img { animation: none; } }
  /* فيديو الهيرو فوق الصورة الثابتة؛ يظهر تدريجياً بعد بدء التشغيل، والصورة تبقى احتياطاً */
  /* فيديو الهيرو ومظهره في global.css (.hero-vid) مع مكوّن HeroVideo */
  /* :global لأن PalmMotif مكوّن منفصل والـ scoped CSS لا تصله */
  :global(.hero-wm) { position: absolute; inset-block-end: -14%; inset-inline-start: -10%; color: var(--c-gold); opacity: .12; z-index: 0; }
  /* التحديد على العناصر الداخلية لا على الحاوية — وإلا انزاحت الكتلة عن حافة البداية */
  .hero-in { position: relative; z-index: 2; padding-block: var(--s-8); }
  .hero-title { font-family: var(--font-heading); font-weight: 700; color: var(--c-sand); font-size: var(--t-display); line-height: 1.12; margin-block: var(--s-4) var(--s-4); text-shadow: 0 2px 30px rgba(0,42,37,.4); max-inline-size: 56ch; }
  .hero-lead { font-size: var(--t-lg); line-height: 1.7; color: rgba(247,243,234,.92); max-inline-size: 48ch; }
  .hero-cta { display: flex; gap: var(--s-3); margin-block-start: var(--s-6); flex-wrap: wrap; }
  .scroll-cue { position: absolute; inset-block-end: var(--s-5); inset-inline-start: 50%; transform: translateX(50%); z-index: 2; }
  .scroll-cue span { display: block; inline-size: 26px; block-size: 42px; border: 2px solid rgba(247,243,234,.6); border-radius: 14px; position: relative; }
  .scroll-cue span::after { content: ''; position: absolute; inset-block-start: 7px; inset-inline-start: 50%; transform: translateX(-50%); inline-size: 4px; block-size: 8px; background: var(--c-gold); border-radius: 2px; animation: cue 1.7s var(--ease) infinite; }
  @keyframes cue { 0%,100% { opacity: 0; transform: translate(-50%, 0); } 50% { opacity: 1; transform: translate(-50%, 10px); } }
  @media (prefers-reduced-motion: reduce) { .scroll-cue span::after { animation: none; } }
  .name-sec { background: var(--c-sand); padding-block: var(--s-8); }
  .name-h { font-size: var(--t-2xl); color: var(--c-turq-deep); margin-block: var(--s-3) var(--s-4); line-height: 1.2; max-inline-size: 60ch; }
  .name-body { font-size: var(--t-lg); line-height: 1.85; color: var(--c-ink); max-inline-size: 60ch; }
  .sec { padding-block: var(--s-8); }
  .sec--sand { background: var(--c-sand-2); }
  .sec-head { max-inline-size: 60ch; margin-block-end: var(--s-6); }
  .sec-title { font-size: var(--t-2xl); color: var(--c-ink); margin-block: var(--s-2) var(--s-3); line-height: 1.2; }

  /* بطاقات الفئات — photo-first: صورة حقيقية تحت تدرّج فيروزي، بلا أيقونات (إعادة تصميم 2026-07) */
  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }
  .cat-card {
    position: relative; display: block; aspect-ratio: 4 / 3; border-radius: var(--radius-lg);
    overflow: hidden; isolation: isolate; text-decoration: none; color: var(--c-sand);
    box-shadow: var(--shadow);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .cat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
  /* تدرّج فيروزي شفاف يثبّت النصّ — يعلو ظلّ .photo::after العامّ */
  .cat-card::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    /* منحنى حادّ: النصف العلوي يبقى شبه صافٍ فتظهر الصورة بألوانها، ثم يهبط
       الشريط السفلي إلى عتامة كافية لتحقيق تباين النصّ (مقيس ≥4.5:1). */
    background: linear-gradient(180deg, rgba(0,42,38,0) 16%, rgba(0,45,40,.34) 44%, rgba(0,40,35,.82) 70%, rgba(0,38,33,.93) 100%);
  }
  /* صورة الفئة تملأ البطاقة (قاعدة عامة مرادفة موجودة في global.css لأن scoped لا يصل لـ <picture>) */
  .cat-card :global(.photo.cat-photo) { position: absolute; inset: 0; }
  .cat-card :global(.photo.cat-photo > img) { transition: transform .6s var(--ease); }
  .cat-card:hover :global(.photo.cat-photo > img) { transform: scale(1.04); }
  .cat-body { position: absolute; inset-block-end: 0; inset-inline: 0; z-index: 2; padding: var(--s-4); }
  .cat-t { font-family: var(--font-heading); font-size: var(--t-lg); color: var(--c-sand); margin-block-end: var(--s-1); }
