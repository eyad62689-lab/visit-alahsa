---
// صفحة المنشأة المفردة (مطعم/مقهى). لا تُولَّد إلا لمن عبر عتبة المتن — الحارس
// في getStaticPaths لكل من صفحتَي [slug]، وتفصيلُه في
// docs/قرار-بنية-صفحات-المنشآت.md. فلا تُنشر صفحة رقيقة أبداً.
//
// التقييم وأوقات العمل والحالة تُعرض في الواجهة فقط ولا تُصدَّر في أي JSON-LD
// (شروط قوقل + إرشادات المراجعات الذاتية) — الحارس الآلي هو الفحص C10 في
// tools/check-consistency.mjs.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Photo from '../Photo.astro';
import OpenNowBadge from '../OpenNowBadge.astro';
import { attractionHref, diningHref } from '../../lib/routes';
import { catLabel } from '../../lib/categories';
import { DISTRICT_NAMES } from '../../data/districts';
import { liveFor, hoursData as hoursDataFor, hoursFor } from '../../lib/places-live';
import { SITE, absUrl, breadcrumb } from '../../lib/schema';
import { localize, titleSep, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import ShareButton from '../ShareButton.astro';

interface Props { entry: CollectionEntry<'dining'>; lang: Lang; alt: AltLinks; }
const { entry, lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
// الروسية (ب6): الصفحة لا تُولَّد إلا لمن حمل body_ru (البوابة في ru/restaurants-cafes/[slug])،
// وحقول البطاقة *_ru من ب5 تتراجع للإنجليزية عند غيابها. الاسم لاتيني كما تسمّي المنشأة نفسها.
const ru = lang === 'ru';
// والألمانية (ج7): البوابة body_de في de/restaurants-cafes/[slug]، وحقول البطاقة *_de من ج6.
const de = lang === 'de';
// والصينية (د1): البوابة body_zh في zh/restaurants-cafes/[slug]، وحقول البطاقة *_zh من الدفعة 14.
const zh = lang === 'zh';
const d = entry.data;
const { Content } = await render(entry);

const name = ar ? d.name : d.name_en;
const area = ar ? d.area : zh ? (d.area_zh ?? d.area_en) : de ? (d.area_de ?? d.area_en) : ru ? (d.area_ru ?? d.area_en) : d.area_en;
const blurb = ar ? d.blurb : zh ? (d.blurb_zh ?? d.blurb_en) : de ? (d.blurb_de ?? d.blurb_en) : ru ? (d.blurb_ru ?? d.blurb_en) : d.blurb_en;
const alTxt = ar ? d.alt : zh ? (d.alt_zh ?? d.alt_en) : de ? (d.alt_de ?? d.alt_en) : ru ? (d.alt_ru ?? d.alt_en) : d.alt_en;

// بيانات قوقل الحية — القارئ الموحّد في lib/places-live.ts، وغيابها يتدهور رشيقاً
const lv = liveFor(d.img);
const hours = hoursFor(lv, lang);
const hoursData = hoursDataFor(lv);
// المتن الإنجليزي: فقرات مفصولة بسطر فارغ — كان يُحقن بـset:html مع استبدال
// «\n\n» فلا يُهرَّب النصّ، والآن يُصيَّر نصاً عادياً فقرةً فقرة.
const bodyEnParas = (zh && d.body_zh?.trim() ? d.body_zh : de && d.body_de?.trim() ? d.body_de : ru && d.body_ru?.trim() ? d.body_ru : d.body_en).split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);

// «معالم قريبة في الحيّ» (الخطوة 9 من خطة التفاعل العالمي): المعالم التي تحمل مفتاح حيّ
// المنشأة نفسه (district — مشتقّ من نصّ area في ملف المعلم، يفرضه المخطط). بلا حيّ لا قسم.
const sights = d.district
  ? (await getCollection('attractions'))
      .filter((e) => e.data.district === d.district)
      .sort((x, y) => x.data.order - y.data.order)
      .map((e) => ({ id: e.data.slug_en, href: attractionHref(e.data, lang), title: ar ? e.data.title : zh ? (e.data.title_zh ?? e.data.title_en ?? e.data.title) : de ? (e.data.title_de ?? e.data.title_en ?? e.data.title) : ru ? (e.data.title_ru ?? e.data.title_en ?? e.data.title) : (e.data.title_en ?? e.data.title), cat: catLabel(e.data.category, lang) }))
  : [];

const C = localize(lang, {
  ar: {
    kindLabel: d.kind === 'cafe' ? 'مقهى' : d.kind === 'bakery' ? 'مخبز' : 'مطعم',
    backLabel: 'كل المطاعم والمقاهي',
    openMaps: t('det.openMaps'),
    newWindow: '(يفتح في خرائط قوقل، نافذة جديدة)',
    hoursH: 'أوقات العمل',
    hoursNote: 'المواعيد من خرائط قوقل وقد تتغير — تحقّق من رابط المكان.',
    ratingLabel: 'التقييم في خرائط قوقل',
    openNow: 'مفتوح الآن',
    closedNow: 'مغلق الآن',
    closedPerm: 'مغلق نهائياً — بحسب خرائط قوقل',
    closedTemp: 'مغلق مؤقتاً — بحسب خرائط قوقل',
    areaH: 'الموقع',
    noteH: 'حول هذه الصفحة',
    noteP: 'الاسم والموقع من خرائط قوقل مباشرة، والتقييم وأوقات العمل تُجلب منها عند كل تحديث للموقع وقد تتغير. لا تُعرض أسعار ولا توصيات بأصناف بعينها.',
    // اسم الفهرس في العنوان والفتات، وعنوان قسم المعالم ({district} اسم الحيّ من DISTRICT_NAMES)
    indexName: 'المطاعم والمقاهي',
    sightsH: 'معالم قريبة في {district}',
  },
  en: {
    kindLabel: d.kind === 'cafe' ? 'Café' : d.kind === 'bakery' ? 'Bakery' : 'Restaurant',
    backLabel: 'All restaurants & cafés',
    openMaps: t('det.openMaps'),
    newWindow: '(opens Google Maps in a new window)',
    hoursH: 'Opening hours',
    hoursNote: 'Hours come from Google Maps and can change — check the place’s link.',
    ratingLabel: 'Rating on Google Maps',
    openNow: 'Open now',
    closedNow: 'Closed now',
    closedPerm: 'Permanently closed — according to Google Maps',
    closedTemp: 'Temporarily closed — according to Google Maps',
    areaH: 'Location',
    noteH: 'About this page',
    noteP: 'The name and location come straight from Google Maps; the rating and opening hours are fetched from it on each site update and can change. No prices or dish recommendations are listed.',
    indexName: 'Restaurants & Cafés',
    sightsH: 'Sights nearby in {district}',
  },
  // الكتلة الألمانية — خط de-translation-pipeline (دفعة de-dind-1 2026-09-20، الحكّام النهائيون: 91 · 90 · 90 · 90).
  // المقفلات (أوقات العمل وصيغ Google Maps وعنوان الفهرس وعنوان صندوق المنهج) منسوخة من
  // كتلة DE المنشورة في فهرس المطاعم — صفحةٌ واحدة بصيغتين لا تُقبل هنا.
  de: {
    kindLabel: d.kind === 'cafe' ? 'Café' : d.kind === 'bakery' ? 'Bäckerei' : 'Restaurant',
    backLabel: 'Alle Restaurants und Cafés',
    openMaps: t('det.openMaps'),
    newWindow: '(öffnet Google Maps in einem neuen Fenster)',
    hoursH: 'Öffnungszeiten',
    hoursNote: 'Die Öffnungszeiten stammen von Google Maps und können sich ändern – nutzen Sie den Link zu diesem Ort, um sie zu prüfen.',
    ratingLabel: 'Bewertung bei Google Maps',
    openNow: 'Jetzt geöffnet',
    closedNow: 'Jetzt geschlossen',
    closedPerm: 'Dauerhaft geschlossen – laut Google Maps',
    closedTemp: 'Vorübergehend geschlossen – laut Google Maps',
    areaH: 'Lage',
    noteH: 'Über diese Seite',
    noteP: 'Name und Standort stammen direkt aus Google Maps; Bewertung und Öffnungszeiten werden bei jeder Aktualisierung der Website von dort abgerufen und können sich ändern. Wir führen weder Preise noch Empfehlungen zu bestimmten Gerichten auf, und diese Seite beschreibt nur, ohne zu empfehlen.',
    indexName: 'Restaurants und Cafés',
    sightsH: 'Sehenswürdigkeiten in der Nähe: {district}',
  },
  // الكتلة الصينية — خط zh-translation-pipeline (دفعة zh-dind-1، المرحلة د1). المقفلات (أوقات العمل
  // وصيغ خرائط Google وعنوان الفهرس وعنوان صندوق المنهج) منسوخة من كتلة ZH المنشورة في فهرس المطاعم.
  zh: {
    kindLabel: d.kind === 'cafe' ? '咖啡馆' : d.kind === 'bakery' ? '烘焙坊' : '餐厅',
    backLabel: '全部餐厅与咖啡馆',
    openMaps: t('det.openMaps'),
    newWindow: '（在新窗口中打开谷歌地图）',
    hoursH: '营业时间',
    hoursNote: '营业时间来自谷歌地图，可能随时变动，请以各场所谷歌地图页面的最新信息为准。',
    ratingLabel: '谷歌地图评分',
    openNow: '营业中',
    closedNow: '已打烊',
    closedPerm: '已永久停业（据谷歌地图）',
    closedTemp: '已暂停营业（据谷歌地图）',
    areaH: '位置',
    noteH: '关于本页',
    noteP: '名称与位置均直接取自谷歌地图；评分与营业时间会随每次网站更新从谷歌地图获取，可能有所变动。本页不展示价格，也不推荐特定菜品。',
    indexName: '餐厅与咖啡馆',
    sightsH: '{district}附近的景点',
  },
  // الروسية — خط ru-translation-pipeline (دفعة ru-dining-detail-1)؛ ما يطابق كتلة RU في الفهرس منسوخٌ منها.
  ru: {
    kindLabel: d.kind === 'cafe' ? 'Кафе' : d.kind === 'bakery' ? 'Пекарня' : 'Ресторан',
    backLabel: 'Все рестораны и кафе',
    openMaps: t('det.openMaps'),
    newWindow: '(открывает Google Карты в новом окне)',
    hoursH: 'Часы работы',
    hoursNote: 'Часы работы указаны по данным Google Карт и могут меняться — проверяйте по ссылке на это место.',
    ratingLabel: 'Рейтинг на Google Картах',
    openNow: 'Открыто сейчас',
    closedNow: 'Закрыто сейчас',
    closedPerm: 'Закрыто навсегда — по данным Google Карт',
    closedTemp: 'Временно закрыто — по данным Google Карт',
    areaH: 'Расположение',
    noteH: 'Об этой странице',
    noteP: 'Название и местоположение взяты напрямую из Google Карт; рейтинг и часы работы подгружаются оттуда при каждом обновлении сайта и могут меняться. Цены и рекомендации по блюдам здесь не указываются.',
    indexName: 'Рестораны и кафе',
    sightsH: 'Достопримечательности поблизости: {district}',
  },
});
const sightsH = d.district ? C.sightsH.replace('{district}', DISTRICT_NAMES[ar ? 'ar' : zh ? 'zh' : de ? 'de' : ru ? 'ru' : 'en'][d.district]) : '';

const closed = lv?.status === 'CLOSED_PERMANENTLY' ? C.closedPerm
  : lv?.status === 'CLOSED_TEMPORARILY' ? C.closedTemp : null;

const indexHref = ar ? '/مطاعم-ومقاهي/' : zh ? '/zh/restaurants-cafes/' : de ? '/de/restaurants-cafes/' : ru ? '/ru/restaurants-cafes/' : '/en/restaurants-cafes/';
const siteUrl = SITE;
const selfUrl = absUrl(diningHref(d, lang), siteUrl);
const jsonLd = [
  breadcrumb([
    { name: t('crumb.home'), path: ar ? '/' : zh ? '/zh/' : de ? '/de/' : ru ? '/ru/' : '/en/' },
    { name: C.indexName, path: indexHref },
    { name, path: diningHref(d, lang) },
  ], siteUrl),
  { '@context': 'https://schema.org',
    '@type': d.kind === 'cafe' ? 'CafeOrCoffeeShop' : d.kind === 'bakery' ? 'Bakery' : 'Restaurant',
    name, url: selfUrl, hasMap: d.maps, image: absUrl(`${d.img}.jpg`, siteUrl),
    // addressLocality يسقط حين لا يكون الموقع المعياري متحقَّقاً منه بعد —
    // عنوانٌ ناقص أصدق من عنوانٍ مخمَّن.
    address: { '@type': 'PostalAddress', ...(area ? { addressLocality: area } : {}), addressRegion: ar ? 'الأحساء' : ru ? 'Аль-Ахса' : 'Al-Ahsa', addressCountry: 'SA' },
  },
];
---
<Base title={`${name} ${titleSep(lang)} ${C.indexName} ${titleSep(lang)} ${t('site.name')}`} description={blurb} image={`${d.img}.jpg`}
  lang={lang} alt={alt} jsonLd={jsonLd}
  preloadImage={d.img} preloadSizes="(max-width: 900px) 100vw, 900px">
  <Header lang={lang} alt={alt} />
  <main id="main">
    <article class="container dd">
      <nav class="dd-crumbs" aria-label={t('a11y.crumbs')}>
        <a href={indexHref}>{C.backLabel}</a>
      </nav>

      <header class="dd-head">
        <span class="eyebrow">{C.kindLabel}</span>
        <h1>{name}</h1>
        <ShareButton lang={lang} contentType="dining" itemId={d.slug_en} class="dd-share" />
        {area && <p class="dd-area">{area}</p>}
        {closed && <p class="dd-closed">{closed}</p>}
        <div class="dd-meta">
          {lv?.rating && (
            <p class="dd-rating"><span class="dd-star" aria-hidden="true">★</span>
              <strong>{lv.rating.toFixed(1)}</strong>
              {lv.count && <span class="dd-count">({lv.count.toLocaleString('en-US')})</span>}
              <span class="sr-only">{C.ratingLabel}</span>
            </p>
          )}
          {!closed && hoursData && (
            <p class="dd-open" hidden data-hours={hoursData} data-open={C.openNow} data-shut={C.closedNow}></p>
          )}
        </div>
      </header>

      <Photo src={d.img} label={alTxt} class="dd-photo" eager sizes="(max-width: 900px) 100vw, 900px" />

      <div class="dd-body prose">
        {ar ? <Content /> : bodyEnParas.map((p) => <p>{p}</p>)}
      </div>

      <div class="dd-panels">
        <section class="dd-panel">
          <h2>{C.areaH}</h2>
          {area && <p>{area}</p>}
          <a class="dd-maps" href={d.maps} target="_blank" rel="noopener">
            {C.openMaps}
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
            </svg>
            <span class="sr-only">{C.newWindow}</span>
          </a>
        </section>

        {hours && hours.length > 0 && (
          <section class="dd-panel">
            <h2>{C.hoursH}</h2>
            <ul class="dd-hours">{hours.map((h) => <li>{h}</li>)}</ul>
            <p class="dd-hnote">{C.hoursNote}</p>
          </section>
        )}

        {sights.length > 0 && (
          <section class="dd-panel dd-sights">
            <h2>{sightsH}</h2>
            <ul class="dd-sights-list">
              {sights.map((s) => (
                <li>
                  <a href={s.href} data-track="related_click" data-track-kind="attraction" data-track-item-id={s.id}>{s.title}</a>
                  <span class="dd-sight-k">{s.cat}</span>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside class="dd-note">
        <h2>{C.noteH}</h2>
        <p>{C.noteP}</p>
      </aside>
    </article>
  </main>
  <Footer lang={lang} />
</Base>

{/* «مفتوح الآن» — السكربت المشترك مع الفهرس، ولا يُضمَّن بلا بيانات ساعات */}
{hoursData && <OpenNowBadge />}

<style>
  .dd { padding-block: var(--s-6) var(--s-8); max-inline-size: 900px; }
  .dd-crumbs { margin-block-end: var(--s-4); font-size: var(--t-sm); }
  .dd-crumbs a { color: var(--c-turq-deep); font-weight: 600; text-decoration: none; }
  .dd-crumbs a:hover { color: var(--c-turq); }
  .dd-head h1 { font-size: var(--t-3xl); margin-block-start: var(--s-2); }
  .dd-area { margin-block-start: var(--s-2); font-size: var(--t-sm); color: var(--c-gold-deep); font-weight: 600; }
  .dd-closed { margin-block-start: var(--s-3); font-size: var(--t-sm); font-weight: 700; color: var(--c-gold-deep); background: var(--c-sand-2); border-inline-start: 3px solid var(--c-gold); border-radius: var(--radius-sm); padding: 8px 12px; }
  .dd-meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); margin-block-start: var(--s-3); }
  .dd-rating { display: flex; align-items: center; gap: 6px; font-size: var(--t-sm); }
  .dd-star { color: var(--c-gold-deep); }
  .dd-count { color: var(--c-ink-soft); font-size: var(--t-xs); }
  .dd-open { display: inline-flex; align-items: center; gap: 6px; font-size: var(--t-sm); font-weight: 700; color: var(--c-ink-soft); }
  .dd-open::before { content: ''; inline-size: 8px; block-size: 8px; border-radius: 50%; background: currentColor; }
  .dd-open.is-open { color: var(--c-turq); }

  :global(.dd-photo) { margin-block: var(--s-5); border-radius: var(--radius); aspect-ratio: 3 / 2; }
  :global(.dd-photo img) { inline-size: 100%; block-size: 100%; object-fit: cover; }

  .dd-body { font-size: var(--t-base); line-height: 1.9; color: var(--c-ink); }
  .dd-body :global(p) { margin-block-end: var(--s-4); }

  .dd-panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--s-4); margin-block-start: var(--s-6); }
  .dd-panel { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); }
  .dd-panel h2 { font-size: var(--t-lg); color: var(--c-turq-deep); margin-block-end: var(--s-2); }
  .dd-panel p { font-size: var(--t-sm); color: var(--c-ink-soft); }
  .dd-hours { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 4px; font-size: var(--t-sm); color: var(--c-ink-soft); }
  .dd-hnote { margin-block-start: var(--s-3); font-size: var(--t-xs); color: var(--c-ink-60); line-height: 1.6; }
  .dd-maps { display: inline-flex; align-items: center; gap: 6px; min-block-size: 44px; margin-block-start: var(--s-3); font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-turq-deep); background: var(--c-sand-2); border: 1px solid var(--c-line); border-radius: var(--radius-pill); padding: 6px 14px; text-decoration: none; transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  .dd-maps:hover { border-color: var(--c-turq); color: var(--c-turq); }

  .dd-sights-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-2); }
  .dd-sights-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-2); font-size: var(--t-sm); }
  .dd-sights-list a { color: var(--c-turq-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .dd-sights-list a:hover { color: var(--c-turq); }
  .dd-sight-k { color: var(--c-ink-soft); font-size: var(--t-xs); }
  .dd-note { margin-block-start: var(--s-6); background: #fff; border-inline-start: 4px solid var(--c-gold); border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); }
  .dd-note h2 { font-size: var(--t-lg); margin-block-end: var(--s-2); }
  .dd-note p { font-size: var(--t-sm); color: var(--c-ink-soft); }
</style>
