---
// فهرس «أماكن الإقامة» — قسمٌ مستقل أُنشئ في 2026-09-01 (قرار إياد) لأن الفندق
// ليس منشأة طعام. النموذج والبوابة نسخة من `dining`: البطاقة تعمل دائماً،
// والصفحة المفردة لا تُولَّد حتى يعبر المتن العتبة (80 كلمة عربية / 100
// إنجليزية) — تدهور رشيق على سابقة `title_zh`.
//
// قاعدة ملزمة: لا تُختلق معلومة، ولا ادعاء جودة ولا أسعار ولا نجوم تصنيف.
// النبذة تصف المكان كما يظهر في صورته، والباقي على خرائط قوقل.
//
// الحياد: هذه بطاقاتٌ وصفية لا ترشيحات — ولذلك تبقى إجابة «خطط لرحلتك» عن
// أفضل الفنادق (لا نرشّح منشأة بعينها) صحيحةً كما هي.
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import Photo from '../Photo.astro';
import PageHero from '../PageHero.astro';
import { getCollection } from 'astro:content';
import { stayHref } from '../../lib/routes';
import { liveFor, fetchedLabel as fetchedLabelFor } from '../../lib/places-live';
import { SITE, absUrl, breadcrumb } from '../../lib/schema';
import { localize, useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
const zh = lang === 'zh';

// التقييمات من Google Places API — نفس آلية صفحة المطاعم (القارئ الموحّد في
// lib/places-live.ts)، ونفس التدهور الرشيق حين يغيب المفتاح.
const fetchedLabel = fetchedLabelFor(lang);

const WORD_MIN_AR = 80;
const WORD_MIN_EN = 100;
const words = (x: string) => x.trim().split(/\s+/).filter(Boolean).length;
const entries = (await getCollection('stay')).sort((a, b) => a.data.order - b.data.order);
const PLACES = entries.map((e) => {
  const d = e.data;
  const bodyAr = (e.body ?? '').trim();
  const passesAr = words(bodyAr) >= WORD_MIN_AR && bodyAr !== d.blurb;
  const passesEn = words(d.body_en) >= WORD_MIN_EN && d.body_en.trim() !== d.blurb_en;
  const hasPage = ar ? passesAr : passesEn;
  return {
    img: d.img, maps: d.maps, kind: d.kind,
    // الاسم لا يُترجم للصينية؛ النبذة والموقع والنص البديل من *_zh (الدفعة 14) بتراجع للإنجليزية
    name: ar ? d.name : d.name_en,
    area: ar ? d.area : zh ? (d.area_zh ?? d.area_en) : d.area_en,
    alt: ar ? d.alt : zh ? (d.alt_zh ?? d.alt_en) : d.alt_en,
    blurb: ar ? d.blurb : zh ? (d.blurb_zh ?? d.blurb_en) : d.blurb_en,
    // الصينية تتراجع للإنجليزية: صفحات المنشآت المفردة بلا نسخة صينية بعد
    href: hasPage ? stayHref(d, zh ? 'en' : lang) : d.maps,
    internal: hasPage,
  };
});

// الكتلة الصينية — خط zh-translation-pipeline (دفعة indexes 2026-09-02، الحاكم 94/100).
// رابط الأسئلة الشائعة يقصد النظير الإنجليزي: صفحة شاطئ العقير بلا نسخة صينية بعد.
const ZH = {
  heroEyebrow: '在绿洲下榻',
  title: '住宿',
  heroSum: '哈萨的住宿选择：从老城里的传统客栈，到乌盖尔（Al-Uqair）海滨的酒店，每处均附照片及其在谷歌地图上的位置。本列表仅作介绍，不构成推荐，并将持续更新。',
  listEyebrow: '首批收录',
  listH: '哈萨住宿一览',
  kindLabels: { 'heritage-inn': '传统客栈', hotel: '酒店' } as Record<string, string>,
  openMaps: '在谷歌地图中打开 ↗',
  newWindow: '（在新窗口中打开谷歌地图）',
  moreLabel: '查看详情',
  ratingLabel: '谷歌地图评分',
  closedPerm: '已永久停业（据谷歌地图）',
  closedTemp: '已暂停营业（据谷歌地图）',
  srcNote: fetchedLabel ? `评分来自谷歌地图，最后更新于 ${fetchedLabel}` : null,
  faqH: '哈萨住宿常见问题',
  faqs: [
    { q: '老胡富夫城区内有可入住的传统客栈吗？',
      a: '有。库特遗产酒店（Al-Koot Heritage Hotel）坐落于库特区一座修复后的宫殿内，正对易卜拉欣宫，是哈萨地区首家获沙特旅游与国家遗产总局许可的遗产酒店。' },
    { q: '乌盖尔海滩附近有住宿吗？',
      a: '有。康提嫩特酒店（Continent Hotel Al Uqayr）坐落于哈萨以东的乌盖尔海岸；海滩上另设房车专用营位，可通过哈萨市政局在线预订。',
      linkText: '详情请见乌盖尔海滩页面 →', linkHref: '/en/attractions/uqair-beach/' },
    { q: '这份列表是对最佳酒店的推荐吗？',
      a: '不是。卡片仅作介绍：每处只列出名称、照片及其在谷歌地图上的位置。我们不做排名，也不展示价格，请您在可信的预订平台上自行比较。' },
  ],
  methodH: '关于本页',
  methodP1: '名称与位置均直接取自谷歌地图，简介仅依据照片所见撰写。本页不展示价格、星级或推荐。',
  places: PLACES,
};

const C = localize(lang, {
  heroEyebrow: 'أين تبيت في الواحة',
  title: 'أماكن الإقامة',
  heroSum: 'أماكن للمبيت في الأحساء — من نُزلٍ تراثي داخل المدينة القديمة إلى فندقٍ على ساحل العقير، لكلٍّ منها صورته وموقعه على خرائط قوقل. القائمة وصفية لا ترشيحية، وتنمو تباعاً.',
  listEyebrow: 'الدفعة الأولى',
  listH: 'أماكن إقامة في الأحساء',
  kindLabels: { 'heritage-inn': 'نُزل تراثي', hotel: 'فندق' } as Record<string, string>,
  openMaps: t('det.openMaps'),
  newWindow: '(يفتح في خرائط قوقل، نافذة جديدة)',
  moreLabel: 'تفاصيل المكان',
  ratingLabel: 'التقييم في خرائط قوقل',
  closedPerm: 'مغلق نهائياً — بحسب خرائط قوقل',
  closedTemp: 'مغلق مؤقتاً — بحسب خرائط قوقل',
  srcNote: fetchedLabel ? `التقييمات من خرائط قوقل — آخر تحديث ${fetchedLabel}` : null,
  faqH: 'أسئلة شائعة عن الإقامة في الأحساء',
  faqs: [
    { q: 'هل توجد نُزل تراثية للمبيت داخل الهفوف القديمة؟',
      a: 'نعم — فندق الكوت التراثي نُزلٌ في قصرٍ مُرمَّم بحي الكوت مقابل قصر إبراهيم، وهو أول فندق تراثي في المحافظة يُرخَّص من الهيئة العامة للسياحة والتراث الوطني.' },
    { q: 'هل توجد إقامة قريبة من شاطئ العقير؟',
      a: 'نعم — فندق كونتننت العقير على ساحل العقير شرق الأحساء. ولأصحاب عربات الكرفان موقفٌ مخصّص بالشاطئ نفسه بحجزٍ إلكتروني عبر أمانة الأحساء.',
      linkText: 'تفاصيله في صفحة شاطئ العقير ←', linkHref: '/معالم/شاطئ-العقير/' },
    { q: 'هل هذه القائمة ترشيحٌ لأفضل الفنادق؟',
      a: 'لا. البطاقات وصفية: اسم المكان وصورته وموقعه على خرائط قوقل. لا نرشّح منشأةً على أخرى ولا نعرض أسعاراً — قارن الخيارات على منصات الحجز الموثوقة.' },
  ],
  methodH: 'حول هذه الصفحة',
  methodP1: 'الأسماء والمواقع مأخوذة من خرائط قوقل مباشرة، والنبذات تعريفية موجزة تصف المكان كما يظهر في صورته. لا تُعرض أسعار ولا تصنيفات نجوم ولا ترشيحات.',
  places: PLACES,
}, {
  heroEyebrow: 'Where to stay in the oasis',
  title: 'Places to Stay',
  heroSum: 'Places to stay in Al Ahsa — from a heritage inn inside the old city to a hotel on the Al-Uqair coast, each with its photo and its spot on Google Maps. The list is descriptive rather than a set of recommendations, and it keeps growing.',
  listEyebrow: 'The first batch',
  listH: 'Places to stay in Al-Ahsa',
  kindLabels: { 'heritage-inn': 'Heritage inn', hotel: 'Hotel' } as Record<string, string>,
  openMaps: t('det.openMaps'),
  newWindow: '(opens Google Maps in a new window)',
  moreLabel: 'Place details',
  ratingLabel: 'Rating on Google Maps',
  closedPerm: 'Permanently closed — according to Google Maps',
  closedTemp: 'Temporarily closed — according to Google Maps',
  srcNote: fetchedLabel ? `Ratings from Google Maps — last updated ${fetchedLabel}` : null,
  faqH: 'Frequently asked questions about staying in Al Ahsa',
  faqs: [
    { q: 'Is there a heritage inn to stay in inside old Hofuf?',
      a: 'Yes — Al-Koot Heritage Hotel occupies a restored palace in the Al-Koot district opposite Qasr Ibrahim, and was the first heritage hotel in the governorate to be licensed by the Saudi Commission for Tourism and National Heritage.' },
    { q: 'Is there anywhere to stay near Al-Uqair beach?',
      a: 'Yes — Continent Hotel Al Uqayr sits on the Al-Uqair coast east of Al-Ahsa. Caravan owners also have a dedicated site on the beach itself, bookable online through Al-Ahsa Municipality.',
      linkText: 'See the details on the Al-Uqair Beach page →', linkHref: '/en/attractions/uqair-beach/' },
    { q: 'Is this list a recommendation of the best hotels?',
      a: 'No. The cards are descriptive: each place’s name, photo and location on Google Maps. We do not rank one venue above another and we do not list prices — compare options on trusted booking platforms.' },
  ],
  methodH: 'About this page',
  methodP1: 'Names and locations come straight from Google Maps, and the blurbs are brief introductions describing each place as it appears in its photo. No prices, star ratings or recommendations are listed.',
  places: PLACES,
}, ZH);

const pageTitle = ar
  ? 'أماكن الإقامة في الأحساء — نُزل تراثية وفنادق'
  : 'Where to Stay in Al Ahsa — Heritage Inns & Hotels';
const description = ar
  ? 'أماكن الإقامة في الأحساء: نُزلٌ تراثي في حي الكوت بالهفوف وفندقٌ على ساحل العقير، بالصور ومواقع خرائط قوقل المباشرة.'
  : 'Where to stay in Al Ahsa: a heritage inn in Hofuf’s Al-Koot district and a hotel on the Al-Uqair coast, with photos and direct Google Maps locations.';

const siteUrl = SITE;
const selfPath = ar ? '/إقامة/' : zh ? '/zh/stay/' : '/en/stay/';
// ملاحظة ملزمة: لا يُصدَّر التقييم ولا عدد المراجعات في أي JSON-LD — الحارس
// الآلي هو الفحص C10 في tools/check-consistency.mjs.
const jsonLd = [
  breadcrumb([
    { name: t('crumb.home'), path: ar ? '/' : zh ? '/zh/' : '/en/' },
    { name: C.title, path: selfPath },
  ]),
  { '@context': 'https://schema.org', '@type': 'ItemList', name: C.title, itemListElement:
    C.places.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: {
      '@type': 'LodgingBusiness', name: p.name, hasMap: p.maps,
      ...(p.internal ? { url: absUrl(p.href, siteUrl) } : {}),
      image: absUrl(`${p.img}.jpg`, siteUrl),
      address: { '@type': 'PostalAddress', ...(p.area ? { addressLocality: p.area } : {}), addressRegion: ar ? 'الأحساء' : 'Al-Ahsa', addressCountry: 'SA' },
    } })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity:
    C.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: {
      '@type': 'Answer', text: f.linkText ? `${f.a} ${f.linkText.replace(/ [←→]$/, '')}` : f.a,
    } })),
  },
];
---
<Base title={pageTitle} description={description} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">

    <PageHero eyebrow={C.heroEyebrow} title={C.title} lead={C.heroSum} leadWidth={62} lang={lang} />

    <section class="container st-list">
      <div class="st-head">
        <span class="eyebrow">{C.listEyebrow}</span>
        <h2>{C.listH}</h2>
        {C.srcNote && <p class="st-src">{C.srcNote}</p>}
      </div>

      <div class="stgrid">
        {C.places.map((p, idx) => {
          const lv = liveFor(p.img);
          const closed = lv?.status === 'CLOSED_PERMANENTLY' ? C.closedPerm
            : lv?.status === 'CLOSED_TEMPORARILY' ? C.closedTemp : null;
          return (
            <article class="card card--lift stay-card" data-reveal style={`transition-delay:${(idx % 3) * 60}ms`}>
              <a class="sc-link" href={p.href} {...(p.internal ? {} : { target: '_blank', rel: 'noopener' })}>
                <Photo src={p.img} label={p.alt} class="st-photo" sizes="(max-width: 760px) 100vw, 33vw" />
                <div class="sc-body">
                  <span class="eyebrow">{C.kindLabels[p.kind]}</span>
                  <h3>{p.name}</h3>
                  {p.area && <p class="sc-area">{p.area}</p>}
                  {closed && <p class="sc-closed">{closed}</p>}
                  <p class="sc-blurb">{p.blurb}</p>
                  {lv?.rating && (
                    <p class="sc-rating"><span class="sc-star" aria-hidden="true">★</span>
                      <strong>{lv.rating.toFixed(1)}</strong>
                      {lv.count && <span class="sc-count">({lv.count.toLocaleString('en-US')})</span>}
                      <span class="sr-only">{C.ratingLabel}</span>
                    </p>
                  )}
                  <span class="sc-maps">
                    {p.internal ? C.moreLabel : C.openMaps}
                    {p.internal ? (
                      <span class="sc-arrow" aria-hidden="true">{ar ? '←' : '→'}</span>
                    ) : (
                      <>
                        <svg class="sc-ext" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /><polyline points="15 3 21 3 21 9" /><line x1="10" y1="14" x2="21" y2="3" />
                        </svg>
                        <span class="sr-only">{C.newWindow}</span>
                      </>
                    )}
                  </span>
                </div>
              </a>
            </article>
          );
        })}
      </div>

      <section class="st-faq">
        <h2>{C.faqH}</h2>
        <dl>
          {C.faqs.map((f) => (
            <>
              <dt>{f.q}</dt>
              <dd>{f.a}{f.linkText && <> <a href={f.linkHref}>{f.linkText}</a></>}</dd>
            </>
          ))}
        </dl>
      </section>

      <aside class="st-note">
        <h2>{C.methodH}</h2>
        <p>{C.methodP1}</p>
      </aside>
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .st-list { padding-block: var(--s-6) var(--s-8); }
  .st-head { margin-block-end: var(--s-6); }
  .st-head h2 { font-size: var(--t-2xl); margin-block-start: var(--s-2); }
  .st-src { margin-block-start: var(--s-2); font-size: var(--t-xs); color: var(--c-ink-soft); }
  .stgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: var(--s-4); }

  /* القشرة والتحويم من card/card--lift الموحّدين في global.css */
  .sc-link { display: flex; flex-direction: column; flex: 1; text-decoration: none; color: inherit; }
  .sc-link:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 3px; border-radius: var(--radius); }
  .sc-body { padding: var(--s-3) var(--s-4) var(--s-5); display: flex; flex-direction: column; flex: 1; gap: var(--s-2); }
  .stay-card h3 { font-size: var(--t-lg); color: var(--c-turq-deep); }
  .sc-area { font-size: var(--t-xs); color: var(--c-gold-deep); }
  .sc-blurb { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.75; }
  .sc-closed { font-size: var(--t-xs); font-weight: 700; color: var(--c-gold-deep); background: var(--c-sand-2); border-inline-start: 3px solid var(--c-gold); border-radius: var(--radius-sm); padding: 6px 10px; }
  .sc-rating { display: flex; align-items: center; gap: 6px; font-size: var(--t-sm); }
  .sc-star { color: var(--c-gold-deep); }
  .sc-count { color: var(--c-ink-soft); font-size: var(--t-xs); }
  .sc-maps { margin-block-start: auto; padding-block-start: var(--s-2); display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-body); font-weight: 600; font-size: var(--t-xs); color: var(--c-turq-deep); }
  .stay-card:hover .sc-arrow { transform: translateX(var(--arrow-shift, -3px)); }
  .sc-arrow { transition: transform var(--dur) var(--ease); }

  :global(.st-photo) { aspect-ratio: 4 / 3; }
  :global(.st-photo img) { inline-size: 100%; block-size: 100%; object-fit: cover; }

  .st-faq { margin-block-start: var(--s-7); }
  .st-faq h2 { font-size: var(--t-2xl); margin-block-end: var(--s-4); }
  .st-faq dt { font-family: var(--font-body); font-weight: 700; font-size: var(--t-base); color: var(--c-turq-deep); margin-block-start: var(--s-4); }
  .st-faq dd { margin: var(--s-2) 0 0; font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.85; }
  .st-faq dd a { color: var(--c-turq-deep); font-weight: 600; }

  .st-note { margin-block-start: var(--s-7); background: #fff; border-inline-start: 4px solid var(--c-gold); border-radius: var(--radius); box-shadow: var(--shadow); padding: var(--s-4) var(--s-5); }
  .st-note h2 { font-size: var(--t-lg); margin-block-end: var(--s-2); }
  .st-note p { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.85; }
</style>
