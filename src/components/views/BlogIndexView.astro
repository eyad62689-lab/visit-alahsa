---
// فهرس المدونة — ثنائي اللغة. يجلب مقالات لغة الصفحة (بلا مسودات) بالأحدث أولاً.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import Footer from '../Footer.astro';
import PageHero from '../PageHero.astro';
import PalmMotif from '../PalmMotif.astro';
import Photo from '../Photo.astro';
import { formatDate } from '../../lib/dates';
import { useTranslations, type AltLinks } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

interface Props { lang: Lang; alt: AltLinks; }
const { lang, alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const base = ar ? '/مدونة/' : '/en/blog/';
const posts = (await getCollection('blog', ({ data }) => data.lang === lang && !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const siteUrl = 'https://visit-alahsa.com';
const pageUrl = new URL(base, siteUrl).href;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Blog',
    name: t('blog.title'), description: t('blog.lead'), url: pageUrl, inLanguage: ar ? 'ar' : 'en',
  },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('crumb.home'), item: new URL(ar ? '/' : '/en/', siteUrl).href },
    { '@type': 'ListItem', position: 2, name: t('crumb.blog'), item: pageUrl },
  ] },
];
---
<Base title={`${t('blog.title')} — ${t('site.name')}`} description={t('blog.lead')} lang={lang} alt={alt} jsonLd={jsonLd}>
  <Header lang={lang} alt={alt} />
  <main id="main">
    <PageHero eyebrow={t('blog.eyebrow')} title={t('blog.title')} lead={t('blog.lead')} leadWidth={52} lang={lang} />

    <section class="container blog-list" data-reveal>
      {posts.length === 0 ? (
        <p class="blog-empty">{t('blog.empty')}</p>
      ) : (
        <div class="bl-grid">
          {posts.map((p) => (
            <a class="card card--lift bl-card" href={base + p.data.slug + '/'}>
              {p.data.heroImage ? (
                <Photo src={p.data.heroImage} label={p.data.title} class="bl-photo" sizes="(max-width: 760px) 100vw, 33vw" />
              ) : (
                <div class="bl-ph" aria-hidden="true"><PalmMotif size={72} class="bl-ph-palm" /></div>
              )}
              <div class="bl-body">
                <span class="t-caption bl-k">{p.data.topic}</span>
                <h2 class="bl-t">{p.data.title}</h2>
                <p class="bl-d">{p.data.description}</p>
                <time class="bl-date" datetime={p.data.pubDate.toISOString().slice(0, 10)}>{formatDate(p.data.pubDate, lang)}</time>
              </div>
            </a>
          ))}
        </div>
      )}
    </section>
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .blog-list { padding-block: var(--s-7) var(--s-8); }
  .blog-empty { color: var(--c-ink-soft); font-size: var(--t-lg); }
  .bl-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-4); }
  /* القشرة والتحويم من صنفَي card/card--lift الموحّدين في global.css */
  :global(.bl-photo) { aspect-ratio: 16 / 10; border-radius: 0; }
  .bl-ph { aspect-ratio: 16 / 10; display: grid; place-items: center; background: var(--c-turq-deep); }
  :global(.bl-ph-palm) { color: var(--c-gold); opacity: .5; }
  .bl-body { padding: var(--s-3) var(--s-4) var(--s-4); display: flex; flex-direction: column; gap: var(--s-1); flex: 1; }
  .bl-k { color: var(--c-gold-deep); }
  .bl-t { font-size: var(--t-lg); color: var(--c-turq-deep); line-height: 1.35; }
  .bl-d { font-size: var(--t-sm); color: var(--c-ink-soft); line-height: 1.7; }
  .bl-date { margin-block-start: auto; padding-block-start: var(--s-2); font-size: var(--t-xs); color: var(--c-ink-60); }
  /* قاعدة الشبكات الثلاثية الموحّدة (دفعة 3): عمودان ≤1000، عمود ≤760 —
     كانت هنا 980/640 وحدها بين شبكات الموقع (تدقيق 2026-08-28) */
  @media (max-width: 1000px) { .bl-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 760px) { .bl-grid { grid-template-columns: 1fr; } }
</style>
