---
// شريط اليوم الوطني السعودي 96 — الشعار الرسمي فوق الترويسة.
//
// الأصل: حزمة الهوية الرسمية الصادرة عن الهيئة العامة للترفيه، نسخة إياد في
// مشروع الإنتاج البصري (‏media-agent/projects/alahsa/works/nd96-ma-yarja-fadi/
// brand/nd96-official/Logo/logo/Logo.pdf) — **النسخة الأفقية** لا الرأسية،
// لأن دليل الهوية (ص9) يخصّها بـ«المساحات العريضة مثل اللافتات والواجهات
// الرقمية»، وهي وحدها التي تُقرأ في شريط بهذا الارتفاع. صُيِّرت من المتجه نفسه
// بـpdf.js عند 5× ثم قُصّت على حدودها المقيسة.
//
// أحكام دليل الهوية المطبَّقة حرفياً (SND-GUIDELINE):
//   1.3 المساحة الهامشية = 2X (ارتفاع مربّعين من نمط الشطرنج). X مقيس من
//       الرندر: 53.5px عند 5× أي 8.96% من ارتفاع اللوكاب — **وهي مخبوزة داخل
//       الصورة** فلا يستطيع تعديل لاحق في CSS أن ينتهكها.
//   1.5 الخلفية لونٌ **واحد** من ألوان الهوية — فسقط التدرّج السابق
//       (فيروزي الموقع → أخضر معمَّق) وحلّ محلّه الأخضر الغامق الرسمي #002628،
//       وهو لون اللوح في ملفَّي الشعار والألوان (مقيس بالعيّنة لا مُقدَّر؛
//       وصحّة القياس مثبَتة بمطابقة #5aba1c المطبوع في الدليل).
//   1.6 في الاستخدامات الرقمية يوضع الشعار **في إحدى الزاويتين يميناً أو
//       يساراً** لا في الوسط (الوسط للطباعة) — فهو عند حافة البداية: يمين في
//       العربية ويسار في الإنجليزية، وكلتاهما ممّا يجيزه البند.
//   1.4 لا نسخة بيضاء/سوداء إلا في الطباعة أحادية اللون — فالنسخة الملوّنة هنا.
//
// الانقضاء بطبقتين، على نمط EventEdition حرفياً (لا عنصر يدوي يُنسى حذفه):
//   (١) البناء: خارج النافذة لا يُصيَّر العنصر إطلاقاً.
//   (٢) المتصفح: سكربت متزامن ملاصق يحذفه بتاريخ الجهاز إن بقيت الصفحة مخزّنة
//       بلا نشرٍ جديد — وهو المعوَّل عليه لأن الموقع ثابت ولا يُبنى إلا عند دفعة.
//       ومتزامناً أثناء التحليل يسبق أول رسم: لا وميض ولا إزاحة تخطيط.
// التوقيت بتوقيت السعودية (UTC+3) لا بتوقيت جهاز الزائر — نفس ksaDay.
//
// <aside> مسمّى لا <div>: قاعدة axe «region» تُلزم أن يكون كل محتوى الصفحة
// داخل معلَم، والشريط يسبق <header> فكان محتواه خارج أي معلَم (أخفق الفحص
// فعلياً بـregion×2 على أربع صفحات). ولا يُضمّ إلى <header> بدلاً من ذلك:
// الترويسة لاصقة فيصير الشريط لاصقاً معها ويبتلع مساحة كل شاشة طوال الأسبوع.
import type { Lang } from '../i18n/ui';
import { localize } from '../i18n/utils';

interface Props { lang: Lang; }
const { lang } = Astro.props;

// نافذة العرض: أسبوع واحد يبدأ 2026-09-22 (طلب إياد) واليوم الوطني 23 سبتمبر.
const START = '2026-09-22';
const END = '2026-09-28';

// يوم البناء بتوقيت السعودية — بنفس اشتقاق السكربت أدناه فلا تتباعد الطبقتان.
const ksaToday = new Date(Date.now() + 3 * 3600000).toISOString().slice(0, 10);
const inWindow = ksaToday >= START && ksaToday <= END;

// العربية والإنجليزية فقط: سلسلة إنجليزية غير مترجمة داخل صفحة zh/de/ru هي
// عين ما يقيسه الفحص C22، وحتى تمرّ النصوص بخطوط الترجمة الثلاثة يبقى غيابُ
// لمسة أهونَ من إضعاف حارس.
//
// الترجمة الإنجليزية للشعار **رسمية** لا من عندنا: دليل الهوية ص8 يقابل
// «عزّنا بطبعنا» بـ«Our pride is in our nature». (قبل الاطّلاع على الدليل كنا
// نتحاشى صوغ مقابلٍ إنجليزي لئلا ندّعي رسميةً لا نملكها — والدليل حسمها.)
const C = localize(lang, {
  ar: { region: 'مناسبة وطنية', alt: 'اليوم الوطني السعودي — عزّنا بطبعنا' },
  en: { region: 'National occasion', alt: 'Saudi National Day — Our pride is in our nature' },
});
const show = inWindow && (lang === 'ar' || lang === 'en');
---

{show && (
  <aside class="natday" aria-label={C.region} data-natday data-natday-end={END} data-pagefind-ignore>
    <div class="nd-in">
      {/* fetchpriority=low وdecoding=async: الشريط فوق الطيّة لكنه ليس عنصر LCP
          (ملصق البطل أكبر منه بمراتب)، فلا يُزاحمه على النطاق. وwidth/height
          الجوهريان يحجزان مكانه فلا إزاحة تخطيط. */}
      <img
        class="nd-logo"
        src="/img/nd96-logo-420.png"
        srcset="/img/nd96-logo-420.png 420w, /img/nd96-logo-840.png 840w"
        sizes="(max-width: 480px) 124px, 150px"
        width="420" height="95"
        alt={C.alt}
        decoding="async"
        fetchpriority="low"
      />
    </div>
  </aside>
  <script is:inline define:vars={{ END }}>
    // متزامن وملاصق: يُنفَّذ أثناء التحليل قبل أول رسم، فلا وميض ولا إزاحة.
    (function () {
      function ksaDay(ms) { return Math.floor((ms + 3 * 3600000) / 86400000); }
      function sweep() {
        var end = Date.parse(END + 'T00:00:00Z');
        if (isNaN(end)) return;
        if (ksaDay(Date.now()) <= end / 86400000) return;
        document.querySelectorAll('[data-natday]').forEach(function (el) { el.remove(); });
      }
      sweep();
      // ClientRouter يبدّل المستند، فيعود الشريط من HTML الصفحة الجديدة —
      // الحارس يمنع تكرار المستمع عبر التنقّلات (نمط __vaLangMenu في الترويسة).
      if (!window.__vaNatDay) {
        window.__vaNatDay = true;
        document.addEventListener('astro:page-load', sweep);
      }
    })();
  </script>
)}

<style>
  /* شريط فوق الترويسة اللاصقة: ينزلق مع الصفحة ولا يزاحم الترويسة مكانها
     الثابت. وهو خارج .hd-in فلا يمسّ ميزانية عرض الشريط المقيسة
     (tools/measure-header-fit.mjs يقيس .hd-in وحدها). */
  .natday {
    /* لون واحد من لوحة الهوية (البند 1.5) — لا تدرّج. وهو نفسه لون خلفية
       الصورة فيصير الشريط سطحاً واحداً بلا حدٍّ مرئي حول الملف. */
    background: #002628;
    /* الخيط الذهبي حدُّ الشريط لا عنصرٌ داخل المساحة الهامشية: المسافة بينه
       وبين رسم الشعار = حشوة الشريط + الـ2X المخبوزة، أي ضعف اللازم. */
    border-block-end: 1px solid color-mix(in srgb, var(--c-gold) 55%, transparent);
  }
  .nd-in {
    inline-size: min(100% - var(--s-3), 1280px);
    margin-inline: auto;
    /* حافة البداية لا الوسط (البند 1.6 للاستخدام الرقمي) */
    display: flex; align-items: center; justify-content: flex-start;
    padding-block: 5px;
  }
  .nd-logo { inline-size: 150px; block-size: auto; }

  @media (max-width: 480px) {
    .nd-logo { inline-size: 124px; }
  }
</style>
