  .adv-cards ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .adv-card { display: flex; align-items: center; gap: 10px; min-block-size: 44px; padding: 6px 10px 6px 6px; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-sm); color: var(--c-turq-deep); font-weight: 600; font-size: var(--t-sm); text-decoration: none; transition: box-shadow var(--dur) var(--ease); }
