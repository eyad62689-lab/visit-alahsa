---
// المستشار الذكي (2026-10-23) — زرّ عائم يفتح لوحة محادثة تسأل دالة Netlify `advisor`
// (netlify/functions/advisor/) التي تبثّ جواب Claude من بطاقة معرفة الموقع وحدها.
//
// المبادئ: الجواب نصّ خام يُعرض بـtextContent (لا HTML من النموذج)؛ الروابط تأتي بطاقاتٍ
// من الدالة (معرّفات البطاقة ← صفحات مبنية)؛ المحادثة في sessionStorage داخل try/catch
// فتنجو من تنقّلات ClientRouter وتُنسى بإغلاق التبويب؛ لا شيء يُحفظ في الخادم.
//
// النصوص: advisor.* في ui.ts باللغات الست (zh/de/ru/ur عبر خطوط ترجمتها، دفعة advisor-ui).
// لغة جديدة بلا مفاتيحها تُعرض بلا نصّ ولا اقتراحات جاهزة (chips) لا إنجليزية.
// الجواب نفسه بلغة الصفحة من النموذج. القياس: data-track (advisor_open / advisor_card_click)
// وVATrack('advisor_send')، وVATrack('advisor_answer') بتسميات المواضيع وأنواع البطاقات بعد كل جواب.
//
// الشخصية (قرار إياد 2026-10-24): المستشار هو «بلبل» — تميمة الموقع (البلبل أبيض الخدين)؛ والتحية بلسانه
// (ui.ts) والنبرة في برومبت الدالة.
//
// المشهد الحي (2026-10-25): بلبل واقعي يجثم في عش فوق الطرف الداخلي للزرّ (وداخل الدائرة على الجوال)،
// يطير مرة بعد التحميل (مرة في الجلسة) ويطير إلى رأس اللوحة عند فتحها فلا يؤخر المستخدم. الأصول من
// tools/gen-bulbul-assets.mjs (صورة الوقوف، شريط وضعيات الأجنحة بمراسي عين موحّدة، رأس اللوحة) وهندستها في
// src/data/bulbul-sprite.json. العش SVG مضمّن يُرسم هنا بمولّد حتمي (خيوط قشّ بلا عشوائية بين البنائين).
// الصور تُطلب بعد حدث load فقط (لا تزاحم LCP)، والمشهد ديكور (aria-hidden)، وprefers-reduced-motion: صورة ساكنة.
import { ui, type Lang } from '../i18n/ui';
import { useTranslations, isRtl } from '../i18n/utils';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const own = (key: string): string | undefined => (ui[lang] as Record<string, string>)[key];
// الصفحة «مترجمة» حين تحمل كتلة لغتها مفاتيح advisor.* نفسها؛ وإلا تُعرض الواجهة بلا أي نصّ إنجليزي من كلمتين
// فأكثر (يحرسه C22 على dist): أيقونة واسم العلامة اللاتيني المعتمد فقط، ولا مقدمة ولا اقتراحات ولا إشعار،
// وعند التعطّل تختفي بصمت — كسابقة SeasonNow على de/ru: كتلة بلا نسخة بلغتها تُخفى لا تُعرض إنجليزية.
const translated = Boolean(own('advisor.title'));
const brand = t('site.brand');
const s = (key: keyof typeof ui['ar']): string => (translated ? t(key) : '');
const chips = ['advisor.chip1', 'advisor.chip2', 'advisor.chip3'].map(own).filter((x): x is string => Boolean(x));
const dir = isRtl(lang) ? 'rtl' : 'ltr';
const endpoint = import.meta.env.PUBLIC_ADVISOR_ENDPOINT ?? '/.netlify/functions/advisor';

// ——— العش: viewBox 120×52، فوهته قطع ناقص مركزه (60,14) ونصفا قطريه 57×11، وقاعه حتى y=51 ———
// مولّد حتمي (mulberry32) فالمخرَج ثابت بين البنائين؛ الإحداثيات بمنزلة عشرية واحدة.
function rng(seed: number) {
  let a = seed >>> 0;
  return () => { a = (a + 0x6d2b79f5) >>> 0; let t = a; t = Math.imul(t ^ (t >>> 15), t | 1); t ^= t + Math.imul(t ^ (t >>> 7), t | 61); return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
const r1 = (v: number) => Math.round(v * 10) / 10;
const STRAW = ['#c49c68', '#8d6942', '#5a402b', '#a77c49'];
const span = (x: number) => Math.max(0, 1 - ((x - 60) / 57) ** 2);
const nearRim = (x: number) => 14 + 11 * Math.sqrt(span(x));
const farRim = (x: number) => 14 - 11 * Math.sqrt(span(x));
const bottom = (x: number) => 14 + 37 * span(x) ** 0.6;
const rand = rng(1563);
const pick = () => STRAW[Math.floor(rand() * STRAW.length)];
// خيط يتبع انحناء الوعاء على عمق t بين الحافة القريبة والقاع، بطول جزئي وميل خفيف
function strand(t: number, curve: (x: number, t: number) => number) {
  const x0 = 2 + rand() * 40, x1 = 78 + rand() * 40, tilt = (rand() - 0.5) * 0.12;
  const pts: string[] = [];
  for (let i = 0; i <= 6; i++) { const x = x0 + ((x1 - x0) * i) / 6; pts.push(`${r1(x)},${r1(curve(x, t) + tilt * (x - 60))}`); }
  return { d: `M${pts.join('L')}`, c: pick(), w: r1(1 + rand() * 1.4), o: r1(0.75 + rand() * 0.25) };
}
const bowlPts: string[] = [];
for (let x = 3; x <= 117; x += 6) bowlPts.push(`${r1(x)},${r1(bottom(x))}`);
const rimPts: string[] = [];
for (let x = 117; x >= 3; x -= 6) rimPts.push(`${r1(x)},${r1(nearRim(x))}`);
const bowlD = `M3,14L${bowlPts.join('L')}L117,14L${rimPts.join('L')}Z`;
const frontStrands = Array.from({ length: 26 }, (_, i) => strand(0.04 + (i / 26) * 0.96, (x, t) => nearRim(x) + t * (bottom(x) - nearRim(x))));
const rimStrands = Array.from({ length: 7 }, () => strand(rand() * 0.12, (x, t) => nearRim(x) + t * 6 - 1.5));
const backStrands = Array.from({ length: 9 }, () => strand(rand(), (x, t) => farRim(x) - t * 4 + 1));
// قشّات بارزة من الحافة
const straws = Array.from({ length: 7 }, () => {
  const x = 6 + rand() * 108, y = nearRim(x) + rand() * 4, side = x < 60 ? -1 : 1;
  const ang = (side * (20 + rand() * 50) * Math.PI) / 180, len = 7 + rand() * 9;
  return { d: `M${r1(x)},${r1(y)}L${r1(x + Math.sin(ang) * len)},${r1(y - Math.cos(ang) * len * 0.6)}`, c: pick() };
});
---
<div class="adv-root" id="advisor" data-lang={lang} data-endpoint={endpoint} dir={dir} data-pagefind-ignore
  data-s-resting={s('advisor.resting')} data-s-rate={s('advisor.rate')} data-s-error={s('advisor.error')}
  data-s-cards={s('advisor.cards')} data-s-thinking={s('advisor.thinking')}>
  <button type="button" class="adv-fab" aria-expanded="false" aria-controls="advisor-panel" aria-label={translated ? t('advisor.open') : brand} data-track="advisor_open">
    <span class="adv-perch" aria-hidden="true">
      <svg class="adv-nest adv-nest--back" viewBox="0 0 120 52" width="60" height="26" focusable="false">
        <defs>
          <radialGradient id="adv-nest-cup" cx="50%" cy="60%" r="60%"><stop offset="0" stop-color="#2a1c10" /><stop offset=".7" stop-color="#3e2b1a" /><stop offset="1" stop-color="#5a402b" /></radialGradient>
        </defs>
        <ellipse cx="60" cy="14" rx="57" ry="11" fill="#6b4c30" />
        {backStrands.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} fill="none" stroke-linecap="round" />)}
        <ellipse cx="60" cy="15" rx="50" ry="8.5" fill="url(#adv-nest-cup)" />
      </svg>
      <span class="adv-bird"><span class="adv-bird-img"></span></span>
      <svg class="adv-nest adv-nest--front" viewBox="0 0 120 52" width="60" height="26" focusable="false">
        <defs>
          <linearGradient id="adv-nest-body" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a77c49" /><stop offset=".55" stop-color="#8d6942" /><stop offset="1" stop-color="#5a402b" /></linearGradient>
          <radialGradient id="adv-nest-shade" cx="50%" cy="10%" r="95%"><stop offset=".55" stop-color="#2a1c10" stop-opacity="0" /><stop offset="1" stop-color="#2a1c10" stop-opacity=".55" /></radialGradient>
          <clipPath id="adv-nest-clip"><path d={bowlD} /></clipPath>
        </defs>
        <path d={bowlD} fill="url(#adv-nest-body)" />
        <g clip-path="url(#adv-nest-clip)" fill="none" stroke-linecap="round">
          {frontStrands.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} />)}
          <path d={bowlD} fill="url(#adv-nest-shade)" stroke="none" />
        </g>
        <g fill="none" stroke-linecap="round">
          {rimStrands.map((s) => <path d={s.d} stroke={s.c} stroke-width={s.w} opacity={s.o} />)}
          {straws.map((s) => <path d={s.d} stroke={s.c} stroke-width="1.3" />)}
        </g>
      </svg>
    </span>
    {translated && <span class="adv-fab-tx">{t('advisor.open')}</span>}
  </button>

  <section id="advisor-panel" class="adv" role="dialog" aria-labelledby="advisor-title" hidden>
    <header class="adv-hd">
      <picture class="adv-hd-ic">
      <source srcset="/img/brand/bulbul-head-64.webp" type="image/webp" />
      <img src="/img/brand/bulbul-head-64.png" width="28" height="28" alt="" loading="lazy" decoding="async" fetchpriority="low" />
    </picture>
      <h2 id="advisor-title" class="adv-title">{translated ? t('advisor.title') : brand}</h2>
      <button type="button" class="adv-reset" aria-label={translated ? t('advisor.reset') : brand} hidden={!translated}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7" /><path d="M3 4v5h5" /></svg>
      </button>
      <button type="button" class="adv-x" aria-label={t('advisor.close')}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
      </button>
    </header>

    <div class="adv-log" aria-live="polite" aria-busy="false">
      {translated && <div class="adv-msg adv-msg--bot adv-intro">{t('advisor.intro').split('\n').map((line) => <p>{line}</p>)}</div>}
      {chips.length > 0 && (
        <div class="adv-chips">
          {chips.map((c) => <button type="button" class="adv-chip">{c}</button>)}
        </div>
      )}
    </div>

    <form class="adv-form" autocomplete="off">
      <textarea id="advisor-input" class="adv-in" rows="1" maxlength="600" placeholder={translated ? t('advisor.placeholder') : undefined} aria-label={translated ? t('advisor.placeholder') : brand} required></textarea>
      <button type="submit" class="adv-send" aria-label={t('advisor.send')}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13" /><path d="M13 6l6 6-6 6" /></svg>
      </button>
    </form>
    {translated && <p class="adv-note">{t('advisor.notice')}</p>}
  </section>
  <span class="adv-fly" aria-hidden="true" hidden></span>
</div>

<script>
  // يُحمَّل مرة لكل جلسة (حارس) ويُعاد ربط العناصر عند كل تنقّل (astro:page-load) لأن القالب يعيد تصييرها.
  import geo from '../data/bulbul-sprite.json';
  type Msg = { role: 'user' | 'assistant'; content: string };
  type Card = { id: string; name: string; href: string; img: string | null; kind: string };

  const w = window as unknown as { __vaAdvisor?: boolean; VATrack?: (n: string, p?: Record<string, unknown>) => void };
  if (!w.__vaAdvisor) {
    w.__vaAdvisor = true;

    const KEY = (lang: string) => `va-advisor-${lang}`;
    const load = (lang: string): Msg[] => { try { return JSON.parse(sessionStorage.getItem(KEY(lang)) || '[]'); } catch { return []; } };
    const save = (lang: string, m: Msg[]) => { try { sessionStorage.setItem(KEY(lang), JSON.stringify(m.slice(-12))); } catch { /* تخزين معطَّل */ } };
    const OPEN = 'va-advisor-open';
    const isOpen = () => { try { return sessionStorage.getItem(OPEN) === '1'; } catch { return false; } };
    const setOpen = (v: boolean) => { try { sessionStorage.setItem(OPEN, v ? '1' : '0'); } catch { /* */ } };

    // يقصّ سطر [[links: …]] من آخر ظهوره مهما كانت صياغته (أقواس زائدة حول المعرّفات مثلاً)،
    // ويقصّ «[[» الناقصة في ذيل النصّ أثناء البث
    const visible = (s: string) => {
      let at = -1;
      for (const m of s.matchAll(/\[\[\s*links?\s*:/gi)) at = m.index ?? -1;
      if (at < 0) { const j = s.lastIndexOf('[['); if (j >= 0 && s.length - j <= 12) at = j; }
      return (at >= 0 ? s.slice(0, at) : s).trimEnd();
    };

    function paragraphs(el: HTMLElement, text: string) {
      el.replaceChildren();
      for (const part of text.split(/\n{2,}/)) {
        const p = document.createElement('p');
        p.textContent = part.replace(/\n/g, ' ').trim();
        if (p.textContent) el.appendChild(p);
      }
    }

    // ——— بلبل: صورة الجثوم وطيرانه ———
    // الأصول بمقياس 2x (src/data/bulbul-sprite.json): كل بكسلين من الأصل بكسل CSS واحد قبل مقياس المشهد.
    // الطائر في الأصول ينظر يساراً؛ في RTL يُعكس العش (CSS) فينظر إلى داخل الصفحة.
    const bulbul = (() => {
      const P = geo.perch, F = geo.fly;
      const PW = P.w / 2, FW = F.w / 2, FH = F.h / 2, EX = F.eye[0] / 2, EY = F.eye[1] / 2;
      const ORDER = [0, 2, 3, 4, 5]; // ضربة الجناح: أعلى ← منبسط ← أسفل ← أدنى ← صاعد
      const GLIDE = 2;               // الأجنحة الممدودة للانزلاق
      const FLOWN = 'va-bulbul-flown';
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      type Pt = { x: number; y: number; s: number; dir: number };
      type Flight = { kind: 'eight' | 'panel'; t0: number; dur: number; from: Pt; ax: [number, number]; h: number; to?: { x: number; y: number } };
      let art: { perch: string; fly: string } | null = null;
      let fl: Flight | null = null;
      let raf = 0, last = 0, beat = 0;
      let intro: ReturnType<typeof setTimeout> | undefined;

      const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(`#advisor ${sel}`);
      const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
      const smooth = (a: number, b: number, v: number) => { const t = clamp((v - a) / (b - a), 0, 1); return t * t * (3 - 2 * t); };

      function paint() {
        if (!art) return;
        const img = $('.adv-bird-img');
        if (img) { img.style.backgroundImage = `url("${art.perch}")`; img.classList.add('is-ready'); }
        const fly = $('.adv-fly');
        if (fly) {
          Object.assign(fly.style, {
            backgroundImage: `url("${art.fly}")`, width: `${FW}px`, height: `${FH}px`,
            backgroundSize: `${FW * F.n}px ${FH}px`, transformOrigin: `${EX}px ${EY}px`,
          });
        }
      }
      const fetchImg = (src: string) => new Promise<string>((ok, fail) => {
        const i = new Image(); i.decoding = 'async'; i.setAttribute('fetchpriority', 'low');
        i.onload = () => ok(src); i.onerror = fail; i.src = src;
      });
      const one = (name: string) => fetchImg(`/img/brand/${name}.webp`).catch(() => fetchImg(`/img/brand/${name}.png`));

      // موضع العين على الشاشة ومقياس المشهد (0.7 على الجوال) واتجاه النظر (−1 يسار، +1 يمين)
      function perchPoint(): Pt | null {
        const bird = $('.adv-bird'); const root = document.getElementById('advisor');
        if (!bird || !root || !art) return null;
        const r = bird.getBoundingClientRect();
        if (!r.width) return null;
        const s = r.width / PW; const mirrored = root.dir === 'rtl';
        const ex = (P.eye[0] / 2) * s, ey = (P.eye[1] / 2) * s;
        return { x: mirrored ? r.right - ex : r.left + ex, y: r.top + ey, s, dir: mirrored ? 1 : -1 };
      }

      function frame(p: Pt, s: number, fx: number, rot: number, pose: number, alpha: number) {
        const fly = $('.adv-fly'); if (!fly) return;
        fly.style.transform = `translate(${(p.x - EX).toFixed(1)}px, ${(p.y - EY).toFixed(1)}px) rotate(${rot.toFixed(1)}deg) scale(${(fx * s).toFixed(3)}, ${s.toFixed(3)})`;
        fly.style.backgroundPosition = `${-pose * FW}px 0`;
        fly.style.opacity = alpha.toFixed(2);
      }

      function stop(silent = false) {
        cancelAnimationFrame(raf); raf = 0; fl = null;
        if (silent && intro) { clearTimeout(intro); intro = undefined; }
        const fly = $('.adv-fly'); if (fly) fly.hidden = true;
        const img = $('.adv-bird-img'); if (img) img.style.opacity = '';
      }

      function tick(now: number) {
        if (!fl) return;
        const dt = Math.min((now - last) / 1000, 0.05); last = now;
        const p = clamp((now - fl.t0) / fl.dur, 0, 1);
        const { from } = fl;
        let x: number, y: number, vx: number, vy: number, s: number, alpha: number;
        if (fl.kind === 'eight') {
          // ثمانية مسطّحة: تخرج إلى جهة النظر وتصعد، تعبر فوق العش في المنتصف، تدور في الجهة الأخرى وتهبط
          const w = Math.sin(2 * Math.PI * p), amp = w >= 0 ? fl.ax[0] : fl.ax[1];
          x = from.x + from.dir * amp * w; y = from.y - fl.h * Math.sin(Math.PI * p);
          vx = from.dir * amp * Math.cos(2 * Math.PI * p) * 2; vy = -fl.h * Math.cos(Math.PI * p);
          s = from.s * (1 - 0.08 * Math.sin(Math.PI * p));
          alpha = smooth(0, 0.06, p) * (1 - smooth(0.93, 1, p));
        } else {
          // إلى رأس اللوحة: قوس يتأرجح إلى جهة النظر ثم يحطّ على أيقونة الرأس ويتلاشى فيها
          const to = fl.to!, e = smooth(0, 1, p), arc = 50 * from.s, swing = 46 * from.s * Math.sin(2 * Math.PI * p) * (1 - p);
          x = from.x + (to.x - from.x) * e + from.dir * swing; y = from.y + (to.y - from.y) * e - arc * Math.sin(Math.PI * p);
          vx = (to.x - from.x) * 6 * p * (1 - p) + from.dir * 46 * from.s * Math.cos(2 * Math.PI * p);
          vy = (to.y - from.y) * 6 * p * (1 - p) - arc * Math.cos(Math.PI * p);
          s = from.s * (1 - 0.45 * e);
          alpha = 1 - smooth(0.8, 1, p);
          if (p > 0.85) document.querySelector('#advisor .adv-hd-ic')?.classList.add('is-pop');
        }
        // الاتجاه: انعكاس أفقي مع انكماش عند الدوران (لا قلب مفاجئ)، وميل خفيف بحسب الصعود
        const v = Math.hypot(vx, vy) || 1, hx = vx / v;
        const face = Math.abs(hx) < 0.02 ? -from.dir : (hx < 0 ? 1 : -1);
        const fx = face * clamp(Math.abs(hx) * 3, 0.35, 1);
        const rot = clamp(face * 14 * (-vy / v), -12, 12);
        beat += dt * 5.5;
        const edge = fl.kind === 'eight' ? p < 0.06 || p > 0.94 : p < 0.05;
        const pose = edge ? 0 : p > 0.42 && p < 0.58 ? GLIDE : ORDER[Math.floor(beat * ORDER.length) % ORDER.length];
        frame({ x, y, s, dir: from.dir }, s, fx, rot, pose, alpha);
        if (fl.kind === 'eight') { const img = $('.adv-bird-img'); if (img) img.style.opacity = (1 - alpha).toFixed(2); }
        if (p >= 1) { stop(); return; }
        raf = requestAnimationFrame(tick);
      }

      function start(f: Flight) {
        const fly = $('.adv-fly'); if (!fly) return false;
        fl = f; beat = 0; last = performance.now(); fly.hidden = false;
        raf = requestAnimationFrame(tick);
        return true;
      }
      const canFly = () => Boolean(art) && !reduced.matches && !document.hidden;

      // الطيران الافتتاحي: حدود الثمانية من موضع العش وحدود الشاشة وأسفل الترويسة
      function eight() {
        const root = document.getElementById('advisor');
        if (!canFly() || !root || root.classList.contains('is-open') || $('.adv-fab.is-away')) return;
        const from = perchPoint(); if (!from) return;
        const mobile = window.innerWidth <= 640;
        const capX = mobile ? 85 : 220, capH = mobile ? 85 : 160;
        const half = FW * from.s * 0.55, gap = 10;
        const left = from.x - gap - half, right = window.innerWidth - from.x - gap - half;
        const header = document.querySelector('header');
        const top = (header ? Math.max(0, header.getBoundingClientRect().bottom) : 0) + gap + EY * from.s;
        const h = clamp(from.y - top, 0, capH);
        const ax: [number, number] = from.dir < 0 ? [clamp(left, 0, capX), clamp(right, 0, capX)] : [clamp(right, 0, capX), clamp(left, 0, capX)];
        if (h < 30 || ax[0] + ax[1] < 60) return; // لا مساحة تكفي: يبقى في عشه
        if (start({ kind: 'eight', t0: performance.now(), dur: 4000, from, ax, h })) {
          try { sessionStorage.setItem(FLOWN, '1'); } catch { /* تخزين معطَّل */ }
        }
      }

      function toPanel(from: Pt) {
        if (!canFly()) return;
        const ic = document.querySelector<HTMLElement>('#advisor .adv-hd-ic');
        const r = ic?.getBoundingClientRect();
        if (!ic || !r || !r.width) return;
        ic.classList.remove('is-pop');
        start({ kind: 'panel', t0: performance.now(), dur: 2000, from, ax: [0, 0], h: 0, to: { x: r.left + r.width * 0.42, y: r.top + r.height * 0.4 } });
      }

      // الأصول بعد load فقط، ثم الطيران الافتتاحي بعد 1.5 ثانية مرة في الجلسة
      const boot = () => {
        Promise.all([one('bulbul-perch'), one('bulbul-fly')]).then(([perch, fly]) => {
          art = { perch, fly }; paint();
          let flown = false; try { flown = sessionStorage.getItem(FLOWN) === '1'; } catch { /* */ }
          if (!flown && !reduced.matches) intro = setTimeout(eight, 1500);
        }).catch(() => { /* يبقى العش وحده */ });
      };
      if (document.readyState === 'complete') boot(); else window.addEventListener('load', boot, { once: true });
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
      window.addEventListener('resize', () => { if (fl) stop(); }, { passive: true });
      reduced.addEventListener('change', () => stop());
      return { paint, perchPoint, toPanel, stop };
    })();

    function wire() {
      const root = document.getElementById('advisor');
      if (!root || root.dataset.wired) return;
      root.dataset.wired = '1';
      const host: HTMLElement = root; // نسخة مضيَّقة النوع لإغلاقات الدوال المرفوعة
      const lang = root.dataset.lang || 'ar';
      const endpoint = root.dataset.endpoint || '/.netlify/functions/advisor';
      const S = (k: string) => root.dataset['s' + k.charAt(0).toUpperCase() + k.slice(1)] || '';
      const fab = root.querySelector<HTMLButtonElement>('.adv-fab')!;
      const panel = root.querySelector<HTMLElement>('.adv')!;
      const log = root.querySelector<HTMLElement>('.adv-log')!;
      const form = root.querySelector<HTMLFormElement>('.adv-form')!;
      const input = root.querySelector<HTMLTextAreaElement>('.adv-in')!;
      const send = root.querySelector<HTMLButtonElement>('.adv-send')!;
      let history = load(lang);
      let busy = false;

      const bubble = (role: Msg['role'], text: string) => {
        const d = document.createElement('div');
        d.className = `adv-msg adv-msg--${role === 'user' ? 'you' : 'bot'}`;
        paragraphs(d, text);
        log.appendChild(d);
        return d;
      };
      const scroll = () => { log.scrollTop = log.scrollHeight; };
      const chipsEl = () => root.querySelector<HTMLElement>('.adv-chips');

      // إعادة رسم المحادثة المحفوظة (بلا بطاقات: الروابط تُطلب مجدداً بسؤال جديد)
      for (const m of history) bubble(m.role, m.content);
      if (history.length && chipsEl()) chipsEl()!.hidden = true;

      const open = (v: boolean) => {
        panel.hidden = !v;
        fab.setAttribute('aria-expanded', String(v));
        fab.classList.remove('is-away');
        root.classList.toggle('is-open', v);
        setOpen(v);
        if (v) { scroll(); setTimeout(() => input.focus(), 50); } else fab.focus();
      };
      fab.addEventListener('click', () => {
        const opening = panel.hasAttribute('hidden');
        // نقطة الجثوم تُقرأ قبل الفتح (الزر يختفي معه)، واللوحة تُفتح فوراً والبلبل يطير إليها أثناءها
        bulbul.stop();
        const from = opening ? bulbul.perchPoint() : null;
        open(opening);
        if (from) bulbul.toPanel(from);
      });
      // التركيز (لوحة مفاتيح أو قارئ شاشة) يُظهر الزر ولو كان منزلقاً خارج الشاشة
      fab.addEventListener('focus', () => fab.classList.remove('is-away'));
      root.querySelector('.adv-x')!.addEventListener('click', () => open(false));
      root.querySelector('.adv-reset')!.addEventListener('click', () => {
        history = []; save(lang, history);
        log.querySelectorAll('.adv-msg:not(.adv-intro), .adv-cards').forEach((n) => n.remove());
        if (chipsEl()) chipsEl()!.hidden = false;
        form.hidden = false; input.focus();
      });
      panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
      if (isOpen()) open(true);

      root.querySelectorAll<HTMLButtonElement>('.adv-chip').forEach((b) => b.addEventListener('click', () => { input.value = b.textContent || ''; form.requestSubmit(); }));
      input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); } });
      input.addEventListener('input', () => { input.style.height = 'auto'; input.style.height = Math.min(input.scrollHeight, 120) + 'px'; });

      function finalNote(text: string, hideForm: boolean) {
        // بلا نصّ بلغة الصفحة (zh/de/ru/ur قبل الترجمة): التعطّل الدائم يُخفي الواجهة كلها، والعابر يُظهر رمزاً وحده
        if (!text) {
          if (hideForm) { open(false); host.hidden = true; return; }
          const d = document.createElement('div'); d.className = 'adv-msg adv-msg--bot adv-msg--note'; d.textContent = '⚠'; d.setAttribute('role', 'status'); log.appendChild(d); scroll(); return;
        }
        const d = bubble('assistant', text); d.classList.add('adv-msg--note');
        if (hideForm) form.hidden = true;
        scroll();
      }

      function renderCards(cards: Card[]) {
        if (!cards.length) return;
        const wrap = document.createElement('div'); wrap.className = 'adv-cards';
        if (S('cards')) { const h = document.createElement('p'); h.className = 'adv-cards-h'; h.textContent = S('cards'); wrap.appendChild(h); }
        const ul = document.createElement('ul');
        for (const c of cards) {
          const li = document.createElement('li');
          const a = document.createElement('a'); a.href = c.href; a.className = 'adv-card';
          a.setAttribute('data-track', 'advisor_card_click'); a.setAttribute('data-track-item-id', c.id); a.setAttribute('data-track-kind', c.kind);
          if (c.img) { const img = document.createElement('img'); img.src = `${c.img}.webp`; img.alt = ''; img.loading = 'lazy'; img.decoding = 'async'; img.width = 64; img.height = 64; a.appendChild(img); }
          const sp = document.createElement('span'); sp.textContent = c.name; a.appendChild(sp);
          li.appendChild(a); ul.appendChild(li);
        }
        wrap.appendChild(ul); log.appendChild(wrap); scroll();
      }

      async function ask(q: string) {
        if (busy || !q.trim()) return;
        busy = true; send.disabled = true; log.setAttribute('aria-busy', 'true');
        if (chipsEl()) chipsEl()!.hidden = true;
        log.querySelectorAll('.adv-cards').forEach((n) => n.remove());
        const userMsg: Msg = { role: 'user', content: q.trim().slice(0, 600) };
        bubble('user', userMsg.content);
        history = [...history, userMsg].slice(-11);
        input.value = ''; input.style.height = 'auto';
        const bot = bubble('assistant', ''); bot.classList.add('is-typing'); if (S('thinking')) bot.setAttribute('aria-label', S('thinking'));
        scroll();
        w.VATrack?.('advisor_send', { lang, turn: history.filter((m) => m.role === 'user').length, page: location.pathname });
        let full = '';
        try {
          const res = await fetch(endpoint, {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ lang, page: location.pathname, messages: history }),
          });
          if (!res.ok || !res.body) {
            let reason = ''; try { reason = (await res.json()).reason || ''; } catch { /* */ }
            bot.remove();
            if (res.status === 503 && (reason === 'cap' || reason === 'off')) finalNote(S('resting'), true);
            else if (res.status === 429) finalNote(S('rate'), true);
            else finalNote(S('error'), false);
            return;
          }
          const reader = res.body.getReader(); const dec = new TextDecoder(); let buf = ''; let cards: Card[] = []; let topics: string[] = []; let failed = false;
          for (;;) {
            const { value, done } = await reader.read();
            if (done) break;
            buf += dec.decode(value, { stream: true });
            let i: number;
            while ((i = buf.indexOf('\n\n')) >= 0) {
              const chunk = buf.slice(0, i); buf = buf.slice(i + 2);
              const ev = /^event: (\w+)/m.exec(chunk)?.[1]; const data = /^data: (.*)$/m.exec(chunk)?.[1];
              if (!ev || !data) continue;
              let d: Record<string, unknown> = {}; try { d = JSON.parse(data); } catch { continue; }
              if (ev === 'delta') { full += String(d.t ?? ''); bot.classList.remove('is-typing'); paragraphs(bot, visible(full)); scroll(); }
              else if (ev === 'cards') cards = (d.cards as Card[]) || [];
              else if (ev === 'done') topics = Array.isArray(d.topics) ? (d.topics as string[]) : [];
              else if (ev === 'error') failed = true;
            }
          }
          const text = visible(full);
          if (!text) { bot.remove(); finalNote(S('error'), false); history = history.slice(0, -1); save(lang, history); return; }
          paragraphs(bot, text);
          history = [...history, { role: 'assistant', content: text.slice(0, 2000) }]; save(lang, history);
          renderCards(cards);
          // إحصاء مجهول: تسميات المواضيع وأنواع البطاقات فقط، لا نصّ سؤال ولا جواب
          w.VATrack?.('advisor_answer', { lang, topics: topics.join(',') || 'none', kinds: [...new Set(cards.map((c) => c.kind))].join(',') || 'none', cards: cards.length });
          if (failed) finalNote(S('error'), false);
        } catch {
          bot.remove(); finalNote(S('error'), false);
          history = history.slice(0, -1); save(lang, history);
        } finally {
          busy = false; send.disabled = false; log.setAttribute('aria-busy', 'false');
        }
      }
      form.addEventListener('submit', (e) => { e.preventDefault(); ask(input.value); });
    }

    // إخفاء الزر العائم أثناء النزول على الجوال (≤760px) وإظهاره عند الصعود أو في أعلى الصفحة.
    // المستمع على window مرة واحدة (الحارس أعلاه) ويبحث عن الزر الحالي في كل استدعاء لأن القالب
    // يعيد تصييره عند التنقّل؛ العتبة 8px تتجاهل اهتزاز اللمس؛ الإخفاء بصري فقط (CSS) فيبقى الزر في شجرة الوصولية.
    const FAB_STEP = 8;
    const mobileMq = window.matchMedia('(max-width: 760px)');
    let lastY = window.scrollY;
    window.addEventListener('scroll', () => {
      const fab = document.querySelector<HTMLButtonElement>('#advisor .adv-fab');
      if (!fab) return;
      const y = Math.max(0, window.scrollY);
      if (!mobileMq.matches || y <= FAB_STEP) { fab.classList.remove('is-away'); lastY = y; return; }
      const dy = y - lastY;
      if (Math.abs(dy) < FAB_STEP) return;
      lastY = y;
      const pinned = fab.getAttribute('aria-expanded') === 'true' || document.activeElement === fab;
      const away = dy > 0 && !pinned;
      fab.classList.toggle('is-away', away);
      if (away) bulbul.stop(); // العش ينزلق مع الزر فيهبط البلبل فوراً
    }, { passive: true });
    document.addEventListener('astro:page-load', () => { lastY = Math.max(0, window.scrollY); });

    document.addEventListener('astro:page-load', () => { wire(); bulbul.paint(); });
    document.addEventListener('astro:before-swap', () => bulbul.stop(true));
    if (document.readyState !== 'loading') wire(); else document.addEventListener('DOMContentLoaded', wire);
  }
</script>

<style>
  .adv-root { position: fixed; z-index: 60; inset-inline-end: var(--s-3); inset-block-end: calc(var(--s-3) + env(safe-area-inset-bottom, 0px)); font-family: var(--font-body); color: var(--c-ink); }

  /* الزرّ العائم: فيروزي على حافة ذهبية رفيعة — الذهبي لمسة لا مساحة */
  .adv-fab { position: relative; display: inline-flex; align-items: center; gap: 10px; min-block-size: 52px; min-inline-size: 84px; padding: 0 18px 0 78px; border: 1px solid rgba(201, 154, 74, .55); border-radius: var(--radius-pill); background: var(--c-turq); color: var(--c-sand); font: 600 var(--t-sm)/1 var(--font-body); box-shadow: var(--shadow-gold); cursor: pointer; transition: transform var(--dur) var(--ease), background var(--dur) var(--ease); }
  [dir='rtl'] .adv-fab { padding: 0 78px 0 18px; }
  .adv-fab:hover { background: var(--c-turq-deep); transform: translateY(-1px); }
