  .adv-perch { --pk: 1; --mx: 1; position: absolute; inset-inline-start: 6px; inset-block-end: calc(100% - 18px); inline-size: 68px; block-size: 66px; direction: ltr; transform: scale(calc(var(--pk) * var(--mx)), var(--pk)); transform-origin: 50% 100%; }
  [dir='rtl'] .adv-perch { --mx: -1; }
