  /* الجوال: دائرة 56px والمشهد داخلها بمقياس 0.7 (العش في نصفها الأسفل، ورأس البلبل يلامس حافتها العليا) */
  @media (max-width: 640px) {
    .adv-fab-tx { display: none; }
    .adv-fab, [dir='rtl'] .adv-fab { inline-size: 56px; min-inline-size: 0; block-size: 56px; padding: 0; justify-content: center; }
    .adv-perch, [dir='rtl'] .adv-perch { --pk: .7; inset-inline-start: calc(50% - 34px); inset-block-end: 8px; }
  }

  /* اللوحة */
  .adv { display: flex; flex-direction: column; inline-size: min(400px, calc(100vw - 2 * var(--s-3))); block-size: min(620px, calc(100dvh - 2 * var(--s-3) - env(safe-area-inset-bottom, 0px))); background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-lg); box-shadow: var(--shadow-hover); overflow: hidden; }
  .adv[hidden] { display: none; }
  .adv-hd { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: var(--c-turq-deep); color: var(--c-sand); }
  .adv-title { flex: 1; margin: 0; font: 700 var(--t-base)/1.2 var(--font-heading); letter-spacing: 0; }
  .adv-x, .adv-reset { display: grid; place-items: center; inline-size: 40px; block-size: 40px; border: 0; border-radius: 50%; background: transparent; color: var(--c-sand); cursor: pointer; }
  .adv-x:hover, .adv-reset:hover { background: rgba(255, 255, 255, .12); }
  .adv-reset[hidden] { display: none; }
  .adv-root[hidden] { display: none; }
  .adv-x:focus-visible, .adv-reset:focus-visible, .adv-send:focus-visible, .adv-chip:focus-visible, .adv-card:focus-visible { outline: 2px solid var(--c-gold); outline-offset: 2px; }

  .adv-log { flex: 1; overflow-y: auto; padding: 14px; display: flex; flex-direction: column; gap: 10px; background: var(--c-sand); overscroll-behavior: contain; }
  .adv-msg { max-inline-size: 88%; padding: 10px 14px; border-radius: var(--radius); font-size: var(--t-sm); line-height: 1.7; }
  .adv-msg p { margin: 0; }
  .adv-msg p + p { margin-block-start: .5em; }
  .adv-msg--bot { align-self: flex-start; background: #fff; border: 1px solid var(--c-line); border-start-start-radius: 4px; }
  .adv-msg--you { align-self: flex-end; background: var(--c-turq); color: var(--c-sand); border-start-end-radius: 4px; }
  .adv-msg--note { color: var(--c-ink-soft); border-inline-start: 3px solid var(--c-gold); }
  .adv-msg.is-typing { min-inline-size: 64px; min-block-size: 40px; position: relative; }
  .adv-msg.is-typing::after { content: ''; position: absolute; inset-block-start: 50%; inset-inline-start: 18px; inline-size: 8px; block-size: 8px; border-radius: 50%; background: var(--c-turq); box-shadow: 12px 0 0 var(--c-turq), 24px 0 0 var(--c-turq); transform: translateY(-50%); opacity: .5; }
  @media (prefers-reduced-motion: no-preference) {
    .adv-msg.is-typing::after { animation: adv-dots 1.1s infinite ease-in-out; }
    @keyframes adv-dots { 0%, 100% { opacity: .35; } 50% { opacity: .9; } }
    .adv { animation: adv-in .3s var(--ease) both; }
    @keyframes adv-in { from { transform: translateY(10px); opacity: 0; } to { transform: none; opacity: 1; } }
  }

