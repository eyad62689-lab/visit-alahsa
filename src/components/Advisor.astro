  .adv-bird-img { display: block; inline-size: 100%; block-size: 100%; background: no-repeat 0 0 / 100% 100%; opacity: 0; transform-origin: 40% 70%; transition: opacity .6s var(--ease); }
  .adv-bird-img.is-ready { opacity: 1; }
  .adv-fly { position: fixed; inset-block-start: 0; left: 0; z-index: 2; background: no-repeat; pointer-events: none; will-change: transform, opacity; }
  .adv-fly[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    /* السكون: تنفّس ±1px كل 3 ثوانٍ وميل رأس نادر (مرة في 12 ثانية) — تحويلات مركّبة بلا تخطيط */
    .adv-bird-img.is-ready { animation: adv-breathe 12s ease-in-out infinite; }
    @keyframes adv-breathe {
      0%, 25%, 50%, 75%, 100% { transform: translateY(0); }
      12.5%, 37.5%, 87.5% { transform: translateY(-1px); }
      60% { transform: translateY(-.5px) rotate(0); }
      64%, 68% { transform: translateY(-1px) rotate(-4deg); }
    }
    .adv-hd-ic.is-pop img { animation: adv-pop .45s var(--ease); }
    @keyframes adv-pop { 0% { transform: scale(.8); } 60% { transform: scale(1.12); } 100% { transform: none; } }
  }

  .adv-hd-ic { display: block; flex-shrink: 0; line-height: 0; }
  .adv-hd-ic img { display: block; inline-size: 28px; block-size: 28px; border-radius: 50%; box-shadow: 0 0 0 1.5px rgba(201, 154, 74, .7); }
  .is-open .adv-fab { display: none; }
  @media (max-width: 760px) {
    .adv-fab { transition: transform var(--dur) var(--ease), background var(--dur) var(--ease), opacity var(--dur) var(--ease); }
    /* ينزلق خارج الحافة السفلية؛ pointer-events لا visibility كي يبقى في شجرة الوصولية ويُركَّز بلوحة المفاتيح */
    .adv-fab.is-away { transform: translateY(calc(100% + var(--s-3) + env(safe-area-inset-bottom, 0px) + 4px)); opacity: 0; pointer-events: none; }
