---
import Wordmark from './Wordmark.astro';
import PalmMotif from './PalmMotif.astro';
import { useTranslations, titleSep } from '../i18n/utils';
import { catLabel } from '../lib/categories';
import { staticHref, aboutHref, storesHref, guidesHref } from '../lib/routes';
import { guidesListed } from '../lib/guides';
import { ORG_EMAIL, ORG_WHATSAPP_URL, orgSocialLinks } from '../lib/schema';
import { storesPage, storesLangs } from '../lib/stores';
import { VISA_LANGS, visaHref } from '../lib/visa-guide.mjs';
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang; }
const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';
// الصينية: ما له نسخة /zh/ يقصدها (توسعة 2026-09-02)؛ والبقية إلى النظير الإنجليزي.
const zh = lang === 'zh';

// الألمانية والروسية: نواةٌ فقط (رئيسية + فهرس معالم)، وبقية الأعمدة تقصد
// النظير الإنجليزي — تسمية إنجليزية لصفحة إنجليزية.
const de = lang === 'de';
const ru = lang === 'ru';
// الأوردو: الرئيسية وفهرسا المعالم والأسواق وصفحات الثمار والمطبخ والخريطة والفعاليات تحت /ur/ (فروع صريحة: listBase وleisureBase ورابطا #name والثمار والمطبخ والخريطة والفعاليات)،
// وكل رابط آخر يقع على الفرع الإنجليزي الأخير في سطره حتى يُبنى قسمه.
const ur = lang === 'ur';
// التركية: فهرس المعالم وحده مبنيّ تحت /tr/ (النواة)، وكل رابط آخر إلى الإنجليزية.
const tr = lang === 'tr';
// دليل المرشدين: عربي/إنجليزي فقط، ولا يُربط إلا متى وُجد مرشد منشور واحد على الأقل
const showGuides = (ar || lang === 'en') && (await guidesListed());
const listBase = ar ? '/معالم/' : zh ? '/zh/attractions/' : de ? '/de/attractions/' : ru ? '/ru/attractions/' : ur ? '/ur/attractions/' : tr ? '/tr/attractions/' : '/en/attractions/';
const leisureBase = ar ? '/أسواق-ومنتزهات-ومزارع/' : zh ? '/zh/souqs-parks-farms/' : de ? '/de/souqs-parks-farms/' : ru ? '/ru/souqs-parks-farms/' : ur ? '/ur/souqs-parks-farms/' : '/en/souqs-parks-farms/';
const planTrip = ar ? '/خطط/' : zh ? '/zh/plan-your-trip/' : de ? '/de/plan-your-trip/' : ru ? '/ru/plan-your-trip/' : ur ? '/ur/plan-your-trip/' : lang === 'tr' ? '/tr/plan-your-trip/' : '/en/plan-your-trip/';
const cols = [
  {
    h: t('foot.col.discover'),
    links: [
      // الأسواق والمنتزهات والمزارع في صفحتها المستقلة (فُصلت 2026-07-13)
      ...['historic', 'nature'].map((c) => ({ label: catLabel(c, lang), href: `${listBase}?cat=${c}` })),
      // صفحة واحدة باسمها كالترويسة، لا مرشّحاتها الثلاثة (حكم إياد 2026-10-04: قرأها القرّاء ثلاث صفحات)
      { label: t('nav.leisure'), href: leisureBase },
      { label: t('nav.fruits'), href: ar ? '/ثمار/' : zh ? '/zh/fruits/' : de ? '/de/fruits/' : ru ? '/ru/fruits/' : ur ? '/ur/fruits/' : '/en/fruits/' },
      { label: t('nav.food'), href: ar ? '/أكلات/' : zh ? '/zh/food/' : de ? '/de/food/' : ru ? '/ru/food/' : ur ? '/ur/food/' : '/en/food/' },
      { label: t('nav.dine'), href: ar ? '/مطاعم-ومقاهي/' : zh ? '/zh/restaurants-cafes/' : de ? '/de/restaurants-cafes/' : ru ? '/ru/restaurants-cafes/' : ur ? '/ur/restaurants-cafes/' : '/en/restaurants-cafes/' },
      { label: t('nav.stay'), href: ar ? '/إقامة/' : zh ? '/zh/stay/' : de ? '/de/stay/' : ru ? '/ru/stay/' : ur ? '/ur/stay/' : '/en/stay/' },
      { label: t('foot.l.events'), href: ar ? '/فعاليات/' : zh ? '/zh/events/' : de ? '/de/events/' : ru ? '/ru/events/' : ur ? '/ur/events/' : '/en/events/' },
      { label: t('nav.trails'), href: ar ? '/trails/' : `/${lang}/trails/` },
      // دليل المتاجر الإلكترونية (أُعلن 2026-10-09) — في التذييل لا الترويسة: الشريط مقيس إلى حدّه.
      // التسمية عنوان الصفحة المعتمد (title_tag) بلغتها، فلا نصّ جديد يُكتب لـzh/de/ru خارج الخطوط.
      ...(storesLangs.includes(lang) ? [{ label: storesPage(lang).seo.title_tag, href: storesHref(lang) }] : []),
      // المدونة في التذييل لا الهيدر: الشريط مقيس على ثمانية روابط بلا التفاف (2026-08-22)
      { label: t('nav.blog'), href: ar ? '/مدونة/' : zh ? '/zh/blog/' : de ? '/de/blog/' : ru ? '/ru/blog/' : ur ? '/ur/blog/' : '/en/blog/' },
      // عن المكان لا عن الموقع: نُقلا من عمود «الموقع» (حكم إياد 2026-10-04)
      { label: t('foot.l.about'), href: ar ? '/#name' : zh ? '/zh/#name' : de ? '/de/#name' : ru ? '/ru/#name' : ur ? '/ur/#name' : '/en/#name' },
      // صفحة مكوّنات اليونسكو بلغاتها الخمس منذ المرحلة هـ (2026-09-26)
      { label: t('foot.l.unesco'), href: staticHref('unesco', lang) },
    ],
  },
  {
    h: t('foot.col.plan'),
    links: [
      { label: t('nav.plan'), href: planTrip },
      { label: t('foot.l.getThere'), href: planTrip + '#getting-there' },
      // دليل التأشيرات عربي وإنجليزي (2026-10-16) — لا رابط في تذييل اللغات التي لم تمرّ نصوصه بخطوطها
      ...(VISA_LANGS.includes(lang) ? [{ label: t('foot.l.visa'), href: visaHref(lang) }] : []),
      ...(showGuides ? [{ label: t('guides.nav'), href: guidesHref(lang) }] : []),
      { label: t('nav.myTrip'), href: ar ? '/رحلتي/' : zh ? '/zh/plan/' : de ? '/de/plan/' : ru ? '/ru/plan/' : ur ? '/ur/plan/' : lang === 'tr' ? '/tr/plan/' : '/en/plan/' },
      { label: t('nav.map'), href: ar ? '/خريطة/' : zh ? '/zh/map/' : de ? '/de/map/' : ru ? '/ru/map/' : ur ? '/ur/map/' : lang === 'tr' ? '/tr/map/' : '/en/map/' },
    ],
  },
  {
    h: t('foot.col.site'),
    links: [
      // «عن زوروا الأحساء» عربي/إنجليزي فقط (2026-09-27) — لا تُربط من zh/de/ru كالمسارات:
      // تسميتها الإنجليزية ترفع نسبة الكتل غير المترجمة فوق عتبة C22 (قيست 21–25%)
      ...(ar || lang === 'en' ? [{ label: t('foot.l.aboutSite'), href: aboutHref(lang) }] : []),
      { label: t('foot.l.privacy'), href: staticHref('legal', lang) },
      { label: t('foot.l.report'), href: staticHref('report', lang) },
      { label: t('foot.l.contact'), href: `mailto:${ORG_EMAIL}` },
      // واتساب: الرقم لا يُعرض كنص — مضمَّن في رابط wa.me فقط (طلب إياد 2026-07-23)
      { label: t('foot.l.whatsapp'), href: ORG_WHATSAPP_URL, external: true, icon: 'whatsapp' },
    ],
  },
];
const year = new Date().getFullYear();
// حسابات التواصل: صف أيقونات بلا نص مرئي (اسم العلم في aria-label فقط) فلا يرفع كتلة غير مترجمة في zh/de/ru/ur (C22).
// بلا روابط معبّأة في ORG_SOCIAL لا يُصيَّر الصف إطلاقاً.
const social = orgSocialLinks();
// مسارات علامات المنصات مبسّطة على شبكة 24×24 (التعبئة بـevenodd لإنشاء الحلقات)
const SOCIAL_ICON: Record<string, string> = {
  x: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
  instagram: 'M7 2a5 5 0 0 0-5 5v10a5 5 0 0 0 5 5h10a5 5 0 0 0 5-5V7a5 5 0 0 0-5-5H7Zm0 2h10a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3Zm5 3a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm5.5-3.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z',
  tiktok: 'M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z',
  youtube: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814ZM9.545 15.568V8.432L15.818 12l-6.273 3.568Z',
};
---
<footer class="site-footer on-dark" data-pagefind-ignore>
  <div class="container ft-grid">
    <div class="ft-brand">
      <Wordmark variant="sand" size="md" pageLang={lang} />
      <p class="ft-tag">{t('foot.tagline')}</p>
      {social.length > 0 && (
        <ul class="ft-social">
          {social.map((p) => (
            <li><a
              href={p.url}
              target="_blank"
              rel="noopener"
              aria-label={p.name}
              data-track="social_click"
              data-track-platform={p.id}
            >
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false"><path d={SOCIAL_ICON[p.id]} /></svg>
            </a></li>
          ))}
        </ul>
      )}
      <PalmMotif size={48} class="ft-palm" />
    </div>
    {cols.map((c) => (
      <nav class="ft-col" aria-label={c.h}>
        <h2 class="ft-h">{c.h}</h2>
        <ul>{c.links.map((l) => (
          <li><a
            href={l.href}
            class={l.icon ? 'ft-icon-link' : undefined}
            {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {l.icon === 'whatsapp' && (
              <svg class="ft-wa" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.25 8.24h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm-3.28 4.4c-.15 0-.4.06-.6.29-.21.23-.8.78-.8 1.9s.82 2.2.93 2.36c.11.15 1.6 2.45 3.9 3.44.54.24.97.38 1.3.48.55.17 1.05.15 1.44.09.44-.07 1.35-.55 1.55-1.09.19-.53.19-.99.13-1.08-.05-.1-.2-.15-.42-.27-.22-.11-1.35-.66-1.55-.74-.21-.08-.36-.11-.51.12-.15.22-.58.73-.71.88-.13.15-.26.17-.48.06-.22-.11-.94-.35-1.79-1.11-.66-.59-1.11-1.32-1.24-1.54-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.14-.22.22-.37.07-.15.04-.28-.02-.39-.06-.11-.5-1.24-.69-1.7-.18-.44-.37-.38-.51-.39-.13-.01-.28-.01-.43-.01Z"/>
              </svg>
            )}
            {l.label}
          </a></li>
        ))}</ul>
      </nav>
    ))}
  </div>

  {/* أُزيل نموذج «النشرة البريدية» بطلب إياد (2026-07-13) — لا تجميع للإيميلات */}
  {/* سطر الاستقلالية: يقود إلى «عن زوروا الأحساء» (ar/en)، وإلى السياسات بلغة الصفحة لبقية اللغات */}
  <p class="container ft-indep"><a href={ar || lang === 'en' ? aboutHref(lang) : staticHref('legal', lang)}>{t('foot.independence')}</a></p>

  <div class="container ft-bar">
    {/* الفاصل رمزٌ لا محرف: الألمانية U+2013 لا U+2014 — يحرسه C17 */}
    <span>© {year} {t('site.brand')} {titleSep(lang)} visit-alahsa.com</span>
    <a href="mailto:info@visit-alahsa.com" class="ft-mail">info@visit-alahsa.com</a>
  </div>
</footer>

<style>
  /* بلا margin علوي: كل قسم أخير في الموقع يحمل padding سفلياً قدره --s-8، وكان
     الهامش يضيف مثله فيتخلّف ~192px من الأرض الفارغة قبل التذييل في كل صفحة. */
  .site-footer { background: var(--c-turq-deep); color: var(--c-sand); padding-block: var(--s-8) var(--s-5); }
  .ft-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: var(--s-6); }
  .ft-tag { color: rgba(247,243,234,.7); margin-block-start: var(--s-3); max-inline-size: 34ch; font-size: var(--t-sm); }
  /* صف الأيقونات: هدف اللمس 44×44 (الأيقونة 20px داخله)؛ الهامش السالب يوازن فراغ الهدف الجانبي
     فتصطفّ الأيقونة الأولى على حافة النص. لونها كروابط التذييل (.74) وذهبي عند التحويم/التركيز (AA). */
  .ft-social { list-style: none; padding: 0; margin-block: var(--s-3) 0; margin-inline-start: -12px; display: flex; flex-wrap: wrap; gap: 0; }
  .ft-social a { display: inline-flex; align-items: center; justify-content: center; inline-size: 44px; block-size: 44px; color: rgba(247,243,234,.74); text-decoration: none; transition: color var(--dur) var(--ease); }
  .ft-social a:hover, .ft-social a:focus-visible { color: var(--c-gold-bright); }
  .ft-social svg { display: block; flex: none; }
  :global(.ft-palm) { color: var(--c-gold); opacity: .55; margin-block-start: var(--s-4); }
  .ft-h { font-size: var(--t-lg); color: var(--c-sand); margin-block-end: var(--s-3); }
  /* الفراغ نُقل من gap إلى padding داخل الرابط: كان ارتفاع هدف اللمس 19px فقط
     (دون حدّ 24px)، وبهذا يصير 34px بلا تغيير يُذكر في إيقاع القائمة البصري */
  .ft-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .ft-col a { display: block; padding-block: var(--s-1); color: rgba(247,243,234,.74); text-decoration: none; font-size: var(--t-sm); transition: color var(--dur) var(--ease); }
  .ft-col a:hover { color: var(--c-gold-bright); }
  /* النوعية تُرفع لتغلب `.ft-col a { display:block }` — بدونها كانت أيقونة واتساب
     تنزل سطراً مستقلاً فوق التسمية (svg عنصر كتلي في الإعداد العامّ). */
  .ft-col a.ft-icon-link { display: inline-flex; align-items: center; gap: .4em; }
  .ft-wa { flex: none; opacity: .85; }
  .ft-indep { margin-block-start: var(--s-6); font-size: var(--t-sm); }
  .ft-indep a { color: rgba(247,243,234,.74); text-decoration: underline; text-underline-offset: .2em; text-decoration-color: rgba(247,243,234,.35); }
  .ft-indep a:hover { color: var(--c-gold-bright); }
  .ft-bar { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); margin-block-start: var(--s-6); padding-block-start: var(--s-4); border-block-start: 1px solid rgba(247,243,234,.14); font-size: var(--t-sm); color: rgba(247,243,234,.72); flex-wrap: wrap; }
  /* تباين AA: الذهبي على الفيروزي الداكن ≈ 3.7:1 فلا يصلح للنص الصغير — رملي أساساً وذهبي عند التحويم */
  .ft-mail { font-family: var(--font-latin); letter-spacing: .04em; color: var(--c-sand); text-decoration: none; }
  .ft-mail:hover { color: var(--c-gold-bright); }
  @media (max-width: 760px) {
    .ft-grid { grid-template-columns: 1fr 1fr; }
    .ft-brand { grid-column: 1 / -1; }
    /* الروسية flex لا grid: مسار `1fr` لا ينزل دون أعرض كلمة في عموده، فكان عموداها
       (179.7 + 159.8 + فجوة 32 = 371.5px) يدفعان الشبكة خارج حاوية 343px عند 375px.
       بالالتفاف ينزل العمود الذي لا يتّسع سطراً مستقلاً، والأساس نصف الحاوية كما في الشبكة. */
    :global([lang='ru']) .ft-grid { display: flex; flex-wrap: wrap; }
    :global([lang='ru']) .ft-brand { flex: 0 0 100%; }
    :global([lang='ru']) .ft-col { flex: 0 1 calc(50% - var(--s-6) / 2); }
  }
</style>
