---
import Wordmark from './Wordmark.astro';
import PalmMotif from './PalmMotif.astro';
import { useTranslations } from '../i18n/utils';
import { catLabel } from '../lib/categories';
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang; }
const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const listBase = ar ? '/معالم/' : '/en/attractions/';
const leisureBase = ar ? '/أسواق-ومنتزهات-ومزارع/' : '/en/souqs-parks-farms/';
const planTrip = ar ? '/خطط/' : '/en/plan-your-trip/';
const cols = [
  {
    h: t('foot.col.discover'),
    links: [
      // الأسواق والمنتزهات والمزارع في صفحتها المستقلة (فُصلت 2026-07-13)
      ...['historic', 'nature'].map((c) => ({ label: catLabel(c, lang), href: `${listBase}?cat=${c}` })),
      ...['market', 'parks', 'farm'].map((c) => ({ label: catLabel(c, lang), href: `${leisureBase}?cat=${c}` })),
      { label: t('nav.fruits'), href: ar ? '/ثمار/' : '/en/fruits/' },
      { label: t('nav.food'), href: ar ? '/أكلات/' : '/en/food/' },
      { label: t('nav.dine'), href: ar ? '/مطاعم-ومقاهي/' : '/en/restaurants-cafes/' },
      { label: t('foot.l.events'), href: ar ? '/فعاليات/' : '/en/events/' },
      // المدونة في التذييل لا الهيدر: الشريط مقيس على ثمانية روابط بلا التفاف (2026-08-22)
      { label: t('nav.blog'), href: ar ? '/مدونة/' : '/en/blog/' },
    ],
  },
  {
    h: t('foot.col.plan'),
    links: [
      { label: t('nav.plan'), href: planTrip },
      { label: t('foot.l.getThere'), href: planTrip + '#getting-there' },
      { label: t('nav.myTrip'), href: ar ? '/رحلتي/' : '/en/plan/' },
      { label: t('nav.map'), href: ar ? '/خريطة/' : '/en/map/' },
    ],
  },
  {
    h: t('foot.col.site'),
    links: [
      { label: t('foot.l.about'), href: ar ? '/#name' : '/en/#name' },
      { label: t('foot.l.brand'), href: '/brand/' },
      { label: t('foot.l.privacy'), href: ar ? '/السياسات/' : '/en/legal/' },
      { label: t('foot.l.report'), href: ar ? '/أبلغ/' : '/en/report/' },
      { label: t('foot.l.contact'), href: 'mailto:info@visit-alahsa.com' },
      // واتساب: الرقم لا يُعرض كنص — مضمَّن في رابط wa.me فقط (طلب إياد 2026-07-23)
      { label: t('foot.l.whatsapp'), href: 'https://wa.me/966532482544', external: true, icon: 'whatsapp' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark" data-pagefind-ignore>
  <div class="container ft-grid">
    <div class="ft-brand">
      <Wordmark variant="sand" size="md" />
      <p class="ft-tag">{t('foot.tagline')}</p>
      <PalmMotif size={48} class="ft-palm" />
    </div>
    {cols.map((c) => (
      <nav class="ft-col" aria-label={c.h}>
        <h2 class="ft-h">{c.h}</h2>
        <ul>{c.links.map((l) => (
          <li><a
            href={l.href}
            class={l.icon ? 'ft-icon-link' : undefined}
            {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {l.icon === 'whatsapp' && (
              <svg class="ft-wa" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.82c0 4.54-3.7 8.24-8.25 8.24h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm-3.28 4.4c-.15 0-.4.06-.6.29-.21.23-.8.78-.8 1.9s.82 2.2.93 2.36c.11.15 1.6 2.45 3.9 3.44.54.24.97.38 1.3.48.55.17 1.05.15 1.44.09.44-.07 1.35-.55 1.55-1.09.19-.53.19-.99.13-1.08-.05-.1-.2-.15-.42-.27-.22-.11-1.35-.66-1.55-.74-.21-.08-.36-.11-.51.12-.15.22-.58.73-.71.88-.13.15-.26.17-.48.06-.22-.11-.94-.35-1.79-1.11-.66-.59-1.11-1.32-1.24-1.54-.13-.22-.01-.34.1-.45.1-.1.22-.26.33-.39.11-.13.14-.22.22-.37.07-.15.04-.28-.02-.39-.06-.11-.5-1.24-.69-1.7-.18-.44-.37-.38-.51-.39-.13-.01-.28-.01-.43-.01Z"/>
              </svg>
            )}
            {l.label}
          </a></li>
        ))}</ul>
      </nav>
    ))}
  </div>

  {/* أُزيل نموذج «النشرة البريدية» بطلب إياد (2026-07-13) — لا تجميع للإيميلات */}
  <div class="container ft-bar">
    <span>© {year} {t('site.name')} — {t('foot.rights')}</span>
    <a href="mailto:info@visit-alahsa.com" class="ft-mail">info@visit-alahsa.com</a>
  </div>
</footer>

<style>
  /* بلا margin علوي: كل قسم أخير في الموقع يحمل padding سفلياً قدره --s-8، وكان
     الهامش يضيف مثله فيتخلّف ~192px من الأرض الفارغة قبل التذييل في كل صفحة. */
  .site-footer { background: var(--c-turq-deep); color: var(--c-sand); padding-block: var(--s-8) var(--s-5); }
  .ft-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: var(--s-6); }
  .ft-tag { color: rgba(247,243,234,.7); margin-block-start: var(--s-3); max-inline-size: 34ch; font-size: var(--t-sm); }
  :global(.ft-palm) { color: var(--c-gold); opacity: .55; margin-block-start: var(--s-4); }
  .ft-h { font-size: var(--t-lg); color: var(--c-sand); margin-block-end: var(--s-3); }
  /* الفراغ نُقل من gap إلى padding داخل الرابط: كان ارتفاع هدف اللمس 19px فقط
     (دون حدّ 24px)، وبهذا يصير 34px بلا تغيير يُذكر في إيقاع القائمة البصري */
  .ft-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .ft-col a { display: block; padding-block: var(--s-1); color: rgba(247,243,234,.74); text-decoration: none; font-size: var(--t-sm); transition: color var(--dur) var(--ease); }
  .ft-col a:hover { color: var(--c-gold-bright); }
  /* النوعية تُرفع لتغلب `.ft-col a { display:block }` — بدونها كانت أيقونة واتساب
     تنزل سطراً مستقلاً فوق التسمية (svg عنصر كتلي في الإعداد العامّ). */
  .ft-col a.ft-icon-link { display: inline-flex; align-items: center; gap: .4em; }
  .ft-wa { flex: none; opacity: .85; }
  .ft-bar { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); margin-block-start: var(--s-6); padding-block-start: var(--s-4); border-block-start: 1px solid rgba(247,243,234,.14); font-size: var(--t-sm); color: rgba(247,243,234,.72); flex-wrap: wrap; }
  /* تباين AA: الذهبي على الفيروزي الداكن ≈ 3.7:1 فلا يصلح للنص الصغير — رملي أساساً وذهبي عند التحويم */
  .ft-mail { font-family: var(--font-latin); letter-spacing: .04em; color: var(--c-sand); text-decoration: none; }
  .ft-mail:hover { color: var(--c-gold-bright); }
  @media (max-width: 760px) { .ft-grid { grid-template-columns: 1fr 1fr; } .ft-brand { grid-column: 1 / -1; } }
</style>
