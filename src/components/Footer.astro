---
import Wordmark from './Wordmark.astro';
import PalmMotif from './PalmMotif.astro';
import { useTranslations } from '../i18n/utils';
import { catLabel } from '../lib/categories';
import type { Lang } from '../i18n/ui';
interface Props { lang?: Lang; }
const { lang = 'ar' } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

const listBase = ar ? '/معالم/' : '/en/attractions/';
const leisureBase = ar ? '/أسواق-ومنتزهات-ومزارع/' : '/en/souqs-parks-farms/';
const planTrip = ar ? '/خطط/' : '/en/plan-your-trip/';
const cols = [
  {
    h: t('foot.col.discover'),
    links: [
      // الأسواق والمنتزهات والمزارع في صفحتها المستقلة (فُصلت 2026-07-13)
      ...['historic', 'nature'].map((c) => ({ label: catLabel(c, lang), href: `${listBase}?cat=${c}` })),
      ...['market', 'parks', 'farm'].map((c) => ({ label: catLabel(c, lang), href: `${leisureBase}?cat=${c}` })),
      { label: t('nav.fruits'), href: ar ? '/ثمار/' : '/en/fruits/' },
      { label: t('nav.food'), href: ar ? '/أكلات/' : '/en/food/' },
      { label: t('foot.l.events'), href: ar ? '/فعاليات/' : '/en/events/' },
    ],
  },
  {
    h: t('foot.col.plan'),
    links: [
      { label: t('nav.plan'), href: planTrip },
      { label: t('foot.l.getThere'), href: planTrip + '#getting-there' },
      { label: t('nav.myTrip'), href: ar ? '/رحلتي/' : '/en/plan/' },
      { label: t('nav.map'), href: ar ? '/خريطة/' : '/en/map/' },
    ],
  },
  {
    h: t('foot.col.site'),
    links: [
      { label: t('foot.l.about'), href: ar ? '/#name' : '/en/#name' },
      { label: t('foot.l.brand'), href: '/brand/' },
      { label: t('foot.l.privacy'), href: ar ? '/السياسات/' : '/en/legal/' },
      { label: t('foot.l.contact'), href: 'mailto:info@visit-alahsa.com' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container ft-grid">
    <div class="ft-brand">
      <Wordmark variant="sand" size="md" />
      <p class="ft-tag">{t('foot.tagline')}</p>
      <PalmMotif size={48} class="ft-palm" />
    </div>
    {cols.map((c) => (
      <nav class="ft-col" aria-label={c.h}>
        <h3 class="ft-h">{c.h}</h3>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>

  {/* أُزيل نموذج «النشرة البريدية» بطلب إياد (2026-07-13) — لا تجميع للإيميلات */}
  <div class="container ft-bar">
    <span>© {year} {t('site.name')} — {t('foot.rights')}</span>
    <a href="mailto:info@visit-alahsa.com" class="ft-mail">info@visit-alahsa.com</a>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-turq-deep); color: var(--c-sand); padding-block: var(--s-8) var(--s-5); margin-block-start: var(--s-8); }
  .ft-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: var(--s-6); }
  .ft-tag { color: rgba(247,243,234,.7); margin-block-start: var(--s-3); max-inline-size: 34ch; font-size: var(--t-sm); }
  :global(.ft-palm) { color: var(--c-gold); opacity: .55; margin-block-start: var(--s-4); }
  .ft-h { font-size: var(--t-lg); color: var(--c-sand); margin-block-end: var(--s-3); }
  .ft-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: var(--s-2); }
  .ft-col a { color: rgba(247,243,234,.74); text-decoration: none; font-size: var(--t-sm); transition: color var(--dur) var(--ease); }
  .ft-col a:hover { color: var(--c-gold); }
  .ft-bar { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); margin-block-start: var(--s-6); padding-block-start: var(--s-4); border-block-start: 1px solid rgba(247,243,234,.14); font-size: var(--t-sm); color: rgba(247,243,234,.72); flex-wrap: wrap; }
  /* تباين AA: الذهبي على الفيروزي الداكن ≈ 3.7:1 فلا يصلح للنص الصغير — رملي أساساً وذهبي عند التحويم */
  .ft-mail { font-family: var(--font-latin); letter-spacing: .04em; color: var(--c-sand); text-decoration: none; }
  .ft-mail:hover { color: var(--c-gold); }
  @media (max-width: 760px) { .ft-grid { grid-template-columns: 1fr 1fr; } .ft-brand { grid-column: 1 / -1; } }
</style>
