    :global([lang='ru']) .nav-toggle:checked ~ .nav, :global([lang='tr']) .nav-toggle:checked ~ .nav { max-block-size: 70vh; overflow-y: auto; visibility: visible; transition: max-block-size var(--dur) var(--ease), visibility 0s; }
