---
// الترويسة — ثنائية اللغة: تنقّل مترجم، مبدّل لغة يربط النظير، RTL/LTR تلقائي.
import Wordmark from './Wordmark.astro';
import Search from './Search.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { AltLinks } from '../i18n/utils';
import { LANG_META } from '../i18n/langs';
import { listedAlt } from '../i18n/unlisted';
import { storesHref } from '../lib/routes';

// overlay: رأس الرئيسية «الواحة تتكشّف» (القرار أ3، البند 4) — شفاف فوق الفصل الأول، ومضبّب
// كالمعتاد حين يعبر حارس [data-header-sentinel] (عند 60% من ارتفاع الشاشة) أعلى الإطار.
interface Props { lang?: Lang; alt?: AltLinks; overlay?: boolean; }
const { lang = 'ar', alt, overlay = false } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

// الصينية: ما اكتملت صفحته الصينية يقصدها (توسعة 2026-09-02: الفعاليات والثمار
// والأكلات والخريطة)؛ والبقية إلى النظير الإنجليزي حتى تكتمل في مراحل التعميم.
// الألمانية والروسية: النواة وحدها مبنيّة (الرئيسية وفهرس المعالم) — وما لا
// نظير له يقصد الصفحة الإنجليزية: تسمية إنجليزية لصفحة إنجليزية، لا وعدٌ مكسور.
const zh = lang === 'zh';
const de = lang === 'de';
const ru = lang === 'ru';
// الأوردو: المبنيّ الرئيسية وفهرسا المعالم والأسواق وصفحات الثمار والمطبخ والخريطة والفعاليات، فلها فروع صريحة هنا؛ وبقية
// الأقسام تقع على الفرع الأخير (الإنجليزي) في كل سطر أدناه — تسمية إنجليزية لصفحة
// إنجليزية حتى يُبنى القسم تحت /ur/ فيُضاف فرعه.
const ur = lang === 'ur';
// التركية: الرئيسية /tr/ (tr-home-1) وفهرس المعالم وصفحات المعالم الحاملة title_tr والمسارات، فلها فروع
// صريحة فيها؛ وبقية الأقسام إلى الإنجليزية حتى تُبنى.
const tr = lang === 'tr';
const home = ar ? '/' : zh ? '/zh/' : de ? '/de/' : ru ? '/ru/' : ur ? '/ur/' : tr ? '/tr/' : '/en/';
const routes = {
  attractions: ar ? '/معالم/' : zh ? '/zh/attractions/' : de ? '/de/attractions/' : ru ? '/ru/attractions/' : ur ? '/ur/attractions/' : tr ? '/tr/attractions/' : '/en/attractions/',
  leisure: ar ? '/أسواق-ومنتزهات-ومزارع/' : zh ? '/zh/souqs-parks-farms/' : de ? '/de/souqs-parks-farms/' : ru ? '/ru/souqs-parks-farms/' : ur ? '/ur/souqs-parks-farms/' : tr ? '/tr/souqs-parks-farms/' : '/en/souqs-parks-farms/',
  map: ar ? '/خريطة/' : zh ? '/zh/map/' : de ? '/de/map/' : ru ? '/ru/map/' : ur ? '/ur/map/' : tr ? '/tr/map/' : '/en/map/',
  events: ar ? '/فعاليات/' : zh ? '/zh/events/' : de ? '/de/events/' : ru ? '/ru/events/' : ur ? '/ur/events/' : tr ? '/tr/events/' : '/en/events/',
  fruits: ar ? '/ثمار/' : zh ? '/zh/fruits/' : de ? '/de/fruits/' : ru ? '/ru/fruits/' : ur ? '/ur/fruits/' : tr ? '/tr/fruits/' : '/en/fruits/',
  food: ar ? '/أكلات/' : zh ? '/zh/food/' : de ? '/de/food/' : ru ? '/ru/food/' : ur ? '/ur/food/' : tr ? '/tr/food/' : '/en/food/',
  dine: ar ? '/مطاعم-ومقاهي/' : zh ? '/zh/restaurants-cafes/' : de ? '/de/restaurants-cafes/' : ru ? '/ru/restaurants-cafes/' : ur ? '/ur/restaurants-cafes/' : tr ? '/tr/restaurants-cafes/' : '/en/restaurants-cafes/',
  stay: ar ? '/إقامة/' : zh ? '/zh/stay/' : de ? '/de/stay/' : ru ? '/ru/stay/' : ur ? '/ur/stay/' : tr ? '/tr/stay/' : '/en/stay/',
  discover: ar ? '/#experiences' : '/en/#experiences',
  plan: ar ? '/خطط/' : zh ? '/zh/plan-your-trip/' : de ? '/de/plan-your-trip/' : ru ? '/ru/plan-your-trip/' : ur ? '/ur/plan-your-trip/' : tr ? '/tr/plan-your-trip/' : '/en/plan-your-trip/',
  myTrip: ar ? '/رحلتي/' : zh ? '/zh/plan/' : de ? '/de/plan/' : ru ? '/ru/plan/' : lang === 'ur' ? '/ur/plan/' : tr ? '/tr/plan/' : '/en/plan/',
};
// التنقّل المجمَّع بكل اللغات: ثلاث مجموعات بعناوين بدل عشرة روابط متساوية. في القائمة المطويّة تُعرض
// المجموعات بعناوينها وشبكة عمودين، وفي الشريط المبسوط تصير الأوليان قائمتين منسدلتين والثالثة روابط
// مباشرة. عناوين المجموعات بلغات zh/de/ru/ur/tr مرّت بخطوطها (docs/nav-groups).
// only: 'drawer' يظهر في القائمة المطويّة وحدها و'bar' في الشريط وحده (الخريطة في «اكتشف» داخل القائمة
// وفي الشريط رابطٌ مباشر؛ و«معالمي المحفوظة» في الشريط أداةٌ أصلاً) — نمط nav-plan: وجهة واحدة لكل عرض.
type NavItem = { href: string; label: string; wide?: boolean; only?: 'drawer' | 'bar'; badge?: boolean };
// في شبكة العمودين على الجوال تضيق الخانة عن كلمة واحدة طويلة (Sehenswürdigkeiten · Достопримечательности: 165 و212px
// في خانة 124–159px بين 320 و390px)، فتأخذ صفّاً كاملاً كـ«الأسواق والمنتزهات والمزارع» بدل قطعها بلا شرطة. 14 محرفاً
// = أطول كلمة تتّسع بخط القائمة عند 320px (Veranstaltungen ‏15 لا تتّسع).
const longWord = (s: string) => s.split(/\s+/).some((w) => w.length > 14);
const groups: { id: string; label: string; flat?: boolean; items: NavItem[] }[] = [
  { id: 'discover', label: t('nav.g.discover'), items: [
    { href: routes.attractions, label: t('nav.attractions') },
    { href: ar ? '/trails/' : `/${lang}/trails/`, label: t('nav.trails') },
    { href: routes.map, label: t('nav.map'), only: 'drawer' },
    { href: routes.events, label: t('nav.events') },
    { href: routes.leisure, label: t('nav.leisure'), wide: true },
  ] },
  { id: 'taste', label: t('nav.g.taste'), items: [
    { href: routes.food, label: t('nav.food') },
    { href: routes.dine, label: t('nav.dining') },
    { href: routes.fruits, label: t('nav.fruits') },
    { href: storesHref(lang), label: t('nav.stores') },
  ] },
  { id: 'visit', label: t('nav.g.visit'), flat: true, items: [
    { href: routes.stay, label: t('nav.stayShort') },
    { href: routes.map, label: t('nav.map'), only: 'bar' },
    { href: routes.myTrip, label: t('nav.myTrip'), only: 'drawer', badge: true },
  ] },
];
// مبدّل اللغة: زرّ واحد يفتح قائمةً باللغات المتاحة لهذه الصفحة (قرار إياد
// 2026-08-29 — قابل للتوسع لأي لغة قادمة بلا إعادة تصميم). اللغة غير العربية
// والإنجليزية تُدرج فقط حين تحمل الصفحة نظيراً لها في alt — لا خيار يقود إلى 404.
// القائمة عنصر <details> أصلي: كيبورد وحالة بلا JS، وسكربت صغير للإغلاق خارجها.
// LANG_META من src/i18n/langs.ts (مصدر واحد مع شريط اقتراح اللغة وصفحة 404)
// الصفحات غير المعلَنة (unlisted.ts) لا تظهر خياراً في المبدّل — كما لا تظهر في hreflang
const altL = alt ? listedAlt(alt) : undefined;
const langItems = (['ar', 'en', 'zh', 'de', 'ru', 'ur', 'tr'] as Lang[])
  .filter((l) => l === lang || (altL ? Boolean(altL[l]) : l === 'ar' || l === 'en'))
  .map((l) => ({
    current: l === lang,
    href: l === lang ? null : (altL?.[l] ?? (l === 'ar' ? '/' : '/en/')),
    ...LANG_META[l],
  }));
---
<header class:list={['site-header', overlay && 'site-header--overlay', 'hd-grouped']} id="top" data-pagefind-ignore data-overlay={overlay ? '' : undefined}>
  <div class="container hd-in">
    <a href={home} class="brand">
      <Wordmark variant="turq" size="sm" pageLang={lang} />
    </a>

    {/* الصندوق نفسه هو عنصر الإتاحة (بؤرة + مسافة + حالة محددة أصلية)، والملصق
        بصري بحت — role="button" على <label> مخالفة aria-allowed-role (لايتهاوس
        2026-08-29)، وتقليد سلوك الزر بجافاسكربت كان يعيد بناء ما يقدمه الصندوق مجاناً */}
    <input type="checkbox" id="navtoggle" class="nav-toggle" aria-controls="site-nav" aria-label={t('a11y.menu')} />
    <label for="navtoggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="nav nav--grouped" id="site-nav" aria-label={t('a11y.mainNav')}>
      {/* أدوات الجوال (≤ 760px) تظهر حيث تختفي أداتا الشريط، واللغات مطويّة في سطر واحد «اللغة: … — تغيير»
          كي لا تشغل أول الشاشة؛ data-nav-lang لا data-lang-menu كي لا يلتقطها محدِّد مبدّل الشريط. */}
      <div class="nav-tools">
        <button type="button" class="nav-search" data-nav-search>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          {t('search.open')}
        </button>
      </div>
      {groups.map((g) => (
        <div class:list={['ng', g.flat && 'ng--flat']} role="group" aria-labelledby={`ng-t-${g.id}`} data-ng>
          <span class="ng-title" id={`ng-t-${g.id}`}>{g.label}</span>
          {!g.flat && (
            <button type="button" class="ng-btn" aria-expanded="false" aria-controls={`ng-p-${g.id}`} data-ng-btn>
              {g.label}<span class="ng-chev" aria-hidden="true"></span>
            </button>
          )}
          <ul class="ng-list" id={`ng-p-${g.id}`}>
            {g.items.map((n) => (
              <li class:list={[(n.wide || longWord(n.label)) && 'ng-wide', n.only && `only-${n.only}`]}>
                <a href={n.href}>{n.label}{n.badge && <span class="plan-badge" data-plan-count>0</span>}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <a href={routes.plan} class="nav-plan">{t('nav.plan')}</a>
      <details class="nav-lang" data-nav-lang>
        <summary>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15.6 15.6 0 0 1 0 18a15.6 15.6 0 0 1 0-18Z" />
          </svg>
          <span>{t('lang.menu')}{zh ? '：' : ': '}<b lang={lang}>{LANG_META[lang].native}</b></span>
          <span class="nav-lang-change">{t('nav.langChange')}<span class="ng-chev" aria-hidden="true"></span></span>
        </summary>
        <div class="nav-langs" role="group" aria-label={t('lang.menu')}>
          {langItems.map((l) => l.current
            ? <span class="lang-item is-current" aria-current="true" lang={l.code} dir={l.dir}>{l.native}</span>
            : <a class="lang-item" href={l.href} lang={l.code} dir={l.dir}>{l.native}</a>)}
        </div>
      </details>
    </nav>

    <div class="hd-actions">
      <Search lang={lang} />
      <a href={routes.myTrip} class="plan-link" aria-label={t('nav.myTrip')}>
        <svg class="plan-ic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5h12v17l-6-4.2-6 4.2z" /></svg>
        <span class="plan-text">{t('nav.myTrip')}</span> <span class="plan-badge" data-plan-count>0</span>
      </a>
      <details class="lang-menu" data-lang-menu>
        {/* الاسم المتاح يحوي النص المرئي (رمز اللغة) — WCAG 2.5.3، يفحصه axe بـlabel-content-name-mismatch */}
        <summary class="lang" aria-label={`${t('lang.menu')} ${LANG_META[lang].short}`}>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15.6 15.6 0 0 1 0 18a15.6 15.6 0 0 1 0-18Z" />
          </svg>
          {LANG_META[lang].short}
          <span class="lang-chev" aria-hidden="true"></span>
        </summary>
        <ul class="lang-list">
          {langItems.map((l) => (
            <li>
              {l.current
                ? <span class="lang-item is-current" aria-current="true" lang={l.code} dir={l.dir}>{l.native}</span>
                : <a class="lang-item" href={l.href} lang={l.code} dir={l.dir}>{l.native}</a>}
            </li>
          ))}
        </ul>
      </details>
      <a href={routes.plan} class="btn-gold">{t('nav.planVisit')}</a>
    </div>
  </div>
</header>

<script is:inline>
  // إغلاق قائمة اللغات بالنقر خارجها أو بـEsc — مستمعان على document مرة واحدة
  // (يبقيان عبر تنقّلات ClientRouter، والحارس يمنع التكرار بعد كل تنقّل).
  // الرأس الشفاف: مراقِب واحد على حارس الفصل الأول، يُعاد ربطه بعد كل تنقّل
  (function () {
    function initOverlay() {
      if (window.__vaHdObs) { window.__vaHdObs.disconnect(); window.__vaHdObs = null; }
      const hd = document.querySelector('.site-header[data-overlay]');
      const sentinel = document.querySelector('[data-header-sentinel]');
      if (!hd) return;
      if (!sentinel || typeof IntersectionObserver !== 'function') { hd.classList.add('is-solid'); return; }
      window.__vaHdObs = new IntersectionObserver(function (entries) {
        const e = entries[0];
        hd.classList.toggle('is-solid', !e.isIntersecting && e.boundingClientRect.top < 0);
      });
      window.__vaHdObs.observe(sentinel);
    }
    if (!window.__vaHdOverlay) { window.__vaHdOverlay = true; document.addEventListener('astro:page-load', initOverlay); }
    initOverlay();
  })();
  if (!window.__vaLangMenu) {
    window.__vaLangMenu = true;
    // زرّ البحث داخل قائمة الجوال: يطوي القائمة ثم ينقر زرّ البحث الأصلي (المخفيّ في الشريط)
    // فيفتح النافذة نفسها ويُقاس search_open كما هو
    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element) || !e.target.closest('[data-nav-search]')) return;
      const toggle = document.getElementById('navtoggle');
      if (toggle) toggle.checked = false;
      document.getElementById('search-open')?.click();
    });
    // مجموعات الشريط المبسوط: زرّ يفتح قائمته ويغلق أختها، والنقر خارجها أو Esc يغلقها
    const closeGroups = (except) => document.querySelectorAll('[data-ng].is-open').forEach((g) => {
      if (g === except) return;
      g.classList.remove('is-open');
      g.querySelector('[data-ng-btn]')?.setAttribute('aria-expanded', 'false');
    });
    document.addEventListener('click', (e) => {
      const btn = e.target instanceof Element ? e.target.closest('[data-ng-btn]') : null;
      if (btn) {
        const g = btn.closest('[data-ng]');
        const open = !g.classList.contains('is-open');
        closeGroups(g);
        g.classList.toggle('is-open', open);
        btn.setAttribute('aria-expanded', String(open));
        return;
      }
      if (!(e.target instanceof Element) || !e.target.closest('[data-ng] .ng-list')) closeGroups(null);
    });
    document.addEventListener('click', (e) => {
      document.querySelectorAll('details[data-lang-menu][open]').forEach((d) => {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('details[data-lang-menu][open]').forEach((d) => d.removeAttribute('open'));
      const open = document.querySelector('[data-ng].is-open');
      if (open) { closeGroups(null); open.querySelector('[data-ng-btn]')?.focus(); }
    });
    // الخروج بـTab من مجموعة مفتوحة يغلقها، فلا تبقى قائمة معلّقة فوق الصفحة
    document.addEventListener('focusout', (e) => {
      const g = e.target instanceof Element ? e.target.closest('[data-ng].is-open') : null;
      if (g && !(e.relatedTarget instanceof Element && g.contains(e.relatedTarget))) closeGroups(null);
    });
  }
</script>

<style>
  .site-header { position: sticky; inset-block-start: 0; z-index: 50; background: color-mix(in srgb, var(--c-sand) 86%, transparent); backdrop-filter: blur(10px); border-block-end: 1px solid var(--c-line); }
  /* الشريط يحمل وردماركاً وتسعة روابط وبحثاً و«رحلتي» ومبدّل لغة وزرّ دعوة،
     في عمودٍ أوسع (1280px) ممّا يتّسع له عمود المحتوى (1120px).
     **العرض اللازم مقيس** (2026-09-04، بـpuppeteer على dist وبقياس العرض
     الجوهري غير المضغوط عند سقف 2000px، لا بالنظر): كان ar ‏1249px · en ‏1331 ·
     zh ‏1131 · de ‏1625 — أي أن ثلاث لغات من أربع كانت تفيض عن 1280px فتضغط
     الفليكس أدوات الشريط وتنزلق روابط التنقّل فوقها. اللقطات أثبتت الضرر:
     «Map» مطموسة خلف زرّ البحث بالإنجليزية عند 1280px، و«Karte» مختفية كلياً
     بالألمانية مع التفاف «Meine Reise» سطرين. أي تطويل للتسميات يُعاد قياسه
     بالأداة نفسها — لا بالنظر ولا بعدّ المحارف. */
  .hd-in { inline-size: min(100% - var(--s-3), 1280px); margin-inline: auto; display: flex; align-items: center; gap: var(--s-3); min-block-size: 68px; }
  .brand { text-decoration: none; }
  /* 16px لا 20px: ثمان فجوات × 4px = 32px موفَّرة في كل لغة، وهي وحدها تكفي
     لردّ العربية إلى داخل الحاوية. الشريط يبقى متنفّساً بصرياً عند 16px. */
  .nav { display: flex; gap: 16px; margin-inline: auto; min-inline-size: 0; }
  /* مخفيّ حيث يظهر الزرّ الذهبي (وجهتهما واحدة)، ويظهر داخل القائمة المطويّة */
  .nav .nav-plan { display: none; }
  .nav a { font-family: var(--font-body); font-weight: 500; font-size: var(--t-ui, .9375rem); color: var(--c-ink); text-decoration: none; padding-block: var(--s-2); position: relative; white-space: nowrap; transition: color var(--dur) var(--ease); }
  .nav a::after { content: ''; position: absolute; inset-block-end: 0; inset-inline: 0; block-size: 2px; background: var(--c-gold); transform: scaleX(0); transform-origin: inline-end; transition: transform var(--dur) var(--ease); }
  .nav a:hover { color: var(--c-turq); }
  .nav a:hover::after { transform: scaleX(1); transform-origin: inline-start; }
  .hd-actions { display: flex; align-items: center; gap: var(--s-3); }
  /* بوزن حبّة البحث المجاورة: كان الحدّ --c-line (‏1.1:1) غير مرئي عملياً
     والهدف اللمسي 47×38 دون 44px. */
  .lang { display: inline-flex; align-items: center; gap: 6px; min-block-size: 44px; font-family: var(--font-latin); letter-spacing: .08em; font-size: .85rem; font-weight: 600; color: var(--c-turq-deep); text-decoration: none; padding: 0 14px; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-pill); transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease); }
  .lang:hover { border-color: var(--c-turq); background: var(--c-sand-2); }
  /* قائمة اللغات المنسدلة — <details> أصلي فوق حبّة .lang نفسها */
  .lang-menu { position: relative; }
  .lang-menu > summary { list-style: none; cursor: pointer; }
  .lang-menu > summary::-webkit-details-marker { display: none; }
  .lang-menu > summary:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 2px; }
  .lang-chev { inline-size: 7px; block-size: 7px; border-inline-end: 1.6px solid currentColor; border-block-end: 1.6px solid currentColor; transform: rotate(45deg); margin-block-start: -4px; transition: transform var(--dur) var(--ease); }
