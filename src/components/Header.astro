---
// الترويسة — ثنائية اللغة: تنقّل مترجم، مبدّل لغة يربط النظير، RTL/LTR تلقائي.
import Wordmark from './Wordmark.astro';
import Search from './Search.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import type { AltLinks } from '../i18n/utils';

interface Props { lang?: Lang; alt?: AltLinks; }
const { lang = 'ar', alt } = Astro.props;
const t = useTranslations(lang);
const ar = lang === 'ar';

// الصينية: ما اكتملت صفحته الصينية يقصدها (توسعة 2026-09-02: الفعاليات والثمار
// والأكلات والخريطة)؛ والبقية إلى النظير الإنجليزي حتى تكتمل في مراحل التعميم.
// الألمانية والروسية: النواة وحدها مبنيّة (الرئيسية وفهرس المعالم) — وما لا
// نظير له يقصد الصفحة الإنجليزية: تسمية إنجليزية لصفحة إنجليزية، لا وعدٌ مكسور.
const zh = lang === 'zh';
const de = lang === 'de';
const ru = lang === 'ru';
const home = ar ? '/' : zh ? '/zh/' : de ? '/de/' : ru ? '/ru/' : '/en/';
const routes = {
  attractions: ar ? '/معالم/' : zh ? '/zh/attractions/' : de ? '/de/attractions/' : ru ? '/ru/attractions/' : '/en/attractions/',
  leisure: ar ? '/أسواق-ومنتزهات-ومزارع/' : zh ? '/zh/souqs-parks-farms/' : '/en/souqs-parks-farms/',
  map: ar ? '/خريطة/' : zh ? '/zh/map/' : '/en/map/',
  events: ar ? '/فعاليات/' : zh ? '/zh/events/' : '/en/events/',
  fruits: ar ? '/ثمار/' : zh ? '/zh/fruits/' : '/en/fruits/',
  food: ar ? '/أكلات/' : zh ? '/zh/food/' : '/en/food/',
  dine: ar ? '/مطاعم-ومقاهي/' : zh ? '/zh/restaurants-cafes/' : '/en/restaurants-cafes/',
  stay: ar ? '/إقامة/' : zh ? '/zh/stay/' : '/en/stay/',
  discover: ar ? '/#experiences' : '/en/#experiences',
  plan: ar ? '/خطط/' : zh ? '/zh/plan-your-trip/' : '/en/plan-your-trip/',
  myTrip: ar ? '/رحلتي/' : zh ? '/zh/plan/' : '/en/plan/',
};
const nav = [
  { href: routes.attractions, label: t('nav.attractions') },
  { href: routes.leisure, label: t('nav.leisure') },
  { href: routes.events, label: t('nav.events') },
  { href: routes.fruits, label: t('nav.fruits') },
  { href: routes.food, label: t('nav.food') },
  { href: routes.dine, label: t('nav.dining') },
  { href: routes.stay, label: t('nav.stayShort') },
  // رابط الخطة مكرَّر عمداً في البنية لا في العرض: زرّ الدعوة الذهبي يقصد
  // routes.plan نفسه، فيصير في الشريط رابطان لوجهة واحدة بتسميتين متقاربتين
  // (‏«خطّط لرحلتك» و«خطّط زيارتك») — تكرارٌ يبتلع ~100px من أضيق شريط في
  // الموقع. الحلّ في CSS لا بالحذف: يظهر هذا الرابط حيث يختفي الزرّ الذهبي
  // (‏القائمة المطويّة) ويختفي حيث يظهر — فالوجهة قابلة للوصول مرّة واحدة
  // عند كل عرض، ولا تضيع على الجوال حيث الزرّ مخفيّ أصلاً.
  { href: routes.plan, label: t('nav.plan'), cls: 'nav-plan' },
  { href: routes.map, label: t('nav.map') },
];
// مبدّل اللغة: زرّ واحد يفتح قائمةً باللغات المتاحة لهذه الصفحة (قرار إياد
// 2026-08-29 — قابل للتوسع لأي لغة قادمة بلا إعادة تصميم). اللغة غير العربية
// والإنجليزية تُدرج فقط حين تحمل الصفحة نظيراً لها في alt — لا خيار يقود إلى 404.
// القائمة عنصر <details> أصلي: كيبورد وحالة بلا JS، وسكربت صغير للإغلاق خارجها.
const LANG_META: Record<Lang, { short: string; native: string; code: string; dir: 'rtl' | 'ltr' }> = {
  ar: { short: 'ع', native: 'العربية', code: 'ar', dir: 'rtl' },
  en: { short: 'EN', native: 'English', code: 'en', dir: 'ltr' },
  zh: { short: '中文', native: '中文（简体）', code: 'zh-CN', dir: 'ltr' },
  de: { short: 'DE', native: 'Deutsch', code: 'de', dir: 'ltr' },
  ru: { short: 'RU', native: 'Русский', code: 'ru', dir: 'ltr' },
};
const langItems = (['ar', 'en', 'zh', 'de', 'ru'] as Lang[])
  .filter((l) => l === lang || (alt ? Boolean(alt[l]) : l !== 'zh' && l !== 'de' && l !== 'ru'))
  .map((l) => ({
    current: l === lang,
    href: l === lang ? null : (alt?.[l] ?? (l === 'ar' ? '/' : '/en/')),
    ...LANG_META[l],
  }));
---
<header class="site-header" id="top" data-pagefind-ignore>
  <div class="container hd-in">
    <a href={home} class="brand">
      <Wordmark variant="turq" size="sm" />
    </a>

    {/* الصندوق نفسه هو عنصر الإتاحة (بؤرة + مسافة + حالة محددة أصلية)، والملصق
        بصري بحت — role="button" على <label> مخالفة aria-allowed-role (لايتهاوس
        2026-08-29)، وتقليد سلوك الزر بجافاسكربت كان يعيد بناء ما يقدمه الصندوق مجاناً */}
    <input type="checkbox" id="navtoggle" class="nav-toggle" aria-controls="site-nav" aria-label={t('a11y.menu')} />
    <label for="navtoggle" class="burger" aria-hidden="true"><span></span><span></span><span></span></label>

    <nav class="nav" id="site-nav" aria-label={t('a11y.mainNav')}>
      {nav.map((n) => <a href={n.href} class={n.cls}>{n.label}</a>)}
    </nav>

    <div class="hd-actions">
      <Search lang={lang} />
      <a href={routes.myTrip} class="plan-link" aria-label={t('nav.myTrip')}>{t('nav.myTrip')} <span class="plan-badge" data-plan-count>0</span></a>
      <details class="lang-menu" data-lang-menu>
        <summary class="lang" aria-label={t('lang.menu')}>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a15.6 15.6 0 0 1 0 18a15.6 15.6 0 0 1 0-18Z" />
          </svg>
          {LANG_META[lang].short}
          <span class="lang-chev" aria-hidden="true"></span>
        </summary>
        <ul class="lang-list">
          {langItems.map((l) => (
            <li>
              {l.current
                ? <span class="lang-item is-current" aria-current="true" lang={l.code} dir={l.dir}>{l.native}</span>
                : <a class="lang-item" href={l.href} lang={l.code} dir={l.dir}>{l.native}</a>}
            </li>
          ))}
        </ul>
      </details>
      <a href={routes.plan} class="btn-gold">{t('nav.planVisit')}</a>
    </div>
  </div>
</header>

<script is:inline>
  // إغلاق قائمة اللغات بالنقر خارجها أو بـEsc — مستمعان على document مرة واحدة
  // (يبقيان عبر تنقّلات ClientRouter، والحارس يمنع التكرار بعد كل تنقّل).
  if (!window.__vaLangMenu) {
    window.__vaLangMenu = true;
    document.addEventListener('click', (e) => {
      document.querySelectorAll('details[data-lang-menu][open]').forEach((d) => {
        if (!d.contains(e.target)) d.removeAttribute('open');
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document.querySelectorAll('details[data-lang-menu][open]').forEach((d) => d.removeAttribute('open'));
    });
  }
</script>

<style>
  .site-header { position: sticky; inset-block-start: 0; z-index: 50; background: color-mix(in srgb, var(--c-sand) 86%, transparent); backdrop-filter: blur(10px); border-block-end: 1px solid var(--c-line); }
  /* الشريط يحمل وردماركاً وتسعة روابط وبحثاً و«رحلتي» ومبدّل لغة وزرّ دعوة،
     في عمودٍ أوسع (1280px) ممّا يتّسع له عمود المحتوى (1120px).
     **العرض اللازم مقيس** (2026-09-04، بـpuppeteer على dist وبقياس العرض
     الجوهري غير المضغوط عند سقف 2000px، لا بالنظر): كان ar ‏1249px · en ‏1331 ·
     zh ‏1131 · de ‏1625 — أي أن ثلاث لغات من أربع كانت تفيض عن 1280px فتضغط
     الفليكس أدوات الشريط وتنزلق روابط التنقّل فوقها. اللقطات أثبتت الضرر:
     «Map» مطموسة خلف زرّ البحث بالإنجليزية عند 1280px، و«Karte» مختفية كلياً
     بالألمانية مع التفاف «Meine Reise» سطرين. أي تطويل للتسميات يُعاد قياسه
     بالأداة نفسها — لا بالنظر ولا بعدّ المحارف. */
  .hd-in { inline-size: min(100% - var(--s-3), 1280px); margin-inline: auto; display: flex; align-items: center; gap: var(--s-3); min-block-size: 68px; }
  .brand { text-decoration: none; }
  /* 16px لا 20px: ثمان فجوات × 4px = 32px موفَّرة في كل لغة، وهي وحدها تكفي
     لردّ العربية إلى داخل الحاوية. الشريط يبقى متنفّساً بصرياً عند 16px. */
  .nav { display: flex; gap: 16px; margin-inline: auto; min-inline-size: 0; }
  /* مخفيّ حيث يظهر الزرّ الذهبي (وجهتهما واحدة)، ويظهر داخل القائمة المطويّة */
  .nav .nav-plan { display: none; }
  .nav a { font-family: var(--font-body); font-weight: 500; font-size: var(--t-ui, .9375rem); color: var(--c-ink); text-decoration: none; padding-block: var(--s-2); position: relative; white-space: nowrap; transition: color var(--dur) var(--ease); }
  .nav a::after { content: ''; position: absolute; inset-block-end: 0; inset-inline: 0; block-size: 2px; background: var(--c-gold); transform: scaleX(0); transform-origin: inline-end; transition: transform var(--dur) var(--ease); }
  .nav a:hover { color: var(--c-turq); }
  .nav a:hover::after { transform: scaleX(1); transform-origin: inline-start; }
  /* الألمانية والروسية في الشريط الأفقي (الروسية انضمّت 2026-09-05: تسمياتها الطبيعية
     تلزمها 1291px مقيسةً تحت هذه الكتلة، مقابل 1188 للإنجليزية):
     14px تشتري 41px مقيسة، و12px فجوةً تشتري
     28px أخرى — ومجموعهما هو الفرق بين انهيارٍ عند 1449px وانهيارٍ عند 1339px،
     أي بين شاشة 1366px تعرض برغراً وأخرى تعرض الشريط. لا يسريان داخل القائمة
     المطويّة — فالمساحة هناك رأسية والتضييق خسارة خالصة. */
  @media (min-width: 1339px) {
    /* وسقفُ حاويتها 1360px لا 1280px: اللازم للألمانية 1299px مقيسة، أي أوسع
       من السقف المشترك — وعند تجاوزه لا ينكسر الشريط ظاهراً بل **ينضغط**:
       الفليكس يقلّص أدوات الشريط فيلتفّ «Meine Reise» سطرين ويصير الشريط 69px
       بدل 68. لذلك لا يكفي قياس التراكب وحده حكماً على الاتّساع؛ الحارس يشترط
       الارتفاع 68px والسطر الواحد معاً. بقية اللغات تبقى على 1280px (اللازم
       لأطولها 1188px) فلا يتغيّر عرض ترويستها. */
    :global([lang='de']) .hd-in, :global([lang='ru']) .hd-in { inline-size: min(100% - var(--s-3), 1360px); }
    :global([lang='de']) .nav, :global([lang='ru']) .nav { gap: 12px; }
    :global([lang='de']) .nav a, :global([lang='ru']) .nav a { font-size: .875rem; }
  }
  .hd-actions { display: flex; align-items: center; gap: var(--s-3); }
  /* بوزن حبّة البحث المجاورة: كان الحدّ --c-line (‏1.1:1) غير مرئي عملياً
     والهدف اللمسي 47×38 دون 44px. */
  .lang { display: inline-flex; align-items: center; gap: 6px; min-block-size: 44px; font-family: var(--font-latin); letter-spacing: .08em; font-size: .85rem; font-weight: 600; color: var(--c-turq-deep); text-decoration: none; padding: 0 14px; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius-pill); transition: border-color var(--dur) var(--ease), background var(--dur) var(--ease); }
  .lang:hover { border-color: var(--c-turq); background: var(--c-sand-2); }
  /* قائمة اللغات المنسدلة — <details> أصلي فوق حبّة .lang نفسها */
  .lang-menu { position: relative; }
  .lang-menu > summary { list-style: none; cursor: pointer; }
  .lang-menu > summary::-webkit-details-marker { display: none; }
  .lang-menu > summary:focus-visible { outline: 2px solid var(--c-turq); outline-offset: 2px; }
  .lang-chev { inline-size: 7px; block-size: 7px; border-inline-end: 1.6px solid currentColor; border-block-end: 1.6px solid currentColor; transform: rotate(45deg); margin-block-start: -4px; transition: transform var(--dur) var(--ease); }
  .lang-menu[open] .lang-chev { transform: rotate(225deg); margin-block-start: 3px; }
  .lang-list { position: absolute; inset-inline-end: 0; inset-block-start: calc(100% + 6px); z-index: 60; min-inline-size: 170px; margin: 0; padding: 6px; list-style: none; background: #fff; border: 1px solid var(--c-line); border-radius: var(--radius); box-shadow: var(--shadow-hover); }
  .lang-item { display: block; padding: 9px 12px; border-radius: var(--radius-sm); font-family: var(--font-body); font-size: var(--t-sm); font-weight: 500; color: var(--c-ink); text-decoration: none; white-space: nowrap; transition: background var(--dur) var(--ease), color var(--dur) var(--ease); }
  a.lang-item:hover { background: var(--c-sand-2); color: var(--c-turq); }
  .lang-item.is-current { font-weight: 700; color: var(--c-turq-deep); display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .lang-item.is-current::after { content: '✓'; color: var(--c-gold-deep); }
  .btn-gold { white-space: nowrap; font-family: var(--font-body); font-weight: 600; font-size: var(--t-ui, .9375rem); background: var(--c-gold); color: var(--c-ink); text-decoration: none; padding: 10px 20px; border-radius: var(--radius-pill); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .btn-gold:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(201,154,74,.35); }
  /* هدف لمس 44×44: كان 40×32 وهو مفتاح التنقّل كلّه على الهاتف */
  .nav-toggle { display: none; }
  .burger { display: none; flex-direction: column; justify-content: center; align-items: center; gap: 5px; cursor: pointer; margin-inline-start: auto; inline-size: 44px; block-size: 44px; padding: 0; }
  /* حلقة تركيز الصندوق تُرسم على البرغر المرئي المجاور */
  .nav-toggle:focus-visible ~ .burger { outline: 2px solid var(--c-turq); outline-offset: 2px; box-shadow: 0 0 0 2px var(--c-sand); border-radius: 6px; }
  .burger span { inline-size: 24px; block-size: 2px; background: var(--c-ink); border-radius: 2px; transition: var(--dur); }
  /* عتبة الانهيار مشتقّة من قياس، لا مختارة: أدنى عرض نافذة = العرض الجوهري
     اللازم + هامش أمان 24px + var(--s-3). بعد إخفاء رابط الخطة المكرَّر وتضييق
     الفجوة إلى 16px صار اللازم ar ‏1123px · en ‏1188 · zh ‏1023 — فأعلاها
     الإنجليزية عند 1228px، والعتبة 1227px أدناها. (كانت 1199px وهي مقيسة على
     ثمانية روابط قبل إضافة التاسع، فصارت تكذب على العربية والإنجليزية معاً.) */
  @media (max-width: 1227px) {
    .hd-actions .btn-gold { display: none; }
    .burger { display: flex; }
    /* على الجوال: الصندوق في مسار التبويب، مخفي بصرياً بقصّ لا بـhidden */
    .nav-toggle { display: block; position: absolute; inline-size: 1px; block-size: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    /* visibility:hidden ضرورية لا تجميلية: max-block-size:0 وحدها تُخفي القائمة بصرياً
       لكن روابطها تبقى في مسار Tab، فيضيع تركيز الكيبورد في قائمة غير مرئية.
       تأخير visibility بمقدار --dur يُبقي حركة الطيّ مرئية عند الإغلاق. */
    .nav { position: absolute; inset-block-start: 100%; inset-inline: 0; flex-direction: column; gap: 0; margin: 0; background: var(--c-sand); border-block-end: 1px solid var(--c-line); max-block-size: 0; overflow: hidden; visibility: hidden; transition: max-block-size var(--dur) var(--ease), visibility 0s linear var(--dur); }
    .nav a { padding: var(--s-3) var(--s-4); border-block-start: 1px solid var(--c-line); }
    /* 70vh بدل 420px الثابتة: المحتوى الحالي 415px أي بهامش 5px فقط، وأي رابط
       سابع يُقصّ بلا تمرير. مع overflow-y:auto تتمرّر القائمة بدل أن تُبتر. */
    .nav-toggle:checked ~ .nav { max-block-size: 70vh; overflow-y: auto; visibility: visible; transition: max-block-size var(--dur) var(--ease), visibility 0s; }
    /* الزرّ الذهبي مخفيّ هنا، فرابط الخطة داخل القائمة هو الطريق الوحيد إليها */
    .nav .nav-plan { display: block; }
  }
  /* الألمانية والروسية تنهاران أعلى: تسمياتهما أطول بنيةً حتى بعد تقصيرها عبر خط الترجمة
     (‏Sehenswertes · Termine · Souqs & Parks، اعتماد الحاكم 91/100)، واللازم لها
     1339px نافذةً بهامش الأمان نفسه. تكرار الكتلة مقصود ومحصور: لو وُحِّدت العتبة
     عند 1338px لخسرت العربية والصينية شريطهما على شاشات 1280px بلا سبب (اللازم
     لهما 1163 و1063). لا تعدّل إحدى الكتلتين دون الأخرى. */
  @media (max-width: 1338px) {
    :global([lang='de']) .hd-actions .btn-gold, :global([lang='ru']) .hd-actions .btn-gold { display: none; }
    :global([lang='de']) .burger, :global([lang='ru']) .burger { display: flex; }
    :global([lang='de']) .nav-toggle, :global([lang='ru']) .nav-toggle { display: block; position: absolute; inline-size: 1px; block-size: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    :global([lang='de']) .nav, :global([lang='ru']) .nav { position: absolute; inset-block-start: 100%; inset-inline: 0; flex-direction: column; gap: 0; margin: 0; background: var(--c-sand); border-block-end: 1px solid var(--c-line); max-block-size: 0; overflow: hidden; visibility: hidden; transition: max-block-size var(--dur) var(--ease), visibility 0s linear var(--dur); }
    :global([lang='de']) .nav a, :global([lang='ru']) .nav a { padding: var(--s-3) var(--s-4); border-block-start: 1px solid var(--c-line); }
    :global([lang='de']) .nav-toggle:checked ~ .nav, :global([lang='ru']) .nav-toggle:checked ~ .nav { max-block-size: 70vh; overflow-y: auto; visibility: visible; transition: max-block-size var(--dur) var(--ease), visibility 0s; }
    :global([lang='de']) .nav .nav-plan, :global([lang='ru']) .nav .nav-plan { display: block; }
  }
  /* هواتف 360px وما دونها: مجموع الوردمارك والبرغر وأدوات الشريط كان يفيض عن
     الحاوية بـ28px فيُقصّ مبدّل اللغة وينزلق الوردمارك خارج الشاشة. */
  @media (max-width: 420px) {
    .hd-in { inline-size: min(100% - var(--s-2), 1280px); gap: var(--s-2); }
    .hd-actions { gap: var(--s-2); }
    .plan-link { padding-inline: 6px; }
    .lang { padding: 6px 9px; }
    .burger { inline-size: 40px; }
  }
</style>
