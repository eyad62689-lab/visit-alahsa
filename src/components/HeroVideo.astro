---
// فيديو الهيرو الموحّد — كان مكرّراً في خمس واجهات بخمسة أصناف وخمسة سكربتات.
//
// ثلاث منها (الرئيسية، المعالم، الفعاليات) كانت بسكربت وحدة (module) لا يعيد
// التنفيذ مع ClientRouter، فيموت الفيديو بعد أول تنقّل داخلي (أُثبت على الإنتاج
// 2026-08-28). التهيئة هنا معلّقة على astro:page-load وتُحرس بـdata-wired.
//
// preload="none" + data-src: لا يُنزَّل الفيديو أصلاً لمن يُفعّل «تقليل الحركة»
// أو «توفير البيانات»، ويبقى ملصق الهيرو (HeroPoster) خلفه هو المشهد.
//
// الفيديو مكتوم وبلا مسار صوت، وزر الإيقاف أُزيل بقرار 2026-10-23: من لا يُشغَّل عنده
// الفيديو (تقليل الحركة، توفير البيانات، شبكة بطيئة) يبقى الملصق مشهده.
interface Props {
  src: string;         // مسار الفيديو، مثل: /video/hero-events.mp4
  srcMobile?: string;  // نسخة عمودية اختيارية للجوال (≤760px)
  class?: string;      // صنف الواجهة للتموضع إن احتاجته
}
const { src, srcMobile, class: cls = '' } = Astro.props;
---
<video class:list={['photo-bg', 'hero-vid', cls]} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1">
  <source data-src={src} data-src-mobile={srcMobile} type="video/mp4" />
</video>

<script is:inline>
  (function () {
    function initHeroVideos() {
      document.querySelectorAll('video.hero-vid').forEach(function (v) {
        if (v.dataset.wired) return;
        v.dataset.wired = '1';
        // الوسم muted لا يُنقل إلى الخاصية حين يُدخل ClientRouter العنصر من مستند محلَّل: يُثبَّت صراحةً
        v.muted = true;
        var reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var s = v.querySelector('source');
        if (reduceMotion || !s || !s.dataset.src) return; // لا حركة أصلاً: الملصق هو المشهد

        var conn = navigator.connection || {};
        var saveData = conn.saveData === true;
        // شبكة بطيئة (2g/3g المُعلنة): لا فيديو — الملصق هو المشهد
        // (الخطوة 3 من خطة التفاعل العالمي: الفيديو كان يزاحم LCP على الجوال).
        var slowNet = typeof conn.effectiveType === 'string' && /(^|-)2g$|^3g$/.test(conn.effectiveType);

        function load() {
          if (s.src) return;
          v.addEventListener('playing', function () { v.classList.add('hero-vid--on'); }, { once: true });
          // نسخة عمودية للجوال حين تتوفر: صندوق الهيرو هناك أقرب إلى 9:16 منه إلى
          // 16:9، فكان object-fit:cover يقصّ أغلب العرض ويُظهر شريحة تبدو مائلة.
          var mobile = matchMedia('(max-width: 760px)').matches;
          s.src = (mobile && s.dataset.srcMobile) ? s.dataset.srcMobile : s.dataset.src;
          v.load();
          v.addEventListener('canplay', function () { v.play().catch(function () {}); }, { once: true });
        }

        var auto = !saveData && !slowNet;
        // التحميل التلقائي يبدأ بعد اكتمال تحميل الصفحة ثم عند خمول المتصفح، لا فوراً:
        // كان الفيديو (1.26 ميغابايت على الجوال) يبدأ عند ~450 مللي ثانية فيزاحم صورة
        // LCP والخطوط على عرض النطاق (Lighthouse 2026-09-08: LCP 4.9 ث على الرئيسية
        // العربية). الملصق يبقى المشهد حتى يبدأ التشغيل فلا يتغير ما يراه الزائر.
        // على الجوال يتأخر ثلاث ثوانٍ أخرى بعد load: النسخة العمودية 1.26 ميغابايت، ومحاكاة
        // Lighthouse للجوال أثبتت أنها تُدرَج في مخطط الشبكة فتؤخر LCP متى بدأت قبل
        // هدوء الشبكة؛ الملصق يبقى المشهد في هذه الثواني.
        function autoLoad() {
          if (s.src) return;
          var delay = matchMedia('(max-width: 760px)').matches ? 3000 : 0;
          setTimeout(function () {
            if ('requestIdleCallback' in window) requestIdleCallback(function () { v.autoplay = true; load(); }, { timeout: 2500 });
            else { v.autoplay = true; load(); }
          }, delay);
        }
        if (auto) {
          if (document.readyState === 'complete') autoLoad();
          else window.addEventListener('load', autoLoad, { once: true });
        }
      });
    }
    document.addEventListener('astro:page-load', initHeroVideos);
    if (document.readyState !== 'loading') initHeroVideos();
    else document.addEventListener('DOMContentLoaded', initHeroVideos);
  })();
</script>
