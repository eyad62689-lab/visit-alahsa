---
// SEO موحّد ثنائي اللغة: canonical + hreflang + Open Graph + Twitter + JSON-LD.
import type { Lang } from '../i18n/ui';
import { useTranslations, type AltLinks } from '../i18n/utils';
import { ogDefault } from '../lib/og';
interface Props {
  title: string; description: string; lang?: Lang; alt?: AltLinks;
  type?: 'website' | 'article'; image?: string; noindex?: boolean; jsonLd?: object | object[];
}
const {
  title, description, lang = 'ar', alt,
  type = 'website', image, noindex = false, jsonLd,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://visit-alahsa.com');
const canonical = new URL(Astro.url.pathname, site).href;
// الصورة الافتراضية بلغة الصفحة (الخطوة 4 من خطة التفاعل العالمي): كانت og-default.png
// العربية النص تخدم 96 صفحة منها كل فهارس EN وzh — فتظهر مشاركة صفحة إنجليزية ببطاقة
// عربية. النسخ الأربع تولّدها tools/gen-og-images.mjs من نصوص القواميس المعتمدة.
const ogImage = new URL(image ?? ogDefault(lang), site).href;
const blocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// صفحة noindex لا تُعلن hreflang: المحركات تتجاهلها على صفحة محجوبة، وإعلانها يربط
// النسخ المفهرسة بنسخة محجوبة بلا فائدة (مبدّل اللغة يبقى يعمل من alt نفسه).
const arHref = alt && !noindex ? new URL(alt.ar, site).href : null;
const enHref = alt && !noindex ? new URL(alt.en, site).href : null;
// zh وde وru تُدرج في hreflang فقط حين توجد نسخة فعلية للصفحة بتلك اللغة
// (الحقول الثلاثة اختيارية في alt) — لا hreflang لصفحة غير مولّدة.
const zhHref = alt?.zh && !noindex ? new URL(alt.zh, site).href : null;
const deHref = alt?.de && !noindex ? new URL(alt.de, site).href : null;
const ruHref = alt?.ru && !noindex ? new URL(alt.ru, site).href : null;
const OG_LOCALE: Record<string, string> = { ar: 'ar_SA', en: 'en_US', zh: 'zh_CN', de: 'de_DE', ru: 'ru_RU' };
const ogLocale = OG_LOCALE[lang];
const ogLocaleAlts = (['ar', 'en', 'zh', 'de', 'ru'] as const)
  .filter((l) => l !== lang && (l !== 'zh' || zhHref) && (l !== 'de' || deHref) && (l !== 'ru' || ruHref))
  .map((l) => OG_LOCALE[l]);
---
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

{arHref && <link rel="alternate" hreflang="ar" href={arHref} />}
{enHref && <link rel="alternate" hreflang="en" href={enHref} />}
{zhHref && <link rel="alternate" hreflang="zh" href={zhHref} />}
{deHref && <link rel="alternate" hreflang="de" href={deHref} />}
{ruHref && <link rel="alternate" hreflang="ru" href={ruHref} />}
{arHref && <link rel="alternate" hreflang="x-default" href={arHref} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={t('site.name')} />
<meta property="og:locale" content={ogLocale} />
{alt && ogLocaleAlts.map((l) => <meta property="og:locale:alternate" content={l} />)}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{blocks.map((obj) => (<script type="application/ld+json" set:html={JSON.stringify(obj)} />))}
