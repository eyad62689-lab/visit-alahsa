---
// صفحة الفعالية المفردة — النسخة العربية
import EventDetailView from '../../components/views/EventDetailView.astro';
import { EVENTS_AR, eventAlt } from '../../data/events';

export function getStaticPaths() {
  return EVENTS_AR.map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props;
// رابط تبديل اللغة يقصد نظير الفعالية نفسه لا قائمة الفعاليات — باللغات الثلاث
const alt = eventAlt(ev.id);
---
<EventDetailView ev={ev} lang="ar" alt={alt} />
