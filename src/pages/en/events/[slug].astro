---
// Single event page — English
import EventDetailView from '../../../components/views/EventDetailView.astro';
import { EVENTS_EN, eventAlt } from '../../../data/events';

export function getStaticPaths() {
  return EVENTS_EN.map((ev) => ({ params: { slug: ev.slug }, props: { ev } }));
}

const { ev } = Astro.props;
// The language switch points at the same event in all three languages
const alt = eventAlt(ev.id);
---
<EventDetailView ev={ev} lang="en" alt={alt} />
