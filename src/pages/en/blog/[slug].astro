---
// Blog post — English edition. The language switcher targets the article's Arabic
// counterpart when it exists, falling back to the Arabic blog index.
import BlogPostView from '../../../components/views/BlogPostView.astro';
import { getCollection } from 'astro:content';
import { postAlt } from '../../../lib/blog';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  return all
    .filter((e) => e.data.lang === 'en')
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, alt: postAlt(all, entry) } }));
}
const { entry, alt } = Astro.props;
---
<BlogPostView entry={entry} lang="en" alt={alt} />
