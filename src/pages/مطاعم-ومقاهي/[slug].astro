---
// صفحة المنشأة العربية. الحارس هنا هو بوابة النشر: لا تُولَّد صفحة لمنشأة لم
// يعبر متنُها العتبة (docs/قرار-بنية-صفحات-المنشآت.md) — فلا صفحة رقيقة تُنشر،
// والفهرس يوجّه بطاقتها إلى خرائط قوقل بدل رابط داخلي مكسور.
import { getCollection } from 'astro:content';
import { diningAlt } from '../../lib/routes';
import DiningDetailView from '../../components/views/DiningDetailView.astro';
import { hasDiningPage } from '../../lib/publish';

export async function getStaticPaths() {
  const items = await getCollection('dining');
  return items
    .filter((e) => hasDiningPage(e, 'ar'))
    .map((entry) => ({
      params: { slug: entry.data.slug_ar },
      props: { entry, alt: diningAlt(entry.data) },
    }));
}
const { entry, alt } = Astro.props;
---
<DiningDetailView entry={entry} lang="ar" alt={alt} />
