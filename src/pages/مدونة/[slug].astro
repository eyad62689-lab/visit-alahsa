---
// صفحة المقال — النسخة العربية. مبدّل اللغة يقصد نظير المقال إن وُجد وإلا فهرس المدونة.
import BlogPostView from '../../components/views/BlogPostView.astro';
import { getCollection } from 'astro:content';
import { postAlt } from '../../lib/blog';

export async function getStaticPaths() {
  const all = await getCollection('blog', ({ data }) => !data.draft);
  return all
    .filter((e) => e.data.lang === 'ar')
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, alt: postAlt(all, entry) } }));
}
const { entry, alt } = Astro.props;
---
<BlogPostView entry={entry} lang="ar" alt={alt} />
