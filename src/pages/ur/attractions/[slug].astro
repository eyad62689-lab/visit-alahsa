---
// صفحات المعالم الأوردية (ur-PK) — تُولَّد فقط للمعالم التي تحمل ترجمة أوردية
// معتمدة من خط ur-translation-pipeline (وجود title_ur هو المفتاح، على سابقة
// title_zh وtitle_de وtitle_ru). البقية لا صفحة لها فلا تظهر في hreflang ولا مبدّل
// اللغة (منطق attractionAlt) — ولا خيار يقود إلى 404.
import { attractionAlt } from '../../../lib/routes';
import DetailView from '../../../components/views/DetailView.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('attractions', ({ data }) => Boolean(data.title_ur));
  return items.map((entry) => ({
    params: { slug: entry.data.slug_en },
    props: { entry, alt: attractionAlt(entry.data) },
  }));
}
const { entry, alt } = Astro.props;
---
<DetailView entry={entry} lang="ur" alt={alt} />
