---
// صفحة 404 ثنائية اللغة — Netlify يلتقط dist/404.html تلقائياً.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PalmMotif from '../components/PalmMotif.astro';
const alt = { ar: '/', en: '/en/' };
---
<Base title="الصفحة غير موجودة — الأحساء" description="لم نعثر على هذه الصفحة." lang="ar" alt={alt} noindex={true}>
  <Header lang="ar" alt={alt} />
  <main id="main">
    <section class="container nf">
      <PalmMotif size={72} class="nf-palm" aria-hidden="true" />
      <p class="nf-code" aria-hidden="true"><bdi>404</bdi></p>
      <h1 class="nf-h">يبدو أنّك خرجت عن مسار الواحة</h1>
      <p class="nf-d">الصفحة التي تبحث عنها غير موجودة أو انتقلت. جرّب أحد هذه الأبواب:</p>
      <p class="nf-d nf-en" lang="en" dir="ltr">This page doesn’t exist. Try the home page or the attractions below.</p>
      <div class="nf-cta">
        <a href="/" class="btn btn--gold">الصفحة الرئيسية</a>
        <a href="/معالم/" class="btn btn--turq">تصفّح المعالم</a>
        <a href="/en/" class="btn btn--ghost-nf" lang="en">English home</a>
      </div>
    </section>
  </main>
  <Footer lang="ar" />
</Base>

<style>
  .nf { text-align: center; padding-block: var(--s-8); max-inline-size: 52ch; margin-inline: auto; }
  :global(.nf-palm) { color: var(--c-turq); opacity: .45; margin-inline: auto; }
  .nf-code { font-family: var(--font-latin); font-size: clamp(3rem, 9vw, 5rem); color: var(--c-gold); line-height: 1; margin-block: var(--s-3); letter-spacing: .08em; }
  .nf-h { font-size: var(--t-2xl); color: var(--c-turq-deep); line-height: 1.2; margin-block-end: var(--s-3); }
  .nf-d { color: var(--c-ink-soft); line-height: 1.8; }
  .nf-en { font-size: var(--t-sm); margin-block-start: var(--s-2); }
  .nf-cta { display: flex; gap: var(--s-3); justify-content: center; flex-wrap: wrap; margin-block-start: var(--s-5); }
  .btn--ghost-nf { background: transparent; color: var(--c-ink); border: 1.5px solid var(--c-line); }
  .btn--ghost-nf:hover { border-color: var(--c-turq); color: var(--c-turq); }
  @media (max-width: 560px) { .nf-cta { flex-direction: column; } .nf-cta .btn { justify-content: center; } }
</style>
