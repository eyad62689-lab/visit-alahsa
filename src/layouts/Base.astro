---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
// الخطوط الفاخرة (مهارة alahsa-typography) مستضافة ذاتياً عبر fontsource
// (سيو 2026-08-22): استدعاء Google Fonts الخارجي كان يحجب العرض ويرفع LCP
// عبر الموقع كله (العقوبة المقيسة في Lighthouse). نفس العائلات والأوزان
// المعتمدة حرفياً — تتغير آلية التحميل فقط، وfont-display: swap مضمّن.
import '@fontsource/cairo/400.css';
import '@fontsource/cairo/700.css';
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/lora/400.css';
import '@fontsource/lora/600.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/600.css';
import Seo from '../components/Seo.astro';
import { srcsetFor } from '../lib/images';
import { dir, htmlLang, type AltLinks } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  alt?: AltLinks;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  /* المسار الأساسي لصورة الهيرو (بلا امتداد) — تُحمَّل مسبقاً لتحسين LCP */
  preloadImage?: string;
}
const {
  title,
  description = 'الأحساء — أكبر واحة نخيل في العالم وموقع تراث عالمي مسجّل في اليونسكو.',
  lang = 'ar', alt, type, image, noindex, jsonLd, preloadImage,
} = Astro.props;

// Google Analytics 4 (GA4). معرّف القياس ثابت للموقع كله.
const GA_ID = 'G-QB084SK5XJ';

// وصفة التحميل المسبق لصورة الهيرو بنفس srcset الذي يستعمله HeroPoster.
// بدونها كان preload يشير إلى الصورة الكاملة فينزّل الجوال نسختين: الكاملة
// (‏260KB في قصر إبراهيم) ثم ما يختاره srcset (‏80KB) — والزائر العائد أسوأ،
// إذ يعرض المتصفح الكاملة من الكاش متجاوزاً srcset (تدقيق 2026-08-28).
// نفس sizes="100vw" الموجودة في HeroPoster وإلا اختار المتصفح مرشّحاً مختلفاً.
const preloadSet = preloadImage ? srcsetFor(preloadImage) : undefined;
---
<!doctype html>
<html lang={htmlLang(lang)} dir={dir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#006E61" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo title={title} description={description} lang={lang} alt={alt} type={type} image={image} noindex={noindex} jsonLd={jsonLd} />

    {/* الخطوط الفاخرة كلها مستضافة ذاتياً الآن (استيرادات fontsource أعلاه) —
        أُزيل استدعاء Google Fonts المحجِب للعرض (سيو 2026-08-22). */}

    {/* preload لخطّ المتن الحرج المستضاف ذاتياً حسب اللغة (يحمي LCP). */}
    {lang === 'ar' ? (
      <link rel="preload" href="/fonts/plex-ar-400.woff2" as="font" type="font/woff2" crossorigin />
    ) : (
      <link rel="preload" href="/fonts/plex-lat-400.woff2" as="font" type="font/woff2" crossorigin />
    )}

    {/* التحميل المسبق لصورة الهيرو (أكبر عنصر مرئي LCP) في الصفحات ذات الهيرو المصوّر */}
    {preloadImage && (
      <link
        rel="preload" as="image" href={`${preloadImage}.webp`} type="image/webp" fetchpriority="high"
        imagesrcset={preloadSet?.webp}
        imagesizes={preloadSet ? '100vw' : undefined}
      />
    )}

    {/* Google Analytics 4 — يُحمّل بالكود بدل حقن Netlify. مع ClientRouter (تحولات
        العرض) نُعطّل page_view التلقائي ونرسله يدوياً في كل astro:page-load
        (يقع عند التحميل الأول وبعد كل تنقّل) فنحصل على زيارةٍ واحدة لكل صفحة.
        تحميل المكتبة مؤجَّل إلى ما بعد load + مهلة خمول (سيو 2026-08-22) كي لا
        تزاحم العرض الأول — الأحداث قبل وصولها تُصفّ في dataLayer وتُعالج حال
        وصول المكتبة، فلا تضيع أي زيارة. */}
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', GA_ID, { send_page_view: false });
      document.addEventListener('astro:page-load', () => {
        gtag('event', 'page_view', {
          page_title: document.title,
          page_location: location.href,
          page_path: location.pathname + location.search,
        });
      });
      (function loadGtagLazily() {
        var injected = false;
        function inject() {
          if (injected) return;
          injected = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
        }
        function afterLoad() {
          if ('requestIdleCallback' in window) requestIdleCallback(inject, { timeout: 4000 });
          else setTimeout(inject, 2000);
        }
        if (document.readyState === 'complete') afterLoad();
        else window.addEventListener('load', afterLoad, { once: true });
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main" data-pagefind-ignore>{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
    <slot />
    <script is:inline>
      function initReveal() {
        const els = document.querySelectorAll('[data-reveal]:not(.in)');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { els.forEach((e) => e.classList.add('in')); return; }
        const io = new IntersectionObserver((ents) => {
          ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((e) => io.observe(e));
      }
      document.addEventListener('astro:page-load', initReveal);
      if (document.readyState !== 'loading') initReveal();
      else document.addEventListener('DOMContentLoaded', initReveal);
    </script>
    <script is:inline>
      window.VAPlan = {
        key: 'va-plan',
        get() { try { return JSON.parse(localStorage.getItem(this.key) || '[]'); } catch (e) { return []; } },
        save(a) { try { localStorage.setItem(this.key, JSON.stringify(a)); } catch (e) {} this.sync(); },
        has(slug) { return this.get().indexOf(slug) !== -1; },
        toggle(slug) { const a = this.get(); const i = a.indexOf(slug); if (i !== -1) a.splice(i, 1); else a.push(slug); this.save(a); return this.has(slug); },
        sync() {
          const favs = this.get();
          document.querySelectorAll('[data-fav]').forEach((b) => {
            const on = favs.indexOf(b.getAttribute('data-fav')) !== -1;
            b.classList.toggle('is-saved', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
            const tx = b.querySelector('[data-fav-tx]');
            if (tx) tx.textContent = on ? (b.getAttribute('data-tx-on') || '') : (b.getAttribute('data-tx-off') || '');
          });
          document.querySelectorAll('[data-plan-count]').forEach((el) => { el.textContent = favs.length; el.classList.toggle('has-items', favs.length > 0); });
          document.dispatchEvent(new CustomEvent('va-plan-change', { detail: favs }));
        },
      };
      document.addEventListener('click', (e) => { const b = e.target.closest('[data-fav]'); if (!b) return; e.preventDefault(); window.VAPlan.toggle(b.getAttribute('data-fav')); });
      document.addEventListener('astro:page-load', () => window.VAPlan.sync());
      if (document.readyState !== 'loading') window.VAPlan.sync();
      else document.addEventListener('DOMContentLoaded', () => window.VAPlan.sync());
    </script>
  </body>
</html>
