    "@fontsource/lora": "^5.3.0",
    "@fontsource/marcellus": "^5.2.8",
    "@fontsource/playfair-display": "^5.3.0",
    "@netlify/blobs": "^10.7.13",
    "astro": "^7.0.0",
    "maplibre-gl": "^6.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.4.0",
