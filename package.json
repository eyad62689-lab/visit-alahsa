    "test:advisor": "node tools/test-advisor.mjs",
    "advisor:dev": "node tools/advisor-dev-server.mjs",
    "advisor:eval": "node tools/advisor-eval.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "fingerprint": "node scripts/fingerprint.mjs",
    "pull:reports": "node scripts/pull-reports.mjs",
    "check:consistency": "node tools/check-consistency.mjs",
    "check:published-text": "node tools/scan-published-text.mjs",
    "test:detect": "node tools/test-ai-detection.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
