    "test:detect": "node tools/test-ai-detection.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.2.8",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
